@state class_umbral
name: Elective: Umbral Theory
kind: class
group: elective
art: skull
tags: class
desc: Restricted. The study of shadow, death and what lies behind both. Strictly theoretical. Mostly.
tick:
  arcana +2
  lore +1
  mood -2

