# ============================================================
#  Persistent states. A state is something that sticks to the
#  player across months: an origin, a class, a club, a job, an
#  illness, a curse. States can:
#    tick:      run every month start while active
#    duration:  default length in months (omit = until removed)
#    group:     only one state of the same group at a time
#    on_add / on_expire / on_remove: effects
#  Events check them with has(state_id) and left(state_id).
# ============================================================

# ---------------- Origins (chosen at the start) ----------------

@state origin_noble
name: Minor Nobility
kind: origin
group: origin
art: crown
desc: A family name that opens doors and an allowance that arrives every month — with letters attached.
tick:
  gold +6
on_add:
  gold +60
  charm +3
  renown +6

@state origin_scholar
name: Scholarship Student
kind: origin
group: origin
art: scroll
desc: The Crown pays your way — as long as your standing stays above 30.
tick:
  if grades >= 30:
    gold +5
on_add:
  lore +5
  grades +8

@state origin_hedge
name: Hedge-Witch's Grandchild
kind: origin
group: origin
art: mushroom
desc: Raised among drying herbs and muttered charms. Proper magic still feels a little too proper.
on_add:
  alchemy +6
  mood +6
  gold +15

@state origin_street
name: Street-Raised
kind: origin
group: origin
art: mask
desc: You learned to read crowds before you learned to read runes.
on_add:
  guile +7
  vigor +3
  gold +10

@state origin_merchant
name: Merchant's Child
kind: origin
group: origin
art: scales
desc: Everything has a price, and you were taught to haggle it down.
tick:
  gold +3
on_add:
  gold +90
  charm +3

# ---------------- Electives (one per term) ----------------

@state class_pyromancy
name: Elective: Pyromancy
kind: class
group: elective
art: flame
tags: class
desc: Fire answers to will, not wishes. Singed eyebrows are considered a rite of passage.
tick:
  arcana +2
  health -1

@state class_tidecalling
name: Elective: Tidecalling
kind: class
group: elective
art: wave
tags: class
desc: Lessons on the lake shore, bending water and patience in equal measure.
tick:
  arcana +1
  vigor +1
  mood +1

@state class_illusion
name: Elective: Illusion & Glamour
kind: class
group: elective
art: mask
tags: class
desc: The art of making people see what you want. Professor Vey insists it is not lying.
tick:
  guile +1
  charm +1

@state class_alchemy
name: Elective: Practical Alchemy
kind: class
group: elective
art: cauldron
tags: class
desc: Brewing, distilling and the occasional controlled explosion.
tick:
  alchemy +2

@state class_divination
name: Elective: Divination
kind: class
group: elective
art: eye
tags: class
desc: Tea leaves, star charts and the Mirror of Next Tuesday.
tick:
  lore +1
  if rand(1, 3) == 1:
    mood -2

@state class_artifice
name: Elective: Artifice
kind: class
group: elective
art: gear
tags: class
desc: Enchanting objects to do what they were never meant to do.
tick:
  alchemy +1
  lore +1

@state class_beastcraft
name: Elective: Beastcraft
kind: class
group: elective
art: paw
tags: class
desc: Familiars, griffon husbandry and dodging the manticore pen.
tick:
  vigor +1
  mood +2

@state class_astromancy
name: Elective: Astromancy
kind: class
group: elective
art: planet
tags: class
desc: Midnight lectures on the observatory roof. You will learn the stars; you will lose sleep.
tick:
  lore +2
  health -1

@state class_healing
name: Elective: Healing Arts
kind: class
group: elective
art: cross
tags: class
desc: Mending flesh with light and needle. Sister Amaranth expects perfection.
tick:
  alchemy +1
  lore +1
  health +1

@state class_umbral
name: Elective: Umbral Theory
kind: class
group: elective
art: skull
tags: class
desc: Restricted. The study of shadow, death and what lies behind both. Strictly theoretical. Mostly.
tick:
  arcana +2
  lore +1
  mood -2

# ---------------- Clubs (one at a time) ----------------

@state club_dueling
name: Club: Dueling Circle
