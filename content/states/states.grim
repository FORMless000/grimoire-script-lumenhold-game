  lore +1
  mood +1

@state club_cartographers
name: Club: Midnight Cartographers
kind: club
group: club
art: map
desc: A club that officially does not exist, mapping corridors that officially do not either.
tick:
  guile +1
  lore +1

# ---------------- Jobs (one at a time) ----------------

@state job_library
name: Job: Library Assistant
kind: job
group: job
art: book
desc: Reshelving books that bite. Quiet hours, modest pay.
tick:
  gold +10
  lore +1
  mood -1

@state job_tavern
name: Job: The Gilded Newt
kind: job
group: job
art: cup
desc: Serving cider in the village tavern. Good tips, sore feet.
tick:
  gold +16
  charm +1
  health -2

@state job_apothecary
name: Job: Apothecary Clerk
kind: job
group: job
art: bottle
desc: Labelling jars at Pell & Daughters. Do not lick anything.
tick:
  gold +12
  alchemy +1

@state job_stables
name: Job: Familiar Stables
kind: job
group: job
art: paw
desc: Feeding hippogriffs and mucking out things that breathe smoke.
tick:
  gold +11
  vigor +1
  health -1

@state job_tutor
name: Job: First-Year Tutor
kind: job
group: job
art: feather
desc: Explaining the difference between a hex and a jinx, again.
tick:
  gold +12
  grades +1
  mood -1

@state job_courier
name: Job: Broom Courier
kind: job
group: job
art: letter
desc: Parcels across the lake at full speed. Pays well. Hurts often.
tick:
  gold +18
  vigor +1
  health -3

# ---------------- Conditions ----------------

@state sick
name: Lake Fever
kind: debuff
art: rain
duration: 2
desc: Shivers, sniffles and a nose that glows faintly blue.
tick:
  health -4
  mood -2

@state injured
name: Injured
kind: debuff
art: cross
duration: 2
desc: Something is bruised, sprained or bent the wrong way.
tick:
  health -2
  vigor -1

@state exhausted
name: Exhausted
kind: debuff
art: bed
duration: 1
desc: You could sleep standing up. You might have.
tick:
  health -3
  mood -3

@state inspired
name: Inspired
kind: buff
art: sparkle
duration: 2
desc: Ideas arrive faster than you can write them down.
tick:
  lore +1
  arcana +1
  mood +2

@state heartbroken
name: Heartbroken
kind: debuff
art: heartbreak
duration: 3
desc: Songs are suddenly about you. All of them.
tick:
  mood -4

@state slacking
name: Skipping Classes
kind: debuff
art: bed
duration: 2
desc: Freedom! Also: falling behind.
tick:
  mood +2

@state detention
name: Detention
kind: debuff
art: lock
duration: 1
desc: Scrubbing cauldrons under the eye of a prefect.
tick:
  mood -3

@state probation
name: Academic Probation
kind: debuff
art: scales
desc: One more failure and the board will not be lenient. Raise your Standing above 35 to clear it.
tick:
  mood -2
  if grades >= 35:
    lose probation

@state in_debt
name: Debt to Grisk
kind: debuff
art: chain
desc: The goblin moneylender takes 12 crowns a month until the debt is cleared.
tick:
  if gold >= 12:
    gold -12
    debt_paid += 1
  else:
    mood -4
    debt_missed += 1
  if debt_paid >= 6:
    lose in_debt
  if debt_missed >= 2:
    queue grisk_collectors now

@state famous
name: Talk of the Academy
kind: buff
art: star
duration: 3
desc: Strangers know your name. Some of them even say it nicely.
tick:
  renown +2
  mood +1

@state hiccup_hex
name: Hiccup Hex
kind: debuff
art: sparkle
duration: 2
desc: Every hiccup releases a small, harmless, extremely embarrassing firework.
tick:
  mood -2
  renown +1

@state blessed
name: Maud's Blessing
kind: buff
art: flower
duration: 3
desc: A sprig of rosemary in your pocket that never wilts.
tick:
  health +3

@state familiar_fox
name: Familiar: Ember
kind: buff
art: fox
desc: A fox-spirit with a smouldering tail who has decided you are hers.
tick:
  mood +2
  if rand(1, 4) == 1:
    guile +1

@state familiar_owl
name: Familiar: Clockwork Owl
kind: buff
art: owl
desc: Mira's gift. It hoots the hour, mostly correctly, and remembers your homework.
tick:
  grades +1

@state training
name: Tournament Training
kind: buff
art: duel
duration: 2
desc: Dawn drills on the dueling green.
tick:
  vigor +2
  arcana +1
  health -1

@state wakeful
name: Draught of Wakefulness
kind: buff
art: potion
duration: 1
desc: You haven't blinked in eleven hours. Your notes are immaculate.
tick:
  grades +3
  health -3

@state haunted
name: Haunted Dormitory
kind: debuff
art: ghost
duration: 2
desc: Something rearranges your socks at night.
tick:
  mood -2

@state watched
name: Under Bram's Eye
kind: debuff
art: eye
duration: 3
desc: The prefect is watching you. Specifically, and with relish.
tick:
  mood -1

@state umbral_curse
name: Umbral Curse
kind: debuff
art: skull
desc: A cold that lives under your skin. Something in the restricted section followed you home.
tick:
  health -3
  mood -1
  arcana +1

@state hollow_dreams
name: Hollow Dreams
kind: debuff
art: moon
desc: Every night: a black star, a door beneath the lake, a voice that knows your name.
tick:
  mood -1
  lore +1

@state star_mark
name: The Star-Mark
kind: buff
art: star
desc: A pale, star-shaped mark on your palm that hums near old magic.
tick:
  arcana +1

@state summer_away
name: Summer Away
kind: neutral
art: house
duration: 2
desc: Away from the academy for the summer recess. No rent, no classes.

@state summer_work
name: Summer Work
kind: job
art: coin
duration: 2
desc: A summer of honest (and occasionally dishonest) labour.
tick:
  gold +25
  health -2

@state frog_voice
name: Croaking
kind: debuff
art: frog
duration: 1
desc: A botched transfiguration left you with the voice of a bullfrog.
tick:
  charm -1
  mood -2

@state garden_plot
name: Garden Plot
kind: buff
art: leaf
desc: A little square of earth behind the greenhouses that is yours. Things grow; so do you.
tick:
  alchemy +1
  if rand(1, 3) == 1:
    mood +2

@state pen_pal
name: Pen Pal in Thornwick
kind: buff
art: letter
desc: A student at the rival academy who writes you long, funny letters full of terrible gossip.
tick:
  mood +1
  if rand(1, 4) == 1:
    lore +1

@state frost_ward
name: Ilse's Frost-Ward
kind: buff
art: snow
desc: A sliver of Northern winter that Ilse sewed into your collar. Cold things think twice about you.
tick:
  arcana +1
  health +1
