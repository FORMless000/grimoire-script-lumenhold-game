@state club_skyrace
name: Club: Skyrace Squad
kind: club
group: club
art: broom
desc: Brooms, hoops and screaming crowds.
tick:
  vigor +2
  health -1

@state club_ledger
name: Club: The Lumen Ledger
kind: club
group: club
art: paper
