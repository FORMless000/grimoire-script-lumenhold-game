# ============================================================
#  Lumenhold Academy — core rules
#  Resources, skills, calendar, global hooks.
#  See docs/grimoire-script.md for the language.
# ============================================================

@game
title: Lumenhold Academy
subtitle: Four years. Forty-seven moons. One apprentice.
# Four years (design §4.1). The academic year starts in autumn; the run ends in Goldenhaze of year 4 (turn 47).
years: 4
last_month: 11
months: Harvestmoon, Emberwane, Mistveil, Frostcall, Deepwinter, Thawmoon, Stormbloom, Greenrise, Blossomtide, Highsun, Goldenhaze, Starfall
calendar: term=1-4 break=5-6 term=7-10 break=11-12
seasons: autumn=1-3 winter=4-6 spring=7-9 summer=10-12
summer_months: 5, 6, 11, 12
# Each month is one day (design §4.2). The two visits are picked on the map.
day_term: morning=courses noon=social:1-2 afternoon=visit evening=visit night=world:1-2 midnight=special:0-1
day_break: morning=plan afternoon=visit night=world:1
max_cards_per_day: 14
cards_per_month: 3
max_cards_per_month: 7
social_per_month: 1
min_random_per_month: 1
intro: The sky-barge lurches. Below, the lake glitters; above, the seven towers of Lumenhold Academy pierce the clouds. You have a trunk, a borrowed wand and a letter of acceptance with your name spelled wrong. Four years begin now.

# ---------------- Resources ----------------
# The top bars (design §8.1) are Health · Mood · Mana · Renown · Alignment, in this order;
# `display: panel` resources (Crowns, Standing) are shown in the You panel instead.

@resource health
name: Health
icon: heart
min: 0
max: 100
start: 70
color: #d9606a
desc: Your body. At zero you collapse.
warn_below: 20
on_zero:
  queue crisis_collapse now

@resource mood
name: Mood
icon: sun
min: 0
max: 100
start: 60
color: #e6b84a
desc: Your spirits. At zero, despair takes hold.
warn_below: 20
on_zero:
  queue crisis_despair now

@resource mana
name: Mana
icon: sparkle
min: 0
max: 40 + arcana / 2
start: 30
color: #5fa8e8
desc: The magic you can spend on spells. Refills each month, faster the stronger your Arcana.
warn_below: 8

@resource renown
name: Renown
icon: star
min: 0
max: 100
start: 5
color: #b58ae0
desc: How much the academy talks about you — for better or worse. Fades a little every month.

@resource alignment
name: Alignment
icon: moon
min: -100
max: 100
start: 0
color: #c9b8ff
drag: -50 0.5
desc: Lumen or Hollow: the light you serve, or the dark that has noticed you. Deep in the Hollow, the way back is slow.

@resource gold
name: Crowns
icon: coin
min: 0
max: 99999
start: 30
color: #d7a948
display: panel
warn_below: 6
desc: Crowns in your purse. Rent is due every month.
on_zero:
  flag broke

@resource grades
name: Standing
icon: scroll
min: 0
max: 100
start: 50
color: #6aa0e0
display: panel
warn_below: 20
desc: Your academic standing. At zero you face the disciplinary board.
on_zero:
  queue crisis_probation now

# ---------------- Skills ----------------

@skill arcana
name: Arcana
icon: wand
start: 8
max: 100
desc: Raw spellcraft — power, control, nerve.

@skill lore
name: Lore
icon: book
start: 8
max: 100
desc: Scholarship, theory, history, languages of the old world.

@skill alchemy
name: Alchemy
icon: potion
start: 6
max: 100
desc: Potions, herbs, reagents and the patience to stir clockwise.

@skill charm
name: Charm
icon: mask
start: 8
max: 100
desc: Wit, warmth, persuasion. Making people want to say yes.

@skill vigor
name: Vigor
icon: sword
start: 8
max: 100
desc: Stamina, reflexes, dueling and broom-flight.

@skill guile
name: Guile
icon: eye
start: 6
max: 100
desc: Sneaking, lying, noticing what others miss.

# ---------------- Global hooks ----------------

@hook rent
on: month_start
label: Dormitory & board
when: turn > 1 and term
do:
  gold -10

@hook break_rent
on: month_start
label: Board at the castle
when: break and has(plan_castle)
do:
  gold -6

# Tuition each term (design §8.2); the scholarship pays half.
@hook tuition
on: term_start
label: Tuition
do:
  if has(origin_scholar):
    gold -20
  else:
    gold -40

# Standing (legacy) follows the GPA at the end of each term until phase 3 retires it.
@hook term_marks
on: term_end
label: Term marks
when: gpa > 0
do:
  grades += (gpa - 2.5) * 8

@hook gpa_probation
on: term_end
label: Academic probation
when: gpa > 0 and gpa < 1.5 and year >= 2
do:
  queue crisis_probation

@hook term_stress
on: month_start
label: Term-time pressure
when: turn > 1 and term
do:
  mood -1
  if month == 4 or month == 10:
    mood -3

@hook debt_pressure
on: month_start
label: Empty purse
when: gold <= 0 and turn > 1
do:
  mood -4

@hook exhaustion_drain
on: month_start
label: Running on empty
when: health < 25
do:
  mood -3

@hook gloom_drain
on: month_start
label: Gloom
when: mood < 20
do:
  health -2

@hook natural_recovery
on: month_start
label: Rest
when: health < 60 and not has(sick) and not has(injured)
do:
  health +2

@hook standing_drift
on: month_start
label: Coursework
when: turn > 1 and term and turn % 2 == 0
do:
  grades -1
  if has(slacking):
    grades -2

@hook fame_fades
on: month_start
label: Fading gossip
when: turn > 1 and renown >= 5
do:
  renown -= floor(renown * 0.2)

@hook mana_regen
on: month_start
label: Mana returns
when: turn > 1
do:
  mana += 10 + arcana / 10

# ---------------- Game start ----------------

@hook start
on: game_start
do:
  queue intro_arrival now
  queue choose_origin now

@hook love_glow
on: month_start
label: Someone to come home to
when: bonds(partner) > 0
do:
  mood +3

@hook lonely
on: month_start
label: Loneliness
when: turn > 4 and bonds(friend) + bonds(close) + bonds(partner) == 0
do:
  mood -2
