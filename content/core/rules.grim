# ============================================================
#  Lumenhold Academy — core rules
#  Resources, skills, calendar, global hooks.
#  See docs/grimoire-script.md for the language.
# ============================================================

@game
title: Lumenhold Academy
subtitle: Four years. Forty-eight moons. One apprentice.
# The content format version (design §12). Frozen: v1 may only grow; see test/golden/schema-v1.json.
schema: 1
# Four years (design §4.1). The academic year starts in autumn; the run ends in Starfall of year 4 (turn 48).
# Year 4's last break is the wrap-up: no plans or duties, board on the house; its last month only resolves the run.
years: 4
last_month: 12
wrapup: 11-12
months: Harvestmoon, Emberwane, Mistveil, Frostcall, Deepwinter, Thawmoon, Stormbloom, Greenrise, Blossomtide, Highsun, Goldenhaze, Starfall
calendar: term=1-4 break=5-6 term=7-10 break=11-12
seasons: autumn=1-3 winter=4-6 spring=7-9 summer=10-12
summer_months: 5, 6, 11, 12
# Each month is one day (design §4.2). The two visits are picked on the map.
day_term: morning=courses noon=social:1-2 afternoon=visit evening=visit night=world:1-2 midnight=special:0-1
day_break: morning=plan afternoon=visit evening=visit night=world:1 midnight=special:0
day_last: morning=special:0
# Social and world cards are dealt across the whole day (playtest 2, M43), not only at noon and night; `slot:` requires a
# slot and `time:` favours one.
spread: social world
# The origin is picked on its own screen before the game (its options are the origins).
origins: choose_origin
# Exams are cards (playtest 2, M4): this one is pushed for each enrolled course in a term's last month.
exam: course_exam
# A failed course pushes this card in the course's context (playtest 2, N4): a won appeal turns the F into a C.
appeal: grade_appeal
spark_cooldown: spark_cooldown
# A job is a fixed number of shifts a term (playtest 2, I1): this card is pushed on the first visit after the last one.
off_shift: job_off_shift
# The term-time map; a break plan's `map_id:` replaces it (home, or the internship host's).
map_id: campus
cards_per_month: 3
max_cards_per_month: 7
social_per_month: 1
min_random_per_month: 1
intro: The sky-barge lurches. Below, the lake glitters; above, the seven towers of Lumenhold Academy pierce the clouds. You have a trunk, a borrowed wand and a letter of acceptance with your name spelled wrong. Four years begin now.

# ---------------- Resources ----------------
# The top bars (design §8.1) are Health · Mood · Mana · Renown · Alignment, in this order;
# `display: panel` resources (Crowns, Standing) are shown in the You panel instead.

@resource health
name: Health
icon: heart
min: 0
max: 100
start: 70
color: #d9606a
desc: Your body. At zero you collapse.
warn_below: 20
on_zero:
  queue crisis_collapse now

@resource mood
name: Mood
icon: sun
min: 0
max: 100
start: 60
color: #e6b84a
desc: Your spirits. At zero, despair takes hold.
warn_below: 20
on_zero:
  queue crisis_despair now

@resource mana
name: Mana
icon: sparkle
min: 0
max: 40 + arcana / 2
start: 30
color: #5fa8e8
desc: The magic you can spend on spells. Refills each month, faster the stronger your Arcana.
warn_below: 8

@resource renown
name: Renown
icon: star
min: 0
max: 100
start: 5
color: #b58ae0
desc: How much the academy talks about you — for better or worse. Fades a little every month.

@resource alignment
name: Alignment
icon: moon
min: -100
max: 100
start: 0
color: #c9b8ff
drag: -50 0.5
desc: Lumen or Hollow: the light you serve, or the dark that has noticed you. Deep in the Hollow, the way back is slow.

@resource gold
name: Crowns
icon: coin
min: 0
max: 99999
start: 30
color: #d7a948
display: panel
warn_below: 6
desc: Crowns in your purse. Rent is due every month.
on_zero:
  flag broke

# ---------------- Skills ----------------

@skill arcana
name: Arcana
icon: wand
start: 8
max: 100
desc: Raw spellcraft — power, control, nerve.

@skill lore
name: Lore
icon: book
start: 8
max: 100
desc: Scholarship, theory, history, languages of the old world.

@skill alchemy
name: Alchemy
icon: potion
start: 6
max: 100
desc: Potions, herbs, reagents and the patience to stir clockwise.

@skill charm
name: Charm
icon: mask
start: 8
max: 100
desc: Wit, warmth, persuasion. Making people want to say yes.

@skill vigor
name: Vigor
icon: sword
start: 8
max: 100
desc: Stamina, reflexes, dueling and broom-flight.

@skill guile
name: Guile
icon: eye
start: 6
max: 100
desc: Sneaking, lying, noticing what others miss.

# ---------------- Global hooks ----------------

# Unpaid board (design §8.2): a hungry month; twice in a row, Grisk settles it for you (grisk_board_debt).
@hook rent
on: month_start
label: Dormitory & board
when: turn > 1 and term
do:
  if gold >= 8:
    gold -8
    board_missed = 0
  else:
    gold = 0
    gain hungry
    board_missed += 1
    if board_missed >= 2 and not has(in_debt) and not flag(grisk_done):
      board_missed = 0
      queue grisk_board_debt
  say: {board_missed == 0: {~The bursar takes the board money with a nod and a tick in a very large book.|Board paid: a bed, three meals and the right to complain about both.|You pay the board and count what's left twice.}|{~The board went unpaid. The refectory still feeds you, a little less each day.|No board money this month. Lunch is a pocketed roll.}}

@hook break_rent
on: month_start
label: Board at the castle
when: break and (has(plan_castle) or has(plan_work))
do:
  gold -8
  say: {~The castle in the holidays still wants its board.|A bed in an empty dormitory costs the same as a full one.}

# Tuition each term (design §8.2): noble and merchant families pay it (L24); the scholarship pays half.
@hook tuition
on: term_start
label: Tuition
do:
  if has(origin_scholar):
    gold -8
  elif not (has(origin_noble) or has(origin_merchant)):
    gold -16
  say: {~Term fees, paid at a window with a very small grille.|The bursar's quill scratches. Another term is paid for.}

@hook gpa_probation
on: term_end
label: Academic probation
when: gpa > 0 and (year >= 2 or month >= 10)
do:
  if gpa < 1.5 and not has(probation):
    gain probation
  if gpa < 1.0:
    gpa_low += 1
  else:
    gpa_low = 0
  if gpa_low >= 2:
    gpa_low = 0
    queue crisis_probation

# Coursework (phase 3): each enrolled course trains its main skill a little every term month.
# (Replaces the v0.2 elective states' ticks, which enrolment used to grant two at a time.)
@hook coursework_evocation
on: month_start
label: Coursework
when: term and enrolled(evocation)
do:
  arcana +small
  say: {~Fire and water drills, twice a week.|Your sleeves smell of smoke, and the cuffs are damp.}

@hook coursework_astromancy
on: month_start
label: Coursework
when: term and enrolled(astromancy)
do:
  lore +small
  say: {~Star charts by candlelight.|Tea leaves in the morning, star tables at night.}

@hook coursework_alchemy
on: month_start
label: Coursework
when: term and enrolled(alchemy)
do:
  alchemy +small
  say: {~Measuring, stirring, writing it all down.|Your fingers are stained a new colour this month.}

@hook coursework_illusion
on: month_start
label: Coursework
when: term and enrolled(illusion)
do:
  charm +small
  say: {~Glamour exercises in front of the mirror.|You practise a smile that isn't quite yours.}

@hook coursework_beastcraft
on: month_start
label: Coursework
when: term and enrolled(beastcraft)
do:
  vigor +small
  say: {~Mucking out and riding drills.|Hay in your hair and a bruise from a broom.}

@hook coursework_umbral
on: month_start
label: Coursework
when: term and enrolled(umbral)
do:
  guile +small
  say: {~Ward drills in the dim tower.|Lessons in the dark, where you learn to listen.}

@hook coursework_artifice
on: month_start
label: Coursework
when: term and enrolled(artifice)
do:
  alchemy +small
  say: {~Gears, springs and burnt fingertips.|The workshop hums with your half-finished work.}

@hook coursework_starcalling
on: month_start
label: Coursework
when: term and enrolled(starcalling)
do:
  lore +small
  say: {~Night appointments under the dome.|Names of stars, said into the cold.}

@hook coursework_hollow_studies
on: month_start
label: Coursework
when: term and enrolled(hollow_studies)
do:
  guile +small
  say: {~A windowless room and very old books.|Lessons you can't repeat at dinner.}

@hook term_stress
on: month_start
label: Term-time pressure
when: turn > 1 and term
do:
  mood -3
  if month == 4 or month == 10:
    mood -6
  say: {month == 4 or month == 10: {~Exams are coming, and everybody's quill moves faster.|The library stays open late and is full until it closes.|You dream of an exam you haven't revised for, which is most of them.}|{~Essays stack up on your desk like weather coming in.|Lectures, reading, more reading. Term has a weight of its own.|Everyone is behind. Everyone says so in the corridors.}}

@hook exhaustion_drain
on: month_start
label: Running on empty
when: health < 25
do:
  mood -6
  say: {~You are so tired that the stairs look personal.|Your body has opinions about this month, and none of them are kind.|You fall asleep in a lecture and wake up in a different mood.}

@hook gloom_drain
on: month_start
label: Gloom
when: mood < 20
do:
  health -5
  say: {~A grey month. You eat little and sleep badly.|Low spirits sit in your chest like a cold.|The gloom gets into your bones; even the stairs feel steeper.}

@hook natural_recovery
on: month_start
label: Rest
when: health < 70 and not has(sick) and not has(injured)
do:
  health +10
  say: {~A few early nights and a warm meal put some colour back in your face.|You rest, and your body thanks you slowly.|Sleep, soup and a quiet week. You feel more like yourself.}

@hook fame_fades
on: month_start
label: Fading gossip
when: turn > 1 and renown >= 5
do:
  renown -= floor(renown * 0.2)
  say: {~The corridors find something else to talk about.|Yesterday's gossip goes the way of yesterday's bread.|Fewer heads turn when you pass. It's restful.}

@hook mana_regen
on: month_start
label: Mana returns
when: turn > 1
do:
  mana += 10 + arcana / 10
  say: {~The magic seeps back into you overnight, like warmth into cold hands.|Your fingertips tingle again by morning.|Whatever you spent, the castle quietly gives some back.}

# Ambient drains (design §8.2): exam nerves in the finals months, so mana matters even without casting.
@hook exam_nerves
on: month_start
label: Exam nerves
when: month == 4 or month == 10
do:
  mana -= 15
  say: {~Exam nerves eat at your magic: your wand hand won't stay still.|Revision drinks your mana before you can cast a thing.}

# ---------------- Game start ----------------

@hook start
on: game_start
do:
  queue intro_arrival now
  # Picked on the origin screen: the mirror only reflects it. Otherwise (tools, old callers) the mirror asks.
  if has(origin_noble) or has(origin_scholar) or has(origin_hedge) or has(origin_street) or has(origin_merchant):
    queue sorting_mirror now
  else:
    queue choose_origin now

@hook love_glow
on: month_start
label: Someone to come home to
when: bonds(partner) > 0
do:
  mood +4
  say: {~Someone saves you a seat, every time.|A note in your bag, in a hand you know. Just a heart.|You catch yourself smiling at nothing, again.}

@hook lonely
on: month_start
label: Loneliness
when: turn > 4 and bonds(friend) + bonds(close) + bonds(partner) == 0
do:
  mood -2
  say: {~You eat alone more often than you mean to.|The common room is loud, and none of it is for you.|You write a letter to nobody, and burn it.}
