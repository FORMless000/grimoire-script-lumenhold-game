{
  "name": "lumenhold-academy",
  "version": "0.3.235",
  "private": true,
  "license": "WTFPL",
  "description": "A swipe-card life simulation at a magical academy, with content in Grimoire Script (.grim).",
  "scripts": {
    "start": "sh tools/with-node24.sh node server/index.js",
    "build": "sh tools/with-node24.sh node tools/grim.js build",
    "check": "sh tools/with-node24.sh node tools/grim.js check",
    "e2e": "sh tools/with-node24.sh node tools/e2e.js",
    "test": "sh tools/with-node24.sh node --test test/*.test.js",
    "prepare": "node tools/version.js --install || true",
    "verify": "sh tools/with-node24.sh node tools/verify.js",
    "verify:full": "sh tools/with-node24.sh node tools/verify.js --full",
    "grim": "sh tools/with-node24.sh node tools/grim.js",
    "setup:authoring": "sh tools/with-node24.sh node rag/setup.js",
    "setup:python": "sh tools/with-node24.sh node rag/setup.js --python",
    "rag:smoke": "sh tools/with-node24.sh node rag/test/incremental-smoke.js",
    "rag:prepare": "sh tools/with-node24.sh node rag/prepare.js"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "playwright": "^1.64.0"
  }
}
