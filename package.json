{
  "name": "lumenhold-academy",
  "version": "0.2.0",
  "private": true,
  "description": "A swipe-card life simulation at a magical academy, with content in Grimoire Script (.grim).",
  "scripts": {
    "build": "node tools/grim.js build",
    "lint": "node tools/grim.js lint",
    "sim": "node tools/grim.js sim 300",
    "sim:social": "node tools/grim.js sim 300 --policy social",
    "stats": "node tools/grim.js stats",
    "check": "node tools/grim.js check",
    "sim:zh": "node tools/grim.js sim 300 --lang zh-CN",
    "i18n": "node tools/grim.js i18n",
    "i18n:zh": "node tools/grim.js i18n zh-CN",
    "e2e": "node tools/e2e.js"
  },
  "engines": {
    "node": ">=18"
  }
}
