#!/bin/sh
# Lumenhold auto-deploy (installed by deploy/setup.sh): each commit on main is pushed to the `live` remote
# in the background; the server's hook tests it and makes it live. Log: .git/deploy.log
# Off: git config lumenhold.autodeploy false
[ "$(git config --bool lumenhold.autodeploy)" = "true" ] || exit 0
[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || exit 0
git remote get-url live >/dev/null 2>&1 || exit 0
LOG="$(git rev-parse --git-common-dir)/deploy.log"
( { echo "== $(date '+%F %T') $(git rev-parse --short HEAD) $(git log -1 --format=%s)"; git push live main 2>&1; echo "exit $?"; } >> "$LOG" 2>&1 & )
exit 0
