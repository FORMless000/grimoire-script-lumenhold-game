# Lumenhold Academy — 简体中文 (zh-CN) translation of content/events/calendar.grim
# Maintained by `node tools/grim.js i18n zh-CN`. Translate the text after "="; keep {tokens}.
# "# en:" shows the English source. [hash] marks the English version a line was translated from;
# lines marked STALE need updating — after fixing the text, delete the [hash] and re-run the tool.


@event intro_arrival
# en: The Sky-Barge
title [59d00d] = 天空驳船
# en: The barge drops through the clouds and there it is: Lumenhold, seven towers stitched together with bridges of light. A first-year beside you is quietly being sick over the side. A prefect with a ledger counts heads and frowns at yours.
text [402ca7] = 驳船穿过云层下降，它就在那里：流明堡，七座高塔由光之桥缝合在一起。你身旁一个一年级新生正悄悄趴在船舷边呕吐。一位拿着名册的级长在清点人头，数到你时皱了皱眉。
# en: A wooden barge with patched sails drifting between clouds toward seven impossibly tall towers above a mirror-still lake.
scene [45ee12] = 一艘打着补丁的木帆驳船在云间漂浮，驶向矗立在镜面般湖泊之上、高得不可思议的七座塔楼。
# en: Step onto the landing
opt.ok.label [2c37cd] = 踏上码头
# en: Your boots touch stone that hums faintly underfoot. Three years. Thirty-six moons.
opt.ok.say.1 [90fc7f] = 你的靴子踩上了石板，脚下微微嗡鸣。三年。三十六轮月。

@event choose_origin
# en: Who Were You Before?
title [3aa3fb] = 来这里之前，你是谁？
# en: The Sorting Mirror in the entrance hall does not sort you into anything. It simply asks, in a voice like cold water, who you were before you came here. It waits.
text [408653] = 门厅里的“分院镜”并不会把你分到哪里去。它只是用冷水般的声音问你：来这里之前，你是谁？然后，它静静等待。
# en: A tall enchanted mirror in the entrance hall, showing a different version of the viewer in each pane.
scene [c49f90] = 门厅里一面高大的魔法镜，每一格镜面都映出观者不同的模样。
# en: The younger child of a minor noble house
opt.noble.label [53c694] = 小贵族家的小儿女
# en: Gold, charm and a name people recognise.
opt.noble.hint [61894b] = 金币、魅力，和一个人人认得的姓氏。
# en: The mirror shows you a crest you have tried to outgrow. It approves, faintly.
opt.noble.say.1 [5615e9] = 镜中出现一枚你一直想摆脱的家徽。它微微表示认可。
# en: A scholarship student from the provinces
opt.scholar.label [4afbdf] = 来自外省的奖学金学生
# en: Lore and Standing. The stipend depends on good marks.
opt.scholar.hint [b50045] = 学识与学业。津贴取决于成绩。
# en: The mirror shows you a candle burning very late in a very small room.
opt.scholar.say.1 [e182c1] = 镜中出现一间很小的屋子，一支蜡烛燃到很晚很晚。
# en: Raised by a hedge-witch in the marshes
opt.hedge.label [8a7115] = 由沼泽里的乡野女巫养大
# en: Alchemy, good spirits, an eye for herbs.
opt.hedge.hint [3c3a98] = 炼金、好心情，还有一双识草药的眼睛。
# en: The mirror smells, briefly, of wet moss and woodsmoke. You feel at home.
opt.hedge.say.1 [734ca9] = 镜子里一瞬间飘出湿苔藓和柴火烟的气味。你觉得像回到了家。
# en: Raised on the streets of Port Calder
opt.street.label [5f489c] = 在考尔德港的街头长大
# en: Guile and grit. Little gold.
opt.street.hint [fefffc] = 诡计与韧劲。金币很少。
# en: The mirror shows a pickpocket's quick hands. You check your pockets out of habit.
opt.street.say.1 [dd71c2] = 镜中出现一双扒手的快手。你习惯性地摸了摸口袋。
# en: The heir to a trading company
opt.merchant.label [2fc5e4] = 一家商行的继承人
# en: Plenty of gold, a nose for bargains.
opt.merchant.hint [026706] = 金币充裕，对买卖嗅觉灵敏。
# en: The mirror shows ledgers, ships and your mother's disappointed face. Still: gold.
opt.merchant.say.1 [604ea4] = 镜中出现账簿、货船，还有你母亲失望的脸。不过：钱是真的多。

@event choose_elective
# en: Choosing an Elective
title [03e0dd] = 选择选修课
# en: The registrar's noticeboard flaps with sign-up sheets for this term's electives. Core lectures are compulsory; your elective is yours to choose. The sheets jostle for your attention.
text [6ed4b3] = 教务处的告示板上，本学期选修课的报名表哗哗作响。核心课程是必修的；选修课由你自己挑。报名表们推推搡搡，争着吸引你的注意。
# en: A long noticeboard covered in fluttering enchanted parchment, each sheet trying to shoulder the others aside.
scene [803e43] = 一块长长的告示板，贴满了飘动的魔法羊皮纸，每一张都想用肩膀把别的挤开。
# en: Pyromancy
opt.pyro.label [22dcef] = 火焰术
# en: +Arcana each month, small burns. Taught by Professor Thorne.
opt.pyro.hint [cea401] = 每月 +奥术，偶有小烧伤。由索恩教授执教。
# en: Tidecalling
opt.tide.label [43908b] = 唤潮术
# en: +Arcana, +Vigor, lakeside calm.
opt.tide.hint [a0ea17] = +奥术，+体魄，湖畔的宁静。
# en: Illusion & Glamour
opt.illusion.label [5cdf61] = 幻术与魅影
# en: +Guile, +Charm.
opt.illusion.hint [21f570] = +诡计，+魅力。
# en: Practical Alchemy
opt.alchemy.label [990d4f] = 实用炼金
# en: +Alchemy.
opt.alchemy.hint [f7922d] = +炼金。
# en: Divination
opt.divination.label [61fc6c] = 占卜学
# en: +Lore, occasional gloomy omens.
opt.divination.hint [a946bb] = +学识，偶尔会有阴郁的预兆。
# en: Artifice
opt.artifice.label [de3328] = 奇械术
# en: +Alchemy, +Lore.
opt.artifice.hint [5dba10] = +炼金，+学识。
# en: Beastcraft
opt.beast.label [573a56] = 驭兽学
# en: +Vigor, +Mood. Smells of hay.
opt.beast.hint [2aa6d4] = +体魄，+心情。一股干草味。
# en: Astromancy
opt.astro.label [65a198] = 星象学
# en: +Lore, late nights.
opt.astro.hint [dc29a9] = +学识，经常熬夜。
# en: Healing Arts
opt.healing.label [e8c0bd] = 治愈术
# en: +Alchemy, +Lore, a little health.
opt.healing.hint [eab2fb] = +炼金，+学识，少量健康。
# en: Umbral Theory (restricted)
opt.umbral.label [430c05] = 暗影理论（受限）
# en: Requires Lore 20 or second year. +Arcana, dark moods.
opt.umbral.hint [6e81e4] = 需要学识 20 或二年级。+奥术，心情阴沉。

@event club_fair
# en: The Club Fair
title [ce4fee] = 社团招新会
# en: The courtyard is a riot of banners. Every club wants you, or at least your membership fee. A broom whizzes overhead trailing a SKYRACE TRYOUTS banner; somewhere a choir is harmonising with a cat.
text [2193b8] = 庭院里旗帜招展，热闹非凡。每个社团都想要你——至少想要你的会费。一把飞帚从头顶呼啸而过，拖着“天空竞速队招新”的横幅；不知哪里，一支合唱团正在和一只猫合唱。
# en: The great courtyard filled with banners and stalls: a duelist juggling sparks, a choir floating a foot off the ground, a girl handing out newspapers that shout headlines.
scene [60c086] = 宏伟的庭院里满是旗帜和摊位：一名决斗者在抛接火花，一支合唱团悬浮在离地一尺的空中，一个女孩在分发会喊出头条的报纸。
# en: Dueling Circle
opt.duel.label [db424f] = 决斗社
# en: +Vigor +Arcana, bruises. Home of the Spring Tournament.
opt.duel.hint [72c44c] = +体魄 +奥术，满身淤青。春季锦标赛的大本营。
# en: Choir of the Spheres
opt.choir.label [41a5f0] = 天球合唱团
# en: +Charm, +Mood.
opt.choir.hint [ffc919] = +魅力，+心情。
# en: Skyrace Squad
opt.sky.label [b4b285] = 天空竞速队
# en: +Vigor, crowd glory, crashes.
opt.sky.hint [c4c7f0] = +体魄，观众的欢呼，以及坠机。
# en: The Lumen Ledger
opt.ledger.label [2606ae] = 《流明纪事报》社
# en: +Guile +Charm. Nessa Quill's student paper.
opt.ledger.hint [d5542a] = +诡计 +魅力。内莎·奎尔的学生报。
# en: Verdant Circle
opt.garden.label [7ac3fd] = 青翠社
# en: +Alchemy +Mood. Greenhouses and gossip.
opt.garden.hint [8c86f5] = +炼金 +心情。温室与八卦。
# en: Stargazers
opt.stars.label [44dc13] = 观星社
# en: +Lore +Mood.
opt.stars.hint [60f956] = +学识 +心情。
# en: Keep your evenings free
opt.none.label [418ad6] = 晚上留给自己
# en: No club (leaves your current club, if any).
opt.none.hint [6ad50e] = 不参加社团（若已有社团则退出）。

@event job_board
# en: The Job Board
title [377c1b] = 招工告示板
# en: Rent is ten crowns a month and your purse is a fragile thing. The board outside the bursar's office offers honest work, and some that is merely work.
text [185fc4] = 房租每月十克朗，而你的钱袋是个脆弱的东西。财务处门外的告示板上，有正经的工作，也有仅仅算是工作的工作。
# en: A cork board outside the bursar's office, papered with notices; one is on fire, one is wriggling.
scene [bbe568] = 财务处门外的一块软木告示板，贴满了启事；其中一张着了火，另一张在扭动。
# en: Library Assistant — 10 gold/month
opt.library.label [dece88] = 图书馆助理——每月 10 金币
# en: +Lore, a little dull.
opt.library.hint [1434fc] = +学识，有点无聊。
# en: The Gilded Newt — 16 gold/month
opt.tavern.label [13979f] = 镀金蝾螈酒馆——每月 16 金币
# en: +Charm, tiring evenings in the village.
opt.tavern.hint [8090e3] = +魅力，镇上累人的夜班。
# en: Apothecary Clerk — 12 gold/month
opt.apothecary.label [f748e6] = 药铺店员——每月 12 金币
# en: Requires Alchemy 12. +Alchemy.
opt.apothecary.hint [0e1e4f] = 需要炼金 12。+炼金。
# en: Familiar Stables — 11 gold/month
opt.stables.label [8ccd8f] = 魔宠马厩——每月 11 金币
# en: +Vigor. Things bite.
opt.stables.hint [cf864a] = +体魄。会被咬。
# en: First-Year Tutor — 12 gold/month
opt.tutor.label [7403eb] = 一年级辅导员——每月 12 金币
# en: Requires Lore 18. +Standing.
opt.tutor.hint [9594b7] = 需要学识 18。+学业。
# en: Broom Courier — 18 gold/month
opt.courier.label [142261] = 飞帚信使——每月 18 金币
# en: Requires Vigor 14. Dangerous.
opt.courier.hint [981b47] = 需要体魄 14。很危险。
# en: No job (quit any current one)
opt.none.label [7a08f4] = 不打工（辞去现有工作）

@event lantern_night
# en: Lantern Night
title [0b1f19] = 灯笼夜
# en: On Lantern Night every student writes a wish on a paper lantern and lets it go over the lake. Rumour says the lanterns that sink were wishes the lake wanted for itself.
text [608e29] = 灯笼夜里，每个学生都会在纸灯笼上写下一个愿望，让它飘过湖面。传说那些沉下去的灯笼，是湖想要据为己有的愿望。
# en: Hundreds of paper lanterns rising off the lake at dusk, each with a wish written on it in glowing ink.
scene [3a7795] = 黄昏时分，数百只纸灯笼从湖面升起，每一只上都用发光的墨水写着一个愿望。
# en: Wish for something selfish
opt.left.label [7e0393] = 许一个自私的愿望
# en: Your lantern rises high. The next morning you find coins in your shoe. The lake is generous, and a little creepy.
opt.left.say.1 [2f05e5] = 你的灯笼升得很高。第二天早上，你在鞋子里发现了硬币。湖很大方，也有点吓人。
# en: Your lantern sinks with a hiss. Something under the water now knows what you want.
opt.left.say.2 [f9d757] = 你的灯笼嘶的一声沉了下去。水下有什么东西，现在知道你想要什么了。
# en: Wish for someone else
opt.right.label [bc6686] = 为别人许愿
# en: Your lantern rises and catches the wind. Across the shore, someone you have never met laughs out loud for no reason.
opt.right.say.1 [002a2f] = 你的灯笼升起来，乘上了风。湖岸对面，一个你从未见过的人无缘无故地放声大笑。

@event kael_arrives
# en: The Boy From the North
title [c3bb2e] = 来自北方的少年
# en: Mid-term, the dining hall doors open and frost crawls across the floor. A boy in a fur coat walks in, takes the empty seat beside you, and says nothing at all. The headmistress introduces him as Kael Dumont, a transfer. She does not say from where.
text [fde128] = 学期过半，餐厅的大门打开，寒霜爬过地板。一个穿毛皮大衣的少年走进来，坐在你身旁的空位上，一言不发。院长介绍说他叫凯尔·杜蒙，是转学生。她没说他从哪里来。
# en: A pale young man in a fur-lined coat standing at the door of the dining hall, frost spreading from his boots across the floor.
scene [f60e23] = 一个面色苍白的年轻人身穿毛皮衬里的大衣站在餐厅门口，霜花从他的靴底向地板蔓延。
# en: Leave him be
opt.left.label [ce4663] = 别打扰他
# en: You eat in silence. When you leave, your cup of tea has frozen solid.
opt.left.say.1 [930b83] = 你们沉默地吃完了饭。你离开时，你那杯茶已经冻成了冰坨。
# en: Offer him the bread
opt.right.label [494eb6] = 把面包递给他
# en: He looks at the bread as if no one has offered him anything in a long time. "...Thank you." His voice sounds like wind over snow.
opt.right.say.1 [6aa70f] = 他看着面包，仿佛很久没人给过他任何东西。“……谢谢。”他的声音像掠过雪原的风。

@event winter_trials
# en: The Winter Trials
title [01bc52] = 冬季考核
# en: The Winter Trials. A hundred desks, a hundred floating quills, one very old proctor who may be asleep. The first question asks you to explain the Third Law of Correspondence. The second asks you to demonstrate it.
text [f596dd] = 冬季考核。一百张课桌，一百支悬浮的羽毛笔，一位很老很老、可能已经睡着的监考官。第一题要你解释“第三对应定律”。第二题要你当场演示。
# en: A vast examination hall where floating quills hover over a hundred desks and the windows are thick with frost.
scene [f46856] = 宽阔的考场里，悬浮的羽毛笔停在一百张课桌上方，窗户上结着厚厚的霜。
# en: Lean on theory (Lore)
opt.left.label [41ae72] = 靠理论取胜（学识）
# en: Your answer is so thorough the quill gets a cramp. Top marks.
opt.left.say.1 [eb0c7e] = 你的答案详尽到羽毛笔都抽筋了。满分。
# en: You write three pages and realise halfway that you have been answering a different question.
opt.left.say.2 [6df893] = 你写了三页，写到一半才发现自己答的是另一道题。
# en: Lean on practice (Arcana)
opt.right.label [d691ec] = 靠实践取胜（奥术）
# en: Your demonstration is clean and bright. The proctor wakes up and applauds.
opt.right.say.1 [5963aa] = 你的演示干净利落、光彩夺目。监考官醒过来，鼓起了掌。
# en: The demonstration backfires. Politely, but with smoke.
opt.right.say.2 [5c503b] = 演示失败了。很有礼貌地失败了，但冒了烟。

@event midwinter_ball
# en: The Midwinter Ball
title [81d1d0] = 仲冬舞会
# en: The great hall has been turned to ice and starlight for the Midwinter Ball. Couples float above the floor. Who will you go with?
text [84852a] = 为了仲冬舞会，大礼堂化作了冰雪与星光的世界。一对对舞伴悬浮在地板上方起舞。你要和谁一起去？
# en: The great hall transformed: an ice-crystal chandelier, couples waltzing a foot above the floor, snow falling indoors without ever landing.
scene [84cb48] = 焕然一新的大礼堂：冰晶吊灯，离地一尺旋转华尔兹的舞伴，室内飘着永不落地的雪。
# en: Ask Lyra
opt.lyra.label [b5812c] = 邀请莱拉
# en: She has had six invitations. She hasn't said yes to any.
opt.lyra.hint [5d0f3a] = 她收到了六份邀请，一份也没答应。
# en: "Finally, someone who doesn't stammer." She dances like a duel — and wins.
opt.lyra.say.1 [c2dd15] = “总算来了个不结巴的。”她跳舞像决斗一样——而且赢了。
# en: "I'm going alone. It's more efficient." You watch her dance alone all night, perfectly.
opt.lyra.say.2 [ba4ab4] = “我一个人去。效率更高。”你看着她独自跳了一整晚，完美无缺。
# en: Ask Tobias
opt.tobias.label [81d042] = 邀请托比亚斯
# en: He has been practising with a broom.
opt.tobias.hint [b74d36] = 他一直在拿扫帚当舞伴练习。
# en: He steps on your feet nine times and apologises ten. It's the best night of the term.
opt.tobias.say.1 [a497bd] = 他踩了你的脚九次，道歉了十次。这是本学期最美好的一晚。
# en: Ask Seraphine
opt.seraphine.label [4c88b3] = 邀请瑟拉芬
# en: She may already know you'll ask.
opt.seraphine.hint [da4e86] = 她可能早就知道你会邀请她。
# en: "I said yes three weeks ago," she says, "you just hadn't asked yet." She dances a beat ahead of the music.
opt.seraphine.say.1 [fd7d7e] = “我三周前就答应了，”她说，“只是你那时还没开口。”她的舞步总比音乐快半拍。
# en: Ask Corvin
opt.corvin.label [cbffdf] = 邀请科尔文
# en: Odds he shows up: unclear.
opt.corvin.hint [bd223d] = 他会不会出现：不好说。
# en: He arrives late, in a stolen jacket, and is the best dancer in the room.
opt.corvin.say.1 [0ec70b] = 他迟到了，穿着一件偷来的外套，却是全场跳得最好的人。
# en: He never shows. A note arrives at midnight: "Got arrested. Long story. Save me a dance next year."
opt.corvin.say.2 [877a8a] = 他始终没来。午夜时分送来一张字条：“被捕了。说来话长。明年给我留支舞。”
# en: Ask Mira
opt.mira.label [1a704d] = 邀请米拉
# en: They're bringing a self-playing violin.
opt.mira.hint [4d4230] = TA 要带一把会自己演奏的小提琴。
# en: Mira's violin plays itself, then plays the chandelier, then plays the windows. You are asked to leave early. Worth it.
opt.mira.say.1 [88a0f6] = 米拉的小提琴自己拉了起来，然后拉起了吊灯，然后拉起了窗户。你们被请提前离场。值了。
# en: Ask Kael
opt.kael.label [bf9bdb] = 邀请凯尔
# en: He doesn't seem to feel the cold.
opt.kael.hint [3c4856] = 他似乎感觉不到寒冷。
# en: He holds your hand like it is something fragile. Where your fingers touch, frost-ferns bloom on the glass.
opt.kael.say.1 [b06391] = 他握着你的手，像握着什么易碎的东西。你们指尖相触之处，玻璃上绽开了霜蕨。
# en: Ask Nessa
opt.nessa.label [6cfd84] = 邀请内莎
# en: She'll be working. She's always working.
opt.nessa.hint [698b3a] = 她会边跳边工作。她永远在工作。
# en: She takes notes between dances. "For the society column." Then she stops taking notes.
opt.nessa.say.1 [ff1845] = 她在舞曲间隙做笔记。“写社交专栏用的。”后来，她不再做笔记了。
# en: Go with friends
opt.friends.label [596790] = 和朋友们一起去
# en: You go as a pack and dance badly together and it is perfect.
opt.friends.say.1 [4cb3f9] = 你们成群结队地去，一起跳得乱七八糟，完美极了。
# en: Stay in and study
opt.skip.label [6d8b57] = 留在宿舍学习
# en: The music drifts up through the floor while you read. Somewhere, people are happy. You are productive.
opt.skip.say.1 [c55696] = 你看书时，音乐透过地板飘上来。某个地方，人们很快乐。而你，很高效。

@event spring_tournament
# en: The Spring Tournament
title [e40010] = 春季锦标赛
# en: The Spring Tournament: dueling on the great lawn, the whole academy watching. Entry is open to anyone foolish enough. Members of the Dueling Circle are expected to enter.
text [3e3333] = 春季锦标赛：在大草坪上决斗，全院围观。任何够傻的人都可以报名。决斗社的成员按惯例必须参赛。
# en: A ring of white stone on the lawn, crowds in the stands, two duelists bowing as their wands spark.
scene [903c03] = 草坪上一圈白石决斗场，看台上挤满人群，两名决斗者行礼致意，魔杖迸出火花。
# en: Watch from the stands
opt.left.label [8d4dec] = 在看台上观战
# en: The Circle captain notes your absence with a very sharp quill.
opt.left.say.1 [aa4407] = 社长用一支非常锋利的羽毛笔记下了你的缺席。
# en: You eat candied chestnuts and scream for strangers.
opt.left.say.2 [8ad597] = 你吃着糖炒栗子，为陌生人声嘶力竭地呐喊。
# en: Enter the tournament
opt.right.label [dd70a1] = 报名参赛
# en: First round: you win, barely, and the crowd learns your name.
opt.right.say.1 [5dba97] = 第一轮：你赢了，险胜，观众记住了你的名字。
# en: First round: you are knocked out of the ring in eleven seconds. A record, apparently.
opt.right.say.2 [39b48e] = 第一轮：你在十一秒内被打出场外。据说是新纪录。

@event tournament_semifinal
# en: Semifinal
title [4ddbc9] = 半决赛
# en: The semifinal. Your opponent is a fourth-year who has never lost. The crowd is louder now; you can hear your own name in it.
text [69650a] = 半决赛。你的对手是一位从未输过的四年级生。人群更吵了；你能在喧闹中听见自己的名字。
# en: The same ring at sunset, scorch marks on the stone. Your opponent is grinning.
scene [54c532] = 夕阳下的同一座决斗场，石面上满是焦痕。你的对手咧嘴笑着。
# en: Fight clean (Arcana)
opt.left.label [4b1c59] = 堂堂正正地战斗（奥术）
# en: You trade spells like questions and answers — and get the last word.
opt.left.say.1 [a411dd] = 你们你来我往地交换咒语，像一问一答——最后一句是你说的。
# en: A good fight. Not good enough. The crowd applauds you off the lawn.
opt.left.say.2 [2ec6f6] = 打得很好。但还不够好。人群鼓掌送你离开草坪。
# en: Fight dirty (Guile)
opt.right.label [bb2a82] = 耍点小手段（诡计）
# en: A feint, a trip, a jinx to the shoelaces. Legal. Mostly.
opt.right.say.1 [28eb74] = 一个虚招，一个绊子，一个冲着鞋带的小咒。合规。大体上。
# en: The referee sees the trick. Disqualified, and booed.
opt.right.say.2 [06fbf6] = 裁判看穿了把戏。你被取消资格，还挨了嘘声。

@event tournament_final
# en: The Final
title [5a826c] = 决赛
# en: The final. Across the ring stands {lyra}, wand raised, eyes blazing. "I was hoping it would be you," she says, and she is not being friendly.
text [9091dd] = 决赛。决斗场对面站着{lyra}，魔杖高举，双眼燃着火光。“我就希望是你，”她说，语气可一点也不友好。
# en: The dueling ring under floating lanterns, a silver cup on a plinth, and across from you, a familiar face.
scene [2b21ea] = 悬浮灯笼下的决斗场，底座上放着一只银杯，对面是一张熟悉的面孔。
# en: Give everything you have
opt.left.label [eef34c] = 拼尽全力
# en: Your final spell lands like a bell. Silence — then the lawn erupts. Lyra stares at you as if seeing you for the first time.
opt.left.say.1 [3285dd] = 你最后一道咒语像钟声一样落下。一片寂静——随后草坪沸腾了。莱拉看着你，好像第一次真正看见你。
# en: She wins, but only just. Afterwards, she offers her hand. "Next year," she says. It is a promise and a threat.
opt.left.say.2 [6d4f46] = 她赢了，但只是险胜。赛后，她向你伸出手。“明年。”她说。这既是承诺，也是威胁。
# en: Yield with a bow
opt.right.label [7ad851] = 鞠躬认输
# en: The crowd boos. Lyra does not cheer her victory. Later she finds you: "Why?" You don't have a good answer, and she seems to like that.
opt.right.say.1 [957fd4] = 人群发出嘘声。莱拉没有为自己的胜利欢呼。后来她找到你：“为什么？”你答不上来，而她似乎正喜欢这一点。

@event grand_exams
# en: Grand Examinations
title [9cf559] = 年度大考
# en: Year-end examinations. Three days, five examiners and a practical in front of a panel that includes the headmistress. Your standing for the year rides on this.
text [148501] = 学年末考试。三天，五位考官，还要在包括院长在内的评审团面前完成一项实践考核。你这一年的学业，全押在这上面了。
# en: A circular examination chamber with a domed ceiling of moving constellations; examiners in grey robes sit behind a long table.
scene [a8e8ed] = 一间圆形考场，穹顶上的星座缓缓移动；身着灰袍的考官们坐在长桌后。
# en: Prepare a dazzling practical
opt.left.label [6b5ebd] = 准备一场惊艳的实践考核
# en: You finish your practical and the examiners actually lean forward. Distinction.
opt.left.say.1 [1ca3b3] = 你完成实践考核时，考官们居然真的向前倾了倾身子。优秀。
# en: The practical sputters. An examiner writes something very short.
opt.left.say.2 [1a07cb] = 实践考核噼啪作响地熄火了。一位考官写下了很短的一句话。
# en: Write a meticulous thesis
opt.right.label [018303] = 写一篇严谨的论文
# en: Your thesis is cited by one examiner in an argument with another. Distinction.
opt.right.say.1 [dbc14d] = 一位考官在和另一位争论时引用了你的论文。优秀。
# en: Your thesis is described, aloud, as "ambitious". It is not a compliment.
opt.right.say.2 [067468] = 你的论文被当众评价为“很有野心”。这可不是夸奖。

@event summer_plans
# en: Summer Recess
title [84178b] = 暑假
# en: The towers empty for the summer. Two months of freedom. How will you spend them?
text [28317e] = 塔楼在夏天空了下来。两个月的自由。你打算怎么过？
# en: The academy gates thrown open to green hills; students with trunks waving from departing sky-barges.
scene [35fcaa] = 学院大门向青翠的山丘敞开；拖着行李箱的学生们在离港的天空驳船上挥手。
# en: Go home
opt.home.label [c93952] = 回家
# en: Rest and recover. No rent while away.
opt.home.hint [735a7b] = 休息与恢复。离校期间不交房租。
# en: Your family hosts three dinners in your honour and asks about your marriage prospects at all of them.
opt.home.say.1 [47c092] = 家里为你办了三场晚宴，每一场都有人问起你的婚事。
# en: The old crowd in Port Calder treats you like a returning hero, and steals your trunk only once.
opt.home.say.2 [c552ac] = 考尔德港的老伙计们把你当成荣归故里的英雄，只偷了你的行李箱一次。
# en: Home is smaller than you remember, and warmer. Someone made your favourite pie.
opt.home.say.3 [c3fe6f] = 家比你记忆中小，也更温暖。有人做了你最爱吃的馅饼。
# en: Take summer work in the village
opt.work.label [3f8e3c] = 在镇上打暑期工
# en: About 50 gold over the summer. Tiring.
opt.work.hint [6173e0] = 整个夏天约 50 金币。很累。
# en: You haul crates, serve tables and polish brass until your hands know the shape of every coin.
opt.work.say.1 [55acbe] = 你搬箱子、端盘子、擦铜器，直到双手熟悉每一枚硬币的形状。
# en: Stay and study in the empty library
opt.study.label [968f6e] = 留在空荡的图书馆学习
# en: +Lore, +Arcana, +Standing. Lonely.
opt.study.hint [8c75a3] = +学识，+奥术，+学业。很孤单。
# en: Just you, the books and the dust motes. You learn things the term never had time for.
opt.study.say.1 [fe7d5b] = 只有你、书本和浮尘。你学到了学期里永远没时间学的东西。
# en: Travel to the coast
opt.travel.label [78a0b3] = 去海边旅行
# en: Costs 40 gold. Great for mood.
opt.travel.hint [b46376] = 花费 40 金币。心情大好。
# en: Salt air, shell markets, a sea serpent at sunset. You come back tanned and ten years younger.
opt.travel.say.1 [1db6b9] = 咸咸的海风，贝壳集市，夕阳下的海蛇。你回来时晒黑了，年轻了十岁。
# en: Join Old Maud's herb expedition
opt.expedition.label [49633f] = 参加老莫德的采药远征
# en: Requires knowing Maud. Adventure.
opt.expedition.hint [362c6b] = 需要认识老莫德。冒险。
# en: Two months in the Whisperwood with Maud and her goat. You learn which mushrooms sing and which ones lie.
opt.expedition.say.1 [929c02] = 和莫德还有她的山羊在低语森林里待了两个月。你学会了分辨哪些蘑菇会唱歌，哪些会撒谎。

@event summer_letter
# en: A Letter From Home
title [418673] = 一封家书
# en: A letter arrives in the last month of summer, the handwriting so familiar it hurts. They want to know how you are doing. Really doing.
text [67658a] = 夏天的最后一个月，一封信寄到了，字迹熟悉得让人心疼。他们想知道你过得怎么样。真正过得怎么样。
# en: A letter sealed with candle wax lying on a sunlit windowsill.
scene [ac2d7b] = 一封用烛蜡封口的信，躺在洒满阳光的窗台上。
# en: Write back honestly
opt.left.label [24b451] = 如实回信
# en: You tell them about your standing. Their reply is kind, which is worse.
opt.left.say.1 [c36670] = 你告诉了他们你的学业情况。他们的回信很温柔，这反而更难受。
# en: You write six pages. It feels like setting down a heavy bag.
opt.left.say.2 [f6372c] = 你写了六页。感觉像放下了一个沉重的包袱。
# en: Write back that everything is perfect
opt.right.label [979dc2] = 回信说一切都很完美
# en: Proud of you, they write, and enclose a little money you suspect they couldn't spare.
opt.right.say.1 [8deb66] = 他们回信说为你骄傲，还附上了一点钱——你猜他们其实拿不出来。
# en: They reply with exclamation marks. The lie sits in your stomach all week.
opt.right.say.2 [75bc50] = 他们的回信满是感叹号。这个谎言在你胃里堵了一整个星期。

@event starfall
# en: Starfall
title [ab87b4] = 星坠节
# en: The last night of the academic year. Everyone climbs onto the observatory roof to watch the stars fall. They say if you catch one in a jar, you get a year of luck.
text [6b880d] = 学年的最后一夜。大家都爬上天文台屋顶看星星坠落。据说，如果你能用罐子接住一颗，就能交一整年的好运。
# en: Students lying on the observatory roof under a sky streaked with falling stars.
scene [7b9deb] = 学生们躺在天文台屋顶上，头顶的夜空划满了流星。
# en: Lie back and just watch
opt.left.label [df7032] = 躺下来，只是看着
# en: You count forty falling stars and then stop counting. It's enough.
opt.left.say.1 [d2a569] = 你数了四十颗流星，然后不再数了。这就够了。
# en: Try to catch a star
opt.right.label [734781] = 试着接住一颗星
# en: It lands in your jar with a hiss and glows for weeks. Students come to see it.
opt.right.say.1 [f06369] = 它嘶的一声落进你的罐子，发光发了好几个星期。同学们都跑来看。
# en: You lunge, miss, and nearly roll off the roof. A prefect catches you by the collar.
opt.right.say.2 [dd228d] = 你扑了过去，没接到，差点滚下屋顶。一位级长揪住了你的衣领。

@event year_two
# en: Second Year
title [c51ea2] = 第二学年
# en: The barge brings new first-years, and you watch them gawp at the towers. Was that really you a year ago? You know which staircases move now, and which professors you can charm.
text [9706f9] = 驳船载来了新一届的一年级生，你看着他们目瞪口呆地仰望高塔。一年前，那真的是你吗？如今你知道哪些楼梯会动，哪些教授可以哄一哄。
# en: The seven towers in autumn colours, the first-year barge arriving below, tiny and nervous.
scene [aa7c3d] = 秋色中的七座高塔，下方新生的驳船正在靠岸，渺小而紧张。
# en: Begin the second year
opt.ok.label [338fd8] = 开始第二学年

@event year_three
# en: Final Year
title [ed5f4c] = 最后一年
# en: "Third years," the headmistress says, "this is your last year in these halls. What you become here, you will be for a long time." She looks, for a moment, directly at you.
text [89b6e8] = “三年级的同学们，”院长说，“这是你们在这些厅堂里的最后一年。你们在这里成为什么样的人，就会长久地是那样的人。”有那么一刻，她直直地看着你。
# en: The headmistress addressing a hall of third-years, every candle in the room leaning toward her.
scene [3c61bc] = 院长向满堂的三年级生讲话，屋里的每一支蜡烛都向她倾斜。
# en: Begin the final year
opt.ok.label [a50a76] = 开始最后一年

@event graduation_eve
# en: The Eve of Graduation
title [16a29d] = 毕业前夜
# en: Tomorrow you graduate. Your robes are laid out on the bed, slightly too long. Outside, the towers are lit gold. Three years have gone like a single held breath.
text [aa0aaa] = 明天你就要毕业了。学士袍摊在床上，稍微长了一点。窗外，高塔被点亮成金色。三年时光，像屏住的一口气，倏忽而过。
# en: Graduation robes laid out on a dormitory bed, a single candle burning, the towers lit gold outside the window.
scene [47f9c3] = 宿舍床上摊着毕业袍，一支蜡烛独自燃烧，窗外的塔楼灯火金黄。
# en: Spend the night with friends
opt.left.label [476937] = 和朋友们共度今夜
# en: Laughter until dawn. Promises to write. Some of them, you'll keep.
opt.left.say.1 [82accb] = 笑到天亮。约好要写信。其中一些约定，你会遵守。
# en: Walk the halls alone one last time
opt.right.label [9cc549] = 最后一次独自走遍厅廊
# en: Every corridor holds a memory. At the end of the last one, the castle sighs, as if saying goodbye.
opt.right.say.1 [fce683] = 每一条走廊都藏着回忆。走到最后一条的尽头时，城堡轻轻叹了口气，像是在道别。
