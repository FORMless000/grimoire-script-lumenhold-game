# Lumenhold Academy — 简体中文 (zh-CN) translation of content/events/alignment.grim
# Maintained by `node tools/grim.js i18n zh-CN`. Translate the text after "="; keep {tokens}.
# "# en:" shows the English source. [hash] marks the English version a line was translated from;
# lines marked STALE need updating — after fixing the text, delete the [hash] and re-run the tool.


@event align_cold_candles
# en: The Candles Lean Away
title [1845e0] = 烛火避让
# en: {You notice it on the east stair. As you pass, the candle flames bend away from you, all of them, like grass from a wind. A first-year on the landing notices too.|The candles lean away again. You have started to time it. It is getting faster.}
text [8f1ab2] = {你是在东楼梯上注意到的。你经过时，烛焰全都朝远离你的方向弯去，像风吹过草地。楼梯平台上的一个一年级生也看见了。|烛火又避开了。你开始给它计时。它越来越快了。}
# en: A long stone corridor at dusk, every candle flame bending away from one student walking down the middle of it.
scene [48ce03] = 黄昏时分一条长长的石廊，每一簇烛焰都朝远离走在中间那名学生的方向弯去。
# en: Let them lean
opt.left.label [131e40] = 由它们去吧
# en: You walk on without looking. Behind you the first-year says nothing at all, which is its own kind of saying.
opt.left.say.1 [93806d] = 你目不斜视地走过去。身后那个一年级生一句话也没说——这本身就是一种表态。
# en: Stop and relight one by hand
opt.right.label [87e0d1] = 停下，亲手点亮一盏
# en: You cup a flame back to life with your palm. It flickers, considers you, and stays. It takes longer than it should.
opt.right.say.1 [4fde72] = 你用掌心护着一簇火苗让它重新燃起。它摇曳着，打量着你，然后留了下来。这比本该花的时间要久。

@event align_whispered_answer
# en: A Voice Over Your Shoulder
title [be6019] = 肩后的声音
# en: Revising late, you get stuck on the same question for the third time. Then the answer is simply there, in a voice that is almost yours, from just behind your left ear. The inkwell has frosted over.
text [b8b636] = 深夜复习时，你第三次卡在同一道题上。然后答案就那样出现了——一个几乎是你自己的声音，从你左耳后方传来。墨水瓶上结了一层霜。
# en: A student bent over a desk by candlelight, revision notes everywhere, and a cold patch of frost forming on the inkwell.
scene [6d785b] = 烛光下伏案的学生，复习笔记摊得到处都是，墨水瓶上正凝出一片冰霜。
# en: Write it down
opt.left.label [f20ae7] = 把它写下来
# en: It is right. Of course it is right. You write until dawn and never once get stuck, and in the morning you cannot remember learning any of it.
opt.left.say.1 [d6cb97] = 它是对的。当然是对的。你一直写到天亮，一次也没卡住；可到了早上，你完全不记得自己学过这些。
# en: Close the book
opt.right.label [7a6dbd] = 合上书
# en: You close the book and sit with your hands flat on the cover until the frost on the inkwell melts. The question stays unanswered. It's yours, at least.
opt.right.say.1 [88c4b2] = 你合上书，双手平放在封面上，一直坐到墨水瓶上的霜化掉。那道题仍然没有答案。但至少它是你自己的。

@event align_maud_way_back
# en: Weeding, Dearie
title [b9db32] = 来拔草吧，孩子
# en: Old Maud looks at you for a long moment over her spectacles, the way she looks at a plant that's been kept in the wrong window. "You've a cold look about you, dearie," she says, and holds out a trowel. "Weeds don't pull themselves. Neither does the rest."
text [602ce6] = 老莫德从眼镜上方久久地看着你，就像在看一株被放错了窗台的植物。“你身上有股冷气，孩子，”她说着，递过来一把小铲子，“杂草不会自己拔掉。别的事也一样。”
# en: An old woman in a straw hat kneeling in a vegetable bed, handing a trowel up to a student who hasn't asked for one.
scene [557087] = 一位戴草帽的老妇人跪在菜畦里，把小铲子递给一个并没有开口要的学生。
# en: Kneel and start pulling
opt.left.label [2be082] = 跪下来开始拔
# en: You weed until your knees ache and your hands smell of earth instead of frost. Maud hums the whole time. Nothing's fixed. Something has started.
opt.left.say.1 [8ff3f1] = 你拔草拔到膝盖发酸，双手闻起来是泥土味而不是霜味。莫德一直在哼歌。什么都还没好起来。但有些事已经开始了。
# en: "I'm fine."
opt.right.label [bdda04] = “我没事。”
# en: "Course you are," Maud says, and goes back to her beans. The trowel stays in the soil beside her, handle towards you, all afternoon.
opt.right.say.1 [6bc997] = “当然没事，”莫德说着，回头去照料她的豆子。那把小铲子整个下午都插在她身边的土里，把手朝着你。

@event align_reproach
# en: "I Don't Know You Lately"
title [5baaf9] = “我最近不认识你了”
# en: {friend} finds you in the cloister and sits without saying hello. "People talk," {they} say{s} at last. "I keep telling them they're wrong about you. I'd like to keep being right."
text [8427e0] = {friend}在回廊里找到你，连招呼都没打就坐下了。“大家在议论，”{they}终于开口，“我一直告诉他们，他们看错你了。我希望我能一直是对的。”
# en: Two friends on a cold bench in the cloister, one looking straight ahead, the other looking at the first.
scene [1d2371] = 回廊里一张冰冷的长凳上坐着两个朋友，一个直视前方，另一个看着前者。
# en: "You are. I'll do better."
opt.left.label [c698dd] = “你是对的。我会改。”
# en: {friend} nods, slowly, and bumps {their} shoulder against yours. It is an apology and a warning at once.
opt.left.say.1 [0320a5] = {friend}慢慢点了点头，用肩膀撞了撞你的肩。这既是和好，也是警告。
# en: "Mind your own business."
opt.right.label [53fb82] = “少管闲事。”
# en: {friend} gets up and goes. {They} don't look back. That's what stays with you: {they} always used to look back.
opt.right.say.1 [d0c677] = {friend}起身走了，没有回头。让你一直记着的正是这一点：{they}以前总会回头的。

@event align_ruthless_nod
# en: Finally, Someone Who Gets It
title [b51f5a] = 总算有人懂了
# en: {rel(other) < 10: {other} has always looked straight through you. Today {they} nod{s} as you pass|{other} catches your eye in the corridor and nod{s} again}, slow and approving, the way people nod at someone who has finally learned the rules of a game.
text [6a6df3] = {rel(other) < 10: {other}向来对你视而不见。今天你经过时，{they}却朝你点了点头|{other}在走廊里和你对上目光，又一次朝你点了点头}——缓慢而赞许，就像人们朝一个终于学会游戏规则的人点头那样。
# en: A hard-faced student leaning on a pillar, giving another a slow, approving nod across a busy corridor.
scene [8d42a3] = 一个神情冷硬的学生倚着柱子，隔着熙攘的走廊朝另一人缓缓点头示意。
# en: Nod back
opt.left.label [ae3c6d] = 点头回应
# en: The nod comes back to you. It feels like being let into a room. You can't tell whether the room is warm.
opt.left.say.1 [375363] = 点头被回敬了过来。那感觉像是被请进了一间屋子。你说不清那屋子是否温暖。
# en: Keep walking
opt.right.label [6ca967] = 继续往前走
# en: You keep walking. {other} snorts, as if you'd failed a test you didn't know you were sitting.
opt.right.say.1 [1c408e] = 你继续往前走。{other}嗤了一声，好像你没通过一场你都不知道自己在考的考试。

@event align_northern_parcel
# en: A Parcel for the North
title [917cb6] = 寄往北境的包裹
# en: {A hooded courier stops you behind the bakery.|The hooded courier is waiting again, same alley, same black oilcloth.} "For the boathouse, after dark," {they say, and hold out the parcel and a purse.|they say. "The families remember who is reliable."} The oilcloth is cold enough to ache.
text [e57cd7] = {一个戴兜帽的信使在面包房后面拦住了你。|那个戴兜帽的信使又在等你了，同一条小巷，同一块黑油布。}“天黑后送到船屋，”{对方说着，递来包裹和一只钱袋。|对方说，“世家记得谁靠得住。”}那块油布冷得发疼。
# en: A hooded courier in a rain-dark alley behind the village, holding out a small parcel wrapped in black oilcloth and a purse.
scene [ab51fb] = 村子后面一条被雨淋暗的小巷里，一个戴兜帽的信使递出一个裹着黑油布的小包裹和一只钱袋。
# en: Carry it
opt.left.label [f4d75d] = 替他们送去
# en: You leave it on the boathouse step at midnight and don't look back. In the morning there's frost on the step in the shape of a hand, and the purse is heavier than it looked.
opt.left.say.1 [f86ac1] = 你在午夜把它放在船屋的台阶上，没有回头。早上，台阶上结着一只手形的霜，而那只钱袋比看上去要沉。
# en: Walk away
opt.right.label [96da1a] = 转身离开
# en: You leave the courier holding it. "Pity," they say, without any pity at all, and the alley is empty when you look back.
opt.right.say.1 [371c1f] = 你让信使自己拿着它。“可惜，”对方说，语气里没有半点可惜。你回头时，小巷已经空了。

@event align_cruel_advantage
# en: Something You Could Use
title [e223de] = 可以利用的东西
# en: {mark} has dropped a letter in the library: something private, something {they} would hate the corridor to hear. You could hand it back. You could also keep it, and {they} would owe you, quietly, for a long time.
text [306670] = {mark}在图书馆掉了一封信：私密的事，{they}最不愿意让整条走廊听到的事。你可以把它还回去。你也可以留着它——那样{they}就会悄悄地欠你很久。
# en: A crumpled letter on a library floor, a student's name on the envelope, another student bending to pick it up.
scene [8a21c3] = 图书馆地板上一封揉皱的信，信封上写着一个学生的名字，另一个学生正弯腰去捡。
# en: Keep it
opt.left.label [87c2f5] = 留着它
# en: You fold it into your book. When you mention it, very lightly, {mark} goes pale and agrees to everything. It works. It keeps working.
opt.left.say.1 [18005f] = 你把它夹进书里。当你轻描淡写地提起它时，{mark}脸色发白，什么都答应了。这招管用，而且一直管用。
# en: Hand it back
opt.right.label [cb62a0] = 还给对方
# en: You hand it back unread. {mark} stares at you, then at the letter, then says "thank you" as if it costs something. It does, for both of you.
opt.right.say.1 [414642] = 你没拆开就把信还了回去。{mark}盯着你，又盯着那封信，然后说了声“谢谢”，好像这要付出什么代价。确实要——对你们俩都是。

@event align_frost_in_the_spell
# en: The Cold That Helps
title [7dac5f] = 有用的寒意
# en: Practising alone, you notice that your spells come easier when you let the cold in, the cold that has been following you lately. It climbs your sleeve like ivy. The candle beside you leans away.
text [a3ee9f] = 独自练习时，你发现只要放那股寒意进来——最近一直跟着你的那股寒意——咒语就来得更容易。它像常春藤一样爬上你的袖子。身旁的蜡烛避开了你。
# en: A student in an empty practice room, a spell flaring unnaturally bright in one hand, frost creeping up the sleeve to the elbow.
scene [2b39b1] = 空荡荡的练习室里，一名学生手中的咒语亮得反常，冰霜正沿着袖子爬到手肘。
# en: Let the cold in
opt.left.label [13fba8] = 放寒意进来
# en: The spell flares bright and clean, brighter than anything you've managed in daylight. It takes an hour for the feeling to come back into your fingers. You don't mind as much as you should.
opt.left.say.1 [ddd5a7] = 咒语亮得干净利落，比你在白天施展过的任何一次都亮。手指过了一个小时才恢复知觉。你没有本该有的那么在意。
# en: Practise the slow way
opt.right.label [210853] = 用笨办法练
# en: You shake the cold out of your hands and do it the slow way, badly, again and again. It is your own bad spell, at least.
opt.right.say.1 [21c347] = 你甩掉手上的寒意，用笨办法练，练得很差，一遍又一遍。至少那是你自己的蹩脚咒语。

@event align_asked_for_help
# en: "You're the One People Ask"
title [8a706f] = “大家都来找你”
# en: {~A first-year hovers by your table with a torn essay and a face like a wet weekend.|A first-year you've never met asks if you're the one who helps people. Apparently you are.|Someone has written your name on the common-room board under "ask them".} "Somebody said you'd know what to do," {~they say, as if that settles it.|they say, and then wait.|they say, pointing back at the board.}
text [775c60] = {~一个一年级生拿着撕破的论文在你桌边徘徊，脸色像个阴雨的周末。|一个你从没见过的一年级生问你是不是那个会帮人的人。看来你是。|有人在公共休息室的告示板上“找他们问”一栏下写了你的名字。}“有人说你会知道该怎么办，”{~对方说，好像这就说明了一切。|对方说完，便等着。|对方说着，回头指了指那块板。}
# en: A nervous first-year with an armful of torn notes hovering at the door of a common room, looking at one particular older student.
scene [dd1c6d] = 一个紧张的一年级生抱着一摞撕破的笔记，在公共休息室门口徘徊，眼睛望着某一位高年级学生。
# en: Sit them down and help
opt.left.label [d2700f] = 让对方坐下，帮忙
# en: It takes the whole evening and half your sleep. They leave lighter than they came. So, oddly, do you.
opt.left.say.1 [c8dac7] = 这花了整整一个晚上，还搭上了你一半的睡眠。对方走的时候比来时轻松了。说来奇怪，你也是。
# en: Point them to a tutor
opt.right.label [0b7f21] = 介绍给辅导员
# en: You give them a name and a smile and get back to your own work. They look disappointed for a moment, then grateful anyway.
opt.right.say.1 [9dd1bd] = 你给了对方一个名字和一个微笑，然后回去做自己的功课。对方失望了片刻，但还是很感激。

@event align_warm_regard
# en: A Good Word
title [352a57] = 一句好话
# en: {friend} pushes the last biscuit across to you. "People talk, you know. About the kind things you do when you think nobody's looking," {they} say{s}. "Don't make a face. It's good. Someone should say so."
text [6b8c11] = {friend}把最后一块饼干推到你面前。“你知道吗，大家都在说。说你以为没人看见时做的那些好事，”{they}说，“别摆那副表情。那是好事。总得有人说出来。”
# en: Two students sharing a pot of tea in a sunny window seat, one pushing the last biscuit towards the other.
scene [7e8fe3] = 两个学生坐在阳光照进来的窗边座位上分一壶茶，其中一人把最后一块饼干推给另一人。
# en: Accept the biscuit, and the praise
opt.left.label [80690f] = 收下饼干和夸奖
# en: You eat the biscuit. {friend} looks very pleased. You buy the next pot.
opt.left.say.1 [909198] = 你吃掉了饼干。{friend}看起来非常得意。下一壶茶你请。
# en: Say anyone would have done the same
opt.right.label [c1a72c] = 说换了谁都会这么做
# en: "Anyone would," you say. "Nobody did," says {friend}, and lets you change the subject, but the look {they} give{s} you says it has only been postponed.
opt.right.say.1 [af9984] = “换了谁都会的，”你说。“可没人做，”{friend}说，然后由着你换了话题，但{they}看你的眼神说明，这个话题只是暂时搁置。

@event align_saint_jibe
# en: "Saint"
title [136318] = “圣人”
# en: {other} blocks the doorway with one arm. "Here comes the saint," {they} say{s}, loud enough for the corridor. "Tell me, does it get heavy, being better than everyone?"
text [58f004] = {other}用一只胳膊挡住门口。“圣人来了，”{they}说，声音大得整条走廊都能听见，“告诉我，比所有人都好，累不累啊？”
# en: A smirking student blocking a doorway with one arm, another student standing in front of them with an armful of books.
scene [1e2bb0] = 一个冷笑着的学生用一只胳膊挡住门口，另一个学生抱着一摞书站在面前。
# en: Let it go
opt.left.label [7a5d2f] = 算了
# en: You wait. Eventually {other} gets bored and drops the arm. Two first-years behind you look at you like you've done something brave. You're not sure you have.
opt.left.say.1 [657e06] = 你等着。{other}终于觉得没意思，放下了胳膊。你身后两个一年级生看着你，好像你做了什么勇敢的事。你自己可不确定。
# en: Give as good as you get
opt.right.label [6cf248] = 以牙还牙
# en: Your answer is quick and much funnier than theirs. The corridor laughs. {other} goes red. It feels wonderful for about an hour.
opt.right.say.1 [28c5ab] = 你的回嘴又快又比对方的好笑得多。走廊里一片哄笑，{other}涨红了脸。这感觉美妙了大约一个小时。
