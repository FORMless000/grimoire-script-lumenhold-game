# Lumenhold Academy — 简体中文 (zh-CN) translation of content/events/social.grim
# Maintained by `node tools/grim.js i18n zh-CN`. Translate the text after "="; keep {tokens}.
# "# en:" shows the English source. [hash] marks the English version a line was translated from;
# lines marked STALE need updating — after fixing the text, delete the [hash] and re-run the tool.


@event soc_study_session
# en: Study Session
title [c13d4e] = 一起自习
# en: {~{npc} drops into the seat across from you with an armful of books. "Exams are coming for us all. Misery loves company. Study with me?"|{npc} slides a stack of notes onto your table. "I've read this chapter four times and it's still in a foreign language. Help?"|{npc} finds you in the library and sits down without asking. "If I study alone I'll just reorganise my quills. Keep me honest?"}
text [4f74e2] = {~{npc}抱着一摞书一屁股坐到你对面。“考试要来收拾我们所有人了。同病相怜嘛。一起学？”|{npc}把一叠笔记推到你桌上。“这一章我读了四遍，还是像外语。帮帮我？”|{npc}在图书馆找到你，不问一声就坐下了。“我一个人学只会去整理羽毛笔。你帮我盯着点？”}
# en: Two students at a candlelit table piled with books, one explaining something with wild hand gestures.
scene [cb85c7] = 两个学生坐在堆满书的烛光桌前，其中一个正手舞足蹈地讲解着什么。
# en: You work better alone
opt.left.label [1f18da] = 你一个人效率更高
# en: You get a lot done. {~{npc} sits at the next table and sighs loudly every few minutes.|{npc} finds someone else, and their laughter carries across the library all evening.|{npc} leaves you a biscuit on the way out, which somehow makes it worse.}
opt.left.say.1 [fb167d] = 你完成了很多。{~{npc}坐在隔壁桌，每隔几分钟就大声叹一口气。|{npc}找了别人一起学，他们的笑声整晚都在图书馆里回荡。|{npc}走的时候给你留了一块饼干，不知怎么反而更难受。}
# en: Pull up a chair
opt.right.label [d0a229] = 拉过一把椅子
# en: You get half as much done and remember twice as much of it. {~{npc} explains the Third Law with a biscuit diagram.|You quiz each other until the candle gutters.|{npc} makes up a rude rhyme for every date, and you will never forget a single one.}
opt.right.say.1 [2f03ab] = 你只完成了一半，却记住了两倍的内容。{~{npc}用饼干摆图讲解了第三定律。|你们互相提问，直到蜡烛快燃尽。|{npc}给每个日期都编了一句粗俗的顺口溜，你一个也忘不掉了。}

@event soc_borrow_money
# en: A Small Loan
title [cd870f] = 一笔小借款
# en: {npc} turns out an empty purse. "I'm fifteen crowns short {~for rent|for the term's ink and parchment|for the wand-mender, and it's my only wand}. I'll pay you back. I swear on my wand."
text [ddf34a] = {npc}把空空的钱袋翻了过来。“我还差十五克朗{~交房租|买这学期的墨水和羊皮纸|付修魔杖的钱，我就这一根魔杖}。我会还你的。我以我的魔杖发誓。”
# en: A student holding out an empty purse upside down with a sheepish grin.
scene [d2da5b] = 一个学生把空钱袋倒过来递给你看，脸上挂着不好意思的笑。
# en: Sorry, you're tight too
opt.left.label [d94071] = 抱歉，你也手头紧
# en: "No, of course, I understand." {They} {are} quiet at dinner.
opt.left.say.1 [e86862] = “不不，当然，我理解。”晚饭时{they}一直没怎么说话。
# en: Lend fifteen crowns
opt.right.label [0326cf] = 借十五克朗
# en: {npc} hugs you with the empty purse still in {their} hand.
opt.right.say.1 [995967] = {npc}抱住了你，手里还攥着那只空钱袋。
# en: {npc} hugs you. You suspect you will never see those fifteen crowns again.
opt.right.say.2 [506678] = {npc}抱住了你。你怀疑那十五克朗再也回不来了。

@event soc_loan_repaid
# en: Paid Back
title [ed4502] = 还钱
# en: {~{npc} finds you after class and presses a little stack of coins into your hand, plus a sticky bun. "Fifteen crowns. And interest." The interest is the bun.|{npc} turns up at breakfast with a small purse and a very straight face. "Fifteen crowns. I said I would."|{npc} slides fifteen crowns across the library table, one coin at a time. The last one has a note under it: "Thank you. Really."}
text [d1878a] = {~下课后{npc}找到你，往你手里塞了一小摞硬币，外加一个黏糊糊的小面包。“十五克朗。还有利息。”利息就是那个面包。|{npc}在早餐时出现，拿着一个小钱袋，一脸严肃。“十五克朗。我说过会还的。”|{npc}在图书馆的桌子上把十五克朗一枚一枚推到你面前。最后一枚下面压着一张字条：“谢谢你。真的。”}
# en: A small stack of coins and a sweet bun left on a desk with a thank-you note.
scene [a79734] = 桌上放着一小摞硬币和一个甜面包，旁边还有一张感谢字条。
# en: Count it
opt.left.label [5fce81] = 数一数
# en: You count it, because {they}'d be offended if you didn't. Fifteen exactly. {npc} nods, satisfied, as if a debt of honour has been settled.
opt.left.say.1 [3ec7dd] = 你数了一遍，因为不数的话{they}会觉得被冒犯。正好十五。{npc}满意地点点头，好像一笔关乎荣誉的债终于了结了。
# en: Pocket it without counting
opt.right.label [4b0d5d] = 不数就收下
# en: You put it away uncounted. {npc} looks quietly pleased to be trusted, which was worth more than the crowns.
opt.right.say.1 [997bc1] = 你没数就收了起来。{npc}看起来暗自高兴被你信任——这比那些克朗值钱多了。

@event soc_become_friends
# en: Something Like Friendship
title [68b938] = 类似友谊的东西
# en: {npc} saves you a seat without asking now, and you save {them} one. You trade notes, complaints and the last biscuit without keeping score. Somewhere along the way, this became a friendship.
text [013159] = 现在{npc}会不声不响地给你占座，你也给{them}占。你们交换笔记、牢骚和最后一块饼干，从不记账。不知从何时起，这已经成了一段友谊。
# en: Two students walking across the lawn at sunset, laughing at the same joke, shadows long behind them.
scene [ea4144] = 夕阳下两个学生穿过草坪，为同一个笑话大笑，身后拖着长长的影子。
# en: Keep a little distance
opt.left.label [37e0f8] = 保持一点距离
# en: You stay friendly. Just not too close. Some walls are load-bearing.
opt.left.say.1 [4470d5] = 你们保持友好。只是不太亲近。有些墙是承重墙。
# en: Call it what it is
opt.right.label [9f3cf3] = 挑明了说
# en: "So we're friends now," {npc} says. "Officially." You shake on it, solemnly, then ruin it by laughing.
opt.right.say.1 [eee457] = “那我们现在是朋友了，”{npc}说，“正式的。”你们郑重地握手，然后笑场毁掉了这份庄重。

@event soc_become_close
# en: The Kind of Friend You Call at 3am
title [e891f8] = 凌晨三点可以去敲门的那种朋友
# en: It's 3am. You can't sleep, and you've walked to {npc}'s door before you've even decided to. {They} open{s} it before you knock.
text [216ec9] = 凌晨三点。你睡不着，还没想好就已经走到了{npc}的门前。你还没敲门，{they}就把门打开了。
# en: Two friends sitting on a dormitory floor at 3am wrapped in one blanket, empty mugs between them.
scene [9f5741] = 凌晨三点，两个朋友裹着同一条毯子坐在宿舍地板上，中间摆着空杯子。
# en: Apologise and go back to bed
opt.left.label [f9def6] = 道个歉，回去睡觉
# en: "Don't be daft," {npc} says, but lets you go. In the morning there's tea outside your door.
opt.left.say.1 [5078b4] = “别傻了。”{npc}说，但还是让你走了。早上，你门外放着一杯茶。
# en: Talk until sunrise
opt.right.label [f5afa4] = 聊到日出
# en: You tell {them} things you haven't told anyone. {They} tell you things back. The sun comes up and neither of you notices.
opt.right.say.1 [c821d1] = 你告诉了{them}从没告诉过任何人的事。{they}也告诉了你{their}心事。太阳升起来了，你们谁都没注意到。

@event soc_secret
# en: A Secret
title [880a88] = 一个秘密
# en: {~{npc} pulls you under the stairs. "I need to tell someone or I'll burst. Swear you won't tell anyone. Not even the portraits."|{npc} closes the dormitory door, checks it, and checks it again. "I have to tell someone. Swear you'll keep it."|{npc} walks you to the far end of the lake path, where nobody goes. "Can you keep something? Really keep it?"}
text [620902] = {~{npc}把你拉到楼梯底下。“我得告诉一个人，不然我会憋炸的。发誓你谁也不说。连肖像画都不说。”|{npc}关上宿舍门，检查了一遍，又检查了一遍。“我得告诉一个人。发誓你会保密。”|{npc}把你带到湖边小路没人去的尽头。“你能守住一件事吗？真的守住？”}
# en: Two students huddled under a staircase, one whispering into the other's ear, a finger to their lips.
scene [e33a93] = 两个学生挤在楼梯下，一个凑在另一个耳边低语，手指竖在唇边。
# en: "I'd rather not carry it."
opt.left.label [a4f5da] = “我宁愿不背这个包袱。”
# en: {npc} looks hurt, then relieved. "Maybe that's better." You'll never know.
opt.left.say.1 [8b5a46] = {npc}先是一脸受伤，然后松了口气。“也许这样更好。”你永远不会知道了。
# en: "I swear."
opt.right.label [381a0e] = “我发誓。”
# en: {~It's not a big secret. It's the kind that's only big to the person holding it. You hold it with {them}.|It's about a letter from home, and it's heavier than {they} let on. You carry half of it now.|It's ridiculous, and {they} know it's ridiculous, and {they} needed someone else to know anyway. You do.}
opt.right.say.1 [5f42d1] = {~不是什么大秘密。是那种只对守着它的人来说很大的秘密。你陪{them}一起守着。|是关于一封家书的事，比{they}表现出来的沉重得多。现在你替{them}分担了一半。|很荒唐，{they}自己也知道很荒唐，但{they}还是需要另一个人知道。现在你知道了。}

@event soc_argument
# en: Words Exchanged
title [260001] = 口角
# en: It starts with something small — {~a borrowed book, a joke that landed wrong|whose turn it was to fetch the tea|a seat someone saved and someone else took} — and suddenly you and {npc} are arguing {~in the corridor|on the stairs|in the middle of the refectory}, louder than either of you intended.
text [838628] = 起因是件小事——{~一本借走的书，一个说错时机的玩笑|该谁去打茶|有人占的座位被别人坐了}——突然间你和{npc}就{~在走廊里|在楼梯上|在食堂正中间}吵了起来，嗓门比你们俩想的都大。
# en: Two students facing off in an empty corridor, one with arms crossed, the other mid-gesture, both flushed.
scene [935b50] = 两个学生在空荡的走廊里对峙，一个抱着双臂，另一个正比划着，两人都涨红了脸。
# en: Apologise first
opt.left.label [9f3966] = 先道歉
# en: {~"I'm sorry." {npc} deflates. "...Me too." It's over. It feels better than winning would have.|You say sorry first. {npc} looks almost disappointed not to get to say it. You share a bun about it later.|"I'm sorry." {npc} blinks, then laughs. "We were both being absurd." You were.}
opt.left.say.1 [d0711f] = {~“对不起。”{npc}一下子泄了气。“……我也是。”结束了。这比吵赢了感觉更好。|你先道了歉。{npc}看上去几乎有点失望，没轮到自己说。后来你们为这事分吃了一个面包。|“对不起。”{npc}眨眨眼，然后笑了。“我们俩都太荒唐了。”确实。}
# en: Stand your ground
opt.right.label [3881f5] = 坚持立场
# en: {npc} storms off. You were right. It doesn't feel as good as you'd hoped.
opt.right.say.1 [23d1ff] = {npc}气冲冲地走了。你是对的。可感觉并没有你希望的那么好。
# en: You argue it out until you're both laughing at how ridiculous it got. Somehow you're closer after.
opt.right.say.2 [16b2d4] = 你们一直吵到两个人都笑了出来，笑这事有多荒唐。不知怎么的，吵完反而更亲近了。

@event soc_village_trip
# en: A Day in the Village
title [1afb52] = 镇上一日
# en: "Barge to the village? Tea at Mabel's, a wander round the bookshops, back before curfew?" {npc} is already wearing {their} coat.
text [07e032] = “坐驳船去镇上吗？去梅布尔茶馆喝茶，逛逛书店，宵禁前回来？”{npc}已经穿好外套了。
# en: A cobbled village street with crooked shopfronts, two students sharing a paper cone of roasted nuts.
scene [743ea4] = 鹅卵石铺就的小镇街道，歪歪扭扭的店面，两个学生分享着一纸筒烤坚果。
# en: Not this week
opt.left.label [0fe3ce] = 这周不行
# en: {~{They} bring{s} you back a cinnamon bun anyway.|{They} bring{s} you back a postcard of the village, which is three streets long.|{They} come{s} back with a story about a goat and tell{s} it badly.}
opt.left.say.1 [b6d43c] = {~{they}还是给你带回来一个肉桂卷。|{they}给你带回来一张小镇明信片，那小镇总共只有三条街。|{they}回来时带着一个关于山羊的故事，讲得很烂。}
# en: Grab your coat
opt.right.label [b14325] = 抓起外套
# en: {~Tea, buns, a bookshop cat that sits on {npc}'s feet. You almost miss the last barge, laughing.|Mabel's, then the market, then a long argument about which bun is best. You get the last barge home with sticky fingers.|Rain, so you spend the whole afternoon in the bookshop. {npc} buys a book about knots and explains every one on the barge home.}
opt.right.say.1 [64f247] = {~喝茶，吃面包，书店的猫趴在{npc}脚上。你们笑着差点错过最后一班驳船。|先去梅布尔茶馆，再逛集市，然后为哪种面包最好吵了半天。你们带着黏糊糊的手指赶上了最后一班驳船。|下雨了，你们一下午都待在书店里。{npc}买了一本讲绳结的书，回程的驳船上把每个结都讲了一遍。}

@event soc_friend_sick
# en: Sick Friend
title [ac406d] = 生病的朋友
# en: {npc} has Lake Fever and is miserable in the infirmary. Sister Amaranth says visitors are allowed, but she won't be responsible.
text [0a1413] = {npc}得了湖热病，在医务室里难受得要命。阿玛兰斯修女说可以探视，但出了事她不负责。
# en: A student tucked into an infirmary bed under a mountain of blankets, a friend sitting beside them with a bowl of soup.
scene [43529f] = 一个学生被埋在医务室病床的一堆毯子底下，一位朋友端着一碗汤坐在床边。
# en: Send a card
opt.left.label [72cab2] = 送张卡片
# en: You send a card with a drawing of Sister Amaranth as a dragon. {npc} keeps it on {their} bedside table.
opt.left.say.1 [eae564] = 你送了一张卡片，上面画着变成了龙的阿玛兰斯修女。{npc}把它摆在床头柜上。
# en: Sit with them every evening
opt.right.label [09fda2] = 每晚都去陪着
# en: You keep {them} company for a week. Then you're in the next bed. You both find this hilarious.
opt.right.say.1 [8c2cc5] = 你陪了{them}一个星期。然后你住进了隔壁床。你们俩都觉得这太好笑了。
# en: {~You read aloud, badly, doing voices. {npc} recovers and claims it was the voices.|You teach {them} every card game you know and lose all of them. {npc} recovers, insufferably.|You bring soup from the kitchens every evening and tell {them} all the gossip. {npc} recovers mostly out of curiosity.}
opt.right.say.2 [0b98ac] = {~你给{them}念书，念得很烂，还学各种腔调。{npc}康复后坚称是那些腔调治好了{them}。|你把会的纸牌游戏全教给了{them}，结果每一局都输了。{npc}康复了，得意得叫人受不了。|你每晚从厨房端汤过来，把所有八卦都讲给{them}听。{npc}康复，主要是出于好奇。}
# en: Bring a spoon of Maud's honey
opt.up.label [e2a568] = 带一勺莫德的蜂蜜
# en: {~You stir silver honey into {npc}'s tea. {They} sit{s} up, sniff, and ask for more. Sister Amaranth pretends not to see.|{npc} takes one spoonful of the honey and colour comes back into {their} face. Amaranth asks where you got it, then asks for some.|The honey tastes of summer. {npc} is up and complaining by the end of the week, which Amaranth calls a full recovery.}
opt.up.say.1 [8e70b0] = {~你把银色的蜂蜜搅进{npc}的茶里。{they}坐起来，闻了闻，还要。阿玛兰斯修女假装没看见。|{npc}吃了一勺蜂蜜，脸上恢复了血色。阿玛兰斯问你从哪儿弄来的，然后也要了一点。|蜂蜜有夏天的味道。不到一周{npc}就下床抱怨了，阿玛兰斯称之为完全康复。}

@event soc_gift_given
# en: A Small Gift
title [9dafb3] = 一件小礼物
# en: There's a small parcel wedged into your pigeonhole, tied with string. A note in {npc}'s handwriting: "Saw this and thought of you. Don't make it weird."
text [ee4873] = 你的信箱格里塞着一个用绳子捆着的小包裹。附着一张{npc}字迹的字条：“看见这个就想到了你。别想太多。”
# en: A small brown-paper parcel tied with string, wedged into a student's pigeonhole in the porters' lodge.
scene [4c823d] = 门房的信箱格里塞着一个牛皮纸小包裹，用细绳捆着。
# en: Thank {them} later
opt.left.label [a0fa69] = 回头再谢{them}
# en: {~It's a tiny brass compass that always points to the nearest teapot. You use it constantly.|It's a bookmark that hums when you stop reading. Annoying. You love it.|It's a pair of gloves that stay warm all winter. You wear them until they're threadbare.}
opt.left.say.1 [e85db0] = {~是一个小小的黄铜罗盘，永远指向最近的茶壶。你天天都在用。|是一枚书签，你一停下不读它就哼哼。烦人。你爱死它了。|是一副整个冬天都暖和的手套。你一直戴到磨破。}
# en: Get {them} something back (8 gold)
opt.right.label [42a27b] = 回赠一份礼物（8 金币）
# en: You find {them} {~a book {they}'d wanted for months|a tin of the good biscuits from the village|a sketchbook with good paper}. {npc} grins and calls you a menace, which is worth twice the price.
opt.right.say.1 [f8c672] = 你给{them}找到了{~一本{they}想要了好几个月的书|一罐村里买的好饼干|一本纸张很好的速写本}。{npc}咧嘴一笑，说你是个祸害——这一句值两倍的价钱。

@event soc_drift
# en: Drifting Apart
title [73c51a] = 渐行渐远
# en: You realise you haven't really talked to {npc} in weeks. You see {them} {~across the courtyard|at the far end of the refectory|on the library steps}, laughing with people you don't know.
text [27eced] = 你发现自己已经好几周没好好跟{npc}说过话了。你看见{them}{~在庭院那头|在食堂另一端|在图书馆台阶上}，和一群你不认识的人说笑。
# en: A student glancing back across a busy courtyard at another who hasn't seen them, the space between them full of strangers.
scene [e8800d] = 一个学生回头望向熙攘庭院另一端没看见自己的人，两人之间隔满了陌生人。
# en: Let it be
opt.left.label [71cc4c] = 顺其自然
# en: People drift. It's nobody's fault. You still smile when you pass in the halls.
opt.left.say.1 [8a48fa] = 人总会渐行渐远。不是谁的错。在走廊里擦肩而过时，你们仍会微笑。
# en: Go over and say hello
opt.right.label [cdae69] = 走过去打个招呼
# en: {~"There you are!" {npc} says, as if you'd been the one missing. Maybe you had.|{npc} introduces you to everyone as "the one I told you about". You wonder what {they} told them. It seems to have been good.|{npc} shifts over to make room on the bench without a word, as if your seat had been waiting.}
opt.right.say.1 [edea7c] = {~“你在这儿呀！”{npc}说，好像失踪的人是你。也许确实是。|{npc}向所有人介绍你：“就是我跟你们说过的那个。”你很好奇{they}说了什么。听起来是好话。|{npc}一言不发地挪了挪，在长凳上给你腾出位置，好像你的座位一直在等你。}
# en: You go over. It is friendly, and short, and you both say "we should catch up" in a way that means you won't.
opt.right.say.2 [46fd68] = 你走过去。气氛很友好，也很短，你们都说了句“改天聚聚”，那语气意味着不会有改天。

@event soc_rumour
# en: Rumours About {npc}
title [e3d846] = 关于{npc}的流言
# en: A nasty rumour about {npc} is going round {~the common room|the refectory|the library steps}: {~that {they} cheated on an exam|that {they} {are} leaving at the end of term in disgrace|that {they} said something cruel about a friend}. It's not true. You know it's not true. People are laughing.
text [fdfb88] = {~公共休息室里|食堂里|图书馆台阶上}流传着一条关于{npc}的恶毒流言：{~说{they}考试作弊|说{they}学期末要灰溜溜地退学|说{they}对朋友说了很刻薄的话}。不是真的。你知道不是真的。大家在笑。
# en: A cluster of students whispering behind their hands in a corridor, glancing toward someone just out of view.
scene [78a3d1] = 一群学生在走廊里捂着嘴窃窃私语，朝视线外的某个人瞟去。
# en: Let it blow over
opt.left.label [962dcd] = 等它自己平息
# en: It blows over. {npc} never finds out you heard it. You find out you don't like yourself for it, a little.
opt.left.say.1 [95d2f0] = 它平息了。{npc}永远不会知道你听到过。可你发现，你有点不喜欢这样的自己。
# en: Shut it down
opt.right.label [e3e364] = 当场制止
# en: You make the rumour-monger look so foolish that the story dies on the spot. {npc} hears about it later and just squeezes your arm.
opt.right.say.1 [78c724] = 你让造谣的人出尽洋相，流言当场就死了。{npc}后来听说了，只是轻轻捏了捏你的胳膊。
# en: You make a scene and now there are rumours about you too. {npc} thinks you're an idiot. A loyal idiot.
opt.right.say.2 [ea7565] = 你大闹了一场，现在也有关于你的流言了。{npc}觉得你是个傻瓜。一个忠诚的傻瓜。

@event soc_homework_help
# en: Desperate Homework
title [b925b8] = 作业告急
# en: {npc} waves a half-finished {~essay|lab report|star chart} at you. "It's due in an hour and I've written the title twice. Help."
text [eb5473] = {npc}朝你挥着一份写了一半的{~论文|实验报告|星图}。“一小时后就要交了，我只把标题写了两遍。救命。”
# en: A student with ink on their face clutching a half-finished essay, another student leaning over to read it.
scene [d955d2] = 一个脸上沾着墨水的学生攥着一篇半成品论文，另一个学生凑过来看。
# en: Explain the concept
opt.left.label [d8e8f3] = 讲解知识点
# en: You explain it so clearly that {npc} finishes the essay with time to spare. {They} insist{s} you're a genius.
opt.left.say.1 [cf80f6] = 你讲得清清楚楚，{npc}提前写完了论文。{they}坚称你是个天才。
# en: You explain it so confusingly that you both end up more lost. You hand it in together, two confused people against the world.
opt.left.say.2 [a0a001] = 你讲得一团乱麻，两个人都更糊涂了。你们一起交了上去——两个糊涂人对抗全世界。
# en: "Copy mine."
opt.right.label [b2d7d3] = “抄我的吧。”
# en: The professor notices two identical pieces of work. You both get detention, a lecture, and a note on your record that every one of your professors reads.
opt.right.say.1 [d3d733] = 教授发现了两份一模一样的作业。你们俩都被关了禁闭，挨了一顿训，档案上还记了一笔，你的每位教授都会看到。
# en: {npc} hands it in and gets a better mark than you did. Unbelievable.
opt.right.say.2 [c22ac9] = {npc}交了上去，分数比你还高。难以置信。

@event soc_faculty_advice
# en: A Word of Advice
title [594b8b] = 一句忠告
# en: {npc} catches you after a lecture. "You've been working hard. Or hardly working. I can never tell with your year. Some advice, if you'll take it?"
text [890d50] = 讲座结束后{npc}叫住了你。“你一直很用功。或者说一直很用‘空’。你们这一届我总是分不清。给你点建议，听不听？”
# en: A professor walking with a student along a covered walkway, pointing at something in an open book.
scene [41385c] = 一位教授和一名学生沿着有顶棚的步道走着，指着一本摊开的书里的某处。
# en: Politely decline
opt.left.label [8a601d] = 礼貌地拒绝
# en: "Suit yourself." {They} walk{s} off. Faculty have long memories.
opt.left.say.1 [19801b] = “随你。”{they}走开了。教职员的记性可都很好。
# en: Listen carefully
opt.right.label [1b6b4d] = 认真听
# en: It's good advice about how to study, {~annoyingly good|delivered at great length|illustrated with a story from {their} own disastrous first year}. Every piece of work you hand in that month is better for it.
opt.right.say.1 [3db8c9] = 是关于怎么学习的好建议，{~好得让人恼火|讲得极其冗长|还配了一个{their}自己一年级时惨痛经历的故事}。那个月你交的每一份作业都因此进步了。

@event soc_spark
# en: A Spark
title [21e629] = 火花
# en: You and {npc} reach for {&the same quill|the last biscuit on the plate|the same library book} at the same moment. Your hands touch. Neither of you lets go immediately. {&It's a perfectly ordinary quill.|It's a perfectly ordinary biscuit.|It's a perfectly ordinary book.}
text [8c5ce5] = 你和{npc}同时伸手去拿{&同一支羽毛笔|盘子里最后一块饼干|同一本图书馆的书}。你们的手碰到了。谁也没有马上松开。{&那只是一支再普通不过的羽毛笔。|那只是一块再普通不过的饼干。|那只是一本再普通不过的书。}
# en: Two hands brushing as they reach for the same quill, both students freezing for a heartbeat.
scene [d87696] = 两只手在伸向同一支羽毛笔时轻轻相触，两个学生都愣了一拍。
# en: Laugh it off
opt.left.label [29c02a] = 一笑了之
# en: "All yours," you say. {npc} laughs. The moment passes. Mostly.
opt.left.say.1 [134287] = “你用吧。”你说。{npc}笑了。那一刻过去了。大体上。
# en: Hold on a moment longer
opt.right.label [04d88b] = 多握一会儿
# en: {npc} looks up. Something in {their} face shifts. Then {they} let{s} go, a little pink, and {&the quill rolls under the desk|the biscuit breaks neatly in half|the book falls open on the floor between you}.
opt.right.say.1 [c7d64d] = {npc}抬起头。{their}脸上有什么东西变了。然后{they}松开了手，脸有点红，{&羽毛笔滚到了桌子底下|饼干整整齐齐地断成了两半|书摊开掉在你们中间的地上}。
# en: {npc} pulls back as if burned, and the rest of the {&lesson|meal|afternoon} is very, very awkward.
opt.right.say.2 [671934] = {npc}像被烫到一样缩回了手，那{&节课|顿饭|个下午}剩下的时间尴尬得要命。

@event soc_date
# en: An Invitation
title [aba1c1] = 一次邀约
# en: You could ask {npc} to {&the lantern show in the village|the travelling players at the Newt|the music on the quay} this weekend. As friends. Or, you know. Not as friends.
text [c7f340] = 你可以邀请{npc}这个周末去{&镇上看灯笼表演|镀金蝾螈酒馆看巡演剧团|码头听音乐}。以朋友的身份。或者，你懂的。不只是朋友。
# en: A student nervously holding out a hand-drawn ticket to the village's floating lantern show.
scene [57c131] = 一个学生紧张地递出一张手绘的小镇浮灯表演门票。
# en: Ask as friends
opt.left.label [bd7c43] = 以朋友身份邀请
# en: You pay for both tickets and the hot cider. It's a lovely evening. You're both very careful about elbows.
opt.left.say.1 [0135a9] = 两张票和热苹果酒都是你付的。那是个美好的夜晚。你们俩都非常小心地不碰到对方的胳膊肘。
# en: Ask as more than friends
opt.right.label [e73a1b] = 以不只是朋友的身份邀请
# en: {npc} says yes before you finish the sentence. You hold hands through the whole {&show and miss every lantern|play and miss every line|evening and miss every song}.
opt.right.say.1 [fb9a21] = 你话还没说完{npc}就答应了。{&整场表演你们都牵着手，一盏灯笼也没看见|整场戏你们都牵着手，一句台词也没听见|一整晚你们都牵着手，一首歌也没听进去}。
# en: {npc} hesitates, then says {they}'d rather go as friends. It's a nice evening. It's a long evening.
opt.right.say.2 [097e94] = {npc}犹豫了一下，说还是以朋友的身份去吧。那是个不错的夜晚。也是个漫长的夜晚。
# en: {npc} says yes before you finish the sentence. You hold hands through the whole {&show and miss every lantern|play and miss every line|evening and miss every song}.
opt.right.say.3 [fb9a21] = 你话还没说完{npc}就答应了。{&整场表演你们都牵着手，一盏灯笼也没看见|整场戏你们都牵着手，一句台词也没听见|一整晚你们都牵着手，一首歌也没听进去}。
# en: {npc} hesitates, then says {they}'d rather go as friends. It's a nice evening. It's a long evening.
opt.right.say.4 [097e94] = {npc}犹豫了一下，说还是以朋友的身份去吧。那是个不错的夜晚。也是个漫长的夜晚。

@event soc_confess_generic
# en: Feelings, Spoken
title [0fdaae] = 说出口的心意
# en: On the bridge between the towers, the wind snatching at your robes, you realise you can't keep it in anymore. {npc} is looking at you like {they} know what you're about to say.
text [0fb936] = 在塔楼之间的桥上，风扯着你的长袍，你意识到自己再也藏不住了。{npc}看着你，好像已经知道你要说什么。
# en: Two students standing very close on a windswept bridge between towers, one with a hand over their heart.
scene [80f257] = 两个学生紧挨着站在塔楼之间风大的桥上，其中一人手按在心口。
# en: Say nothing
opt.left.label [d1151d] = 什么也不说
# en: The moment passes. You walk back together, a careful inch apart.
opt.left.say.1 [8f2183] = 那一刻过去了。你们一起往回走，小心地隔着一寸距离。
# en: Tell {them}
opt.right.label [3c60a0] = 告诉{them}
# en: "Finally," {npc} says, and kisses you, and the wind steals your breath anyway.
opt.right.say.1 [bdde21] = “终于说了。”{npc}说着吻了你，而风依旧夺走了你的呼吸。
# en: {npc} takes a long breath. "I care about you," {they} say{s}. "Just not like that. I'm sorry." The wind is very cold.
opt.right.say.2 [fe43d9] = {npc}深吸了一口气。“我在乎你，”{they}说，“只是不是那种在乎。对不起。”风很冷。

@event soc_partner_date
# en: Date Night
title [b6d8e3] = 约会之夜
# en: {npc} has booked the window table at Mabel's. Candles. {season == "winter": Snow outside.|The lake going gold outside.} "We're splitting the bill," {they} say{s}. "Don't argue."
text [ae9174] = {npc}订了梅布尔茶馆靠窗的位子。蜡烛。{season == "winter": 窗外飘着雪。|窗外的湖正染成金色。}“这顿我们平摊，”{they}说，“别跟我争。”
# en: Two people at a tiny candlelit table in a window alcove of a village tea shop, snow falling outside.
scene [7b9157] = 小镇茶馆窗边凹室里一张小小的烛光桌，两个人对坐，窗外飘着雪。
# en: Talk about the future
opt.left.label [4d8f04] = 聊聊未来
# en: {&You talk about where you'll be in ten years. In every version, you're both there.|You talk about after graduation, carefully, then not carefully at all.|You make a list of places you'll go together. It is already too long.}
opt.left.say.1 [c9de6d] = {&你们聊起十年后会在哪里。每一个版本里，你们俩都在。|你们聊起毕业以后的事，起初小心翼翼，后来一点也不小心了。|你们列了一张以后要一起去的地方的清单。已经太长了。}
# en: Talk about absolutely nothing
opt.right.label [75d2d9] = 聊些完全没用的事
# en: You argue for an hour about {&whether soup is a drink|whether owls are smart or just look it|which professor would win in a duel}, and {npc} pays the bill while you're making your closing argument. {&It is the best date of your life.|It might be better than the last one.|You lose the argument and don't mind.}
opt.right.say.1 [cc5078] = 你们争论了一个小时{&汤到底算不算饮料|猫头鹰是真聪明还是只是看起来聪明|哪位教授决斗会赢}，你还在做总结陈词时，{npc}已经把账结了。{&这是你这辈子最棒的一次约会。|也许比上一次还要好。|你辩输了，却一点也不在意。}

@event soc_partner_neglect
# en: "You're Always Busy"
title [46e97c] = “你总是很忙”
# en: {npc} is waiting outside your door. "I feel like I only see you in corridors," {they} say{s}. "Do you even want this?"
text [0e3f61] = {npc}等在你门外。“我觉得我只能在走廊里见到你，”{they}说，“你到底还想不想要这段感情？”
# en: A person waiting alone at a table set for two, a candle burned low, the other chair empty.
scene [b603a7] = 一个人独自坐在摆好两人份餐具的桌前，蜡烛快燃尽了，另一把椅子空着。
# en: "I'm sorry. I'll make time."
opt.left.label [b59fcc] = “对不起。我会挤出时间的。”
# en: You skip a study session for a long walk by the lake. It's the right call.
opt.left.say.1 [8a05e5] = 你翘掉一次自习，陪{them}在湖边走了很久。这个决定是对的。
# en: "You know how busy I am."
opt.right.label [a60981] = “你知道我有多忙。”
# en: {npc} nods slowly. Something between you cools a degree.
opt.right.say.1 [2bc62a] = {npc}缓缓点了点头。你们之间的什么东西，冷了一度。

@event soc_breakup
# en: The End of Something
title [179272] = 某件事的结束
# en: {npc} sits down at the far end of the bench. "I think we both know," {they} say{s} quietly. "This isn't working anymore."
text [c059c0] = {npc}在长椅的另一头坐下。“我想我们都心知肚明，”{they}轻声说，“这已经行不通了。”
# en: Two people sitting on opposite ends of a bench in a grey garden, not looking at each other, rain beginning.
scene [4b79cd] = 灰蒙蒙的花园里，两个人坐在长椅两端，谁也不看谁，开始下雨了。
# en: Fight for it
opt.left.label [7ed077] = 争取一下
# en: You talk for hours. It's raw and honest and it hurts. And at the end, {npc} takes your hand again.
opt.left.say.1 [207908] = 你们谈了几个小时。赤裸、坦诚，而且很痛。最后，{npc}又握住了你的手。
# en: You try. It only makes it harder. In the end you're both crying, and it's over anyway.
opt.left.say.2 [2de21e] = 你努力了。却只让一切更难。最后你们都哭了，而它终究还是结束了。
# en: Let {them} go
opt.right.label [185a66] = 放{them}走
# en: You agree. It's terrible and gentle and right. {npc} kisses your forehead once before {they} leave{s}.
opt.right.say.1 [e0897b] = 你同意了。这很糟糕，很温柔，也很对。{npc}离开前在你额头上吻了一下。

@event soc_two_timing
# en: Found Out
title [f1af67] = 东窗事发
# en: {npc} is holding two letters. One is to {them}. The other isn't. "I found it in your bag," {they} say{s}, very quietly. Half the corridor has stopped to watch.
text [b63ccd] = {npc}手里拿着两封信。一封是写给{them}的。另一封不是。“我在你包里找到的，”{they}说，声音很轻。半条走廊的人都停下来看着。
# en: A person holding up two crumpled love letters in a crowded corridor, the crowd parting around them.
scene [28e97e] = 拥挤的走廊里，一个人举着两封揉皱的情书，人群在他们周围分开。
# en: Beg forgiveness
opt.left.label [b42d94] = 乞求原谅
# en: {npc} doesn't forgive you. But {they} don't leave. Not yet. You're on borrowed time.
opt.left.say.1 [27d6d1] = {npc}没有原谅你。但{they}也没有离开。暂时没有。你在借来的时间里过日子。
# en: {npc} tears both letters in half and walks away. Everyone knows by dinner.
opt.left.say.2 [3f568e] = {npc}把两封信都撕成两半，转身离开。晚饭时所有人都知道了。
# en: Say nothing
opt.right.label [d1151d] = 一言不发
# en: Your silence is an answer. {npc} drops the letters at your feet and leaves. The story is all over the academy.
opt.right.say.1 [855b96] = 你的沉默就是答案。{npc}把信扔在你脚边，走了。这件事传遍了整个学院。

@event soc_ex_encounter
# en: Awkward
title [8ea9c0] = 尴尬
# en: {~You turn into the library aisle and there's {npc}. Your ex. Holding the same book you came for.|The only free seat in the refectory is opposite {npc}. Your ex. {They} look{s} up at the same moment you do.|You open the door to the owlery and there's {npc}. Your ex. Holding a letter, halfway to an owl.} Neither of you moves.
text [d14bf3] = {~你拐进图书馆的一条过道，{npc}就在那儿。你的前任。手里拿着你正要找的那本书。|食堂里唯一的空位在{npc}对面。你的前任。{they}和你同时抬起了头。|你推开猫头鹰塔的门，{npc}就在那儿。你的前任。手里拿着一封信，正要交给猫头鹰。}你们谁也没动。
# en: Two people coming face to face in a narrow library aisle, both holding books, neither moving.
scene [0292af] = 两个人在图书馆狭窄的过道里迎面相遇，手里都拿着书，谁也没动。
# en: Turn around and leave
opt.left.label [a746c5] = 转身离开
# en: You find a different book in a different aisle and read the same paragraph six times.
opt.left.say.1 [a75b45] = 你在另一条过道找了另一本书，把同一段读了六遍。
# en: Say hello like a person
opt.right.label [06a265] = 像个正常人一样打招呼
# en: It's awkward for one minute, then it isn't. You end up laughing about the worst of the dates you went on. Friends, maybe. Really.
opt.right.say.1 [38140b] = 尴尬了一分钟，然后就不尴尬了。你们最后笑着聊起约会时最糟的那一次。也许能做朋友。真的。
# en: "Hello." "Hello." You both stand there. Then you both leave. It's a start.
opt.right.say.2 [f4910b] = “你好。”“你好。”你们俩站在那儿。然后各自离开。算是个开始。

@event soc_rival_taunt
# en: A Public Taunt
title [0b1cd5] = 当众嘲讽
# en: In the middle of a crowded {~meal|common room|library queue}, {npc} loudly recounts {~your most embarrassing moment of the term|the time you walked into a door that was a painting|your worst spell in front of the whole class}. People laugh. {They} look{s} very pleased.
text [86e910] = 在挤满人的{~饭桌上|公共休息室里|图书馆排队时}，{npc}大声讲起{~你这学期最丢人的一幕|你一头撞上一扇其实是画的门那次|你当着全班的面施出的最烂的咒语}。大家都笑了。{they}看起来非常得意。
# en: A smirking student surrounded by a small audience, pointing at someone across a crowded dining hall.
scene [fc4e76] = 一个得意洋洋的学生被一小群观众围着，隔着拥挤的餐厅指向某人。
# en: Ignore {them}
opt.left.label [c17487] = 不理{them}
# en: The laughter dies down. {~You carry on with as much dignity as you can find.|You wait it out, and stare at a fixed point on the wall.|Someone nearby passes you a biscuit in silent solidarity.}
opt.left.say.1 [b738e5] = 笑声渐渐平息。{~你尽可能体面地继续做自己的事。|你熬过去，眼睛一直盯着墙上的某一点。|旁边有人默默递给你一块饼干，以示声援。}
# en: Fire back
opt.right.label [edc214] = 反唇相讥
# en: {~Your comeback is so good that someone at the far table applauds.|Your comeback lands so well that people repeat it for a week.|Your comeback is quiet, exact and devastating.} {npc} goes scarlet.
opt.right.say.1 [6c86a5] = {~你的回击太漂亮了，远处那桌有人鼓起掌来。|你的回击一语中的，大家足足学了一个星期。|你的回击轻声、精准、致命。}{npc}满脸通红。
# en: Your comeback comes out as a squeak. The laughter doubles.
opt.right.say.2 [992f30] = 你的回击变成了一声尖叫。笑声翻了一倍。

@event soc_make_peace
# en: Burying the Hatchet
title [91164f] = 握手言和
# en: {npc} finds you after class, scuffing {their} shoes. "This whole rivalry thing. It's getting tiring. Truce?"
text [d5620e] = 下课后{npc}找到你，鞋尖蹭着地面。“这整个当对手的事儿。有点累了。休战？”
# en: Two former rivals shaking hands on a dueling green at sunset, wands tucked away.
scene [f9c463] = 夕阳下的决斗草坪，两个昔日对手收起魔杖握手。
# en: Keep the edge
opt.left.label [a15600] = 保持锋芒
# en: "Thought so," {npc} says, half-smiling. The game goes on.
opt.left.say.1 [4e5e1c] = “我就知道。”{npc}半笑着说。较量继续。
# en: Shake on it
opt.right.label [982713] = 握手为定
# en: You shake. It's strange — you know {them} better than most of your friends. Maybe that's the point.
opt.right.say.1 [e1ff36] = 你们握了手。说来奇怪——你对{them}的了解，比对大多数朋友都深。也许这正是意义所在。

@event soc_rival_bet
# en: The Wager
title [5a804e] = 赌约
# en: "Eight crowns says I {~outscore you in the next practical|light more candles in one breath than you|hold a ward longer than you}," {npc} says, slapping coins on the table. A crowd forms.
text [ff384f] = “八克朗，赌我{~下次实践课分数比你高|一口气点的蜡烛比你多|护界撑得比你久}。”{npc}把硬币拍在桌上。一群人围了过来。
# en: Two students slapping coins onto a table between them, a crowd gathering, a chalked tally on the wall.
scene [8dd838] = 两个学生把硬币拍在中间的桌上，人群聚拢，墙上用粉笔记着比分。
# en: Decline the bet
opt.left.label [99b979] = 不赌
# en: "Thought so." {npc} pockets the coins. You decide not to care. You care.
opt.left.say.1 [556d0b] = “我就知道。”{npc}收起了硬币。你决定不在乎。你很在乎。
# en: Take the bet
opt.right.label [8a4d52] = 接下赌约
# en: You win by a hair. {npc} pays up with a theatrical bow. "Next time."
opt.right.say.1 [e1aac3] = 你以毫厘之差赢了。{npc}夸张地鞠了一躬，付了钱。“下次再说。”
# en: You lose by a hair. "Next time," you say. {npc} grins. "Next time."
opt.right.say.2 [8023a9] = 你以毫厘之差输了。“下次再说。”你说。{npc}咧嘴一笑。“下次再说。”

@event spark_cooldown
# en: Something Between You
title [e1d3d8] = 你们之间的什么
# en: Something has shifted between you and {npc}. {~They hold your gaze a moment too long.|They've started saving you a seat, and blushing about it.|Your names keep turning up next to each other in other people's gossip.} You could let it grow, or gently let it cool.
text [042740] = 你和{npc}之间有什么变了。{~对方看着你的时间长了那么一瞬。|对方开始给你留座位，还为此脸红。|你们的名字总在别人的闲话里挨在一起。}你可以任它生长，也可以轻轻让它冷下来。
# en: Two students on a bench a little closer than friends usually sit, both pretending to read the same page.
scene [dd0df1] = 两个学生坐在长椅上，比朋友通常坐得近一点，都假装在读同一页书。
# en: Let it grow
opt.left.label [8ba126] = 任它生长
# en: {~You don't say anything. You don't move away either.|You hold their gaze back, for exactly as long.|Let them gossip. You sit beside them anyway, in front of everyone.}
opt.left.say.1 [82adf3] = {~你什么也没说。也没有挪开。|你回望对方，时间不多不少，正好一样长。|让他们去说吧。你还是当着所有人的面坐到了对方身边。}
# en: Let it cool, kindly
opt.right.label [6bd6f5] = 温和地让它冷却
# en: {~You find a gentle way to say you value them as a friend. They look relieved, or almost.|You keep it light and friendly, and the moment passes. The friendship stays.|You give the gossip nothing to work with, gently, and in a week it moves on. The friendship doesn't.}
opt.right.say.1 [028f08] = {~你找了个温和的方式，说你珍惜这份友情。对方看起来松了口气，或者差不多。|你把气氛保持得轻松友好，那一刻过去了。友情还在。|你温和地不给流言任何把柄，一个星期后它就转向了别处。友情没有。}

@event jealousy_two_invitations
# en: Two Invitations
title [b97cfd] = 两份邀请
# en: Two notes in one morning. {suitor} asks if you're free on Friday evening, in neat handwriting, crossed out once. {other} asks the same, for the same evening, in a hurry. They both know the other asked. The whole corridor seems to know.
text [cbc824] = 一个早上收到两张字条。{suitor}问你周五晚上有没有空，字迹工整，划掉过一处。{other}问了同样的事，同一个晚上，写得很匆忙。他们都知道对方也问了。整条走廊似乎都知道。
# en: A student holding two folded notes, one in each hand, in a corridor where two people wait at opposite ends.
scene [657e49] = 一个学生一手拿着一张折好的字条，站在走廊里，走廊两头各等着一个人。
# en: Say yes to {suitor}
opt.left.label [686714] = 答应{suitor}
# en: Friday with {suitor} is everything the note promised. On Saturday {other} passes you on the stairs with a smile that stops a little short of the eyes.
opt.left.say.1 [396855] = 和{suitor}的周五，和字条上许诺的一样好。周六，{other}在楼梯上与你擦肩而过，笑容还没到眼睛就停住了。
# en: Say yes to {other}
opt.right.label [88b7a4] = 答应{other}
# en: Friday with {other} runs late and warm. On Saturday {suitor} is very polite to you at breakfast, which is worse than if they'd been rude.
opt.right.say.1 [4809fb] = 和{other}的周五很晚才散，暖洋洋的。周六早餐时，{suitor}对你客客气气，比翻脸还难受。

@event jealousy_seen_together
# en: "Who Was That?"
title [8e9dfe] = “那是谁？”
# en: {suitor} saw you laughing with {other} in the courtyard yesterday, and is now asking about it too casually, in the voice people use when they've rehearsed. "You two looked… close. Not that it's any of my business."
text [f83a3f] = {suitor}昨天看见你在庭院里和{other}说说笑笑，现在正装作随口问起，用的是那种事先排练过的语气。“你们俩看起来……挺亲近的。当然，这不关我的事。”
# en: Two students talking by a window in a crowded common room, one of them asking a question too casually while looking at someone across the room.
scene [3f099c] = 拥挤的公共休息室里，两个学生在窗边说话，其中一个装作随口一问，眼睛却瞟着屋子另一头的人。
# en: Tell the truth: you like {other}
opt.left.label [093300] = 说实话：你喜欢{other}
# en: It lands like a dropped plate. {suitor} nods, and swallows, and thanks you for not pretending. It's the kindest thing you've done all week, and it doesn't feel kind at all.
opt.left.say.1 [9b3e8a] = 这话像一只摔碎的盘子。{suitor}点点头，咽了一下，谢谢你没有装傻。这是你这周做过最善良的事，却一点也不觉得善良。
# en: "Oh, we're just friends"
opt.right.label [8fedc9] = “哦，我们只是朋友”
# en: {suitor}'s shoulders come down an inch. You spend the rest of the evening together, and nobody mentions the courtyard again.
opt.right.say.1 [b90ca0] = {suitor}的肩膀放松了一寸。那天晚上剩下的时间你们一直在一起，谁也没再提庭院的事。
# en: It goes well, until word gets back to {other}, who hears "just friends" and decides to believe it.
opt.right.say.2 [0917cb] = 一切都好，直到话传到了{other}耳朵里。TA听到了“只是朋友”，决定当真。

@event jealousy_cold_supper
# en: A Quiet Supper
title [c2a4e7] = 沉默的晚饭
# en: {suitor} has gone quiet at supper, and answers in single words. From the far end of the hall, {other} is waving you over to an empty seat. You know exactly why {suitor} is quiet. So, by the look of it, does {other}.
text [c7f87d] = {suitor}晚饭时一言不发，问什么都只答一两个字。大厅另一头，{other}正招手让你过去，旁边有个空位。你很清楚{suitor}为什么沉默。看样子，{other}也很清楚。
# en: A long refectory table at supper, one student eating in pointed silence beside another, a third person waving from the far end of the hall.
scene [6a1477] = 晚饭时长长的膳堂餐桌，一个学生在另一个人身边刻意沉默地吃饭，大厅另一头有人在招手。
# en: Stay and talk it through
opt.left.label [5621eb] = 留下来把话说开
# en: A long walk after supper and a careful, clumsy conversation. {suitor} laughs at the end of it, which is something. At the far end of the hall, the empty seat stays empty.
opt.left.say.1 [16900d] = 晚饭后长长的散步，一场小心又笨拙的谈话。最后{suitor}笑了，总算有点什么。大厅那头的空位，一直空着。
# en: Take the seat {other} saved
opt.right.label [9c1575] = 坐到{other}留的位子上
# en: The seat is warm and so is {other}. Behind you, {suitor} finishes supper alone and leaves without the pudding, which everyone notices.
opt.right.say.1 [58b5f7] = 位子是暖的，{other}也是。你身后，{suitor}一个人吃完晚饭，连甜点都没吃就走了，所有人都看见了。
