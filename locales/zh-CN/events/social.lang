# Lumenhold Academy — 简体中文 (zh-CN) translation of content/events/social.grim
# Maintained by `node tools/grim.js i18n zh-CN`. Translate the text after "="; keep {tokens}.
# "# en:" shows the English source. [hash] marks the English version a line was translated from;
# lines marked STALE need updating — after fixing the text, delete the [hash] and re-run the tool.


@event soc_study_session
# en: Study Session
title [c13d4e] = 一起自习
# en: {npc} drops into the seat across from you with an armful of books. "Exams are coming for us all. Misery loves company. Study with me?"
text [e20c0b] = {npc}抱着一摞书一屁股坐到你对面。“考试要来收拾我们所有人了。同病相怜嘛。一起学？”
# en: Two students at a candlelit table piled with books, one explaining something with wild hand gestures.
scene [cb85c7] = 两个学生坐在堆满书的烛光桌前，其中一个正手舞足蹈地讲解着什么。
# en: You work better alone
opt.left.label [1f18da] = 你一个人效率更高
# en: You get a lot done. {npc} sits at the next table and sighs loudly every few minutes.
opt.left.say.1 [0d0d7f] = 你完成了很多。{npc}坐在隔壁桌，每隔几分钟就大声叹一口气。
# en: Pull up a chair
opt.right.label [d0a229] = 拉过一把椅子
# en: You get half as much done and remember twice as much of it. {npc} explains the Third Law with a biscuit diagram.
opt.right.say.1 [7cc537] = 你只完成了一半，却记住了两倍的内容。{npc}用饼干摆图讲解了第三定律。

@event soc_borrow_money
# en: A Small Loan
title [cd870f] = 一笔小借款
# en: {npc} turns out an empty purse. "I'm fifteen crowns short for rent. I'll pay you back. I swear on my wand."
text [d700eb] = {npc}把空空的钱袋翻了过来。“我房租还差十五克朗。我会还你的。我以我的魔杖发誓。”
# en: A student holding out an empty purse upside down with a sheepish grin.
scene [d2da5b] = 一个学生把空钱袋倒过来递给你看，脸上挂着不好意思的笑。
# en: Sorry, you're tight too
opt.left.label [d94071] = 抱歉，你也手头紧
# en: "No, of course, I understand." {They} {are} quiet at dinner.
opt.left.say.1 [e86862] = “不不，当然，我理解。”晚饭时{they}一直没怎么说话。
# en: Lend fifteen crowns
opt.right.label [0326cf] = 借十五克朗
# en: {npc} hugs you with the empty purse still in {their} hand.
opt.right.say.1 [995967] = {npc}抱住了你，手里还攥着那只空钱袋。
# en: {npc} hugs you. You suspect you will never see those fifteen crowns again.
opt.right.say.2 [506678] = {npc}抱住了你。你怀疑那十五克朗再也回不来了。

@event soc_loan_repaid
# en: Paid Back
title [ed4502] = 还钱
# en: {~{npc} finds you after class and presses a little stack of coins into your hand, plus a sticky bun. "Fifteen crowns. And interest." The interest is the bun.|{npc} turns up at breakfast with a small purse and a very straight face. "Fifteen crowns. I said I would."|{npc} slides fifteen crowns across the library table, one coin at a time. The last one has a note under it: "Thank you. Really."}
text [d1878a] = {~下课后{npc}找到你，往你手里塞了一小摞硬币，外加一个黏糊糊的小面包。“十五克朗。还有利息。”利息就是那个面包。|{npc}在早餐时出现，拿着一个小钱袋，一脸严肃。“十五克朗。我说过会还的。”|{npc}在图书馆的桌子上把十五克朗一枚一枚推到你面前。最后一枚下面压着一张字条：“谢谢你。真的。”}
# en: A small stack of coins and a sweet bun left on a desk with a thank-you note.
scene [a79734] = 桌上放着一小摞硬币和一个甜面包，旁边还有一张感谢字条。
# en: Count it
opt.left.label [5fce81] = 数一数
# en: You count it, because {they}'d be offended if you didn't. Fifteen exactly. {npc} nods, satisfied, as if a debt of honour has been settled.
opt.left.say.1 [3ec7dd] = 你数了一遍，因为不数的话{they}会觉得被冒犯。正好十五。{npc}满意地点点头，好像一笔关乎荣誉的债终于了结了。
# en: Pocket it without counting
opt.right.label [4b0d5d] = 不数就收下
# en: You put it away uncounted. {npc} looks quietly pleased to be trusted, which was worth more than the crowns.
opt.right.say.1 [997bc1] = 你没数就收了起来。{npc}看起来暗自高兴被你信任——这比那些克朗值钱多了。

@event soc_become_friends
# en: Something Like Friendship
title [68b938] = 类似友谊的东西
# en: {npc} saves you a seat without asking now, and you save {them} one. You trade notes, complaints and the last biscuit without keeping score. Somewhere along the way, this became a friendship.
text [013159] = 现在{npc}会不声不响地给你占座，你也给{them}占。你们交换笔记、牢骚和最后一块饼干，从不记账。不知从何时起，这已经成了一段友谊。
# en: Two students walking across the lawn at sunset, laughing at the same joke, shadows long behind them.
scene [ea4144] = 夕阳下两个学生穿过草坪，为同一个笑话大笑，身后拖着长长的影子。
# en: Keep a little distance
opt.left.label [37e0f8] = 保持一点距离
# en: You stay friendly. Just not too close. Some walls are load-bearing.
opt.left.say.1 [4470d5] = 你们保持友好。只是不太亲近。有些墙是承重墙。
# en: Call it what it is
opt.right.label [9f3cf3] = 挑明了说
# en: "So we're friends now," {npc} says. "Officially." You shake on it, solemnly, then ruin it by laughing.
opt.right.say.1 [eee457] = “那我们现在是朋友了，”{npc}说，“正式的。”你们郑重地握手，然后笑场毁掉了这份庄重。

@event soc_become_close
# en: The Kind of Friend You Call at 3am
title [e891f8] = 凌晨三点可以去敲门的那种朋友
# en: It's 3am. You can't sleep, and you've walked to {npc}'s door before you've even decided to. {They} open{s} it before you knock.
text [216ec9] = 凌晨三点。你睡不着，还没想好就已经走到了{npc}的门前。你还没敲门，{they}就把门打开了。
# en: Two friends sitting on a dormitory floor at 3am wrapped in one blanket, empty mugs between them.
scene [9f5741] = 凌晨三点，两个朋友裹着同一条毯子坐在宿舍地板上，中间摆着空杯子。
# en: Apologise and go back to bed
opt.left.label [f9def6] = 道个歉，回去睡觉
# en: "Don't be daft," {npc} says, but lets you go. In the morning there's tea outside your door.
opt.left.say.1 [5078b4] = “别傻了。”{npc}说，但还是让你走了。早上，你门外放着一杯茶。
# en: Talk until sunrise
opt.right.label [f5afa4] = 聊到日出
# en: You tell {them} things you haven't told anyone. {They} tell you things back. The sun comes up and neither of you notices.
opt.right.say.1 [c821d1] = 你告诉了{them}从没告诉过任何人的事。{they}也告诉了你{their}心事。太阳升起来了，你们谁都没注意到。

@event soc_secret
# en: A Secret
title [880a88] = 一个秘密
# en: {npc} pulls you under the stairs. "I need to tell someone or I'll burst. Swear you won't tell anyone. Not even the portraits."
text [556649] = {npc}把你拉到楼梯底下。“我得告诉一个人，不然我会憋炸的。发誓你谁也不说。连肖像画都不说。”
# en: Two students huddled under a staircase, one whispering into the other's ear, a finger to their lips.
scene [e33a93] = 两个学生挤在楼梯下，一个凑在另一个耳边低语，手指竖在唇边。
# en: "I'd rather not carry it."
opt.left.label [a4f5da] = “我宁愿不背这个包袱。”
# en: {npc} looks hurt, then relieved. "Maybe that's better." You'll never know.
opt.left.say.1 [8b5a46] = {npc}先是一脸受伤，然后松了口气。“也许这样更好。”你永远不会知道了。
# en: "I swear."
opt.right.label [381a0e] = “我发誓。”
# en: It's not a big secret. It's the kind that's only big to the person holding it. You hold it with {them}.
opt.right.say.1 [a21861] = 不是什么大秘密。是那种只对守着它的人来说很大的秘密。你陪{them}一起守着。

@event soc_argument
# en: Words Exchanged
title [260001] = 口角
# en: It starts with something small — a borrowed book, a joke that landed wrong — and suddenly you and {npc} are arguing in the corridor, louder than either of you intended.
text [4ede37] = 起因是件小事——一本借走的书，一个说错时机的玩笑——突然间你和{npc}就在走廊里吵了起来，嗓门比你们俩想的都大。
# en: Two students facing off in an empty corridor, one with arms crossed, the other mid-gesture, both flushed.
scene [935b50] = 两个学生在空荡的走廊里对峙，一个抱着双臂，另一个正比划着，两人都涨红了脸。
# en: Apologise first
opt.left.label [9f3966] = 先道歉
# en: "I'm sorry." {npc} deflates. "...Me too." It's over. It feels better than winning would have.
opt.left.say.1 [47bc55] = “对不起。”{npc}一下子泄了气。“……我也是。”结束了。这比吵赢了感觉更好。
# en: Stand your ground
opt.right.label [3881f5] = 坚持立场
# en: {npc} storms off. You were right. It doesn't feel as good as you'd hoped.
opt.right.say.1 [23d1ff] = {npc}气冲冲地走了。你是对的。可感觉并没有你希望的那么好。
# en: You argue it out until you're both laughing at how ridiculous it got. Somehow you're closer after.
opt.right.say.2 [16b2d4] = 你们一直吵到两个人都笑了出来，笑这事有多荒唐。不知怎么的，吵完反而更亲近了。

@event soc_village_trip
# en: A Day in the Village
title [1afb52] = 镇上一日
# en: "Barge to the village? Tea at Mabel's, a wander round the bookshops, back before curfew?" {npc} is already wearing {their} coat.
text [07e032] = “坐驳船去镇上吗？去梅布尔茶馆喝茶，逛逛书店，宵禁前回来？”{npc}已经穿好外套了。
# en: A cobbled village street with crooked shopfronts, two students sharing a paper cone of roasted nuts.
scene [743ea4] = 鹅卵石铺就的小镇街道，歪歪扭扭的店面，两个学生分享着一纸筒烤坚果。
# en: Not this week
opt.left.label [0fe3ce] = 这周不行
# en: {They} bring{s} you back a cinnamon bun anyway.
opt.left.say.1 [bce668] = {they}还是给你带回来一个肉桂卷。
# en: Grab your coat
opt.right.label [b14325] = 抓起外套
# en: Tea, buns, a bookshop cat that sits on {npc}'s feet. You almost miss the last barge, laughing.
opt.right.say.1 [fca757] = 喝茶，吃面包，书店的猫趴在{npc}脚上。你们笑着差点错过最后一班驳船。

@event soc_friend_sick
# en: Sick Friend
title [ac406d] = 生病的朋友
# en: {npc} has Lake Fever and is miserable in the infirmary. Sister Amaranth says visitors are allowed, but she won't be responsible.
text [0a1413] = {npc}得了湖热病，在医务室里难受得要命。阿玛兰斯修女说可以探视，但出了事她不负责。
# en: A student tucked into an infirmary bed under a mountain of blankets, a friend sitting beside them with a bowl of soup.
scene [43529f] = 一个学生被埋在医务室病床的一堆毯子底下，一位朋友端着一碗汤坐在床边。
# en: Send a card
opt.left.label [72cab2] = 送张卡片
# en: You send a card with a drawing of Sister Amaranth as a dragon. {npc} keeps it on {their} bedside table.
opt.left.say.1 [eae564] = 你送了一张卡片，上面画着变成了龙的阿玛兰斯修女。{npc}把它摆在床头柜上。
# en: Sit with them every evening
opt.right.label [09fda2] = 每晚都去陪着
# en: You keep {them} company for a week. Then you're in the next bed. You both find this hilarious.
opt.right.say.1 [8c2cc5] = 你陪了{them}一个星期。然后你住进了隔壁床。你们俩都觉得这太好笑了。
# en: You read aloud, badly, doing voices. {npc} recovers and claims it was the voices.
opt.right.say.2 [55eed3] = 你给{them}念书，念得很烂，还学各种腔调。{npc}康复后坚称是那些腔调治好了{them}。

@event soc_gift_given
# en: A Small Gift
title [9dafb3] = 一件小礼物
# en: There's a small parcel on your pillow. A note in {npc}'s handwriting: "Saw this and thought of you. Don't make it weird."
text [1d6ca6] = 你的枕头上放着一个小包裹。附着一张{npc}字迹的字条：“看见这个就想到了你。别想太多。”
# en: A small wrapped parcel tied with ribbon left on a dormitory pillow, a pressed flower tucked into the bow.
scene [5a37d3] = 宿舍枕头上一个系着丝带的小包裹，蝴蝶结里夹着一朵压花。
# en: Thank {them} later
opt.left.label [a0fa69] = 回头再谢{them}
# en: It's a tiny brass compass that always points to the nearest teapot. You use it constantly.
opt.left.say.1 [0451b8] = 是一个小小的黄铜罗盘，永远指向最近的茶壶。你天天都在用。
# en: Get {them} something back (8 gold)
opt.right.label [42a27b] = 回赠一份礼物（8 金币）
# en: You find {them} a book {they}'d wanted for months. {npc}'s face when {they} open{s} it is worth twice the price.
opt.right.say.1 [3ade33] = 你找到了一本{they}想要了好几个月的书。{npc}打开时的表情，值两倍的价钱。

@event soc_drift
# en: Drifting Apart
title [73c51a] = 渐行渐远
# en: You realise you haven't really talked to {npc} in weeks. You see {them} across the courtyard, laughing with people you don't know.
text [17b0c4] = 你发现自己已经好几周没好好跟{npc}说过话了。你看见{them}在庭院那头，和一群你不认识的人说笑。
# en: A student glancing back across a busy courtyard at another who hasn't seen them, the space between them full of strangers.
scene [e8800d] = 一个学生回头望向熙攘庭院另一端没看见自己的人，两人之间隔满了陌生人。
# en: Let it be
opt.left.label [71cc4c] = 顺其自然
# en: People drift. It's nobody's fault. You still smile when you pass in the halls.
opt.left.say.1 [8a48fa] = 人总会渐行渐远。不是谁的错。在走廊里擦肩而过时，你们仍会微笑。
# en: Go over and say hello
opt.right.label [cdae69] = 走过去打个招呼
# en: "There you are!" {npc} says, as if you'd been the one missing. Maybe you had.
opt.right.say.1 [1d0cee] = “你在这儿呀！”{npc}说，好像失踪的人是你。也许确实是。
# en: You go over. It is friendly, and short, and you both say "we should catch up" in a way that means you won't.
opt.right.say.2 [46fd68] = 你走过去。气氛很友好，也很短，你们都说了句“改天聚聚”，那语气意味着不会有改天。

@event soc_rumour
# en: Rumours About {npc}
title [e3d846] = 关于{npc}的流言
# en: A nasty rumour about {npc} is going round the common room. It's not true. You know it's not true. People are laughing.
text [bf28b6] = 公共休息室里流传着一条关于{npc}的恶毒流言。不是真的。你知道不是真的。大家在笑。
# en: A cluster of students whispering behind their hands in a corridor, glancing toward someone just out of view.
scene [78a3d1] = 一群学生在走廊里捂着嘴窃窃私语，朝视线外的某个人瞟去。
# en: Let it blow over
opt.left.label [962dcd] = 等它自己平息
# en: It blows over. {npc} never finds out you heard it. Probably.
opt.left.say.1 [fd8345] = 它平息了。{npc}永远不会知道你听到过。大概吧。
# en: Shut it down
opt.right.label [e3e364] = 当场制止
# en: You make the rumour-monger look so foolish that the story dies on the spot. {npc} hears about it later and just squeezes your arm.
opt.right.say.1 [78c724] = 你让造谣的人出尽洋相，流言当场就死了。{npc}后来听说了，只是轻轻捏了捏你的胳膊。
# en: You make a scene and now there are rumours about you too. {npc} thinks you're an idiot. A loyal idiot.
opt.right.say.2 [ea7565] = 你大闹了一场，现在也有关于你的流言了。{npc}觉得你是个傻瓜。一个忠诚的傻瓜。

@event soc_homework_help
# en: Desperate Homework
title [b925b8] = 作业告急
# en: {npc} waves a half-finished essay at you. "It's due in an hour and I've written the title twice. Help."
text [600d7a] = {npc}朝你挥着一篇写了一半的论文。“一小时后就要交了，我只把标题写了两遍。救命。”
# en: A student with ink on their face clutching a half-finished essay, another student leaning over to read it.
scene [d955d2] = 一个脸上沾着墨水的学生攥着一篇半成品论文，另一个学生凑过来看。
# en: Explain the concept
opt.left.label [d8e8f3] = 讲解知识点
# en: You explain it so clearly that {npc} finishes the essay with time to spare. {They} insist{s} you're a genius.
opt.left.say.1 [cf80f6] = 你讲得清清楚楚，{npc}提前写完了论文。{they}坚称你是个天才。
# en: You explain it so confusingly that you both end up more lost. You hand it in together, two confused people against the world.
opt.left.say.2 [a0a001] = 你讲得一团乱麻，两个人都更糊涂了。你们一起交了上去——两个糊涂人对抗全世界。
# en: "Copy mine."
opt.right.label [b2d7d3] = “抄我的吧。”
# en: The professor notices two identical essays. You both get detention, and a lecture.
opt.right.say.1 [bd43e1] = 教授发现了两篇一模一样的论文。你们俩都被关了禁闭，还挨了一顿训。
# en: {npc} hands it in and gets a better mark than you did. Unbelievable.
opt.right.say.2 [c22ac9] = {npc}交了上去，分数比你还高。难以置信。

@event soc_faculty_advice
# en: A Word of Advice
title [594b8b] = 一句忠告
# en: {npc} catches you after a lecture. "You've been working hard. Or hardly working. I can never tell with your year. Some advice, if you'll take it?"
text [890d50] = 讲座结束后{npc}叫住了你。“你一直很用功。或者说一直很用‘空’。你们这一届我总是分不清。给你点建议，听不听？”
# en: A professor walking with a student along a covered walkway, pointing at something in an open book.
scene [41385c] = 一位教授和一名学生沿着有顶棚的步道走着，指着一本摊开的书里的某处。
# en: Politely decline
opt.left.label [8a601d] = 礼貌地拒绝
# en: "Suit yourself." {They} walk{s} off. Faculty have long memories.
opt.left.say.1 [19801b] = “随你。”{they}走开了。教职员的记性可都很好。
# en: Listen carefully
opt.right.label [1b6b4d] = 认真听
# en: It's good advice. Annoyingly good. Your next essay is better for it.
opt.right.say.1 [aeda53] = 是好建议。好得让人恼火。你的下一篇论文因此进步了不少。

@event soc_spark
# en: A Spark
title [21e629] = 火花
# en: You reach for the same quill as {npc}. Your hands touch. Neither of you lets go immediately. It's a perfectly ordinary quill.
text [563401] = 你和{npc}同时伸手去拿同一支羽毛笔。你们的手碰到了。谁也没有马上松开。那只是一支再普通不过的羽毛笔。
# en: Two hands brushing as they reach for the same quill, both students freezing for a heartbeat.
scene [d87696] = 两只手在伸向同一支羽毛笔时轻轻相触，两个学生都愣了一拍。
# en: Laugh it off
opt.left.label [29c02a] = 一笑了之
# en: "All yours," you say. {npc} laughs. The moment passes. Mostly.
opt.left.say.1 [134287] = “你用吧。”你说。{npc}笑了。那一刻过去了。大体上。
# en: Hold on a moment longer
opt.right.label [04d88b] = 多握一会儿
# en: {npc} looks up. Something in {their} face shifts. Then {they} let{s} go, a little pink, and the quill rolls under the desk.
opt.right.say.1 [6bf6bf] = {npc}抬起头。{their}脸上有什么东西变了。然后{they}松开了手，脸有点红，羽毛笔滚到了桌子底下。
# en: {npc} pulls back as if burned, and the rest of the lesson is very, very awkward.
opt.right.say.2 [cb9381] = {npc}像被烫到一样缩回了手，那节课剩下的时间尴尬得要命。

@event soc_date
# en: An Invitation
title [aba1c1] = 一次邀约
# en: You could ask {npc} to the lantern show in the village this weekend. As friends. Or, you know. Not as friends.
text [ec7b1b] = 你可以邀请{npc}这个周末去镇上看灯笼表演。以朋友的身份。或者，你懂的。不只是朋友。
# en: A student nervously holding out a hand-drawn ticket to the village's floating lantern show.
scene [57c131] = 一个学生紧张地递出一张手绘的小镇浮灯表演门票。
# en: Ask as friends
opt.left.label [bd7c43] = 以朋友身份邀请
# en: It's a lovely evening. You're both very careful about elbows.
opt.left.say.1 [692d15] = 那是个美好的夜晚。你们俩都非常小心地不碰到对方的胳膊肘。
# en: Ask as more than friends
opt.right.label [e73a1b] = 以不只是朋友的身份邀请
# en: {npc} says yes before you finish the sentence. You hold hands through the whole show and miss every lantern.
opt.right.say.1 [ccf6c4] = 你话还没说完{npc}就答应了。整场表演你们都牵着手，一盏灯笼也没看见。
# en: {npc} hesitates, then says {they}'d rather go as friends. It's a nice evening. It's a long evening.
opt.right.say.2 [097e94] = {npc}犹豫了一下，说还是以朋友的身份去吧。那是个不错的夜晚。也是个漫长的夜晚。
# en: {npc} says yes before you finish the sentence. You hold hands through the whole show and miss every lantern.
opt.right.say.3 [ccf6c4] = 你话还没说完{npc}就答应了。整场表演你们都牵着手，一盏灯笼也没看见。
# en: {npc} hesitates, then says {they}'d rather go as friends. It's a nice evening. It's a long evening.
opt.right.say.4 [097e94] = {npc}犹豫了一下，说还是以朋友的身份去吧。那是个不错的夜晚。也是个漫长的夜晚。

@event soc_confess_generic
# en: Feelings, Spoken
title [0fdaae] = 说出口的心意
# en: On the bridge between the towers, the wind snatching at your robes, you realise you can't keep it in anymore. {npc} is looking at you like {they} know what you're about to say.
text [0fb936] = 在塔楼之间的桥上，风扯着你的长袍，你意识到自己再也藏不住了。{npc}看着你，好像已经知道你要说什么。
# en: Two students standing very close on a windswept bridge between towers, one with a hand over their heart.
scene [80f257] = 两个学生紧挨着站在塔楼之间风大的桥上，其中一人手按在心口。
# en: Say nothing
opt.left.label [d1151d] = 什么也不说
# en: The moment passes. You walk back together, a careful inch apart.
opt.left.say.1 [8f2183] = 那一刻过去了。你们一起往回走，小心地隔着一寸距离。
# en: Tell {them}
opt.right.label [3c60a0] = 告诉{them}
# en: "Finally," {npc} says, and kisses you, and the wind steals your breath anyway.
opt.right.say.1 [bdde21] = “终于说了。”{npc}说着吻了你，而风依旧夺走了你的呼吸。
# en: {npc} takes a long breath. "I care about you," {they} say{s}. "Just not like that. I'm sorry." The wind is very cold.
opt.right.say.2 [fe43d9] = {npc}深吸了一口气。“我在乎你，”{they}说，“只是不是那种在乎。对不起。”风很冷。

@event soc_partner_date
# en: Date Night
title [b6d8e3] = 约会之夜
# en: {npc} has booked the window table at Mabel's. Candles. Snow outside. "We're splitting the bill," {they} say{s}. "Don't argue."
text [cdc59b] = {npc}订了梅布尔茶馆靠窗的位子。蜡烛。窗外飘着雪。“这顿我们平摊，”{they}说，“别跟我争。”
# en: Two people at a tiny candlelit table in a window alcove of a village tea shop, snow falling outside.
scene [7b9157] = 小镇茶馆窗边凹室里一张小小的烛光桌，两个人对坐，窗外飘着雪。
# en: Talk about the future
opt.left.label [4d8f04] = 聊聊未来
# en: You talk about where you'll be in ten years. In every version, you're both there.
opt.left.say.1 [c75a7f] = 你们聊起十年后会在哪里。每一个版本里，你们俩都在。
# en: Talk about absolutely nothing
opt.right.label [75d2d9] = 聊些完全没用的事
# en: You argue for an hour about whether a hotdog is a sandwich. It is the best date of your life.
opt.right.say.1 [3c61e8] = 你们争论了一个小时热狗到底算不算三明治。这是你这辈子最棒的一次约会。

@event soc_partner_neglect
# en: "You're Always Busy"
title [46e97c] = “你总是很忙”
# en: {npc} is waiting outside your door. "I feel like I only see you in corridors," {they} say{s}. "Do you even want this?"
text [0e3f61] = {npc}等在你门外。“我觉得我只能在走廊里见到你，”{they}说，“你到底还想不想要这段感情？”
# en: A person waiting alone at a table set for two, a candle burned low, the other chair empty.
scene [b603a7] = 一个人独自坐在摆好两人份餐具的桌前，蜡烛快燃尽了，另一把椅子空着。
# en: "I'm sorry. I'll make time."
opt.left.label [b59fcc] = “对不起。我会挤出时间的。”
# en: You skip a study session for a long walk by the lake. It's the right call.
opt.left.say.1 [8a05e5] = 你翘掉一次自习，陪{them}在湖边走了很久。这个决定是对的。
# en: "You know how busy I am."
opt.right.label [a60981] = “你知道我有多忙。”
# en: {npc} nods slowly. Something between you cools a degree.
opt.right.say.1 [2bc62a] = {npc}缓缓点了点头。你们之间的什么东西，冷了一度。

@event soc_breakup
# en: The End of Something
title [179272] = 某件事的结束
# en: {npc} sits down at the far end of the bench. "I think we both know," {they} say{s} quietly. "This isn't working anymore."
text [c059c0] = {npc}在长椅的另一头坐下。“我想我们都心知肚明，”{they}轻声说，“这已经行不通了。”
# en: Two people sitting on opposite ends of a bench in a grey garden, not looking at each other, rain beginning.
scene [4b79cd] = 灰蒙蒙的花园里，两个人坐在长椅两端，谁也不看谁，开始下雨了。
# en: Fight for it
opt.left.label [7ed077] = 争取一下
# en: You talk for hours. It's raw and honest and it hurts. And at the end, {npc} takes your hand again.
opt.left.say.1 [207908] = 你们谈了几个小时。赤裸、坦诚，而且很痛。最后，{npc}又握住了你的手。
# en: You try. It only makes it harder. In the end you're both crying, and it's over anyway.
opt.left.say.2 [2de21e] = 你努力了。却只让一切更难。最后你们都哭了，而它终究还是结束了。
# en: Let {them} go
opt.right.label [185a66] = 放{them}走
# en: You agree. It's terrible and gentle and right. {npc} kisses your forehead once before {they} leave{s}.
opt.right.say.1 [e0897b] = 你同意了。这很糟糕，很温柔，也很对。{npc}离开前在你额头上吻了一下。

@event soc_two_timing
# en: Found Out
title [f1af67] = 东窗事发
# en: {npc} is holding two letters. One is to {them}. The other isn't. "I found it in your bag," {they} say{s}, very quietly. Half the corridor has stopped to watch.
text [b63ccd] = {npc}手里拿着两封信。一封是写给{them}的。另一封不是。“我在你包里找到的，”{they}说，声音很轻。半条走廊的人都停下来看着。
# en: A person holding up two crumpled love letters in a crowded corridor, the crowd parting around them.
scene [28e97e] = 拥挤的走廊里，一个人举着两封揉皱的情书，人群在他们周围分开。
# en: Beg forgiveness
opt.left.label [b42d94] = 乞求原谅
# en: {npc} doesn't forgive you. But {they} don't leave. Not yet. You're on borrowed time.
opt.left.say.1 [27d6d1] = {npc}没有原谅你。但{they}也没有离开。暂时没有。你在借来的时间里过日子。
# en: {npc} tears both letters in half and walks away. Everyone knows by dinner.
opt.left.say.2 [3f568e] = {npc}把两封信都撕成两半，转身离开。晚饭时所有人都知道了。
# en: Say nothing
opt.right.label [d1151d] = 一言不发
# en: Your silence is an answer. {npc} drops the letters at your feet and leaves. The story is all over the academy.
opt.right.say.1 [855b96] = 你的沉默就是答案。{npc}把信扔在你脚边，走了。这件事传遍了整个学院。

@event soc_ex_encounter
# en: Awkward
title [8ea9c0] = 尴尬
# en: You turn into the library aisle and there's {npc}. Your ex. Holding the same book you came for. Neither of you moves.
text [320159] = 你拐进图书馆的一条过道，{npc}就在那儿。你的前任。手里拿着你正要找的那本书。你们谁也没动。
# en: Two people coming face to face in a narrow library aisle, both holding books, neither moving.
scene [0292af] = 两个人在图书馆狭窄的过道里迎面相遇，手里都拿着书，谁也没动。
# en: Turn around and leave
opt.left.label [a746c5] = 转身离开
# en: You find a different book in a different aisle and read the same paragraph six times.
opt.left.say.1 [a75b45] = 你在另一条过道找了另一本书，把同一段读了六遍。
# en: Say hello like a person
opt.right.label [06a265] = 像个正常人一样打招呼
# en: It's awkward for one minute, then it isn't. You end up laughing about the time the dummy caught fire. Friends, maybe. Really.
opt.right.say.1 [9dcf0b] = 尴尬了一分钟，然后就不尴尬了。你们最后笑着聊起那次假人着火的事。也许能做朋友。真的。
# en: "Hello." "Hello." You both stand there. Then you both leave. It's a start.
opt.right.say.2 [f4910b] = “你好。”“你好。”你们俩站在那儿。然后各自离开。算是个开始。

@event soc_rival_taunt
# en: A Public Taunt
title [0b1cd5] = 当众嘲讽
# en: In the middle of dinner, {npc} loudly recounts your most embarrassing moment of the term. People laugh. {They} look{s} very pleased.
text [2c1a0a] = 晚饭吃到一半，{npc}大声讲起你这学期最丢人的一幕。大家都笑了。{they}看起来非常得意。
# en: A smirking student surrounded by a small audience, pointing at someone across a crowded dining hall.
scene [fc4e76] = 一个得意洋洋的学生被一小群观众围着，隔着拥挤的餐厅指向某人。
# en: Ignore {them}
opt.left.label [c17487] = 不理{them}
# en: The laughter dies down. You eat your soup with as much dignity as soup allows.
opt.left.say.1 [4234da] = 笑声渐渐平息。你以喝汤所能允许的最大尊严喝完了汤。
# en: Fire back
opt.right.label [edc214] = 反唇相讥
# en: Your comeback is so good that someone at the far table applauds. {npc} goes scarlet.
opt.right.say.1 [e2e5b5] = 你的回击太漂亮了，远处那桌有人鼓起掌来。{npc}满脸通红。
# en: Your comeback comes out as a squeak. The laughter doubles.
opt.right.say.2 [992f30] = 你的回击变成了一声尖叫。笑声翻了一倍。

@event soc_make_peace
# en: Burying the Hatchet
title [91164f] = 握手言和
# en: {npc} finds you after class, scuffing {their} shoes. "This whole rivalry thing. It's getting tiring. Truce?"
text [d5620e] = 下课后{npc}找到你，鞋尖蹭着地面。“这整个当对手的事儿。有点累了。休战？”
# en: Two former rivals shaking hands on a dueling green at sunset, wands tucked away.
scene [f9c463] = 夕阳下的决斗草坪，两个昔日对手收起魔杖握手。
# en: Keep the edge
opt.left.label [a15600] = 保持锋芒
# en: "Thought so," {npc} says, half-smiling. The game goes on.
opt.left.say.1 [4e5e1c] = “我就知道。”{npc}半笑着说。较量继续。
# en: Shake on it
opt.right.label [982713] = 握手为定
# en: You shake. It's strange — you know {them} better than most of your friends. Maybe that's the point.
opt.right.say.1 [e1ff36] = 你们握了手。说来奇怪——你对{them}的了解，比对大多数朋友都深。也许这正是意义所在。

@event soc_rival_bet
# en: The Wager
title [5a804e] = 赌约
# en: "Eight crowns says I outscore you in the next Arcana practical," {npc} says, slapping coins on the table. A crowd forms.
text [2cae36] = “八克朗，赌下次奥术实践课我分数比你高。”{npc}把硬币拍在桌上。一群人围了过来。
# en: Two students slapping coins onto a table between them, a crowd gathering, a chalked tally on the wall.
scene [8dd838] = 两个学生把硬币拍在中间的桌上，人群聚拢，墙上用粉笔记着比分。
# en: Decline the bet
opt.left.label [99b979] = 不赌
# en: "Thought so." {npc} pockets the coins. You decide not to care. You care.
opt.left.say.1 [556d0b] = “我就知道。”{npc}收起了硬币。你决定不在乎。你很在乎。
# en: Take the bet
opt.right.label [8a4d52] = 接下赌约
# en: You win by a hair. {npc} pays up with a theatrical bow. "Next time."
opt.right.say.1 [e1aac3] = 你以毫厘之差赢了。{npc}夸张地鞠了一躬，付了钱。“下次再说。”
# en: You lose by a hair. "Next time," you say. {npc} grins. "Next time."
opt.right.say.2 [8023a9] = 你以毫厘之差输了。“下次再说。”你说。{npc}咧嘴一笑。“下次再说。”
