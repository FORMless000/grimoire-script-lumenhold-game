# Lumenhold Academy — 简体中文 (zh-CN) translation of content/events/spell_uses.grim
# Maintained by `node tools/grim.js i18n zh-CN`. Translate the text after "="; keep {tokens}.
# "# en:" shows the English source. [hash] marks the English version a line was translated from;
# lines marked STALE need updating — after fixing the text, delete the [hash] and re-run the tool.


@event mabels_cold_range
# en: The Cold Range
title [e9bf9f] = 冷掉的炉灶
# en: {No steam on Mabel's windows, and no smell of toast. The range behind the counter has gone out, and a queue of students in scarves is stamping its feet. "No tea till it's lit, petal," says Mabel, rattling the grate.|The range is out again: the flue sulks in a north wind. Mabel looks at the queue, then at you, then at the coal bucket.|Mabel's range, cold again, and Mabel in front of it with a twist of paper. "It knows you now," she says. "Talk to it."}
text [a59fcf] = {梅布尔茶馆的窗上没有水汽，也闻不到烤面包的香味。柜台后的炉灶熄了，围着围巾的学生排成一队，直跺脚。“炉子不点着就没有茶，小宝贝。”梅布尔一边说，一边哐哐地摇炉栅。|炉灶又熄了：北风一刮，烟道就闹脾气。梅布尔看看队伍，看看你，又看看煤桶。|梅布尔的炉灶又冷了，梅布尔捏着一卷纸捻站在它跟前。“它现在认得你了，”她说，“跟它说说话。”}
# en: A village tea shop on a cold day, its iron range out, a queue of students in scarves, a woman on her knees at the grate.
scene [9ca5e2] = 一间山下小镇的茶馆，天气寒冷，铁炉灶熄了火，围着围巾的学生排着队，一个女人跪在炉栅前。
# en: Fetch coal from the yard
opt.left.label [503113] = 去院子里搬煤
# en: {You haul two buckets in from the frozen yard. When the kettle finally sings, Mabel pours yours first and waves your coins away.|Two buckets, one dropped on your foot. The range catches on the third try, and Mabel puts a scone by your cup, "for the foot".|You fetch the coal without being asked. Mabel tells the queue you're "staff, near enough", and makes you carry the milk.}
opt.left.say.1 [257ca7] = {你从冻硬的院子里拎回两桶煤。水壶终于响起来时，梅布尔先给你倒了一杯，摆摆手不收你的钱。|两桶煤，一桶砸在了你脚上。炉子试到第三次才着，梅布尔在你杯子旁放了一块司康饼，“给你的脚”。|没人开口，你就去搬了煤。梅布尔跟排队的人说你“差不多算店里的人了”，然后让你去端牛奶。}
# en: Read in the cold till it's lit
opt.right.label [24c390] = 冻着读书，等它点着
# en: {You read a chapter in your coat while the queue grumbles. By the time the tea comes your fingers can't turn the page.|You read by the cold window. The chapter is good; the draught under the door is better at its job.|Coat on, book open, breath fogging. You learn a great deal and feel your toes rather less.}
opt.right.say.1 [afafa8] = {你裹着外套读完一章，队伍在旁边抱怨。等茶端上来，你的手指已经冻得翻不动书页了。|你靠着冰冷的窗户读书。这一章写得很好；门缝底下的穿堂风干活更卖力。|外套穿着，书摊着，呵出白气。你学到了很多，也渐渐感觉不到脚趾了。}
# en: Light it with a finger
opt.up.label [2bfc60] = 用手指点着它
# en: {You lean over the counter and touch the coals. The range roars, the queue cheers, and Mabel calls you "a useful sort of petal" for the rest of the term.|A flick, and the flue draws like a chimney in a storybook. Mabel pours your cup first and doesn't charge, "for services to tea".|{spell_level(flame) >= 2: You light the range and the lamps and the kettle's underside, one, two, three. Mabel applauds with the tea towel.|You light it before Mabel has finished asking. She gives you a look that's half thanks, half "show-off".}}
opt.up.say.1 [70ef09] = {你探身越过柜台，碰了碰煤块。炉火轰地一声烧起来，排队的人一片欢呼，梅布尔这一整个学期都叫你“有用的小宝贝”。|手指一弹，烟道就像故事书里的烟囱一样呼呼抽起风来。梅布尔先给你倒茶，不收钱，“算你对茶事有功”。|{spell_level(flame) >= 2: 你点着了炉灶，又点着了灯，再点着水壶底下，一、二、三。梅布尔挥着茶巾给你鼓掌。|梅布尔还没开口，你就把它点着了。她看你的眼神一半是谢意，一半是“显摆”。}}

@event boathouse_damp_stove
# en: The Damp Stove
title [c554df] = 受潮的炉子
# en: {A rowing crew comes in off the lake soaked to the skin, laughing through chattering teeth. The boathouse stove is cold, and the kindling basket is wet through.|The crew again, wetter than last time: someone caught a crab and took the boat over. The kindling has been left out in the rain, as usual.|Another soaking. The crew have started looking at you when they come in, and then at the stove.}
text [27f52a] = {一支划船队从湖上回来，浑身湿透，牙齿打着颤还在笑。船屋的炉子是冷的，引火柴的篮子也湿透了。|又是那支船队，比上次还湿：有人一桨没划好，把船弄翻了。引火柴照例被扔在外头淋了雨。|又一次落汤鸡。船队现在一进门就先看你，再看炉子。}
# en: A wooden boathouse at dusk, a rowing crew dripping and shivering around a cold iron stove, wet kindling steaming in a basket.
scene [f9bbd4] = 黄昏时的木船屋，划船队的人滴着水，围着冰冷的铁炉子发抖，篮子里的湿引火柴冒着潮气。
# en: Run to the boatman's loft for dry wood
opt.left.label [536a8a] = 跑去船夫的阁楼拿干柴
# en: {You run up to the loft and back with an armful of dry wood. By the time the stove's going you're as wet as they are, from the sweat.|The loft ladder, in the dark, with an armful of wood. You make it. The crew make room for you on the bench.|The loft ladder is the worst part. The crew cheer you down it like a returning hero.}
opt.left.say.1 [04ef44] = {你跑上阁楼，抱着一捆干柴跑回来。等炉子烧旺了，你跟他们一样湿，是汗湿的。|黑灯瞎火的阁楼梯子，怀里抱着一捆柴。你成功了。船队在长凳上给你挪出个位子。|最难的是阁楼那架梯子。你从梯子上下来时，船队像迎接凯旋的英雄一样欢呼。}
# en: Lend your scarf and leave them to it
opt.right.label [5d5e5c] = 借出围巾，让他们自己想办法
# en: {You give your scarf to the one with blue lips and walk back up to the castle with a cold neck. You'll get the scarf back. Probably.|You hand round your scarf and your sympathy and leave them to it. The scarf comes back a week later, smelling of lake.|Scarf, a joke, and goodnight. They wave you off, still shivering, still laughing.}
opt.right.say.1 [7d77ce] = {你把围巾给了嘴唇发紫的那个，自己缩着冷脖子走回城堡。围巾会还回来的。大概吧。|你把围巾和同情都分了出去，让他们自己想办法。一周后围巾还回来了，一股湖水味。|一条围巾，一句玩笑，一声晚安。他们挥手送你，还在发抖，还在笑。}
# en: Dry the kindling with a flame
opt.up.label [ebf123] = 用火烘干引火柴
# en: {You hold a flame under the wet kindling until it steams, then catches. The crew crowd the stove and somebody's lake-cold hand finds your shoulder in thanks.|A flame, coaxed small and patient, and the kindling catches in a fizz of steam. The crew name the stove after you. It's not a compliment, exactly.|You dry the whole basket in one long breath of fire. The crew offer you a seat in the boat next week. You decline, warmly.}
opt.up.say.1 [fd1004] = {你在湿柴底下托着一团火，直到它冒出白汽，然后着了。船队挤到炉子边，不知谁湖水般冰凉的手搭上你的肩头，算是道谢。|一团火，耐着性子哄得小小的，引火柴嘶的一声冒着蒸汽燃了起来。船队用你的名字给炉子命了名。严格说来，这不太算是夸奖。|你长长呼出一口火，把整篮柴都烘干了。船队邀你下周坐他们的船。你热情地婉拒了。}

@event secret_garden_late_frost
# en: A Hard Frost
title [73a497] = 一场重霜
# en: {A hard frost is coming down out of a clear sky. Old Maud is going along the row of clay smudge pots under the humming pear with a tinderbox that won't strike. "Every one, dearie," she says, "or the old pear sulks for a month."|Frost again. The pear has gone quiet, which Maud says is how it shivers.|The smudge pots are set out before you arrive. Maud has left a second tinderbox on the wall, for you.}
text [93be83] = {晴空万里，一场重霜正降下来。老莫德拿着一只怎么也打不着的火绒盒，沿着嗡鸣梨树下那排陶制熏烟罐挨个走。“每一个都要点，亲爱的，”她说，“不然这棵老梨树要闹一个月脾气。”|又下霜了。梨树不哼了，莫德说，这是它在打哆嗦。|你到的时候熏烟罐已经摆好了。莫德在墙头给你留了第二只火绒盒。}
# en: A hidden garden on a clear, freezing evening, the humming pear tree, a row of unlit clay pots and an old woman with a tinderbox.
scene [70d1a8] = 一个隐秘的花园，晴朗而冰冷的傍晚，嗡鸣的梨树，一排没点着的陶罐，一位拿着火绒盒的老妇人。
# en: Light the pots with a tinderbox
opt.left.label [54b74c] = 用火绒盒点罐子
# en: {Forty pots, a tinderbox and numb fingers. The last one catches as the frost comes down, and the pear starts humming again, low and grateful.|You light pot after pot on your knees in the frost. Maud brings you something hot in a chipped cup and doesn't say what it is.|You light your half of the row before Maud lights hers, and she pretends to be cross about it.}
opt.left.say.1 [e51b90] = {四十个罐子，一只火绒盒，冻僵的手指。霜降下来时最后一个罐子着了，梨树又哼了起来，低低的，满怀感激。|你跪在霜地里一个接一个地点罐子。莫德用一只缺了口的杯子给你端来一杯热的东西，没说那是什么。|你抢在莫德之前点完了你那半排，她装作生气。}
# en: Wrap the low branches in sacking
opt.right.label [d4c741] = 用麻袋裹住低处的树枝
# en: {You climb into the lower branches and wrap what you can reach. It isn't all of it. Maud says some is a lot more than none.|Sacking, string and a ladder that leans the wrong way. You save the low branches; the top will have to take its chances.|You wrap the branches like presents. Maud says the pear will remember, and she says it as if pears do.}
opt.right.say.1 [292830] = {你爬上低处的枝杈，够得着的地方都裹上了。不是全部。莫德说，有一些可比什么都没有强多了。|麻袋、绳子，还有一架歪向错误方向的梯子。你保住了低处的枝条，高处的只好听天由命。|你像包礼物一样把树枝裹好。莫德说梨树会记得的，说得好像梨树真会记事。}
# en: Light every pot at once
opt.up.label [134f29] = 一口气点亮所有罐子
# en: {You hold out your hand and every pot in the row blooms at once, a line of small suns in the frost. Maud laughs, which you've never heard her do so loudly.|One breath, forty flames. The pear hums so loudly the bees come out to see. "Well," says Maud. "Aren't you handy."|{spell_level(flame) >= 3: You light the pots and hold the warmth over the whole tree like a hand. Not one bud browns. Maud says she'll name a pear after you, and does.|You light the row in two breaths. Maud says it took her forty years to learn to do it with a tinderbox, and she isn't sure which of you to be proud of.}}
opt.up.say.1 [47e39d] = {你伸出手，整排罐子一齐绽开火光，霜夜里排起一列小小的太阳。莫德笑出了声，你从没听她笑得这么响。|一口气，四十团火。梨树哼得那么响，连蜜蜂都飞出来看。“好嘛，”莫德说，“你还真顶用。”|{spell_level(flame) >= 3: 你点着罐子，又把暖意像一只手似的罩住整棵树。一个花苞都没冻焦。莫德说要用你的名字给一只梨命名，后来真这么做了。|你两口气点完了一整排。莫德说她花了四十年才学会用火绒盒干这活，现在都不知道该为谁骄傲。}}

@event refectory_tipping_tray
# en: The Tipping Tray
title [636073] = 要翻的托盘
# en: {A first-year is coming down the aisle with a tray of eight soup bowls stacked like a tower, and a bench leg is sticking out right where they'll step.|The same first-year, a bigger tray, a different bench leg. Some people never learn; some benches don't either.|The tray, the first-year, the bench. You can almost hear the crash before it happens.}
text [e806f5] = {一个一年级生端着八碗汤叠成的高塔沿过道走来，而一条长凳腿正好伸在TA要落脚的地方。|还是那个一年级生，更大的托盘，换了一条凳子腿。有些人永远学不乖；有些凳子也是。|托盘、一年级生、长凳。你几乎能提前听见那声巨响。}
# en: A crowded dining hall, a first-year carrying a towering tray of soup bowls between long benches, one bench leg sticking out into the aisle.
scene [6bd0cc] = 拥挤的膳堂，一个一年级生端着高高一摞汤碗走在长凳之间，一条凳子腿伸进了过道。
# en: Lunge for the tray
opt.left.label [0089d8] = 扑过去接托盘
# en: {You catch the tray an inch from disaster with soup up to your wrists. The first-year looks at you as if you'd stopped the sun.|You get a hand under it and one bowl of eight goes over. The first-year counts it as a miracle.|Tray, bowls, first-year, all upright, and not a drop on your sleeve. The table nearest applauds with spoons.}
opt.left.say.1 [dcacbf] = {你在离灾难一寸的地方接住托盘，汤一直没到手腕。那个一年级生看你的样子，像是你让太阳停住了。|你一只手托住了它，八碗只洒了一碗。那个一年级生认为这是奇迹。|托盘、汤碗、一年级生，全都稳稳当当，你的袖子上一滴汤都没沾。最近那一桌用勺子敲着桌子鼓掌。}
# en: {You get there just in time to wear the soup. All eight bowls. It's leek.|You catch the first-year and miss the tray. The crash is heard in the kitchens; the cook comes out to see.|You lunge, the bench catches you too, and you both go down in a lake of soup.}
opt.left.say.2 [780c9d] = {你赶到得正是时候——刚好接住了一身汤。八碗全中。是韭葱汤。|你接住了一年级生，没接住托盘。那一声连厨房都听见了，厨娘出来看。|你扑过去，长凳把你也绊倒了，你们俩一起摔进一摊汤里。}
# en: Move your own bowl out of range
opt.right.label [b79db7] = 把自己的碗挪远
# en: {You lift your bowl to safety and watch it happen. The leg, the trip, the crash. Nobody blames you. You blame you, a little.|You move your bowl. The first-year doesn't move theirs. Somebody else catches the tray, and the first-year thanks them with shining eyes.|Out of range, and dry. The crash is spectacular. You help pick up the bowls afterwards, which is something.}
opt.right.say.1 [8c3194] = {你把碗端到安全的地方，看着事情发生。凳子腿，一绊，一声巨响。没人怪你。你自己有点怪自己。|你挪开了自己的碗。那个一年级生没能挪开TA的。别人接住了托盘，一年级生两眼放光地谢那个人。|躲开了，滴汤未沾。那一下摔得蔚为壮观。事后你帮着捡碗，总算做了点什么。}
# en: Kick the bench leg in first
opt.up.label [cb034f] = 先把凳子腿踢回去
# en: {You see it a heartbeat early, the leg and the step and the tray, and nudge the bench in with your heel. The first-year sails past and never knows.|A glimpse ahead and a small shove. The tray arrives whole. The first-year doesn't notice; you do, and it's lovely.|You move the bench before the first-year has even turned into the aisle. The cook, watching from the hatch, raises her ladle at you like a salute.}
opt.up.say.1 [872817] = {你提前一个心跳看见了——凳子腿、那一步、那托盘——用脚跟把长凳轻轻一推。那个一年级生顺顺当当地走了过去，一无所知。|向前一瞥，轻轻一推。托盘完好无损地送到了。一年级生没察觉；你察觉了，这感觉真好。|那个一年级生还没拐进过道，你就把长凳挪好了。从窗口看着的厨娘冲你举了举汤勺，像在敬礼。}

@event library_crumbs
# en: Crumbs
title [36bd2d] = 饼干屑
# en: {You're three floors up in the library with a paper bag of ginger biscuits from the village, which is against every rule painted on the stairs. Somewhere in the stacks the head librarian is doing her rounds, and her rounds make no sound at all.|Biscuits again, and the head librarian again, somewhere in the shelves. Footnote has smelt the ginger and is watching you from the next desk with enormous patience.|The bag rustles. Two stacks away, a floorboard doesn't.}
text [783884] = {你在图书馆四楼，揣着一纸袋山下小镇买的姜饼，这违反了楼梯上写着的每一条规矩。书架深处，总馆员正在巡视，而她巡视时一点声音都没有。|又是饼干，又是总馆员，在书架间某处。脚注闻到了姜味，正从隔壁桌极有耐心地盯着你。|纸袋沙沙一响。隔着两排书架，一块地板没有响。}
# en: A quiet library stack three floors up, a student hunched over notes with a paper bag of biscuits, a grey cat watching, a lamp moving somewhere among the shelves.
scene [426dd7] = 图书馆高处一排安静的书架间，一个学生伏在笔记上，手边一纸袋饼干，一只灰猫在一旁看着，书架间某处有一盏灯在移动。
# en: Put the bag away and work hungry
opt.left.label [d85f04] = 收起纸袋，饿着干活
# en: {You fold the bag into your satchel and work on an empty stomach. You get a great deal done, all of it about food.|The bag goes away. Your stomach complains loudly enough to echo down the stacks.|You work hungry. When the head librarian passes, she nods at your empty desk, as if she knows exactly what's in the satchel.}
opt.left.say.1 [0c3288] = {你把纸袋折好塞进书包，空着肚子干活。你完成了很多，满脑子都是吃的。|纸袋收起来了。你的肚子叫得那么响，声音顺着书架一路传了过去。|你饿着肚子干活。总馆员经过时，朝你空空的桌面点了点头，好像她清楚书包里装着什么。}
# en: Eat them and risk it
opt.right.label [9e6694] = 吃了，碰碰运气
# en: {You eat the whole bag a crumb at a time. Nobody comes. It's the best chapter you've ever read.|You and Footnote share the bag, one for you, one for the cat. The rounds pass two stacks away and keep going.|You eat them all and brush the crumbs into your sleeve. Nobody ever knows except the cat, who is not telling.}
opt.right.say.1 [2d4585] = {你一点一点地吃完了整袋。谁也没来。这是你读过的最好的一章。|你和脚注分着吃，你一块，猫一块。巡视的脚步在两排书架外经过，没有停。|你全吃完了，把碎屑拂进袖子里。除了猫谁也不知道，而猫不会说。}
# en: {The head librarian is behind you, holding out her hand for the bag. She takes it without a word. You hear her eating them, later, at the desk.|A crunch, and the lamp is suddenly at the end of your row. Your name goes in a book with a black cover.|Footnote knocks the bag off the desk at the worst possible moment. The head librarian arrives as the biscuits finish rolling.}
opt.right.say.2 [d24c7b] = {总馆员就站在你身后，伸手要那个纸袋。她一言不发地拿走了。后来你听见她在服务台那边吃。|咔嚓一声，灯光忽然就到了你这排的尽头。你的名字被记进了一本黑封皮的本子。|脚注在最要命的时刻把纸袋拍下了桌。总馆员赶到时，饼干刚刚滚停。}
# en: See her coming
opt.up.label [dbc48a] = 预见她过来
# en: {You glimpse the lamp turning into your row a breath before it does, and when it arrives there is nothing on your desk but notes and a very innocent face.|A moment ahead, every time. The bag goes under the book, the book comes out of the bag, and the head librarian passes and never knows.|You see her coming, and seeing her coming, offer her a biscuit. She looks at you for a long time. Then she takes one.}
opt.up.say.1 [b3745e] = {你提前一口气瞥见灯光拐进你这一排，等它真到了，你桌上只有笔记和一张无比无辜的脸。|每一次都提前一刻。纸袋塞到书底下，书从纸袋里抽出来，总馆员走过，什么都不知道。|你预见她要来，既然预见了，就递给她一块饼干。她盯着你看了很久。然后拿了一块。}

@event gilded_newt_knucklebones
# en: Knucklebones
title [972621] = 抓羊拐
# en: {At the fireside table the regulars are throwing knucklebones for coppers. There's a space on the bench, and a copper on the table with your name on it, if you want it.|Knucklebones again. The old carter who always wins is winning. He pats the bench beside him.|The regulars wave you over before you've shut the door. The landlady says the game's been dull without you, and charges you for it.}
text [eeb472] = {壁炉边那张桌上，常客们在用羊拐赌铜板。长凳上空着一个位子，桌上还有一枚写着你名字的铜板，你要的话。|又在抓羊拐。那个总是赢的老车夫正在赢。他拍拍身边的长凳。|你还没关上门，常客们就招呼你过去。老板娘说你不在的时候这游戏没劲透了，还为此收了你的钱。}
# en: A low-beamed village tavern, regulars round a table throwing knucklebones for copper stakes by the fire.
scene [76bbca] = 一间房梁低矮的小镇酒馆，常客们围坐在炉火边的桌旁，用羊拐赌铜板。
# en: Play it straight
opt.left.label [324ce2] = 老老实实地玩
# en: {The bones fall your way three throws running. The carter says it's beginner's luck, then that it's been going on too long for that.|You win the pot, a handful of coppers and a lot of goodwill. The landlady takes a cut for the fire.|You play badly and win anyway. The table says that's the worst kind of player.}
opt.left.say.1 [2556e6] = {羊拐连着三把都落得合你心意。车夫说这是新手运，过一会儿又说，这运气未免也太长了。|你赢下了彩池，一把铜板外加满桌的好感。老板娘抽了一成，说是柴火钱。|你玩得很烂，却还是赢了。桌上的人说，这是最气人的那种玩家。}
# en: {The bones roll every way but yours. The carter buys you a cider out of your own losses, with great ceremony.|You lose, cheerfully and steadily. The regulars like you better for it.|Down a few coppers by the end. The carter says you've got the hands for it, just not the luck.}
opt.left.say.2 [08d0b1] = {羊拐往哪儿滚都不往你这边滚。车夫用你输掉的钱给你买了一杯苹果酒，还郑重其事。|你输得开开心心、稳稳当当。常客们因此更喜欢你了。|到最后输了几个铜板。车夫说你手是好手，就是没那个运。}
# en: Buy the round and just watch
opt.right.label [6ba84e] = 请一轮酒，光看着
# en: {You buy the round and watch. By the end you know everyone's name and the carter's whole family tree.|A round for the table, and a seat by the fire with no stakes at all. It's the best evening you've had all month.|You buy the round. The landlady writes it on your tab, to the penny, and the table drinks your health.}
opt.right.say.1 [f7de95] = {你请了一轮，坐着看。到散场时，你已经认得每个人，还知道了车夫的整张家谱。|给全桌请一轮，在炉火边占个座，一个铜板都不押。这是你这个月过得最好的一晚。|你请了这一轮。老板娘把账一分不差地记在你名下，满桌人举杯祝你健康。}
# en: See how the bones will fall
opt.up.label [6c0f43] = 预见羊拐怎么落
# en: {You glimpse each throw before it leaves the hand and bet on what you've seen. You win, and win, and the carter starts to look at you with great interest.|A moment ahead every time. You win the pot and buy the next round with it, which helps your conscience a little.|You see the bones fall before they're thrown. You take the pot, and leave before the carter works out how, which he is getting close to.}
opt.up.say.1 [b1a186] = {每一把还没出手，你就瞥见了结果，照着看到的下注。你赢了又赢，车夫开始饶有兴味地打量你。|每次都提前一刻。你赢下彩池，又拿它请了下一轮，良心多少好受了点。|羊拐还没抛出，你就看见了它们怎么落。你拿走彩池，赶在车夫想明白之前离开——他就快想明白了。}

@event workshop_cracked_lens
# en: The Cracked Lens
title [971ae9] = 裂了的镜片
# en: {Mir is holding their best lens up to the window, and there's a crack across it like a hair. "Demonstration's tomorrow," they say. "For the faculty. It's probably fine. It's not fine."|Another lens, another crack. Mir has started keeping the good ones in a sock.|Mir doesn't say anything; they just hold up the lens. The crack is worse than last time.}
text [15f32d] = {米尔把TA最好的镜片举到窗前，上面横着一道发丝般的裂纹。“明天就要演示了，”TA说，“给教职员看。大概没事。肯定有事。”|又一片镜片，又一道裂纹。米尔开始把好镜片装在袜子里了。|米尔什么也没说，只是把镜片举起来。裂纹比上次还长。}
# en: A cluttered workshop, an artificer holding up a large glass lens with a crack running across it, a half-built machine waiting on the bench.
scene [13b4ac] = 杂乱的工坊，一位奇械师举着一片横贯裂纹的大玻璃镜片，工作台上一台造到一半的机器等着它。
# en: Grind a spare by hand
opt.left.label [d9d80b] = 手工磨一片备用的
# en: {You grind a spare lens with Mir until midnight. It's slightly wrong in a way only Mir can see, and they say it's the best wrong lens they've ever had.|Two hours of grit and polish. The new lens works. Mir writes your name on its rim in tiny letters.|Mir grinds one side, you the other. The lens is done by ten; Mir makes tea that tastes of solder.}
opt.left.say.1 [863fca] = {你和米尔一起磨一片备用镜片，磨到半夜。它有点不对劲，不对得只有米尔看得出来，TA说这是TA用过的最好的一片不对劲的镜片。|两个钟头的砂和抛光。新镜片能用了。米尔用极小的字把你的名字刻在镜框边上。|米尔磨一面，你磨另一面。十点就磨好了；米尔泡的茶有股焊锡味。}
# en: Tape it and hope
opt.right.label [ca862f] = 粘上胶带，听天由命
# en: {You tape the crack and tell Mir it'll hold. It holds for the demonstration and splits in half at the applause, which Mir calls "dramatic timing".|Tape, and a promise to come back. Mir says "probably" four times in a row, which is a lot even for Mir.|You tape it. Mir looks at the tape for a long time, then at you, then says it's fine in a voice that means it isn't.}
opt.right.say.1 [7b1a83] = {你用胶带粘住裂缝，告诉米尔撑得住。它撑过了演示，在掌声响起时裂成两半，米尔管这叫“戏剧性的时机”。|一条胶带，一句会回来的承诺。米尔一连说了四遍“大概”，就算对米尔来说也够多了。|你粘好了。米尔盯着胶带看了很久，又看看你，然后用一种明显不是没事的语气说没事。}
# en: Mend it, seamless
opt.up.label [3f49a9] = 修好它，天衣无缝
# en: {You close the crack with a breath of Mend, and the glass runs together like water. Mir holds it to the light and can't find where it was. "Probably magic," they say, and hug you.|The lens mends clear as the day it was poured. Mir tests it on a moth, which is now the best-studied moth in the castle.|{spell_level(mend) >= 2: You mend the lens and the hairline crack in its brass ring. Mir makes you promise to come to the demonstration, "in case".|You mend it on the second try. Mir says the first try was "very educational", and keeps the slightly wobbly result for a different machine.}}
opt.up.say.1 [63ef8b] = {你呼出一口愈合咒，玻璃像水一样流到一起。米尔把它对着光看，找不到裂过的地方。“大概是魔法吧。”TA说着，抱了你一下。|镜片愈合得像刚浇铸那天一样清亮。米尔拿一只飞蛾来试，如今那是城堡里被研究得最透彻的飞蛾。|{spell_level(mend) >= 2: 你修好了镜片，顺手把黄铜镜框上的细纹也修了。米尔要你保证去看演示，“以防万一”。|你第二次才修好。米尔说第一次“很有教育意义”，把那片有点歪的留下来，给另一台机器用。}}

@event lakeshore_torn_net
# en: The Torn Net
title [97490e] = 破了的渔网
# en: {An old fisher is sitting on an upturned boat, mending a net with a hole in it the size of a door. "The old pike," they say, not looking up. "Bigger every year."|The fisher again, the net again, a different hole. "Same pike," they say.|The fisher has kept a space on the boat for you, and the net has kept a hole.}
text [64bcf0] = {一位老渔人坐在一条倒扣的船上补网，网上的洞有门那么大。“那条老梭子鱼，”TA头也不抬地说，“一年比一年大。”|又是那位渔人，又是那张网，换了个洞。“还是那条梭子鱼。”TA说。|渔人在船上给你留了个位子，网上也给你留了个洞。}
# en: An old fisher sitting on an upturned boat on a still lakeshore, a long net across their knees with a ragged hole torn through it.
scene [ee73c6] = 平静的湖岸，一位老渔人坐在倒扣的船上，膝上摊着一张长长的渔网，网上破了个参差不齐的大洞。
# en: Help knot the net
opt.left.label [5f4fe4] = 帮忙结网
# en: {You knot until your fingers go white in the cold. The fisher tells you about every fish they ever lost, and none they caught.|An hour of knots, badly, then less badly. The fisher gives you a fish wrapped in a dock leaf, still flapping.|The knot comes to your fingers more easily than you expected. The fisher says you'd have made a fisher, in a tone that means it's the highest thing they can say.}
opt.left.say.1 [884747] = {你一直结到手指冻得发白。渔人跟你讲了TA丢掉的每一条鱼，抓到的一条没提。|一个钟头的结，先是结得很糟，后来没那么糟了。渔人送你一条用酸模叶包着的鱼，还在扑腾。|那个结在你指间打得比你预想的顺手。渔人说你本来能当个渔人，那语气意味着这是TA能给的最高评价。}
# en: Buy a fish and leave them to it
opt.right.label [be5464] = 买条鱼，让TA自己补
# en: {You buy the best of the morning's catch. The fisher wraps it in yesterday's Ledger and doesn't look up from the net.|A fish, a nod, a coin. You eat it grilled on the shore, and the net doesn't get any smaller.|You buy a fish. The fisher throws in a second, small and ugly, "for luck". It's the tastier of the two.}
opt.right.say.1 [8fba71] = {你买下早上捕到的最好的一条。渔人用昨天的《流明纪事报》把鱼包好，眼睛没离开渔网。|一条鱼，一个点头，一枚硬币。你在岸边把它烤着吃了，那张网一点也没变小。|你买了一条鱼。渔人又白送一条，又小又丑，“图个吉利”。结果这条更好吃。}
# en: Mend the whole net
opt.up.label [ca04f2] = 把整张网补好
# en: {You lay a hand on the net and the hole knits shut, knot by knot, from the edges in. The fisher stares at it, then at you, then gives you their lunch.|The net mends in one breath. The fisher says nothing for a long time, then tells you about the pike, which by the end of the story is the length of a rowing boat.|You mend the net and two old patches you hadn't noticed. The fisher says the pike will be furious, and grins with three teeth.}
opt.up.say.1 [c7b777] = {你把手按在网上，那个洞一结一结地从边缘往里合拢。渔人盯着网，又盯着你，然后把午饭给了你。|一口气，网就补好了。渔人很久没说话，然后给你讲起那条梭子鱼，讲到最后，它已经有一条划艇那么长了。|你补好了网，还顺手补了两块你都没注意到的旧补丁。渔人说那条梭子鱼要气坏了，咧嘴一笑，露出三颗牙。}

@event great_hall_cracked_sky
# en: A Crack in Tomorrow
title [a0c68c] = 明天裂了道缝
# en: {The great hall's ceiling shows tomorrow, and tomorrow, it seems, is wet. There's a crack across the sky above the end of the long table, and tomorrow's rain is dripping through it into somebody's soup.|The crack is back, over a different table. Tomorrow is sleet.|A crack again, and a first-year holding a bowl under it with the air of someone who's been there a while.}
text [9a6765] = {大礼堂的天花板显示的是明天，而明天看来要下雨。长桌尽头上方的天空裂了一道缝，明天的雨正从缝里滴进某人的汤碗。|裂缝又出现了，换到了另一张桌子上方。明天是雨夹雪。|又一道裂缝，一个一年级生捧着碗接在底下，看样子已经接了好一阵子。}
# en: A vaulted hall whose ceiling shows tomorrow's weather, a thin crack across the painted sky, rain dripping through it onto the end of a long table.
scene [6901ed] = 拱顶大厅，天花板映着明天的天气，画一般的天空上有一道细裂缝，雨水从中滴落在一张长桌的尽头。
# en: Fetch buckets from the kitchens
opt.left.label [55c1a8] = 去厨房拿水桶
# en: {You fetch two buckets and a mop. By supper there are buckets all down the table, and the hall sounds like a clock shop.|You set out buckets under the drips. They ring all through supper in different notes, and somebody starts conducting.|Buckets, and the mop, and the first-year freed from duty. They follow you about for a week.}
opt.left.say.1 [188112] = {你拿来两只水桶和一把拖把。到晚饭时，整张长桌下摆满了水桶，礼堂里滴答声响成一片，像钟表铺。|你在滴水处摆好水桶。晚饭时它们一直在响，音高各不相同，有人开始打起了拍子指挥。|水桶、拖把，还有那个终于解放了的一年级生。TA跟了你整整一个星期。}
# en: Move to a dry bench and eat
opt.right.label [a3c7f6] = 换张干凳子吃饭
# en: {You move up the table and eat with tomorrow dripping steadily behind you. Someone else will fix it. Nobody does until Thursday.|You move. The first-year with the bowl watches you go with the look of a soldier left at the gate.|A dry bench, and supper. The drip keeps time with your spoon all evening, which is somehow worse.}
opt.right.say.1 [da1718] = {你挪到长桌另一头吃饭，身后明天一滴一滴地落个不停。会有别人来修的。一直到星期四都没人修。|你挪走了。捧碗的一年级生看着你离开，眼神像被留在城门口的哨兵。|一张干凳子，一顿晚饭。那滴水一整晚都跟着你的勺子打拍子，不知怎的更糟了。}
# en: Mend the sky
opt.up.label [788f2f] = 补好天空
# en: {You reach up with Mend and the crack in tomorrow knits shut, cloud to cloud. The drip stops mid-fall. Half the hall claps; the other half didn't notice, which is the better compliment.|The crack draws together from both ends and meets in the middle with a small click. Tomorrow's rain will have to wait for tomorrow, as it should.|You mend the sky over the long table. The first-year with the bowl pours it, solemnly, into a plant pot.}
opt.up.say.1 [5d9692] = {你举手施展愈合咒，明天的裂缝一朵云接一朵云地合上了。那滴水停在半空。礼堂里一半人鼓掌；另一半人根本没注意到，这才是更高的夸奖。|裂缝从两头往中间收拢，合上时轻轻咔哒一声。明天的雨只好等到明天再下，这才对。|你把长桌上方的天空补好了。捧碗的一年级生郑重其事地把碗里的水倒进了一个花盆。}

@event boathouse_good_boat
# en: The Good Boat
title [dc7c09] = 那条好船
# en: {The boathouse has six boats that leak and one, the blue one, that doesn't. The boatman keeps it for himself and sits on it to make the point.|The blue boat, the boatman, the folded arms. You've started to think of them as one animal.|The boatman sees you coming and settles more firmly onto the blue boat. "No," he says, before you've asked.}
text [4320a2] = {船屋里有六条漏水的船，还有一条不漏的，那条蓝色的。船夫把它留给自己，还坐在上面，以示立场。|蓝船、船夫、抱着的胳膊。你已经开始把它们看作同一只动物了。|船夫看见你过来，在蓝船上坐得更稳了。“不行。”你还没开口，他就说了。}
# en: A boathouse jetty, a row of patched rowing boats and one sound blue one, a weathered boatman sitting on it with his arms folded.
scene [44416f] = 船屋的栈桥，一排打满补丁的划艇和一条完好的蓝船，一个饱经风霜的船夫抱着胳膊坐在蓝船上。
# en: Pay his price for an hour
opt.left.label [279614] = 照他的价租一个钟头
# en: {He takes your crowns, counts them twice and lets you have the blue boat for exactly an hour. It's the stillest hour you've spent all term.|An hour on the lake in a boat that doesn't sink. You row out to the middle and lie back and watch the towers upside down.|You pay. He watches you the whole hour, from the jetty, as if you'd borrowed his dog.}
opt.left.say.1 [d5635f] = {他收下你的克朗，数了两遍，把蓝船借给你，不多不少一个钟头。这是你这学期度过的最安静的一个钟头。|在一条不会沉的船上待一个钟头。你划到湖心，向后一躺，看倒映的塔楼。|你付了钱。他从栈桥上盯了你整整一个钟头，好像你借走的是他的狗。}
# en: Take the green one, bailing
opt.right.label [5f83ca] = 划那条绿的，边划边舀水
# en: {You take the green boat and a bailer. You row half the time and bail the other half. It's still the lake, and still lovely.|The green boat, which takes on water like a sponge. You come back with wet boots and a better opinion of yourself.|You bail all the way out and all the way back. The boatman says you've got a rower's arms now, and charges you nothing for the joke.}
opt.right.say.1 [d1fb9d] = {你划了那条绿船，带着一只舀水勺。一半时间划船，一半时间舀水。湖还是那个湖，还是那么美。|那条绿船，吃水像块海绵。你回来时靴子湿透，对自己的评价却高了一截。|你一路舀着水划出去，又一路舀着水划回来。船夫说你现在有了一双划船手，这个笑话不收你钱。}
# en: Charm him off the blue boat
opt.up.label [bbf0d2] = 用魅影咒哄他让出蓝船
# en: {You turn on a little more charm than you have, and he finds himself telling you about his late wife, and then lending you the blue boat, and then wondering why.|A smile with Glamour in it. The boatman gets up, holds the boat steady for you, and calls you "young sir or madam" like a courtier.|He remembers liking you and not quite why. You get the blue boat for the rest of the day and a cup of his terrible tea after.}
opt.up.say.1 [8b4fbe] = {你多施展了一点你本没有的魅力，他不知不觉跟你讲起了他过世的妻子，接着把蓝船借给了你，然后才纳闷自己为什么这么做。|带着魅影咒的一个微笑。船夫站起身，替你扶稳船，像个侍臣一样称你“年轻的先生或女士”。|他记得自己喜欢你，却不太记得为什么。那天余下的时间蓝船都归你，回来后还有一杯他泡的难喝的茶。}

@event courtyard_prefects_notebook
# en: The Prefect's Notebook
title [5f43aa] = 级长的本子
# en: {You have, it turns out, been walking on the lawn, which is for looking at. Bram Hollis has his notebook open and his pencil licked. "Rule nine," he says. "Demerit."|Bram again, and the notebook again, and the lawn again. "Rule nine," he says, with real joy.|Bram's pencil is already moving when you look up. He has a page with your name at the top now.}
text [464bab] = {原来你一直踩在草坪上，而那片草坪是用来看的。布拉姆·霍利斯翻开本子，舔了舔铅笔。“第九条，”他说，“记过。”|又是布拉姆，又是本子，又是草坪。“第九条，”他说，满心欢喜。|你一抬头，布拉姆的铅笔已经在动了。他现在有一页专门以你的名字打头。}
# en: A sunny castle courtyard, a red-sashed prefect with a notebook open and pencil poised, a student standing on a forbidden patch of lawn.
scene [59f37c] = 阳光明媚的城堡庭院，一位佩着红色绶带的级长翻开本子、举着铅笔，一个学生站在一块禁止踩踏的草坪上。
# en: Argue the rule
opt.left.label [ef485c] = 跟他争这条规矩
# en: {You point out that rule nine was repealed in a year when the lawn caught fire. Bram checks. It was. He closes the notebook with great dignity.|You argue that you were looking at the lawn, very closely. Bram can't find the rule against that. He'll have one by Thursday.|You quote rule nine back at him, with the bit he left out. Bram goes pink and lets you off "this once, as a courtesy".}
opt.left.say.1 [2e228e] = {你指出，第九条在草坪着火的那一年就废除了。布拉姆查了查。确实如此。他极有尊严地合上了本子。|你争辩说你是在看草坪，看得很仔细。布拉姆找不到禁止这样做的条款。到星期四他就会有一条了。|你把第九条连同他漏掉的那半句一起背给他听。布拉姆脸红了，放你一马，“仅此一次，算是给你面子”。}
# en: {Bram reads rule nine out loud to the whole courtyard, twice, and writes your name in capitals.|You argue; Bram quotes rule ten, which is about arguing. Two demerits.|Bram listens to your whole case, then writes it down as a separate offence.}
opt.left.say.2 [efbe56] = {布拉姆当着整个庭院把第九条大声念了两遍，然后用大写字母写下你的名字。|你争辩；布拉姆引用第十条，那条是关于争辩的。记过两次。|布拉姆听完了你的全部陈词，然后把它记成了另一项过失。}
# en: Take the demerit and move on
opt.right.label [008a36] = 认了记过，走人
# en: {You take it. Bram writes slowly, so everyone can see. "Next time," he says, and means it kindly, in his way.|Demerit. You walk off the lawn with your hands in your pockets. A first-year on a bench gives you a sympathetic look.|You take the demerit with a bow. Bram doesn't know what to do with a bow, and writes that down too.}
opt.right.say.1 [7697f1] = {你认了。布拉姆写得很慢，好让大家都看见。“下次注意。”他说，以他的方式，带着善意。|记过一次。你双手插兜走下草坪。长凳上一个一年级生向你投来同情的目光。|你鞠了一躬，认下了记过。布拉姆不知道该拿一个鞠躬怎么办，于是把这个也记了下来。}
# en: Remind him he likes you
opt.up.label [9d7ca6] = 提醒他，他喜欢你
# en: {You say his name the way people say a friend's, with a little Glamour in it. Bram's pencil stops. He forgets, quite visibly, what he was writing.|A smile with a spell behind it. Bram closes the notebook, tells you to "watch the edges", and walks off frowning at himself.|Bram remembers liking you and not why. He lets you off, then follows you to the cloister to explain rule nine properly, which is its own punishment.}
opt.up.say.1 [05c57d] = {你像叫朋友那样叫他的名字，里面掺了一点魅影咒。布拉姆的铅笔停住了。他明显忘了自己在写什么。|一个背后藏着咒语的微笑。布拉姆合上本子，叮嘱你“注意边上”，然后皱着眉对自己生着闷气走开了。|布拉姆记得自己喜欢你，却不记得为什么。他放过了你，然后跟着你走到回廊，把第九条从头到尾给你讲清楚，这本身就是一种惩罚。}

@event grimsbys_book_behind_counter
# en: The Book Behind the Counter
title [70cf88] = 柜台后的书
# en: {Behind Mr Grimsby's counter there's a book wrapped in brown paper, kept apart. "For someone who'll need it," he says vaguely. "Not you. Or not yet."|The wrapped book is still there. Mr Grimsby moves it a little further from you when you come in.|The brown-paper book has a name pencilled on it now, but he keeps his thumb over the name.}
text [65738b] = {格林斯比先生的柜台后面放着一本牛皮纸包着的书，单独搁着。“给一个会需要它的人，”他含糊地说，“不是你。或者说，还不是。”|那本包着的书还在。你一进门，格林斯比先生就把它往离你远一点的地方挪了挪。|牛皮纸包着的书上现在用铅笔写了个名字，可他总用拇指压着那个名字。}
# en: A cramped bookshop, an elderly bookseller behind his counter with one wrapped book kept apart from the rest, a student leaning in hopefully.
scene [afdcfb] = 一间挤得满满的书店，一位年迈的书商站在柜台后，身边单独放着一本包好的书，一个学生满怀希望地探过身去。
# en: Wait to be the someone
opt.left.label [92aa81] = 等着成为那个人
# en: {You browse for an hour in plain sight, being the sort of person who'd need a book. Mr Grimsby sells you a history of lighthouses instead.|You come back twice in the week. On the second visit he lets you hold it, then takes it back. "Soon," he says.|You don't ask. Mr Grimsby notices you not asking, and approves, and doesn't give you the book.}
opt.left.say.1 [7a36e6] = {你在他眼皮底下逛了一个钟头，努力做一个会需要一本书的人。格林斯比先生最后卖给你一本灯塔史。|这个星期你又来了两次。第二次他让你拿了拿那本书，又收了回去。“快了。”他说。|你没开口问。格林斯比先生注意到你没问，颇为赞许，然后还是没把书给你。}
# en: Buy what he recommends instead
opt.right.label [661be7] = 买他推荐的那本
# en: {He hands you something about tides that smells of seaweed. Chapter two is exactly what your essay needed, as usual, annoyingly.|You buy his recommendation without arguing. He looks almost disappointed you didn't fight for the other one.|A slim book on candle-making, for reasons he won't explain. You'll need it on Thursday.}
opt.right.say.1 [565866] = {他递给你一本讲潮汐的书，闻着有海藻味。第二章恰好是你的论文需要的，一如既往，叫人恼火。|你二话不说买下他推荐的书。他看上去几乎有点失望，你没为另一本争一争。|一本讲做蜡烛的薄书，原因他不肯说。星期四你就会用上它。}
# en: Charm the parcel out of him
opt.up.label [846107] = 用魅影咒把书哄到手
# en: {You smile at him with a little more charm than you own, and he finds himself handing you the parcel. "Ah," he says, puzzled. "It was you all along. Was it?"|Glamour, and a compliment about his shelving. He unwraps the book for you himself. It's the one you came in for last month and couldn't find.|He beams, decides you've been a customer for years, and wraps the parcel again for you, more nicely, with string.}
opt.up.say.1 [e788b1] = {你朝他笑了笑，那份魅力比你本有的多一点，他不知不觉就把包裹递给了你。“啊，”他困惑地说，“原来一直是你。是吗？”|一点魅影咒，再夸一句他的书架。他亲手为你拆开了包装。正是你上个月来找却没找到的那本。|他笑逐颜开，认定你是多年的老主顾，又替你把包裹重新包了一遍，包得更漂亮，还系上了绳子。}

@event lecture_tower_far_bell
# en: The Far Bell
title [32b356] = 远处的钟
# en: {The bell for your lecture is ringing in the other tower, and you are on the wrong side of the bridge with all your books.|The bell again, and you on the wrong end of the bridge again. You're starting to suspect the bridge.|You can hear the bell before you see the bridge. Seven strokes; it's on the third.}
text [09eaf4] = {你那堂课的钟声在另一座塔里敲响了，而你抱着所有的书，站在桥的这一头。|又是钟声，你又站在桥的另一头。你开始怀疑这座桥了。|还没看见桥，你就听见了钟声。一共七下，现在是第三下。}
# en: A bridge of light between two towers, a student running across it with an armful of books while a bell rings on the far side.
scene [bac538] = 两座塔之间的一道光桥，一个学生抱着一摞书在桥上奔跑，桥那头的钟正在敲响。
# en: Run for it
opt.left.label [38d292] = 拼命跑过去
# en: {You slide into your seat on the last stroke with your books in a heap. The lecturer looks at the clock, then at you, then lets it go.|You make it, red-faced and triumphant. Your neighbour pushes a quill at you without a word.|You know the run now: left foot on the second plank, duck the lamp. In with a stroke to spare.}
opt.left.say.1 [092118] = {最后一声钟响时，你滑进座位，书堆成一团。讲师看看钟，又看看你，没跟你计较。|你赶上了，满脸通红，得意洋洋。邻座一言不发地把一支羽毛笔推了过来。|这条路你跑熟了：左脚踩第二块板，低头躲过灯。还剩一声钟响，你就进了门。}
# en: {You drop your books halfway across the bridge and arrive five minutes late with half of them.|You arrive as the door closes, and spend the hour listening through it. It's not the same.|You trip on the top step and the whole lecture turns to watch you pick up your inkwell.}
opt.left.say.2 [c512e6] = {你在桥中间把书掉了一地，迟到五分钟，只抱着一半的书赶到。|你赶到时门正好关上，于是你隔着门听了一个钟头。这不一样。|你在最上面一级台阶绊了一跤，整堂课的人都转过头来看你捡墨水瓶。}
# en: Arrive late, quietly
opt.right.label [8cc63d] = 安安静静地迟到
# en: {You walk, and slip in at the back ten minutes late. You miss the one thing that'll be on the exam.|You arrive late and sit on the end of the back row, where the notes from the front arrive late too.|Late, and calm, and behind for the rest of the hour. Someone lends you their notes afterwards, in a hand you can't read.}
opt.right.say.1 [e7e484] = {你走着去，晚了十分钟从后门溜进去。你错过了考试唯一会考的那一点。|你迟到了，坐在最后一排的边上，前排传下来的笔记也传得最晚。|迟到了，心平气和，这一个钟头都跟不上。下课后有人把笔记借给你，字迹你一个也认不出。}
# en: Borrow a hare's legs
opt.up.label [19664e] = 借一双野兔的腿
# en: {You cross the bridge in four strides with the wind whistling, and sit down before the bell has finished. Your books arrive a moment later, in your arms.|Haste, and the bridge goes by in a blur of light. You're in your seat, notes open, looking as if you've been there an hour.|{spell_level(haste) >= 2: You're early. You've time to sharpen a quill and help a first-year find the room.|You arrive breathless but on the stroke. The lecturer says "Prompt," which from them is warm.}}
opt.up.say.1 [66762c] = {你四步跨过了桥，耳边风声呼啸，钟声还没敲完你就坐下了。你的书过了一会儿才到——在你怀里。|疾速咒一施，光桥化作一道模糊的光影掠过。你已经坐在座位上，笔记摊开，好像来了一个钟头似的。|{spell_level(haste) >= 2: 你来早了。还有时间削一支羽毛笔，再帮一个一年级生找到教室。|你赶在钟声上到了，气喘吁吁。讲师说了句“准时”，这对TA来说算是热情了。}}

@event courtyard_loose_pages
# en: Loose Pages
title [115f61] = 散落的纸页
# en: {A gust comes over the wall and takes a first-year's essay out of their hands, every page of it, and scatters it across the courtyard towards the fountain. They stand there holding the empty folder.|Wind, a folder, a first-year, and pages everywhere. The fountain looks hungry.|The pages are already in the air when you come through the arch. You know exactly where the fountain is.}
text [3751e2] = {一阵风翻过墙头，把一个一年级生手里的论文卷走了，一页不剩，朝着喷泉撒了一院子。TA站在那儿，手里只剩一个空文件夹。|风、文件夹、一年级生，满地纸页。喷泉看起来很饿。|你穿过拱门时，纸页已经飞在空中了。你很清楚喷泉在哪儿。}
# en: A castle courtyard on a windy day, a first-year clutching an empty folder while the pages of an essay blow across the flagstones toward a fountain.
scene [1d334d] = 刮风天的城堡庭院，一个一年级生紧抓着空文件夹，论文的纸页正被风卷过石板地，飞向一座喷泉。
# en: Chase them down
opt.left.label [e61193] = 追回来
# en: {You run them down one by one, off the flagstones, out of a hedge, one off a prefect's back. Every page, and only one of them damp.|You stamp on three, catch two and dive for the last at the fountain's rim. The first-year hugs the folder like a lost dog.|You read the wind and get to the fountain before the pages do, and catch them as they come.}
opt.left.say.1 [85b0a3] = {你一张一张地追：从石板上、从树篱里，还有一张从一位级长背上揭下来。一页不少，只有一页湿了。|你踩住三张，接住两张，在喷泉边上扑住了最后一张。那个一年级生抱着文件夹，像抱着失而复得的小狗。|你看准了风向，赶在纸页之前到了喷泉边，一张张接住。}
# en: {You get most of them. The last three go into the fountain, and you go in after the last one, and it's a long cold walk to the dormitory.|You trip on the fountain step and the pages sail on without you. The first-year helps you up, which isn't how it was meant to go.|The wind wins. You bring back half an essay and a leaf.}
opt.left.say.2 [f58186] = {大部分都追回来了。最后三张掉进了喷泉，你追着最后一张也进去了，回宿舍的路又长又冷。|你在喷泉台阶上绊了一跤，纸页撇下你继续飞。那个一年级生把你扶了起来，这跟原本的剧本可不一样。|风赢了。你只带回来半篇论文和一片树叶。}
# en: Lend them your own notes to start again
opt.right.label [d60985] = 借出笔记，让TA重写
# en: {You sit with them on the cloister step while they work it up again from your notes. It comes out shorter and, honestly, better.|You lend them your notes and your afternoon. It takes all of it, and they tell their whole year you did.|You lend them your quill and your evening, and they hand it in on time.}
opt.right.say.1 [2c4043] = {你陪TA坐在回廊台阶上，看TA照着你的笔记重新写。写出来的短了些，而且说实话，更好了。|你借出了笔记，也搭上了一下午。整个下午都搭进去了，TA跟全年级的人都说了是你帮的忙。|你借出羽毛笔，搭上一晚上，TA按时交上了论文。}
# en: Gather every page before it lands
opt.up.label [a7a43a] = 赶在落地前收齐每一页
# en: {Haste, and the courtyard slows around you. You pluck every page out of the air before the gust has finished, and hand back the folder neatly stacked.|You go round the courtyard like a whirl of wind yourself, and come back with the essay in order. The first-year counts the pages twice, then stares at you.|{spell_level(haste) >= 2: You catch the pages and the first-year's hat, which they hadn't noticed had gone.|You get every page but one, and that one you snatch off the fountain's surface, barely wet.}}
opt.up.say.1 [14a5d0] = {疾速咒一施，庭院在你周围慢了下来。风还没停，你就从空中摘下了每一页，把文件夹整整齐齐地递了回去。|你自己也像一阵旋风似的绕着庭院转了一圈，回来时论文已经按顺序排好。那个一年级生数了两遍，然后呆呆地看着你。|{spell_level(haste) >= 2: 你接住了纸页，还接住了那个一年级生的帽子——TA都没发现帽子飞了。|你接住了除一页以外的所有纸页，那一页你是从喷泉水面上抢回来的，只湿了一点点。}}

@event refectory_supper_hatch
# en: The Supper Hatch
title [32f841] = 晚饭窗口
# en: {The kitchen hatch shuts at the bell, and the bell is going, and you are at the wrong end of the longest hall in the castle.|The hatch is coming down again. The cook leaves it open an inch less for you every week, on principle.|You hear the hatch rattle before you're through the door. Stew night, too.}
text [cbc127] = {厨房的窗口钟一响就关，钟已经在响了，而你在城堡里最长的大厅的另一头。|窗口又要落下来了。厨娘每周给你留的缝都少一寸，原则问题。|你还没进门就听见窗口哗啦作响。偏偏还是炖菜之夜。}
# en: A long dining hall at evening, the kitchen hatch at the far end with its shutter starting to come down, a student at the wrong end of the hall.
scene [1a5617] = 傍晚的长条膳堂，尽头厨房窗口的挡板正开始落下，一个学生站在大厅的另一头。
# en: Run the length of the hall
opt.left.label [481e9e] = 跑过整个大厅
# en: {You get a bowl under the hatch as it comes down. The cook gives you the last of the stew and a look of grudging respect.|You make it with a slide that would win prizes. The hatch stops for you. The cook looks almost impressed.|In under the shutter by a hand's breadth. The cook says, "You again," and adds a dumpling, as a prize.}
opt.left.say.1 [e8b740] = {你在窗口落下时把碗伸了进去。厨娘给了你最后一勺炖菜，外加一个勉强服气的眼神。|你一个滑步冲过去，这一下能拿奖。窗口为你停住了。厨娘看起来几乎有点佩服。|你从挡板底下以一掌之隔钻了进去。厨娘说：“又是你。”然后加了一个面团子，算是奖品。}
# en: {The hatch closes in your face, gently, with finality. Bread and cheese it is.|You slip on the flagstones halfway and arrive on your back. The cook leans over the hatch to check you're alive, and closes it.|Too slow. You hear the stew being scraped into a bucket for the pigs, which is a sound that stays with you.}
opt.left.say.2 [d9ae89] = {窗口当着你的面关上了，轻轻地，不容商量。那就面包和奶酪吧。|你跑到一半在石板上滑倒，仰面朝天到了窗口。厨娘探出身确认你还活着，然后关上了窗口。|太慢了。你听见炖菜被刮进喂猪的桶里，那声音你会记很久。}
# en: Take bread and cheese from the board
opt.right.label [5d4d5d] = 从板子上拿面包和奶酪
# en: {You take bread and cheese from the board by the door and eat them on the steps. It's fine. It isn't stew.|Bread, cheese and an apple, eaten walking. You catch the smell of the stew all the way upstairs.|You take the board's bread and somebody's abandoned pudding. You're not proud. You're full.}
opt.right.say.1 [9c3a59] = {你从门边的板子上拿了面包和奶酪，坐在台阶上吃。还行。不是炖菜。|面包、奶酪和一个苹果，边走边吃。一路上楼你都闻得到炖菜的香味。|你拿了板子上的面包，还有不知谁剩下的布丁。你不骄傲。你吃饱了。}
# en: Cross the hall in a heartbeat
opt.up.label [14d195] = 一个心跳间穿过大厅
# en: {You're at the hatch before the bell's first echo. The cook stares at the door, then at you, then ladles. "Well," she says. "Somebody's hungry."|Haste down the long aisle, between the benches, round a prefect, and your bowl is under the hatch with time to spare.|You arrive so fast you have to wait for the hatch to finish opening. The cook gives you seconds out of sheer surprise.}
opt.up.say.1 [fec03d] = {钟声的第一道回音还没落，你已经站在窗口前了。厨娘看看门，看看你，然后舀了一勺。“好家伙，”她说，“有人饿坏了。”|疾速咒一施，你沿着长长的过道，穿过长凳，绕过一位级长，碗已经伸进窗口，时间绰绰有余。|你到得太快，只好等窗口完全打开。厨娘惊得给你多盛了一份。}

@event lecture_tower_volunteer
# en: A Volunteer
title [9dfa7e] = 一名志愿者
# en: {"I need a volunteer," says the lecturer, holding up a charm that crackles, "for a hex that is only mildly unpleasant." Their eyes are travelling along the back row towards you.|The volunteer again. The back row has learned to look at its shoes; the lecturer has learned to look at the back row.|"Volunteer," says the lecturer, and you can feel the word coming for you like weather.}
text [51aede] = {“我需要一名志愿者，”讲师举着一道噼啪作响的咒符说，“来试一个只是有点不舒服的恶咒。”TA的目光正沿着最后一排朝你移过来。|又要志愿者。最后一排已经学会了盯着自己的鞋；讲师也学会了盯着最后一排。|“志愿者。”讲师说，你能感觉到这个词像天气一样朝你压过来。}
# en: A tiered lecture hall, a lecturer at the front with a crackling demonstration charm, scanning the back row for a volunteer.
scene [f7ebbc] = 阶梯讲堂，讲师在前面举着一道噼啪作响的示范咒符，扫视最后一排寻找志愿者。
# en: Put your hand up
opt.left.label [fef1af] = 举手
# en: {You volunteer. The hex is exactly as mildly unpleasant as promised, and your hair stays upright until supper. You learn more than anyone else in the room.|You go down and take it on the chin, literally. The class applauds; your chin doesn't.|You volunteer before they ask. The lecturer, delighted, gives you the slightly worse hex, "as a treat".}
opt.left.say.1 [e18cc1] = {你自告奋勇。那个恶咒果然只是有点不舒服，你的头发一直竖到晚饭。你比教室里任何人学到的都多。|你走下去，硬生生地扛了下来——字面意义上，用下巴扛的。全班鼓掌；你的下巴没鼓。|讲师还没开口你就举了手。讲师很高兴，给了你一个稍微更难受的恶咒，“当作奖励”。}
# en: Sink into your seat
opt.right.label [89c92c] = 缩进座位里
# en: {You sink. The lecturer picks the student beside you, who gives you a look you'll be paying for until the end of term.|You become very interested in your notes. It works; the person in front is less lucky and less interested in theirs.|You sink until you're more desk than student. The lecturer says, "I can see you," and picks someone else anyway.}
opt.right.say.1 [67d79b] = {你缩了下去。讲师点了你旁边的同学，那人看你的眼神，你得一直还到学期末。|你忽然对自己的笔记产生了浓厚的兴趣。这招管用；前排那个人运气差一点，对笔记的兴趣也少一点。|你缩得几乎跟桌子融为一体。讲师说：“我看得见你。”然后还是点了别人。}
# en: Step into the pillar's shadow
opt.up.label [bb49f2] = 踏进柱子的阴影
# en: {You step into the shadow of the pillar and out of the shadow by the door, and spend the demonstration watching from the corridor, very innocently.|A step into the dark under your desk and out under the window. When the lecturer's eyes reach your seat, your seat is empty, and they look puzzled for the rest of the hour.|You're gone before the word "volunteer" lands. From the doorway you watch someone else's hair stand on end, and feel only slightly guilty.}
opt.up.say.1 [bf3e27] = {你踏进柱子的阴影，又从门边的阴影里踏出来，整个示范你都在走廊里观看，一脸无辜。|一步踏进桌下的暗处，再从窗下踏出。讲师的目光扫到你的座位时，座位是空的，TA困惑了整整一个钟头。|“志愿者”这个词还没落地，你就不见了。你从门口看着别人的头发竖起来，只觉得有那么一点点愧疚。}

@event observatory_shutter_rope
# en: The Shutter Rope
title [8ec21b] = 天窗的绳子
# en: {The stars are coming out, and the dome is still shut. The crank rope has jumped its pulley and is hanging up in the dark of the ribs, well out of anyone's reach. A dozen students with star charts look up at it.|The shutter rope has jumped its pulley again. The caretaker says it does it on clear nights only, out of spite.|Up in the ribs of the dome, in the dark, the rope again. Somebody has chalked an arrow on the floor pointing at it.}
text [86a967] = {星星出来了，圆顶却还关着。摇柄的绳子跳出了滑轮，挂在穹肋间的暗处，谁也够不着。十几个拿着星图的学生仰头望着它。|天窗的绳子又跳出了滑轮。看守说它只在晴朗的夜里这么干，纯属故意。|圆顶的穹肋间，暗处，又是那根绳子。有人在地板上用粉笔画了个箭头指着它。}
# en: A brass observatory dome at dusk, its shutter still closed, a crank rope dangling out of reach up in the dark of the dome's ribs, students with star charts waiting below.
scene [c70f94] = 黄昏时的黄铜观星圆顶，天窗仍然紧闭，一根摇柄绳挂在穹肋间的暗处够不着，拿着星图的学生在下面等着。
# en: Climb the brass ribs
opt.left.label [004882] = 爬上黄铜穹肋
# en: {You climb the ribs like a ladder and hook the rope with one foot. The shutter grinds open on a sky full of stars, and the room cheers.|Up the ribs, out along the curve, a grab. The rope comes free and the dome opens with a groan like a waking giant.|The handholds are just where you'd hope. Up, grab, down, and the sky is open before the charts are unrolled.}
opt.left.say.1 [20949c] = {你像爬梯子一样爬上穹肋，用一只脚勾住了绳子。天窗嘎吱嘎吱地打开，满天星斗，屋里一片欢呼。|爬上穹肋，沿着弧顶往外，一把抓住。绳子松了下来，圆顶像巨人醒来似的呻吟着打开了。|抓手正好都在你希望的地方。上去，一抓，下来，星图还没展开，天空已经敞开了。}
# en: {Halfway up a rib turns slippery with dew and you come down a lot faster than you went up. The rope stays where it is.|You get a hand to the rope and the pulley bites your fingers. You let go of both.|You climb, reach, miss and hang there by your elbows while someone runs for the caretaker.}
opt.left.say.2 [583080] = {爬到一半，一根穹肋沾了露水变得滑溜，你下来的速度比上去快得多。绳子纹丝未动。|你一只手碰到了绳子，滑轮夹了你的手指。你两样都松开了。|你爬上去，伸手，没够着，用胳膊肘挂在那儿，有人跑去叫看守了。}
# en: Read the charts by lamplight instead
opt.right.label [d68028] = 借着灯光看星图
# en: {The caretaker comes up an hour later with a hook on a pole. By then you've learned the charts by heart, and the best of the sky has gone behind the hill.|You spread the charts on the floor and plot tonight's route across them instead. It isn't the same; it's not nothing.|You read by lamplight under the shut dome. When it finally opens, the moon is up and drowning half of what you came for.}
opt.right.say.1 [e88039] = {一个钟头后，看守拿着一根带钩的长杆上来了。那时你已经把星图背得滚瓜烂熟，最好的那片天空也落到山后去了。|你把星图摊在地板上，在上面规划今晚的观测路线。这不一样；但也不是什么都没有。|你在关着的圆顶下借着灯光读图。等它终于打开，月亮已经升起，你想看的有一半都被月光淹没了。}
# en: Step into the dark under the dome
opt.up.label [f0f458] = 踏进圆顶下的黑暗
# en: {You step into the shadow by the door and out of the shadow in the ribs, grab the rope, and step back down. The dome opens. A dozen star charts lower slowly as their owners stare at you.|Shadow to shadow, up into the dark of the dome and back. The rope slots onto its pulley with a clunk. Someone asks if you can do that for the bell tower.|You don't even put your charts down. A step into the dark, a tug, and the shutter rolls back on the whole sky.}
opt.up.say.1 [6430d2] = {你踏进门边的阴影，从穹肋间的阴影里踏出，抓住绳子，再一步踏回地面。圆顶打开了。十几张星图慢慢放了下来，它们的主人都盯着你。|影子到影子，上到圆顶的黑暗里又回来。绳子咔哒一声落回滑轮。有人问你能不能也去钟楼帮个忙。|你连星图都没放下。一步踏进黑暗，一拉，天窗向后卷开，露出整片天空。}

@event infirmary_slip_out
# en: One More Night
title [47564e] = 再住一晚
# en: {Sister Amaranth wants you in for "one more night, for observation". You feel completely fine and have three things due tomorrow.|One more night again. Sister Amaranth has started leaving your boots on the far side of the ward.|The bed by the window has your name on the slate in ink. "One more night," says Sister Amaranth, not as a question.}
text [a9f95a] = {阿玛兰斯修女要你“再住一晚，观察观察”。你觉得自己好得很，明天还有三样东西要交。|又是再住一晚。阿玛兰斯修女开始把你的靴子放到病房另一头去了。|靠窗那张床的石板上用墨水写着你的名字。“再住一晚。”阿玛兰斯修女说，不是在商量。}
# en: An infirmary ward at night, a student sitting up in a white bed fully dressed, a healer's lamp moving between beds at the far end.
scene [c74b0b] = 夜晚的医务室病房，一个学生穿戴整齐地坐在白色病床上，远处一盏医师的灯在病床间移动。
# en: Stay the night
opt.left.label [b1754d] = 住下
# en: {You stay. You sleep through two bells and the breakfast trolley and wake up much better than "completely fine" turned out to be. Your three things are now late.|You stay. She was right, irritatingly; you sleep like a dropped stone. Your essay, unwritten, waits.|You stay without arguing. Sister Amaranth notices, and gives you the good tonic, and a look that might be respect.}
opt.left.say.1 [e2cb3c] = {你住下了。你一觉睡过了两次钟响和早饭推车，醒来后发现，比起所谓的“好得很”，你现在好多了。那三样东西现在都迟交了。|你住下了。她是对的，真让人恼火；你睡得像块掉进井里的石头。你的论文还没写，就那么等着。|你没争辩就住下了。阿玛兰斯修女注意到了，给了你那瓶好药水，还有一个可能是尊重的眼神。}
# en: Argue your case
opt.right.label [c2ad84] = 为自己争取
# en: {You make a short, true, convincing case. She looks at you over her spectacles. "Go," she says. "Come back if it swells. Don't come back if it doesn't."|You tell her the true version of how fine you are, with the limp left in. She respects that and lets you go.|She lets you go with a tonic in your pocket and instructions you'll follow later, when you understand them.}
opt.right.say.1 [f4e4d3] = {你的陈述简短、真实、令人信服。她从眼镜上方看着你。“走吧，”她说，“肿了就回来。没肿就别回来。”|你把自己有多好的真实版本告诉了她，连那点跛都没瞒。她认可这一点，放你走了。|她放你走了，往你兜里塞了一瓶药水，还有几句叮嘱，你要过些日子才会明白、才会照做。}
# en: {She listens to every word, then points at the bed. You lie down. You don't remember falling asleep.|"No," says Sister Amaranth, which was always going to be the answer, and she says it while doing something else.|She lets you argue to the end, then writes "argued" on your slate, under your name.}
opt.right.say.2 [c4b33e] = {她听完了每一个字，然后指了指床。你躺下了。你不记得自己是怎么睡着的。|“不行。”阿玛兰斯修女说，答案本来就只会是这个，她说的时候手上还在忙别的。|她让你一直争到底，然后在你的石板上、名字下面写了“争辩过”。}
# en: Step out through the dark
opt.up.label [939587] = 从暗处溜出去
# en: {When her lamp turns, you step into the shadow behind the screen and out of the shadow by the door. In the morning there's a note on your desk in square handwriting. It says "Next time, ask."|You step out of the ward and into your own room's corner in one breath. You get your three things done. Sister Amaranth, of course, knows.|Shadow to shadow, past the beds, out. Your essay is finished by midnight. At breakfast Sister Amaranth puts a tonic by your plate without a word.}
opt.up.say.1 [b69da4] = {她的灯一转开，你就踏进屏风后的阴影，从门边的阴影里踏出来。第二天早上，你桌上有一张字迹方正的纸条。上面写着：“下次，先问。”|一口气，你从病房踏进了自己房间的角落。三样东西都完成了。阿玛兰斯修女当然知道。|影子到影子，穿过病床，出去了。半夜前你写完了论文。早饭时，阿玛兰斯修女一言不发地在你盘子旁放了一瓶药水。}

@event alchemy_lab_do_not_drop
# en: Do Not Drop
title [d4aebe] = 切勿掉落
# en: {A first-year at the top of the shelf ladder is reaching for a bottle labelled, in large letters, DO NOT DROP. It's sliding off their fingertips, over a bench crowded with people.|The same shelf, a different first-year, the same bottle. Someone has added AGAIN to the label.|The bottle is tilting before you've put your bag down. You'd swear it waits for you.}
text [d27a2b] = {一个一年级生站在架子梯的最高处，去够一个标签上用大字写着“切勿掉落”的瓶子。瓶子正从TA指尖滑出去，下面是挤满了人的工作台。|同一个架子，换了个一年级生，同一个瓶子。有人在标签上加了“又来”两个字。|你还没放下书包，瓶子就已经歪了。你敢发誓它是在等你。}
# en: A laboratory with tall shelves, a first-year on a ladder reaching for a bottle labelled DO NOT DROP, the bottle tilting off their fingertips over a crowded bench.
scene [f5abbb] = 一间立着高架子的实验室，一个一年级生站在梯子上去够一个标着“切勿掉落”的瓶子，瓶子正从指尖滑落，下面是拥挤的工作台。
# en: Dive and catch it
opt.left.label [af6772] = 扑过去接住
# en: {You catch it an inch above the bench. Everyone breathes out at once. The first-year comes down the ladder very carefully and shakes your hand for a long time.|Caught, with both hands, against your chest. You put it back on the shelf yourself, at the bottom.|You catch it one-handed without looking, which surprises you more than anyone. Somebody starts a sweepstake on next time.}
opt.left.say.1 [cd5c0f] = {你在离工作台一寸的地方接住了它。所有人同时松了一口气。那个一年级生小心翼翼地爬下梯子，握着你的手久久不放。|接住了，用两只手，抱在胸前。你亲手把它放回架子——放在最底层。|你看都没看，单手就接住了，最吃惊的是你自己。有人开始押注下一次。}
# en: {You touch it and it skips off your fingers and bursts on the floor. Everyone's eyebrows go blue, yours most.|You get a hand to it and slow it down. It still breaks, but only on your boots, which smoke politely for an hour.|You catch the first-year instead of the bottle. Both of you are blue until Thursday.}
opt.left.say.2 [20c5bb] = {你碰到了它，它从你指尖弹开，在地上炸开了。所有人的眉毛都变蓝了，你的最蓝。|你一只手碰到了它，减缓了下落。它还是碎了，不过只碎在你的靴子上，靴子礼貌地冒了一个钟头的烟。|你接住的是那个一年级生，不是瓶子。你们俩一直蓝到星期四。}
# en: Shout everyone back from the bench
opt.right.label [d3558b] = 喊大家离开工作台
# en: {"Back!" Everyone backs. The bottle hits the bench and the cloud goes up blue and harmless and smelling of pear drops. The bench is ruined; nobody is.|You clear the bench in a word. The bottle breaks; the first-year cries; the lecturer says it was the right call, in a voice that says it was an expensive one.|You shout before it's fallen. The bench clears; the bottle, perversely, lands upright.}
opt.right.say.1 [504c6a] = {“退后！”所有人都退了。瓶子砸在工作台上，腾起一团无害的蓝雾，一股水果硬糖味。工作台毁了；人都没事。|你一句话就清空了工作台。瓶子碎了；一年级生哭了；讲师说你做得对，那语气在说这代价可不小。|瓶子还没落，你就喊了出来。工作台空了；瓶子偏偏正着落地，一点事没有。}
# en: Throw a ward over the bench
opt.up.label [2a5b0d] = 在工作台上撑起护界
# en: {The bottle bursts on a pale shell an arm's length above everyone's heads. The cloud rolls off the ward like rain off a window. The first-year, still on the ladder, starts to clap.|A ward, flat over the bench like a tabletop. The bottle breaks on it and the cloud slides off into the sink. The lecturer writes your name down, in the good column.|{spell_level(ward) >= 2: You ward the bench and the first-year at once. Nothing touches anyone. Somebody asks you to teach them; you do, after.|You ward the bench, a little late; the cloud catches your sleeve. Your sleeve is blue. Nobody else is.}}
opt.up.say.1 [f0e91c] = {瓶子在众人头顶一臂高的一层淡色护壳上炸开。雾气从护界上滚落，像雨水从窗玻璃上滑下。梯子上的一年级生开始鼓掌。|一道护界，像桌面一样平铺在工作台上方。瓶子在上面摔碎，雾气滑进了水槽。讲师把你的名字记了下来，记在好的那一栏。|{spell_level(ward) >= 2: 你同时护住了工作台和那个一年级生。什么都没碰到任何人。有人请你教TA；事后你教了。|你护住了工作台，只是稍晚了一点；雾气沾上了你的袖子。你的袖子蓝了。别人都没事。}}

@event courtyard_hail
# en: Hail in the Courtyard
title [178de2] = 庭院里的冰雹
# en: {Hail comes out of a clear sky, stones the size of peas, then the size of marbles. A knot of first-years is caught in the middle of the courtyard with their books over their heads.|Hail again, the courtyard's speciality. The first-years know to run now; they just don't know where.|The sky goes white and the hail comes down like a dropped tray of beads. {season == "summer": In summer, which is insulting.|The fountain rings with it.}}
text [7ccd74] = {晴空里落下冰雹，起先像豌豆那么大，后来像弹珠那么大。一群一年级生被困在庭院中央，把书顶在头上。|又下冰雹了，这是庭院的特产。一年级生现在知道要跑了；只是不知道往哪儿跑。|天空一白，冰雹像打翻了一盘珠子似的砸下来。{season == "summer": 还是在夏天，简直是侮辱。|喷泉被砸得叮当作响。}}
# en: A castle courtyard in a sudden hailstorm, first-years caught in the open with their arms over their heads, white stones bouncing off the flagstones.
scene [23c11c] = 突降冰雹的城堡庭院，一年级生们被困在空地上，双臂护着头，白色的冰粒在石板上弹跳。
# en: Herd them into the cloister
opt.left.label [985672] = 把他们赶进回廊
# en: {You wave them into the cloister and take the last of the hail on your own back. One of them gives you a sugar mouse from their pocket, warm and slightly squashed.|You get them all in and count them twice. Your ears ring for an hour from the stones.|You herd them like ducks into the cloister, the stones bouncing off your shoulders. One of them says thank you in a very small voice.}
opt.left.say.1 [56a32a] = {你挥手把他们赶进回廊，最后一阵冰雹全砸在你自己背上。其中一个从口袋里掏出一只糖老鼠给你，温温的，有点压扁了。|你把他们全带了进去，还数了两遍。冰雹砸得你耳朵嗡嗡响了一个钟头。|你像赶鸭子一样把他们赶进回廊，冰雹从你肩头弹开。其中一个用很小很小的声音说了声谢谢。}
# en: Run for cover yourself
opt.right.label [d4ce6f] = 自己先找地方躲
# en: {You make the cloister in six strides and watch them work it out for themselves. They do, eventually, damply.|You run. A prefect gets them in. You feel you were quicker than you should have been.|Cover first. From the cloister you shout directions, which helps a little and makes you feel better a lot.}
opt.right.say.1 [d40d8d] = {你六步跨进回廊，看着他们自己想办法。他们最后想出来了，湿漉漉的。|你跑了。一位级长把他们带了进去。你觉得自己跑得比应该的快。|先顾自己。你在回廊里朝外面喊着指路，帮了一点小忙，让自己心里好受了许多。}
# en: Raise a ward over them
opt.up.label [e586fe] = 在他们头上撑起护界
# en: {You throw up a ward like a roof and the hail bounces off it in a white roar. The first-years stand under it, dry, looking up at you as if you'd hung the sky.|A pale shell over the knot of them. The hail drums on it like rain on a tent. Somebody under it starts to sing.|You walk them across the courtyard under a ward, slowly, like a procession. Half the castle is watching from the windows. You don't hurry.}
opt.up.say.1 [d4383f] = {你撑起一道像屋顶一样的护界，冰雹在上面弹开，一片白茫茫的轰响。一年级生们站在下面，干干爽爽，抬头看你，好像天是你挂上去的。|一层淡色的护壳罩住了这群人。冰雹敲在上面，像雨点打在帐篷上。下面有人唱起了歌。|你撑着护界，领着他们慢慢穿过庭院，像一支游行队伍。半座城堡都在窗口看着。你一点也不急。}

@event lakeshore_swan
# en: The Swan
title [f3d181] = 天鹅
# en: {A first-year has wandered into the reeds too close to the swans' nest. The cob is coming out of the water with his wings up, hissing like a kettle.|The swans are nesting again. The cob has grown, or your memory of him has, and there's a first-year in the reeds.|The cob sees you from across the lake and starts hissing in advance.}
text [53f410] = {一个一年级生钻进芦苇丛，离天鹅窝太近了。那只雄天鹅张着翅膀从水里冲出来，嘶嘶叫得像一把水壶。|天鹅又在筑巢了。那只雄天鹅长大了，或者是你记忆里的它长大了，而芦苇丛里又有一个一年级生。|雄天鹅隔着湖就看见了你，提前嘶嘶叫起来。}
# en: A reedy lakeshore, a huge white swan with wings raised and neck lowered, hissing at a first-year who has wandered too close to its nest.
scene [eae669] = 长满芦苇的湖岸，一只巨大的白天鹅张开翅膀、压低脖子，冲着一个离窝太近的一年级生嘶叫。
# en: Step between them
opt.left.label [f242e3] = 挡在他们中间
# en: {You step between them with your arms out wide and hiss back. The cob considers this, and decides you are the bigger swan. The first-year runs.|You stand your ground, slowly, talking nonsense in a low voice. He lowers his wings an inch, then another, then goes back to the nest.|He knows you by now, and you know him. You both posture, politely, until the first-year is clear.}
opt.left.say.1 [39f757] = {你张开双臂挡在中间，也冲它嘶嘶叫。雄天鹅琢磨了一下，认定你是更大的那只天鹅。一年级生跑了。|你慢慢地站稳脚跟，低声说着胡话。它把翅膀放低了一寸，又一寸，然后回窝去了。|它现在认得你了，你也认得它。你们俩客客气气地摆着架势，直到一年级生脱身。}
# en: {He hits you with a wing like a flung door. The first-year gets away; you get a bruise the size of a plate.|You step in and the cob takes it personally. You retreat across the reeds at speed, honked at.|You take one wing and then a bite on the ankle. The first-year helps you limp home, which seems backwards.}
opt.left.say.2 [799431] = {它一翅膀扇过来，像一扇甩过来的门。一年级生逃掉了；你得到一块盘子大的淤青。|你一挡上去，雄天鹅就当成了私人恩怨。你飞快地撤过芦苇丛，身后一路被它冲着叫。|你挨了一翅膀，脚踝又被咬了一口。最后是那个一年级生扶着你一瘸一拐地回去，这好像反过来了。}
# en: Shout for them to run
opt.right.label [62f02f] = 喊他们快跑
# en: {"Run!" The first-year runs, the cob chases them twenty yards, and everyone ends up in the lake except you.|You shout, they run, the cob gets a mouthful of their scarf. They don't get the scarf back.|You shout from a safe distance. It works, mostly. The first-year limps into the infirmary with a story they'll tell for years.}
opt.right.say.1 [005fd0] = {“快跑！”一年级生跑了，雄天鹅追了二十码，最后除了你，所有人都掉进了湖里。|你一喊，TA就跑，雄天鹅叼住了TA的围巾。围巾再也没要回来。|你在安全距离外喊话。基本管用。那个一年级生一瘸一拐地进了医务室，带着一个能讲好多年的故事。}
# en: Put a ward between them
opt.up.label [5e969d] = 在他们之间撑起护界
# en: {A pale shell springs up between the cob and the first-year. He beats his wings on it twice, offended, then sails back to his nest with enormous dignity.|You ward the first-year and walk them out of the reeds inside it. The cob hisses at the ward all the way, and the ward doesn't mind.|A ward, and a slow walk, and the swans left in peace. The cob watches you go, and you'd swear he nods.}
opt.up.say.1 [bb7207] = {一层淡色的护壳在雄天鹅和一年级生之间撑了起来。它气呼呼地扑打了两下，然后无比庄严地游回了窝里。|你用护界罩住那个一年级生，带着TA从芦苇丛里走出来。雄天鹅一路冲着护界嘶叫，护界毫不在意。|一道护界，一段慢慢的路，天鹅们得以安宁。雄天鹅目送你离开，你敢发誓它点了点头。}
