# Lumenhold Academy — 简体中文 (zh-CN) translation of content/events/pools/castle_halls.grim
# Maintained by `node tools/grim.js i18n zh-CN`. Translate the text after "="; keep {tokens}.
# "# en:" shows the English source. [hash] marks the English version a line was translated from;
# lines marked STALE need updating — after fixing the text, delete the [hash] and re-run the tool.


@event courtyard_sundial_bench
# en: The Slow Sundial
title [eef7f9] = 慢吞吞的日晷
# en: {There's a bench by the old sundial, which runs eleven minutes slow.|Someone has scratched a tiny "+11" by the dial's noon. A fellow sufferer.|The sundial bench is yours by custom. A first-year asked if you came with it.} {season == "winter": Frost fills the hour lines, and the shadow skates across them.|{~Pigeons are holding a meeting on the gnomon.|A first-year checks a watch against it, horrified.|Someone has chalked a face where noon should be.}}
text [dcbbbc] = {老日晷旁有一张长椅。这日晷慢十一分钟。|有人在晷面正午旁刻了个小小的“+11”。同病相怜的人。|日晷长椅按惯例归你了。有个一年级生问过，你是不是和它配套的。} {season == "winter": 霜填满了时刻刻线，影子在上面滑冰。|{~一群鸽子正在晷针上开会。|一个一年级生拿怀表对它，吓坏了。|有人在正午的位置用粉笔画了张脸。}}
# en: A stone bench beside a weathered sundial in a flagstone courtyard, a student reading with their back to the dial.
scene [549ef0] = 石板庭院里，一张石凳挨着一座饱经风霜的日晷，一个学生背对晷面读书。
# en: Read until the shadow moves
opt.left.label [7b2740] = 读到影子挪动为止
# en: {season == "winter": {~Your fingers go numb by page two. The chapter is worth it.|You read in gloves, turning pages with your teeth.}|{~You finish a chapter in the minutes the sundial owes you, squinting into the glare.|A pigeon reads over your shoulder, unimpressed, and your neck has a crick in it by the end.|The shadow crawls; you outpace it by three pages and a stiff back.}}
opt.left.say.1 [a0fbd0] = {season == "winter": {~读到第二页手指就冻麻了。这一章值得。|你戴着手套读，用牙齿翻页。}|{~日晷欠你的那几分钟，够你眯着眼迎着日光读完一章。|一只鸽子凑在你肩头一起读，不以为然；读完时你的脖子也僵了。|影子慢慢爬，你领先它三页，背也坐僵了。}}
# en: Close your eyes a while
opt.right.label [64f7ca] = 闭眼歇一会儿
# en: {~You wake with a chalk moustache and no suspects.|You wake to a prefect clearing his throat an inch from your ear.|You wake rested and late, eleven minutes late by the dial.}
opt.right.say.1 [5659ef] = {~你醒来时脸上多了粉笔胡子，却找不到嫌疑人。|你醒来时，一位级长正贴着你耳边清嗓子。|你醒来时神清气爽，也迟到了——按日晷算，正好迟到十一分钟。}

@event courtyard_saved_seat
# en: A Seat on the Rim
title [c87795] = 喷泉边的座位
# en: {{here} has claimed the dry stretch of the fountain rim and waves you over.|{here} is on your favourite stretch of the fountain rim, the one the sun reaches first, and waves you over.|Your stretch of the fountain rim is known now. {here} is sitting on it and shifts over without being asked.} {~Two towers' bells are arguing about the hour.|Pigeons circle like creditors.|{season == "winter": Your breath hangs between you.|Someone's lunch smells better than yours.}}
text [0fa2f5] = {{here}占了喷泉边沿上干燥的一段，朝你招手。|{here}坐在你最喜欢的那段喷泉边沿上——太阳最先照到的那段——朝你招手。|喷泉边沿上你的那一段如今人尽皆知。{here}正坐在上面，不等你开口就挪了挪。} {~两座塔的钟正为几点钟争执不休。|鸽子像债主一样盘旋。|{season == "winter": 你们之间呵出的白气悬在半空。|别人的午饭闻起来比你的香。}}
# en: Two students sitting on the dry edge of a courtyard fountain, bags between them, pigeons circling overhead.
scene [9547e3] = 两个学生坐在庭院喷泉干燥的边沿上，书包放在中间，鸽子在头顶盘旋。
# en: Sit down and catch up
opt.left.label [ebe7f0] = 坐下聊聊
# en: {~Corvin tells you three stories, one of them true, and calls you "saint" when you don't ask which.|Corvin spots a prefect, palms something off the rim, and goes on talking as if nothing happened.}
opt.left.say.1 [3afeb8] = {~科尔文给你讲了三个故事，只有一个是真的；你没问是哪个，他便叫你“圣人”。|科尔文瞥见一位级长，从边沿上顺走了什么，接着若无其事地往下说。}
# en: {~Nessa interviews you about the weather, the soup and your love life, in that order, and writes down all three.|Nessa reads you tomorrow's headline and asks if it's too cruel. It is. She keeps it.}
opt.left.say.2 [d2957f] = {~内莎就天气、汤和你的感情生活依次采访了你，三样都记了下来。|内莎给你念明天的头条，问是不是太刻薄了。是的。她决定照登。}
# en: {~Bram lists every rule broken in the courtyard while you sit. Then, gruffly, he asks how your exams went.|Bram writes a demerit for a passing first-year, then tears it up when he thinks you aren't looking.}
opt.left.say.3 [397168] = {~你坐着的工夫，布拉姆把庭院里违反的校规一条条数了一遍。然后，他粗声粗气地问你考得怎么样。|布拉姆给路过的一年级生记了一次过，以为你没看见时又把单子撕了。}
# en: {~You trade the castle's news for an hour. {here} does most of the trading.|You talk until the shadows cross the fountain. Neither of you can remember about what.}
opt.left.say.4 [1508f0] = {~你们交换了一小时城堡新闻，大多是{here}在说。|你们一直聊到影子爬过喷泉，谁也想不起聊了些什么。}
# en: The cider from the cart by the gate is on you.
opt.left.say.5 [e9717b] = 城门边小推车上的苹果酒，算你请的。
# en: Wave, and keep walking
opt.right.label [ff1be9] = 挥挥手，继续走
# en: {~You promise next time and take your book to the library instead. {here} looks as if {they} {are} counting.|You spend the hour with a book instead. It is a good book; it is not much company.}
opt.right.say.1 [2575b9] = {~你说下次一定，拿着书去了图书馆。{here}看上去像是在记账。|你改和一本书待了一小时。书很好，只是不太能陪人。}

@event courtyard_seasonal_game
# en: The Courtyard Game
title [bfcc17] = 庭院游戏
# en: {season == "winter": A snowball war between Emberhall and Stillwater has reached the treaty stage.|{season == "spring": A charmed ball is loose, dodging everyone who kicks at it.|{season == "summer": It's too hot for sport, so it's catch with a charmed apple that bites.|It's conker season. The champion conker is said to be older than the fountain.}}} {Someone shouts for one more player.|They shout for you by name.|Both sides shout for you, and start bidding.}
text [d0e0af] = {season == "winter": 烬厅和静水之间的雪仗已经打到了签订和约的阶段。|{season == "spring": 一只施了魔法的球在庭院里乱窜，谁去踢就躲谁。|{season == "summer": 天太热，没法运动，于是改玩抛接一只会咬人的魔法苹果。|七叶树果大战的季节到了。据说那颗冠军果比喷泉还老。}}} {有人喊着还差一个人。|这回他们直接喊你的名字。|两边都在喊你，还开始竞价。}
# en: Students playing a rowdy game across a flagstone courtyard while others crowd the edges shouting bets.
scene [9846ca] = 学生们在石板庭院里玩得热火朝天，旁边围着的人大声下注。
# en: Join in
opt.left.label [a87be8] = 加入
# en: {~Your side wins, and the result is disputed until supper.|You score the deciding point and are carried three whole steps before they drop you.}
opt.left.say.1 [4a86ad] = {~你们这边赢了，比分一直争到晚饭。|你拿下了制胜一分，被大家抬着走了整整三步，然后摔了下来。}
# en: {~You are flattened, politely, by both sides at once.|You spend the rest of the game as the thing the other side aims at.}
opt.left.say.2 [af1171] = {~你被两队人马同时、礼貌地压扁了。|余下的比赛里，你成了对方瞄准的那个东西。}
# en: Hold the coats and the bets
opt.right.label [175f1b] = 帮忙看外套和赌注
# en: {~The favourite loses. You are the only person in the courtyard who is pleased about it.|The underdog wins by a whisker, and the coats you are holding are suddenly lighter on your conscience.}
opt.right.say.1 [445a49] = {~大热门输了。整个庭院里只有你一个人高兴。|冷门险胜，你手里抱着的外套忽然让你良心轻了不少。}
# en: {~The favourite wins, and so does everyone who backed them, out of your pocket.|Everyone bet the same way, and everyone was right. You pay out in a hail of small coins.}
opt.right.say.2 [68429d] = {~大热门赢了，押它的人也都赢了——钱从你兜里出。|大家都押了同一边，也都押对了。你在一阵小硬币的冰雹里赔了钱。}
# en: The favourite wins. With nothing in your pocket to pay out, you're chased twice round the fountain and lose a coat button to the crowd.
opt.right.say.3 [69835b] = 热门赢了。你口袋里一个子儿也没有，赔不出钱，被人追着绕喷泉跑了两圈，还在人堆里丢了一颗外套扣子。

@event library_wandering_book
# en: The Book That Moved
title [fe710d] = 会挪窝的书
# en: {Yesterday your book was on the third floor. Today the third floor has never heard of it.|Your book has moved again, leaving a bookmark in the gap, like a note.|You keep a map of where the shelves hide your books. They've started hiding the map.} {~In its place is a shelf of cookery spells.|In its place are bound weather reports.|In its place is one slim volume, face out, waiting.} {final_year: Soon they'll play these games with someone else.|}
text [4356c6] = {昨天你要的书还在三楼。今天三楼说从没听说过它。|你的书又挪走了，空位上留了一张书签，像一张字条。|你画了一张书架藏书的地图。书架开始藏那张地图了。} {~原位上是一架烹饪咒语。|原位上是一排装订好的天气报告。|原位上只有一本薄薄的书，封面朝外，像在等你。} {final_year: 很快，它们就要和别人玩这种游戏了。|}
# en: Tall library shelves leaning very slightly, a gap where one book should be, a student on a ladder peering into it.
scene [d131b1] = 高高的书架微微倾斜，本该放一本书的地方空着，一个学生站在梯子上往缝里瞧。
# en: Hunt it down
opt.left.label [e1addf] = 把它找出来
# en: {You find it on the sixth floor, filed under "regret".|You find it in the stairwell, halfway between floors, as if it had been trying to leave.|You find it at once. Either you are learning the shelves, or they are getting lazy.}
opt.left.say.1 [05a6d5] = {你在六楼找到了它，归在“悔恨”类下。|你在楼梯间找到了它，卡在两层之间，好像它正打算出走。|你一下子就找到了。要么是你摸透了书架，要么是书架变懒了。}
# en: Read what's in front of you
opt.right.label [5bdb99] = 读手边这本
# en: {~You read the wrong book with great conviction, and quote it at supper.|You learn a great deal about something nobody will ever ask you about.|The wrong book turns out to be a very good novel. You read all of it, and none of it will be on any exam.}
opt.right.say.1 [101f3f] = {~你满怀信心地读了一本错的书，晚饭时还引用了它。|你学到了大量永远不会有人问起的知识。|读错的书原来是一本很好的小说。你把它读完了，而里面没有一个字会出现在考试里。}

@event library_shared_table
# en: The Last Free Chair
title [694ef7] = 最后一把空椅子
# en: {The library is full. The only free chair is opposite {here}.|The only free chair is opposite {here}. A shelf has leaned over it, as if keeping it for you.|The library knows your habits now. The free chair, opposite {here}, has a book you wanted waiting on it.} {~Rain ticks on the tall windows.|A shelf nearby is quietly rearranging itself.|Footnote is asleep in the returns basket.|{season == "winter": The radiators clank like a ghost with a grudge.|Dust turns gold in the light.}}
text [85baec] = {图书馆满了。唯一的空椅子在{here}对面。|唯一的空椅子在{here}对面。一个书架斜靠在椅子上方，像在替你占座。|图书馆已经摸清了你的习惯。{here}对面那把空椅子上，放着一本你想看的书在等你。} {~雨点敲着高窗。|附近的书架正悄悄自己重新排列。|“脚注”睡在还书筐里。|{season == "winter": 暖气片哐哐作响，像个怀恨在心的幽灵。|灰尘在光里变成金色。}}
# en: A crowded library reading room, every table full but one, a single empty chair facing a student absorbed in a book.
scene [b58e03] = 拥挤的图书馆阅览室，所有桌子都坐满了，只有一把空椅子，对面是个埋头读书的学生。
# en: Take the chair and work
opt.left.label [4d48da] = 坐下来用功
# en: {~Kael doesn't look up. By the end of the hour there is frost on your inkwell and a tiny, careful correction in your margin.|Kael pushes a page of his notes across to you, then looks away as if it had moved on its own.}
opt.left.say.1 [8926ef] = {~凯尔没有抬头。一小时后，你的墨水瓶上结了霜，页边多了一处细小工整的订正。|凯尔把一页笔记推到你面前，然后移开视线，仿佛那页纸是自己挪过去的。}
# en: {~Lyra slides the candle an inch toward your side without looking up. Neither of you mentions it.|Lyra finishes before you, and waits, and says she wasn't waiting.}
opt.left.say.2 [38a29a] = {~莱拉头也不抬，把蜡烛往你这边推了一寸。你们谁也没提。|莱拉比你先写完，却等着你，还说她没在等。}
# en: {~Seraphine writes a word in your notes that you won't understand until next week.|Seraphine reads the same page for an hour, smiling at something that isn't on it.}
opt.left.say.3 [395056] = {~瑟拉芬在你的笔记上写了一个词，你要到下周才会明白。|瑟拉芬对着同一页读了一小时，冲着一件不在书上的事微笑。}
# en: {~Bram informs you that you breathe too loudly. Then he lends you his ruler.|Bram underlines every rule in his book twice. Once, he asks your opinion of one.}
opt.left.say.4 [f53329] = {~布拉姆通知你：你呼吸太大声了。然后他把尺子借给了你。|布拉姆把书里每一条规则都划了两道线。有一次，他问你对其中一条怎么看。}
# en: {~You work in silence for an hour, which turns out to be a kind of company.|Neither of you speaks. Both of you get further than you would have alone.}
opt.left.say.5 [279cd0] = {~你们默默用功了一小时，原来这也算一种陪伴。|你们谁也没说话，却都比一个人时走得更远。}
# en: Whisper a question
opt.right.label [1952d6] = 小声问个问题
# en: {~The conversation is worth it. The look from the front desk has a long memory.|You get three sentences in before a shush arrives from two floors up.}
opt.right.say.1 [fa0472] = {~这番交谈很值。只是前台投来的那一眼，记性很长。|你刚说了三句，两层楼上就传来一声“嘘”。}

@event library_overdue
# en: Overdue
title [40f62b] = 逾期
# en: {The book you borrowed in a hurry is overdue, and the library knows it. The spine has started to sigh.|Another overdue book. The front desk has begun keeping a little card with your name on it.|Your overdue books sigh in chorus now, and the card at the front desk has a second side.} {~Footnote watches you approach the returns basket with professional interest.|The front desk is, for once, unattended.|A queue of first-years is paying fines in small, sad coins.}
text [6edf21] = {你匆忙借的那本书逾期了，图书馆心知肚明。书脊开始叹气。|又一本逾期的书。前台开始为你单独留一张写着你名字的小卡片。|你的逾期书现在齐声叹气，前台那张卡片已经写到了背面。} {~“脚注”以专业的兴趣看着你走近还书筐。|前台难得没人。|一队一年级生正用小小的、可怜的硬币交罚款。}
# en: A student holding a book behind their back near a wicker returns basket, a cat on the front desk watching them.
scene [9136c2] = 一个学生把书藏在身后，靠近一只柳条还书筐，前台上的猫盯着他们。
# en: Own up and pay the fine
opt.left.label [1ffaa0] = 认错交罚款
# en: {The fine is paid; the desk, mollified, lends you the sequel.|You pay, and are lent another book, which you suspect is a trap.|The desk sighs, takes your coins and hands you a book it says you'll like. It is always right, which is the annoying part.}
opt.left.say.1 [e1d0b0] = {罚款交了，前台消了气，把续集借给了你。|你交了钱，又被借了一本书，你怀疑这是个圈套。|前台叹口气，收下硬币，递给你一本说你会喜欢的书。它总是对的，这才让人恼火。}
# en: You own up with empty pockets. The desk lets you work the fine off reshelving, which takes all evening, and lends you the sequel anyway.
opt.left.say.2 [6ba749] = 你两手空空地去认错。前台让你靠整理书架抵罚款，整整花了一个晚上，还照样把续集借给了你。
# en: Slip it into the basket
opt.right.label [aa0b65] = 偷偷塞进还书筐
# en: {~The book goes in without a sound. It stops sighing at once, which feels like forgiveness.|You drop it in under cover of a sneeze. Footnote saw. Footnote will keep it to himself, for a price.}
opt.right.say.1 [bc9c6d] = {~书悄无声息地滑了进去，立刻不再叹气，像是原谅了你。|你借着一个喷嚏把书丢了进去。“脚注”看见了。“脚注”会替你保密——有代价的。}
# en: {~The book announces itself with a sigh like a dying organ. Everyone turns. You pay double.|It lands with a groan. The front desk adds a mark to your card, and the fine, doubled.}
opt.right.say.2 [d005ec] = {~那本书发出一声垂死管风琴般的叹息，宣告了自己的到来。所有人都回过头。你交了双倍罚款。|书落进筐里，呻吟了一声。前台在你的卡片上又记了一笔，罚款翻倍。}
# en: The book announces itself with a sigh like a dying organ. Everyone turns. With nothing to pay, you're put on reshelving until the fine is worked off twice over.
opt.right.say.3 [cb93a1] = 那本书发出一声垂死管风琴般的叹息，宣告了自己的到来。所有人都回过头。你没钱可付，只好去整理书架，直到把双倍罚款抵完。

@event refectory_late_supper
# en: Late Supper
title [095a3c] = 晚来的晚饭
# en: {You come in late. The benches are empty and the cooks are wiping the far tables.|The cook leaves a lamp lit at the end of the bench now, where the draught can't find you.|Your late bowl is waiting under a plate, with a spoon laid beside it. Nobody admits to it.} {year == 1: Home feels very far away tonight.|{final_year: You count the suppers you have left, and stop.|{~The candles are down to stubs.|Someone has left a half-done puzzle on the next table.}}}
text [9c5052] = {你来晚了。长凳都空着，厨工们在擦远处的桌子。|厨娘现在会在长凳尽头、穿堂风找不到的地方给你留一盏灯。|你那碗晚饭扣在盘子下等着你，旁边摆好了勺子。没人承认是谁放的。} {year == 1: 今晚，家显得格外遥远。|{final_year: 你数了数还剩几顿这样的晚饭，然后不数了。|{~蜡烛快烧到底了。|有人在隔壁桌上留了一幅拼了一半的拼图。}}}
# en: The far end of a long refectory table at night, most benches empty, a single student with a bowl and a half-written letter.
scene [0600ae] = 深夜膳堂长桌的尽头，大部分长凳空着，一个学生面前放着一只碗和一封写了一半的信。
# en: Write a letter home
opt.left.label [67bcd4] = 给家里写信
# en: {~You write two pages and post them with the last of your coppers.|You write about the food. You do not write about anything else, but they'll know.|You write a letter that is mostly questions. You post it before you can make it braver.}
opt.left.say.1 [988bf2] = {~你写了两页，用最后几枚铜板寄了出去。|你写了饭菜，别的什么都没写，但他们会懂的。|你写了一封几乎全是问题的信，趁自己还没想把它写得更勇敢之前寄了出去。}
# en: Revise over the bowl
opt.right.label [5fbeee] = 边吃边复习
# en: {~You learn three dates and a spill of gravy across all of them.|The cook reads over your shoulder and corrects one of your answers. She is right.}
opt.right.say.1 [1b9554] = {~你记住了三个年份，还有一摊洒在上面的肉汁。|厨娘从你肩后看了一眼，改正了你的一个答案。她是对的。}

@event refectory_house_tables
# en: Where to Sit
title [3b38cd] = 坐哪儿
# en: {Supper, and the question of where to sit.|Your house table has started saving a gap on the bench, roughly your width.|The gap is a named seat now, and the quiet table nods at you too.} Your house table is {~loud with a story about a goat|in the middle of a pudding treaty|singing, badly}. At the far end, {season == "winter": some second-years from Rootward huddle round a warming charm.|some second-years from Duskgate are arguing quietly about a map.}
text [386628] = {晚饭时间，又是那个问题：坐哪儿。|你们学院那桌开始在长凳上留一个空位，差不多你那么宽。|那个空位现在有了名字，安静的那桌也会朝你点头了。} 你们学院那桌{~正在大声讲一个关于山羊的故事|正在谈判一份布丁和约|正在唱歌，唱得很难听}。远处那头，{season == "winter": 几个根庐的二年级生围着一个取暖咒挤成一团。|几个暮门的二年级生正低声争论一张地图。}
# en: A crowded refectory at suppertime, a student standing with a tray between a loud house table and a quieter one of strangers.
scene [6196b3] = 晚饭时拥挤的膳堂，一个学生端着托盘站在一张喧闹的学院长桌和一张陌生人的安静桌子之间。
# en: Squeeze in with your house
opt.left.label [956401] = 挤进自己学院那桌
# en: {~You eat with an elbow in your ribs and laugh the whole way through.|Somebody's story gets better every time you hear it. So does the pudding.}
opt.left.say.1 [9bee35] = {~你肋下顶着别人的胳膊肘吃完了饭，从头笑到尾。|有人的故事每听一遍就更精彩一点，布丁也是。}
# en: Sit with the strangers
opt.right.label [88cc69] = 和陌生人坐一起
# en: {~They are polite, then curious, then actually rather good company.|It is awkward for exactly one course. By pudding, they have told you their secret map route.}
opt.right.say.1 [457b18] = {~他们先是客气，然后好奇，然后竟成了相当不错的伙伴。|尴尬只持续了一道菜。到布丁时，他们已经把秘密地图路线告诉了你。}

@event refectory_pudding_tax
# en: The Pudding Tax
title [03d210] = 布丁税
# en: {{friend} sits down opposite you and looks at your pudding the way a cat looks at a fish.|Your pudding has a reputation now. {friend} sits down opposite you with a spoon already in hand.|Word of your pudding tax has got round the refectory. Tonight {friend} comes to collect, with a little receipt.} {season == "winter": Tonight it's treacle sponge, steaming.|{~Tonight it's apple crumble.|Tonight it's a custard that wobbles with intent.}}
text [c994f2] = {{friend}在你对面坐下，看你的布丁就像猫看鱼。|你的布丁如今声名在外。{friend}在你对面坐下，勺子已经握在手里。|你的布丁税已经在膳堂传开了。今晚{friend}来收税，还带着一张小收据。} {season == "winter": 今晚是热气腾腾的糖浆海绵布丁。|{~今晚是苹果酥。|今晚是一份意图不明地颤动着的蛋奶冻。}}
# en: Two friends at a refectory table, one guarding a bowl of treacle pudding, the other holding a spoon at the ready.
scene [2f960a] = 膳堂桌边的两个朋友，一个护着一碗糖浆布丁，另一个举着勺子随时准备出手。
# en: Pay the pudding tax
opt.left.label [7c4562] = 交布丁税
# en: {~Tobias apologises four times, eats it all, then tells you a long story about a goat who did the same. It helps, somehow.|Tobias eats half, then pushes the bowl back with a sprig of mint from his pocket on top, as an apology.}
opt.left.say.1 [20994e] = {~托比亚斯道了四次歉，把它吃得一干二净，然后给你讲了个长长的故事，说一只山羊也干过这种事。不知怎么，这让你好受了些。|托比亚斯吃了一半，把碗推回来，上面放着一枝从口袋里掏出的薄荷，算是赔礼。}
# en: {~"Efficient," Lyra says, finishing it. The next day a whole pudding appears on your tray. She doesn't mention it.|Lyra eats it in four exact bites and critiques the custard. She does not give it back.}
opt.left.say.2 [672475] = {~“高效。”莱拉吃完说道。第二天，你的托盘上出现了一整份布丁。她只字未提。|莱拉精确地四口吃完，还点评了蛋奶酱。她没还给你。}
# en: {~Mir eats it while explaining a pudding-defence device that would probably work. Probably.|Mir eats it with a spoon they built themselves, which hums. They say the humming is probably normal.}
opt.left.say.3 [28f29e] = {~米尔边吃边讲解一种防布丁被偷的装置，说大概能用。大概。|米尔用自己做的勺子吃，那勺子嗡嗡作响。TA说嗡嗡响大概是正常的。}
# en: {~{friend} eats exactly half and leaves you the burnt corner.|{friend} eats it slowly, savouring your defeat.}
opt.left.say.4 [565aa6] = {~{friend}正好吃了一半，把烤焦的那角留给了你。|{friend}慢慢地吃，细细品味你的失败。}
# en: Defend your pudding
opt.right.label [c73449] = 捍卫你的布丁
# en: {~You hide it under a napkin and point at the window. It works. {friend} will remember this.|You claim it's been sneezed on. {friend} retreats in disgust, and you eat in peace.}
opt.right.say.1 [38d242] = {~你把它藏在餐巾下，指着窗外。成功了。{friend}会记住这一笔的。|你声称有人对着它打过喷嚏。{friend}嫌恶地退却，你安心吃完。}
# en: {~{friend} sees straight through you and takes the whole thing as a penalty. It is hard to stay cross.|{friend} distracts you with a story and the bowl is empty before it ends.}
opt.right.say.2 [03e22f] = {~{friend}一眼看穿了你，把整份没收作为罚款。很难一直生气。|{friend}用一个故事分散你的注意力，故事还没讲完碗就空了。}

@event lecture_tower_old_board
# en: Someone Else's Lecture
title [108850] = 别人的课
# en: {term: {The fourth-floor hall is empty, but someone else's lecture is still on the board.|In the empty hall, a stub of chalk waits on the ledge, as if for you.|The board has a corner fenced off in chalk, labelled "answers here".}|In the break the boards are wiped, except one nobody dares touch.} {~Today it's a ward diagram, labelled "wrong, but how?"|Today it's half a proof, ending in a thumbprint.|Today it's a list headed "on the exam", crossed out.}
text [e6e2e7] = {term: {四楼的讲堂空着，黑板上却还留着别人的课。|空讲堂里，一截粉笔头在槽里等着，像是留给你的。|黑板角上用粉笔圈出一块，标着“答案写这里”。}|假期里黑板都擦干净了，只有一块没人敢碰。} {~今天是一幅护界图，标注着“错了，但错在哪？”|今天是半个证明，结尾是一枚指纹。|今天是一张题为“会考的内容”的清单，被划掉了。}
# en: An empty spiral lecture hall, a blackboard still dense with chalk diagrams from a class that has long gone.
scene [b21ec8] = 空荡荡的螺旋讲堂，黑板上还密密麻麻留着一堂早已散场的课的粉笔图解。
# en: Copy it all down
opt.left.label [71d09a] = 全部抄下来
# en: {~Your hand cramps. Your head, for once, does not.|You copy it all and understand most of it. The rest you'll grow into.}
opt.left.say.1 [182650] = {~你的手抽筋了。你的脑子却难得没有。|你全抄了下来，大部分都懂。剩下的，你会慢慢长进去。}
# en: Add your own answer
opt.right.label [b05ba7] = 写上你的答案
# en: {~Next time, someone has added "yes!" under your line.|Someone has answered your answer. The board has become a correspondence.|By the afternoon someone has drawn a box around your line, to keep it safe.}
opt.right.say.1 [8250cf] = {~下次再来，有人在你那行下面加了个“对！”|有人回答了你的回答。黑板成了一场书信往来。|到了下午，有人在你那行字周围画了个框，好好护着。}
# en: {~The professor whose board it was finds you holding the chalk. "Hm," says the look.|Your answer is wiped by the time you reach the door, by someone who knew better.}
opt.right.say.2 [f25454] = {~那块黑板的主人——一位教授——撞见你手里拿着粉笔。那一眼在说：“嗯。”|你还没走到门口，你的答案就被一个更懂行的人擦掉了。}

@event lecture_tower_stair_question
# en: One Question a Flight
title [d64af4] = 一层楼一个问题
# en: {You meet Professor Thorne on the spiral stair. He allows one question per flight, and climbs fast.|Professor Thorne on the stair. He has slowed down by about one step in seven, which is how you know he expects you.|Thorne hands you half his stack of papers at the foot of the stair, without a word, and starts climbing.} {term: |The tower is half empty for the break; your footsteps echo twice.}{final_year: There are not many of these climbs left.|}
text [fa2b42] = {你在螺旋楼梯上遇见索恩教授。他允许每层楼问一个问题，而且爬得很快。|楼梯上的索恩教授。他每七级台阶慢下一级，你由此知道他在等你。|索恩在楼梯口一言不发地把一半文件塞给你，然后开始往上爬。} {term: |假期里塔楼空了一半，你的脚步声有两重回音。}{final_year: 这样的攀爬已经不剩几次了。|}
# en: A narrow spiral stair inside a stone tower, a severe professor climbing ahead with a stack of papers, a student a step behind.
scene [0a9608] = 石塔里狭窄的螺旋楼梯，一位严厉的教授抱着一摞文件走在前面，一个学生落后一级台阶。
# en: Ask a hard question
opt.left.label [7531ee] = 问个难题
# en: {~He answers in four words, and the four words are enough.|"Hm," he says, then answers it properly, all the way to the seventh floor.}
opt.left.say.1 [0b7fe2] = {~他只用四个字回答，而这四个字就够了。|“嗯。”他说，然后认真地回答了，一直讲到七楼。}
# en: {~He answers with a harder question and leaves you on the landing.|"Wrong question," he says. "Find the right one by Thursday."}
opt.left.say.2 [0cca52] = {~他用一个更难的问题作答，把你留在了楼梯平台上。|“问错了。”他说，“星期四之前找到对的问题。”}
# en: Climb in silence beside him
opt.right.label [f05732] = 默默陪他爬楼
# en: {~He climbs faster than you. At the top he says, "Adequate," and you are fairly sure he means the climbing.|Neither of you says a word for seven flights. It is oddly restful, apart from your legs.}
opt.right.say.1 [4ed2b3] = {~他爬得比你快。到了顶上，他说：“尚可。”你相当确定他指的是爬楼。|七层楼里你们一句话也没说。除了腿，这出奇地让人放松。}

@event lecture_tower_scorched_room
# en: The Scorched Room
title [b134c8] = 烧焦的练习室
# en: {The practice room on the Evocation floor is empty. A sign forbids unsupervised casting.|The scorched room is empty. Since your last visit, someone has underlined the sign.|The scorched room. The sign is underlined three times now, and signed by the headmistress.} {~A fresh scorch mark is shaped like a surprised face.|Someone has left a bucket of sand by the door.|{season == "winter": The walls are the only warm thing here.|The air smells faintly of singed eyebrow.}}
text [efe1ca] = {塑能术那层的练习室空着。告示禁止无人监督施法。|烧焦的练习室空着。自你上次来过，有人在告示下划了线。|烧焦的练习室。告示上现在划了三道线，还有院长的签名。} {~一道新焦痕的形状像一张吃惊的脸。|有人在门边放了一桶沙子。|{season == "winter": 这里只有墙是暖的。|空气里隐约有烧焦眉毛的味道。}}
# en: A practice room on a lower floor of a stone tower, walls streaked with scorch marks, a sign by the door forbidding unsupervised casting.
scene [5b6deb] = 石塔低层的一间练习室，墙上满是焦痕，门边的告示禁止无人监督施法。
# en: Practise anyway
opt.left.label [5b8fa1] = 照练不误
# en: {~Your spell lands clean in the centre of the oldest scorch mark. You leave no evidence.|You practise until the flame does what you mean, not what you say.}
opt.left.say.1 [b1fe32] = {~你的咒语正中最古老那道焦痕的中心，没留下任何证据。|你一直练到火焰照你的意思行事，而不是照你的话。}
# en: {~A new scorch mark joins the wall, shaped very like you.|The spell comes back at you. You leave with your eyebrows, mostly.}
opt.left.say.2 [5f86e8] = {~墙上添了一道新焦痕，形状很像你。|咒语反弹到你身上。你离开时眉毛还在——大部分。}
# en: Work through the theory
opt.right.label [0d1f5b] = 钻研理论
# en: {~You draw the spell on paper fifty times. Paper is very forgiving.|You learn exactly why the walls look like that, and resolve not to add to them.}
opt.right.say.1 [d62ca2] = {~你在纸上把咒语画了五十遍。纸很宽容。|你彻底弄懂了墙为什么是这副模样，并决心不再给它添彩。}

@event great_hall_tomorrow_sky
# en: Tomorrow's Weather
title [fdb53c] = 明天的天气
# en: {The great hall is empty but for the candles. The ceiling shows tomorrow.|One candle drifts over to you and hovers at reading height.|Your candle meets you at the door now and leads you to your bench.} {season == "winter": Tomorrow, it says, it will snow.|{season == "spring": Tomorrow, a storm with bad manners.|{season == "summer": Tomorrow is cloudless, stars and all.|Tomorrow is fog, rolling across the vaults.}}} {final_year: There are fewer tomorrows here now.|}
text [e5b36c] = {大礼堂里空无一人，只有蜡烛。天花板在放映明天。|一支蜡烛飘到你身边，停在适合读书的高度。|你的蜡烛现在会在门口迎你，把你领到你的长凳。} {season == "winter": 天花板说，明天要下雪。|{season == "spring": 明天，一场不讲礼貌的暴风雨。|{season == "summer": 明天万里无云，满天星斗。|明天是雾，在拱顶间缓缓滚过。}}} {final_year: 这里剩下的明天不多了。|}
# en: An empty great hall in the evening, floating candles drifting under a vaulted ceiling that shows a different sky from the windows.
scene [85f031] = 傍晚空荡的大礼堂，漂浮的蜡烛在拱顶下飘移，天花板上的天空与窗外不同。
# en: Lie on a bench and watch
opt.left.label [e7d231] = 躺在长凳上看
# en: {~You watch tomorrow until your neck stiffens. It is worth it.|A candle drifts down to see if you are all right, and stays.|You fall half asleep and dream tomorrow a little early.}
opt.left.say.1 [d8d820] = {~你看着明天，直到脖子发僵。值得。|一支蜡烛飘下来看你是否安好，然后就留下了。|你半睡半醒，提前梦见了一点明天。}
# en: Read by the floating candles
opt.right.label [e66c83] = 借烛光读书
# en: {~A candle drips wax onto the best paragraph. You read it anyway, through the wax.|The candles follow your page like curious moths. It is the best light in the castle.}
opt.right.say.1 [841a19] = {~一支蜡烛把蜡滴在了最好的那段上。你隔着蜡照读不误。|蜡烛像好奇的飞蛾一样跟着你的书页。这是城堡里最好的光。}

@event great_hall_choir_rehearsal
# en: The Choir Rehearses
title [2fc949] = 合唱团排练
# en: {The choir is rehearsing on the stage, a foot off the floor, and one voice short.|Still a voice short. The conductor has left a spare songbook on your bench.|The spare songbook has your name pencilled in it, and the alto line marked in red.} {season == "winter": They are learning the Midwinter music.|{~Tonight it's a round that nobody can find the end of.|Tonight it's a lament, sung far too cheerfully.}}
text [b0d458] = {合唱团在舞台上排练，离地一尺，还差一个声部。|还是差一个声部。指挥在你的长凳上放了一本备用歌本。|那本备用歌本上用铅笔写了你的名字，女低音声部用红笔标了出来。} {season == "winter": 他们在学仲冬的曲子。|{~今晚是一首没人找得到结尾的轮唱。|今晚是一首挽歌，唱得未免太欢快了。}}
# en: A choir rehearsing on the stage of a candlelit great hall, a few singers floating a foot off the boards, the benches mostly empty.
scene [f55935] = 烛光摇曳的大礼堂舞台上，合唱团正在排练，几位歌手离地漂浮一尺，长凳上几乎空着。
# en: Listen from the back
opt.left.label [73c47c] = 在后排听
# en: {~The collection hat comes round. It is worth every coin.|You listen until the candles gutter. The hat comes round twice.}
opt.left.say.1 [5759b2] = {~募捐的帽子传了过来。每一枚硬币都值。|你一直听到蜡烛摇摇欲灭。帽子传了两回。}
# en: Fill the missing voice
opt.right.label [2ec625] = 补上那个声部
# en: {~You hit every note but one. The conductor says it was the best one.|You float a little off the floor on the last chord. Nobody mentions it, which is how you know.}
opt.right.say.1 [5817c2] = {~你只错了一个音。指挥说那是最好的一个。|最后一个和弦时你微微离了地。没人提起，你就知道了。}
# en: {~You come in confidently, in the wrong key, in the wrong song. The choir is very kind about it, which is worse.|You sing the round in a straight line and finish alone. The conductor thanks you for your enthusiasm.}
opt.right.say.2 [ccf4f2] = {~你信心满满地进了拍——调不对，歌也不对。合唱团对此非常宽容，这更糟。|你把轮唱唱成了一条直线，最后一个人唱完。指挥感谢你的热情。}

@event great_hall_high_table_dare
# en: The High Table Dare
title [09ad02] = 高桌之赌
# en: {Someone dares you to sit in the headmistress's chair at the empty high table.|The dare comes round again, and someone has started keeping a tally in chalk on the doorframe.|The tally on the doorframe has your column and everyone else's. First-years dare each other to dare you.} {~The chair is still warm.|A cushion embroidered with an owl sits on it.|Her teacup has been left behind, still steaming, which is worse.}
text [3e340f] = {有人赌你不敢坐到空着的高桌上，坐院长的椅子。|这个赌又来了，有人开始在门框上用粉笔记分。|门框上的记分表里有你的一栏和其他所有人的。一年级生们互相怂恿着来赌你。} {~椅子还是温的。|椅子上放着一个绣着猫头鹰的坐垫。|她的茶杯落在那儿，还冒着热气，这更糟。}
# en: An empty high table on a dais at the end of a dark great hall, a carved chair at its centre, students daring each other from the doorway.
scene [788e3e] = 昏暗大礼堂尽头的高台上，一张空着的高桌，中央是一把雕花椅子，学生们在门口互相起哄。
# en: Take the dare
opt.left.label [6cb2fd] = 接下赌约
# en: {~You sit, cross your legs, and sip the air. The doorway erupts.|You sit for a full minute. The chair is surprisingly comfortable, and very slightly warm.}
opt.left.say.1 [5ee522] = {~你坐下，跷起腿，对着空气啜了一口。门口炸开了锅。|你坐了整整一分钟。椅子出奇地舒服，还微微有点暖。}
# en: {~As you sit, a quiet, delighted laugh comes from the dark beyond the dais. You leave very fast.|A portrait above the table clears its throat. You have never moved so fast in your life.}
opt.left.say.2 [a971e9] = {~你刚坐下，高台后的黑暗里传来一声轻轻的、愉快的笑。你飞快地离开了。|高桌上方的一幅肖像清了清嗓子。你这辈子从没跑得这么快过。}
# en: Tell them you value your life
opt.right.label [bbde75] = 说你还想活命
# en: {~They call you a coward, fondly. You keep your dignity, and your place at the academy.|"Coward," they chant. You bow. It seems the safest thing to do in that hall.}
opt.right.say.1 [b3254c] = {~他们亲切地骂你胆小鬼。你保住了尊严，也保住了学籍。|“胆小鬼！”他们齐声喊。你鞠了一躬。在那间礼堂里，这似乎是最安全的做法。}

@event infirmary_spare_bed
# en: The Spare Bed
title [f2835c] = 空床位
# en: {You only came in for a plaster.|Your name is on the slate by the end bed, in pencil.|Your name on the slate is in ink now.} {health < 40: Sister Amaranth takes one look at you and points at the spare bed.|Sister Amaranth decides, over her spectacles, that you'll live.} {~It smells of lavender and singed wool.|Two beds down, someone hiccups in a minor key.|{season == "winter": A warming charm hums under every blanket.|The curtains breathe.}}
text [4c9497] = {你只是来要块膏药的。|尽头那张床边的石板上，用铅笔写着你的名字。|石板上你的名字现在是用墨水写的了。} {health < 40: 阿玛兰斯修女看了你一眼，指了指那张空床。|阿玛兰斯修女从眼镜上方打量你，判定你死不了。} {~屋里有薰衣草和烧焦羊毛的味道。|隔两张床，有人在用小调打嗝。|{season == "winter": 每条毯子底下都嗡嗡响着取暖咒。|窗帘在呼吸。}}
# en: A row of white infirmary beds under a high arched window, one turned down, a stern healer pointing at it.
scene [6baaff] = 高拱窗下一排白色病床，其中一张已铺开，一位严厉的医护指着它。
# en: Lie down for an hour
opt.left.label [a6694f] = 躺一个钟头
# en: {~You sleep the deep, dreamless sleep of the infirmary. The tonic afterwards costs a few crowns and tastes of regret.|You wake under a blanket you didn't pull up. There is a tonic on the side, and a bill under it.}
opt.left.say.1 [6b4424] = {~你睡了一场医务室式的、无梦的深眠。醒来后的补药要几个克朗，味道像悔恨。|你醒来时身上盖着一条不是你拉的毯子。床头有一瓶补药，下面压着账单。}
# en: Help roll bandages
opt.right.label [a9dc7c] = 帮忙卷绷带
# en: {~Sister Amaranth teaches you the knot she uses. You will never tie your boots any other way.|You roll bandages and listen to her opinion of duelling, which is long and specific.}
opt.right.say.1 [1b955e] = {~阿玛兰斯修女教你她打的那种结。从此你系鞋带再也不用别的结。|你一边卷绷带，一边听她对决斗的看法——又长又具体。}

@event infirmary_visiting_hour
# en: Visiting Hour
title [d29dca] = 探视时间
# en: {Visiting hour. {friend} is in the bed by the window,|Visiting hour. Sister Amaranth waves you to the stool you used last time. Today it's {friend},|Visiting hour. The stool by the window has worn to your shape. Today it's {friend},} {~nursing a duelling bruise the colour of plums.|recovering from a draught of hiccups that hiccups back.|wrapped in three blankets against a lake chill.} {They} brighten{s} when you come in.
text [cefb8d] = {探视时间。{friend}躺在靠窗的床上，|探视时间。阿玛兰斯修女朝你上回坐的凳子招招手。今天是{friend}，|探视时间。窗边那只凳子已经磨成了你的形状。今天是{friend}，} {~正护着一块李子色的决斗淤青。|正从一剂会反过来打嗝的打嗝药里恢复。|正裹着三条毯子抵御湖上的寒气。} 看见你进来，{they}眼睛一亮。
# en: A friend propped up in an infirmary bed by a window, a visitor on a stool beside them with a paper bag of grapes.
scene [3e7207] = 一位朋友靠坐在窗边的病床上，探视者坐在旁边的凳子上，手里拿着一纸袋葡萄。
# en: Sit and keep {them} company
opt.left.label [036ca8] = 坐下陪陪{them}
# en: {~You bring grapes and eat most of them yourself. {friend} doesn't mind.|You stay until Sister Amaranth sweeps you out. {friend} waves from the pillows.}
opt.left.say.1 [d696d5] = {~你带了葡萄，自己吃了大半。{friend}并不介意。|你一直待到阿玛兰斯修女把你扫地出门。{friend}在枕头间朝你挥手。}
# en: Smuggle in a pastry
opt.right.label [1dcbe0] = 偷带一块点心
# en: {~The pastry makes it past the desk. {friend} eats it under the blanket like a crime.|You hide the pastry in a hollowed-out book. {friend} is delighted by both.}
opt.right.say.1 [5fa4dc] = {~点心顺利混过了前台。{friend}躲在毯子底下吃，像在作案。|你把点心藏在一本挖空的书里。{friend}对两样都很开心。}
# en: {~Sister Amaranth confiscates the pastry and eats it herself, slowly, while looking at you.|Sister Amaranth smells the pastry from across the ward and holds out her hand without a word.}
opt.right.say.2 [47d6e3] = {~阿玛兰斯修女没收了点心，然后看着你，慢慢地自己吃掉了。|阿玛兰斯修女隔着整个病房就闻到了点心味，一言不发地伸出手。}

@event infirmary_tonic_cupboard
# en: The Tonic Cupboard
title [f80f9b] = 补药柜
# en: {The tonic cupboard is open, and Sister Amaranth is in the back having her tea.|The tonic cupboard is open at teatime. A new label on the door reads "counted daily".|At teatime the cupboard is open, and the label now reads "counted daily, by name". The bright blue bottles have moved to the front.} {mana < 20: Your head aches with the dry ache of spent magic.|{~The bottles clink in the draught.|A label reads, in her handwriting, "absolutely not".}}
text [55052c] = {补药柜开着，阿玛兰斯修女在里屋喝茶。|下午茶时间，补药柜开着。门上新贴了一张标签：“每日清点”。|下午茶时间，柜门开着，标签现在写着“每日清点，按人登记”。亮蓝色的瓶子都挪到了前排。} {mana < 20: 你的头隐隐作痛，是法力耗尽后那种干涩的疼。|{~瓶子在穿堂风里叮当作响。|一张标签上是她的字迹：“绝对不行”。}}
# en: A tall glass-fronted cupboard of coloured tonics in an empty infirmary, its door ajar, a teacup steaming on the healer's desk.
scene [e6e707] = 空荡荡的医务室里，一个装满彩色补药的高玻璃柜，柜门半开，医护的桌上一杯茶正冒着热气。
# en: Help yourself to a tonic
opt.left.label [3899be] = 自己拿一瓶
# en: {~You drink it in the corridor. It tastes of peppermint and getting away with things.|You pocket the bottle, rinse it later, and put it back full of water. You feel slightly worse about that.}
opt.left.say.1 [758b11] = {~你在走廊里喝了它。薄荷味，外加侥幸得手的味道。|你把瓶子揣进兜里，后来洗净，灌满清水放了回去。这让你心里更过意不去了一点。}
# en: {~"That one is for goats," says Sister Amaranth from the doorway. She makes you drink the right one, which is worse.|Sister Amaranth's teacup appears at your elbow. "Put it back," she says, "and sit down."}
opt.left.say.2 [2814ae] = {~“那瓶是给山羊的。”阿玛兰斯修女在门口说。她让你喝下对的那瓶，这更糟。|阿玛兰斯修女的茶杯出现在你手肘边。“放回去，”她说，“然后坐下。”}
# en: Ask for one properly
opt.right.label [8a2146] = 好好开口要
# en: {She charges you, lectures you, and gives you the good one.|She charges you, lectures you a little less, and gives you the good one.|"You again," she says, and hands it over before you ask.}
opt.right.say.1 [381f3d] = {她收了钱，训了你一顿，给了你好的那瓶。|她收了钱，训得少了些，给了你好的那瓶。|“又是你。”她说，没等你开口就递了过来。}
# en: She looks at your empty purse, gives you the good one anyway, and lectures you twice as long.
opt.right.say.2 [58433e] = 她看了看你空空的钱袋，照样给了你好的那瓶，训话却长了一倍。

@event alchemy_lab_spare_cauldron
# en: A Spare Cauldron
title [9b8e1b] = 一口空坩埚
# en: {There is a spare cauldron on the second bench, unclaimed.|The spare cauldron has a chalk mark on its rim like your initial.|Your cauldron, everyone calls it. Someone has scratched your initial into the handle.} {~Someone has left a ladle standing upright in something.|The bench smells of mint and burnt sugar.|{season == "summer": The heat makes every brew twice as eager.|The windows have steamed over with other people's experiments.}}
text [bbcf91] = {第二张工作台上有一口空坩埚，没人认领。|那口空坩埚的边沿上有个粉笔记号，像你名字的首字母。|大家都管它叫“你的坩埚”。有人把你的首字母正经刻在了把手上。} {~有人把一把长勺竖着插在某种东西里。|工作台上有薄荷和焦糖的味道。|{season == "summer": 炎热让每锅药剂都格外急躁。|窗户被别人的实验蒸得一片模糊。}}
# en: A long laboratory bench in the afternoon light, a small cauldron free among larger ones, jars of ingredients lined up beside it.
scene [eac0fa] = 午后阳光里一张长长的实验台，大坩埚之间空着一口小坩埚，旁边排着一列药材罐。
# en: Brew a practice batch
opt.left.label [7eec57] = 熬一锅练手
# en: {~The brew turns the right colour at the right moment. It feels like being trusted.|It comes out clear and smells of nothing, which is exactly right.}
opt.left.say.1 [2a573b] = {~药剂在恰好的时刻变成了恰好的颜色。那感觉像是被信任。|成品清澈、无味，正是该有的样子。}
# en: {~The brew turns a colour you have never seen. So do your eyebrows.|It foams over and sets, firmly, around your sleeve.}
opt.left.say.2 [c4de09] = {~药剂变成了一种你从没见过的颜色，你的眉毛也是。|它沸溢出来，牢牢地凝固在你的袖子上。}
# en: Scrub the cauldrons for crowns
opt.right.label [cb89c5] = 刷坩埚挣几个钱
# en: {~You learn more about failed potions from their residue than from any lecture.|You scrub until the bench is clean. Then you scratch your own initials into it, small, under the rim.}
opt.right.say.1 [dcd00e] = {~从失败药剂的残渣里，你学到的比任何一堂课都多。|你把工作台刷得干干净净，然后在边沿下面小小地刻上了自己的名字缩写。}

@event alchemy_lab_third_floor
# en: The Third-Floor Fumes
title [fa28aa] = 三楼的烟雾
# en: {On the third floor the ventilation charm has given up, and the fumes have taken charge.|Someone has hung a sign by the stairs giving the fumes' mood of the day.|The fumes' sign has a column for forecasts now, in several hands.} {~Everyone is speaking in rhyme and trying to hide it.|Everyone is laughing at nothing and cannot stop.|Everyone is being unusually honest about everyone else's hair.} {season == "winter": The windows are frozen shut.|}
text [e293ea] = {三楼的通风咒已经放弃了，烟雾接管了这里。|有人在楼梯口挂了块牌子，写着烟雾今天的心情。|烟雾的牌子现在多了一栏预报，好几种笔迹。} {~所有人都在用押韵说话，还想掩饰。|所有人都在莫名其妙地笑，停不下来。|所有人都对别人的发型异常坦诚。} {season == "winter": 窗户冻死了。|}
# en: A crowded upper floor of an alchemy laboratory, coloured vapour hanging under the ceiling, students working with handkerchiefs tied over their faces.
scene [51e9da] = 炼金实验室拥挤的楼上，彩色的蒸气悬在天花板下，学生们脸上蒙着手帕干活。
# en: Stay and work in the fug
opt.left.label [d14428] = 留在烟里干活
# en: {~You get a great deal done and agree with everyone about everything.|You leave with good notes and a headache that hums.}
opt.left.say.1 [5db6b3] = {~你干了一大堆活，而且对所有人的所有话都表示赞同。|你带着一份好笔记和一阵嗡嗡响的头疼离开。}
# en: Force the windows open
opt.right.label [0d2916] = 把窗户撬开
# en: {season == "winter": {~The ice cracks. Half the floor cheers; half complains of the cold.|The frozen latch gives, and so does your thumbnail.}|{~The windows give. The fumes leave, sulking, and the floor applauds.|You wedge the window with a textbook. The fumes drift out, and nearly the textbook too.}}
opt.right.say.1 [d12ef6] = {season == "winter": {~冰裂开了。半层楼欢呼，另一半抱怨冷。|冻住的插销开了，你的指甲也裂了。}|{~窗户开了。烟雾悻悻离去，整层楼鼓掌。|你用一本课本卡住窗户。烟雾飘了出去，课本也差点跟着出去。}}

@event alchemy_lab_unlabelled_jar
# en: The Unlabelled Jar
title [a3c74d] = 没贴标签的罐子
# en: {Someone has left an unlabelled jar on the shared shelf. It glows, faintly.|Another unlabelled jar on the shared shelf, beside the cautious label someone wrote for the last one.|The shared shelf now has a row of careful labels, and one new jar at the end of it, waiting its turn.} {~It smells of thunder.|Something inside it turns over when you look.|It is warm to the touch.} {gpa >= 3: You could probably identify it, given time.|You have no idea what it is.}
text [c01c59] = {有人在公用架上落下一只没贴标签的罐子。它微微发光。|公用架上又一只没贴标签的罐子，旁边是有人给上一只写的谨慎标签。|公用架上现在排着一列仔细写好的标签，末尾一只新罐子在排队等着。} {~它闻起来像雷声。|你一看它，里面就有东西翻了个身。|摸上去是温的。} {gpa >= 3: 给你点时间，你大概能认出它。|你完全不知道它是什么。}
# en: A dusty shelf of ingredient jars in an alchemy laboratory, one jar with no label glowing faintly, a student reaching for it.
scene [328708] = 炼金实验室里一排积灰的药材罐，其中一只没有标签、微微发光，一个学生正伸手去拿。
# en: Add a pinch to your brew
opt.left.label [163e45] = 往药里加一撮
# en: {~The brew turns gold and so do you, briefly. You feel enormous.|The brew sings a single note and leaves you humming with power.}
opt.left.say.1 [6ecb37] = {~药剂变成金色，你也短暂地变成了金色。你觉得自己无比庞大。|药剂唱出一个音，让你浑身嗡嗡作响，充满力量。}
# en: {~The brew ignites, politely, and then impolitely.|Your cauldron sneezes. So, for the rest of the afternoon, do you.}
opt.left.say.2 [2a14a9] = {~药剂先是礼貌地、随后很不礼貌地烧了起来。|你的坩埚打了个喷嚏。整个下午，你也跟着打喷嚏。}
# en: Label it, carefully
opt.right.label [0222a1] = 小心地贴上标签
# en: {~An hour of tests later, you write a cautious label. Someone adds a skull to it.|You work out what it is. Then you wash your hands three times.}
opt.right.say.1 [f78b5f] = {~一小时的测试之后，你写下一张谨慎的标签。有人在上面加了个骷髅。|你弄清了它是什么。然后把手洗了三遍。}

@event job_board_odd_jobs
# en: Odd Jobs
title [99e6aa] = 零活
# en: {Under the proper postings, someone has pinned an odd job.|Under the proper postings is an odd job, and a second pin someone has left beside it, for answers.|The odd-jobs corner has a card addressed to you by name, in a hand you're starting to recognise.} {~Someone wants a homesick portrait read to.|Someone wants a ladder held, no questions asked.|Someone wants a reluctant gargoyle walked.} {term: |In the break the board is half bare, and the odd jobs pay a little better.}
text [876911] = {正式招工启事底下，有人钉了一张零活。|正式启事底下有一张零活，旁边还多钉了一枚图钉，留着给人回复。|零活角有一张写着你名字的卡片，笔迹你开始认得了。} {~有人想找人给一幅想家的肖像画念书。|有人想找人扶梯子，不许问问题。|有人想找人遛一只不情愿的石像鬼。} {term: |假期里告示板空了一半，零活的工钱也高了一点。}
# en: A cork board in an entrance hall, a small notice pinned at an angle under the official job postings, a student reading it with a frown.
scene [b55309] = 门厅里的软木告示板，一张小启事歪钉在正式招工启事下面，一个学生皱着眉读它。
# en: Take the job
opt.left.label [a7359a] = 接下这活
# en: {~It takes all afternoon and pays exactly what it said, which is rarer than it should be.|It is stranger than the notice suggested, and pays slightly less.}
opt.left.say.1 [6233c9] = {~花了一整个下午，报酬和说好的分毫不差——这比应有的要少见。|比启事上写的更古怪，工钱也少了一点。}
# en: Haggle first
opt.right.label [789545] = 先讲讲价
# en: {~You haggle the fee up by a third. Your employer seems to respect you more for it.|You agree a price and a biscuit. The biscuit turns out to be the better half of the deal.}
opt.right.say.1 [b212fb] = {~你把价钱抬高了三分之一。雇主似乎因此更尊重你了。|你们谈定了价钱外加一块饼干。结果饼干才是这笔买卖里更划算的那一半。}
# en: {~Your employer takes the notice down and pins up a new one, asking for "someone less difficult".|The job goes to a first-year who asked for nothing. They seem very happy with it.}
opt.right.say.2 [d201b3] = {~雇主把启事撕下来，换上一张新的，要找个“好说话一点的人”。|活儿给了一个什么都没要求的一年级生。那孩子看起来非常高兴。}

@event job_board_lost_familiars
# en: Lost and Found
title [7ffffa] = 失物招领
# en: {The corner of the board for lost things is busier than the jobs.|An old poster in the lost-things corner now reads "found, thanks to a student".|The lost-things corner has thank-you notes now. One draws the rescuer with a halo.} {~A toad called "Sir" is missing, last seen being brave.|A ransom note demands three biscuits for one sock.|A small owl is lost, answers to nothing, and bites.} {season == "winter": Half the familiars have simply gone somewhere warm.|}
text [8617a3] = {告示板上的失物角比招工那边还热闹。|失物角里一张旧启事上现在写着“已找到，多亏一位学生”。|失物角如今贴着感谢信。有一张把救星画上了光环。} {~一只叫“爵士”的蟾蜍走失了，最后一次被人看见时正在逞英雄。|一封勒索信要求三块饼干，换回一只袜子。|一只小猫头鹰走丢了，叫什么都不应，还咬人。} {season == "winter": 一半的魔宠只是自己跑去暖和地方了。|}
# en: The corner of a cork board crowded with hand-drawn posters of lost familiars and a ransom note for a sock.
scene [8f714b] = 软木告示板的一角，贴满了手绘的走失魔宠启事，还有一封索要一只袜子赎金的勒索信。
# en: Go looking for it
opt.left.label [24390e] = 去找找看
# en: {~You find it behind a radiator in the east tower, deeply unrepentant. The reward is small and grateful.|You find it, and the owner cries, and the reward is mostly biscuits.}
opt.left.say.1 [db63a7] = {~你在东塔的暖气片后面找到了它，毫无悔意。酬金不多，谢意满满。|你找到了它，失主哭了，酬金大部分是饼干。}
# en: {~You search for an hour and find only a different, much angrier creature.|You don't find it. The next day the poster says "Found! Thanks anyway."}
opt.left.say.2 [473240] = {~你找了一小时，只找到另一只脾气暴躁得多的生物。|你没找到。第二天，启事上写着：“找到了！还是谢谢。”}
# en: Read every notice twice
opt.right.label [778bc2] = 每张启事读两遍
# en: {~The board is the castle's diary. You learn who lost what, and who owes whom.|You learn three secrets from the small print, and who has terrible handwriting.}
opt.right.say.1 [cd911d] = {~告示板是城堡的日记。你知道了谁丢了什么，谁欠谁的。|你从小字里读出了三个秘密，还知道了谁的字写得最难看。}

@event job_board_yellow_notice
# en: The Oldest Notice
title [0c2305] = 最老的告示
# en: In the bottom corner of the board, under years of newer notices, is one gone yellow and soft: "Wanted, Thursdays: someone to read the newssheet aloud to the portrait on the west stair. He likes the sport and the obituaries. Small pay." Someone has renewed the pin.
text [b5755a] = 告示板底角，压在多年来的新告示下面，有一张已经发黄变软：“招人，每周四：为西侧楼梯上的肖像朗读新闻报。他爱看体育版和讣告。酬劳微薄。”有人换过了图钉。
# en: A corner of a cork board where one notice, yellowed and curling, is pinned beneath years of newer ones.
scene [f55d35] = 软木告示板的一角，一张发黄卷边的告示压在多年来的新告示底下。
# en: Answer it, this Thursday
opt.left.label [716d02] = 这周四就去应聘
# en: The portrait is a bald man in an old-fashioned collar who hasn't had the news read to him in years. He cheers the duelling results and sighs at the obituaries. You lose your Thursday evening, and he asks you to come back.
opt.left.say.1 [129d7b] = 肖像是个戴老式领子的秃顶男人，好多年没人给他读报了。他为决斗赛果欢呼，对着讣告叹气。你搭进了周四晚上，他请你再来。
# en: Ask the porter who pins it
opt.right.label [f1824a] = 问门房是谁钉的
# en: The porter says the notice was there when he started, and that a few crowns appear on the stair every Thursday whether anyone reads or not. He has never asked who leaves it. He suggests you don't either.
opt.right.say.1 [506c26] = 门房说，他来的时候这张告示就在了，而且每周四楼梯上都会出现几枚克朗，不管有没有人去读。他从没问过是谁留的。他建议你也别问。

@event job_board_torn_notice
# en: Half a Notice
title [067821] = 半张告示
# en: A well-paid notice ("one evening's portering, generous rates") has drawn two students, who have both got hold of it. It tears down the middle as you arrive. One holds the half with the pay; the other holds the half with the address. Both look at you.
text [cdc4cd] = 一张报酬丰厚的告示（“一晚上的搬运活，酬劳优厚”）引来了两个学生，两人都抓住了它。你走过来时它从中间撕开了。一个拿着写报酬的那半，另一个拿着写地址的那半。两人都看着你。
# en: Two students tugging at either end of a single job notice in front of a crowded cork board, the paper starting to tear.
scene [2ca221] = 拥挤的软木告示板前，两个学生各拽着一张招工告示的一头，纸开始撕裂。
# en: Settle it between them
opt.left.label [c453e7] = 帮他们调解
# en: You suggest they share the evening and split the fee. They both hate the idea, then both agree to it, then both thank you. You get nothing but a reputation for being reasonable.
opt.left.say.1 [9bba47] = 你建议他们一起干那一晚，平分报酬。两人都讨厌这个主意，然后都同意了，然后都谢了你。你什么也没得到，除了一个通情达理的名声。
# en: Read the address and go yourself
opt.right.label [ff6244] = 看清地址自己去
# en: You read the address over a shoulder and get there first. The job pays well. By supper both of them have told everyone what you did.
opt.right.say.1 [9c63ca] = 你从别人肩后瞥见了地址，抢先赶到。这活儿给钱很多。到晚饭时，他俩已经跟所有人说了你干的事。

@event job_board_monthly_letter
# en: A Letter a Month
title [22898d] = 每月一封信
# en: A small notice in a careful, shaky hand: "Wanted: a student to post a letter for me in the village, first of each month. A few crowns. I can't manage the hill any more." The letter is pinned beside it, sealed and addressed to someone in the village.
text [184718] = 一张小告示，字迹工整却发抖：“招一名学生，每月初帮我到山下小镇寄一封信。几枚克朗。我已经爬不动那座山了。”信就钉在旁边，封好了，寄给小镇上的某个人。
# en: A small handwritten notice pinned beside a sealed letter on a cork board, a student reaching to unpin both.
scene [144090] = 软木告示板上，一张手写的小告示旁钉着一封封好的信，一个学生伸手要把两样都取下来。
# en: Take the letter down the hill
opt.left.label [6cf051] = 把信带下山
# en: You post it, then the next, then the next. In the third month the letter-writer leaves a note: the replies have started coming. You never learn who either of them is. You keep the crowns in a jar.
opt.left.say.1 [9043ac] = 你寄了这封，又寄下一封，再下一封。第三个月，写信人留了张字条：回信开始来了。你始终不知道他们两个是谁。你把那些克朗存在一个罐子里。
# en: Leave it for someone else
opt.right.label [43df3f] = 留给别人
# en: You leave it on the board. The next morning it's gone, and someone has drawn a small heart beside the notice in pencil.
opt.right.say.1 [5241d2] = 你把它留在告示板上。第二天早上它不见了，有人用铅笔在告示旁画了一颗小小的心。
