# Maintained by `node tools/grim.js i18n zh-CN`. Translate the text after "="; keep {tokens}.
# "# en:" shows the English source. [hash] marks the English version a line was translated from;
# lines marked STALE need updating — after fixing the text, delete the [hash] and re-run the tool.


@event village_barge_crossing
# en: The Barge Across
title [bac81a] = 渡湖驳船
# en: {The village barge is slower than walking, if you could walk on water.|The bargeman has started nodding at you like a regular.|The bargeman saves you the dry end of the bench.} {season == "winter": Ice ticks against the hull.|{season == "summer": Dragonflies ride the bow for free.|{~A first-year is being sick, very politely.|Two prefects are pretending not to hold hands.|Someone is reading aloud to a crate of chickens.}}}
text [afc63f] = {去小镇的驳船慢得很——如果你能在水上走路，走过去都比它快。|船夫开始像对待熟客那样冲你点头了。|船夫开始给你留长凳上干的那一头了。} {season == "winter": 薄冰一下下轻敲着船身。|{season == "summer": 蜻蜓停在船头，免费搭船。|{~一个一年级生正趴在船边呕吐，吐得非常有礼貌。|两个级长正假装没在牵手。|有人在给一笼鸡大声朗读。}}}
# en: A flat-bottomed barge crossing a mirror-still lake, the seven towers shrinking behind it.
scene [456c6d] = 一艘平底驳船驶过镜面般平静的湖，七座塔在身后渐渐变小。
# en: Read on the crossing
opt.left.label [467133] = 渡湖时看书
# en: {~You finish a chapter and miss the towers turning gold behind you.|You read the same paragraph four times; the lake keeps interrupting.|You look up only when the hull bumps the quay, and feel you've skipped something.}
opt.left.say.1 [484d14] = {~你读完一章，却错过了身后的塔楼被夕阳染成金色。|同一段你读了四遍；湖光总来打岔。|直到船身撞上码头你才抬头，总觉得错过了什么。}
# en: Chat with the bargeman
opt.right.label [89b231] = 跟船夫聊天
# en: {~He tells you the lake was rougher in his father's day, and expects a tip for the history.|He has opinions about every tower and charges for none of them, except in tips.|He asks after your exams as if they were a sick relative. You tip him for the sympathy.}
opt.right.say.1 [704add] = {~他说他父亲那时候湖上风浪大得多，并且指望你为这段历史付点小费。|他对每座塔都有看法，一概免费——小费除外。|他问起你的考试，口气像在问候一位生病的亲戚。你为这份同情付了小费。}

@event village_square_errand
# en: One Thing in the Square
title [e25a84] = 广场上的“就一件事”
# en: {friend} has come down to the village with you "for one thing", which turns out to be several. {First, a hat.|You've learned that "one thing" means at least three.|You've stopped asking what the one thing is.} {~A stallholder is selling candied chestnuts in paper twists.|A tinker is mending a cauldron with a great deal of swearing.|The market cat has chosen {friend} and will not be moved.}
text [10243b] = {friend}陪你下山到小镇，说是“就办一件事”，结果是好几件。{先是一顶帽子。|你已经明白，“一件事”至少意味着三件。|你已经不再问那“一件事”是什么了。}{~一个摊贩在卖纸包的糖炒栗子。|一个补锅匠正骂骂咧咧地修一口坩埚。|集市上的猫选中了{friend}，怎么也赶不走。}
# en: A crooked village market square, two students weaving between stalls, one already carrying too many parcels.
scene [52254a] = 歪歪扭扭的小镇集市广场，两个学生在摊位间穿行，其中一个已经抱了太多包裹。
# en: Carry the parcels
opt.left.label [faeb8d] = 帮忙拎包裹
# en: {~You come back up the hill with an armful of string-tied parcels and sore wrists.|{friend} buys you a chestnut as payment. It is not enough payment.|One parcel clinks suspiciously. You decide not to ask.}
opt.left.say.1 [5cbcb5] = {~你抱着一摞系着绳子的包裹爬回山上，手腕酸痛。|{friend}买了颗栗子当报酬。这报酬远远不够。|有个包裹叮当作响，十分可疑。你决定不问。}
# en: Talk {them} out of it
opt.right.label [2a8f41] = 劝{them}别买了
# en: {~You talk {friend} out of the third thing. {They} sulk{s} the whole way back to the barge.|Your argument is excellent. {friend} buys the thing anyway, and now you've been wrong in public.|You win. {friend} says you'd make a terrible shopkeeper and a worse friend, then takes your arm anyway.}
opt.right.say.1 [4768d2] = {~你劝{friend}放弃了第三样东西。{They}一路生着闷气回到驳船上。|你的论证无懈可击。{friend}还是买了，于是你当众输了一回。|你赢了。{friend}说你会是个糟糕的店主、更糟糕的朋友，然后照样挽起你的胳膊。}

@event village_last_barge
# en: The Last Barge
title [d7085d] = 末班驳船
# en: {The last barge back leaves at the bell, and the bell is ringing.|The last-barge bell, and you're nowhere near the quay. The bargeman knows your running by now.|The bell. Of course the bell.} {season == "winter": Snow is coming down thick over the square.|{~The inn has started a song with too many verses.|The lamps are only half lit.|The lake has gone the colour of pewter.}} {final_year: Not many evenings like this are left.|You could run. You could stay.}
text [6fe390] = {回城堡的末班驳船随钟声开船，而钟声正在响。|末班船的钟声响了，你离码头还远着呢。船夫早就熟悉你奔跑的样子了。|钟声。当然是钟声。} {season == "winter": 大雪正纷纷扬扬落在广场上。|{~酒馆里有人唱起一首段落多得没完的歌。|街灯才点亮一半。|湖水变成了锡镴般的灰色。}} {final_year: 这样的夜晚剩下的不多了。|你可以跑。你也可以留下。}
# en: A lamplit village quay at dusk, the last barge pulling at its rope, a student hesitating at the edge of the square.
scene [aa10dd] = 黄昏时灯火点点的小镇码头，末班驳船拽着缆绳，一个学生在广场边犹豫。
# en: Run for it
opt.left.label [38d292] = 跑去赶船
# en: {~You make it with a leap and one wet boot.|You make it; your scarf does not.|The bargeman holds the rope a heartbeat longer than he should. You owe him.}
opt.left.say.1 [2b9596] = {~你纵身一跃赶上了，湿了一只靴子。|你赶上了；你的围巾没赶上。|船夫多攥了一会儿缆绳，比他该攥的久一点。你欠他个人情。}
# en: Stay a little longer
opt.right.label [4a025a] = 再待一会儿
# en: {~A fisherman rows you back for a ruinous fare and a story you didn't ask for.|You pay the night ferryman far too much. He rows like he has somewhere better to be.}
opt.right.say.1 [4245d0] = {~一个渔夫划船送你回去，要价高得离谱，还附赠一个你没想听的故事。|你付给夜间摆渡人太多钱了。他划船的样子，像是有更要紧的地方要去。}
# en: {~You sleep on a bench under the Newt's eaves and wake up with a cat on your feet.|The first barge of morning finds you yawning on the quay.}
opt.right.say.2 [daec8c] = {~你在蝾螈酒馆的屋檐下睡了一夜长凳，醒来时脚上趴着一只猫。|清晨的头班驳船发现你正在码头上打哈欠。}

@event gilded_newt_fireside
# en: By the Newt's Fire
title [5b6147] = 蝾螈的炉火边
# en: {The Gilded Newt's fire has never gone out, and the landlady says it never will while she lives.|The landlady chalks your name on her slate before you've ordered.|Your corner by the fire is free. The regulars leave it for you now.} {season == "winter": Snow hisses off the boots of everyone who comes in.|{~A dog is asleep with its paws in the hearth.|Someone has hung wet socks on the fire-irons.|A farmer is explaining turnips to nobody.}}
text [c2f98a] = {镀金蝾螈酒馆的炉火从没熄过，老板娘说只要她还活着，就永远不会熄。|你还没点单，老板娘就已经在石板上写好了你的名字。|炉边你的那个角落空着。常客们现在都把它留给你。} {season == "winter": 每个进门的人靴子上的雪都在嘶嘶作响。|{~一条狗把爪子搭在炉边睡着了。|有人把湿袜子挂在了火钳上。|一个农夫正对着空气讲解芜菁。}}
# en: A low-beamed tavern with a roaring hearth, a student tucked into the corner seat beside it with a steaming cup.
scene [886f83] = 低矮房梁的酒馆里炉火熊熊，一个学生窝在炉边的角落座位，捧着一杯冒热气的饮料。
# en: Order a cider and stay
opt.left.label [fc74cf] = 点杯苹果酒坐着
# en: {~The cider is warm and spiced and costs exactly what the landlady says it does.|You stay until your cheeks are red and your worries are smaller.|The landlady brings the cider without being asked, and charges for it all the same.}
opt.left.say.1 [6609da] = {~苹果酒温热、带着香料味，价钱分毫不差，正如老板娘所说。|你一直坐到脸颊发红，烦恼也变小了。|老板娘没等你开口就端来了苹果酒，钱照收不误。}
# en: Work by the firelight
opt.right.label [01152e] = 借着炉光干活
# en: {~You get two pages done between three toasts and a fiddle.|The noise is terrible, and somehow you concentrate better than in the library.|A regular reads over your shoulder and corrects your spelling of "wyvern".}
opt.right.say.1 [d61234] = {~在三轮祝酒和一段提琴之间，你写完了两页。|吵得要命，可不知为何你比在图书馆里还专心。|一位常客从你肩后看过来，纠正了你“双足飞龙”的拼写。}

@event gilded_newt_card_game
# en: Cards at the Newt
title [cae7f0] = 蝾螈的牌局
# en: {There's a card game in the back room of the Gilded Newt, and an empty chair.|The empty chair in the back room has a cushion on it now, as if it's been waiting.|The card players greet you by the name of your worst hand.} {~Tonight it's a tinker, a widow and a man who shuffles like a conjuror.|Tonight the stakes are copper and pride.|Tonight a second-year from Duskgate is losing very cheerfully.}
text [82b92a] = {镀金蝾螈的后屋有一局牌，还有一把空椅子。|后屋那把空椅子上如今多了个坐垫，像是一直在等你。|牌友们用你最烂的那手牌给你起了外号来打招呼。} {~今晚是一个补锅匠、一个寡妇，还有一个洗牌像变戏法的男人。|今晚的赌注是铜板和面子。|今晚一个暮门的二年级生正输得兴高采烈。}
# en: A smoky back room in a tavern, a card game around a scarred table and one empty chair.
scene [939cdf] = 烟雾缭绕的酒馆后屋，一张满是划痕的桌上正在打牌，还有一把空椅子。
# en: Take the empty chair
opt.left.label [2c28bd] = 坐上那把空椅子
# en: {~You win a handful of crowns and a reputation for an honest face.|You win, and the widow asks where you learned to bluff like that.}
opt.left.say.1 [08271b] = {~你赢了一把克朗，还落了个“老实面相”的名声。|你赢了，寡妇问你从哪儿学的这手虚张声势。}
# en: {~You lose your crowns slowly, and then all at once.|The tinker takes your last coin and buys you a drink with it, which somehow makes it worse.}
opt.left.say.2 [8e7d17] = {~你的克朗先是慢慢地输，然后一下子全没了。|补锅匠赢走你最后一枚硬币，又用它请你喝了一杯，不知怎的更难受了。}
# en: Watch for the tells
opt.right.label [f1d424] = 观察他们的破绽
# en: {~You spend the evening watching. The man who shuffles like a conjuror scratches his ear when he lies.|You learn a great deal about bluffing and nothing about having fun.|Someone asks if you're playing or haunting. You leave before you have to answer.}
opt.right.say.1 [28ad8d] = {~你看了一整晚。那个洗牌像变戏法的男人，撒谎时会挠耳朵。|你学到了很多虚张声势的门道，却一点乐子也没有。|有人问你是来打牌的还是来闹鬼的。你没等回答就走了。}

@event gilded_newt_corner_table
# en: The Corner Table
title [30043d] = 角落那张桌
# en: {here} is at the corner table with {a jug of cider and no plans to leave.|the house jug, which the landlady refills for whoever sits there.|the table's jug. The landlady nods at you as you come in, as if you're expected.} "{~Sit down, you're blocking the fire.|You look like you need a drink. I look like I need company.|Don't tell anyone you saw me here.}" {season == "winter": Snow is piling up against the window.|The window is open to the night.}
text [8248cd] = {here}坐在角落那张桌旁，{面前一壶苹果酒，完全没有走的意思。|面前是店里那只专属酒壶，谁坐在那儿，老板娘就给谁续满。|面前是那张桌的酒壶。你进门时老板娘冲你点点头，好像早料到你会来。}“{~坐下吧，你挡着火了。|你看上去需要喝一杯。我看上去需要个伴。|别告诉别人你在这儿见过我。}”{season == "winter": 雪正堆在窗台上。|窗户朝着夜色敞开。}
# en: A tavern corner table with a half-empty jug of cider, someone familiar waving a student over.
scene [5c8294] = 酒馆角落的桌上放着半壶苹果酒，一个熟面孔正招手叫学生过去。
# en: Sit down for one drink
opt.left.label [e16ef4] = 坐下喝一杯
# en: {~One drink becomes three stories and a long walk to the barge.|{here} tells you something true halfway down the jug, then pretends not to have.|You stay later than you meant to. It's worth the morning.}
opt.left.say.1 [6ac2b8] = {~一杯变成了三个故事，外加一段走回驳船的长路。|喝到半壶时{here}跟你说了句真心话，然后装作没说过。|你待得比打算的晚。明早难熬，但值得。}
# en: Wave and keep walking
opt.right.label [11b59d] = 挥挥手继续走
# en: {~You wave and get back to your book. {here} toasts your back, a little hurt.|You plead an early lecture. It's even true.}
opt.right.say.1 [9c38b6] = {~你挥挥手，回去看你的书。{here}冲你的背影举杯，有点受伤。|你推说明早有课。这居然是真的。}

@event mabels_the_door
# en: Mabel Reads the Door
title [d9674c] = 梅布尔看门识人
# en: {Mabel looks up as you open the door and is already reaching for a tin.|Mabel watches you open the door the way a doctor watches a cough.|You've tried opening Mabel's door every way you can think of. She still knows.} {~The bell over the door rings a little flat today.|There's a queue of two, which for Mabel's is a crowd.|A cake is cooling on the counter, out of reach and smug about it.}
text [01fd58] = {你一推门，梅布尔抬起头，手已经伸向了一个茶罐。|梅布尔看你推门的样子，就像医生听人咳嗽。|你试过用各种方式推梅布尔的门。她照样看得出来。} {~今天门上的铃铛响得有点走调。|店里排着两个人的队，对梅布尔茶馆来说这已经算拥挤了。|柜台上晾着一块蛋糕，够不着，还一脸得意。}
# en: A tiny tea shop crammed with tins, the shop-bell over the door still swinging, a shrewd woman behind the counter already reaching for a tin.
scene [8b72a6] = 塞满茶罐的小茶馆，门上的铃铛还在摇晃，柜台后一位精明的妇人已经伸手去拿茶罐。
# en: Let Mabel choose your tea
opt.left.label [d2a63d] = 让梅布尔替你选
# en: {~She brings you something smoky and says, "For the week you've had." You hadn't told her about the week.|She brings you something with rose in it and won't explain why. It helps.|It's mint. It's always mint when you've been lying to yourself, apparently.}
opt.left.say.1 [05b49e] = {~她端来一杯带烟熏味的茶，说：“给你这一周喝的。”你可没跟她提过这一周。|她端来一杯有玫瑰味的茶，也不解释为什么。挺管用。|是薄荷茶。据说你自欺欺人的时候，永远是薄荷茶。}
# en: Fake a cheerful entrance
opt.right.label [35b845] = 装出高兴的样子进门
# en: {~She brings you the cheerful tea. It's so good you actually cheer up, which may have been her plan all along.|Mabel looks fooled. Then she adds a biscuit, which means she wasn't.}
opt.right.say.1 [a472a0] = {~她端来了“开心的茶”。好喝得你真的开心起来——说不定这本来就是她的打算。|梅布尔一副被骗过去的样子。然后她多给了你一块饼干，说明她根本没被骗。}
# en: {~She brings you a pot labelled, in her own hand, "for people pretending".|"Nice try, dear," says Mabel, and brings the strong one.}
opt.right.say.2 [a03282] = {~她端来一壶茶，壶上是她亲手写的标签：“给装样子的人”。|“想得美，亲爱的。”梅布尔说完，端来了浓的那种。}

@event mabels_window_seat
# en: The Window Seat
title [15c249] = 靠窗的座位
# en: {Mabel's window seat looks out over the lake to the castle, and it's free.|Mabel has stopped asking if you're waiting for someone at the window seat.|Your window seat. Mabel puts a cushion on it when she sees you on the quay.} {season == "winter": Frost has drawn ferns on the glass.|{season == "spring": Blossom keeps landing on the sill.|{~The towers look small from here, almost friendly.|Rain streaks the glass and blurs the towers.}}}
text [a61345] = {梅布尔茶馆的靠窗座位能望见湖对岸的城堡，而且正空着。|你坐在靠窗座位时，梅布尔已经不再问你是不是在等人了。|你的靠窗座位。梅布尔一看见你在码头，就往上放个软垫。} {season == "winter": 霜在玻璃上画出了蕨叶。|{season == "spring": 花瓣不停落在窗台上。|{~从这儿看，塔楼显得小小的，几乎有点亲切。|雨水顺着玻璃流下，把塔楼晕成一片。}}}
# en: A window seat in a tea shop looking across a still lake to seven distant towers, a teapot and open notes on the sill.
scene [36406e] = 茶馆的靠窗座位，隔着平静的湖望见远处七座塔，窗台上放着茶壶和摊开的笔记。
# en: Make one pot last all day
opt.left.label [abe18d] = 一壶茶坐一整天
# en: {~You get through a whole chapter on one pot, under Mabel's increasingly pointed looks.|By the third hour the tea is cold and Mabel is dusting very close to your table.|You finish your notes. Mabel says nothing, which is worse.}
opt.left.say.1 [3095f9] = {~一壶茶你读完了整整一章，梅布尔的眼神越来越意味深长。|到第三个钟头，茶凉了，梅布尔在离你桌子很近的地方掸灰。|你写完了笔记。梅布尔一句话也没说，这更可怕。}
# en: Order cake with it
opt.right.label [8d317c] = 再配块蛋糕
# en: {You've had two of Mabel's three cakes. Today, the third, which is lemon and worth every crown.|Mabel has started cutting the lemon cake before you sit down.|{~Mabel brings the lemon without asking. You eat it slowly while the barges come and go.|The lemon cake, the window, the lake. The work can wait.}}
opt.right.say.1 [a91f90] = {梅布尔的三种蛋糕你吃过两种了。今天是第三种，柠檬味的，每个克朗都花得值。|梅布尔开始在你坐下之前就切好柠檬蛋糕了。|{~梅布尔没等你开口就端来了柠檬蛋糕。你慢慢吃着，看驳船来来去去。|柠檬蛋糕、窗户、湖。功课可以等一等。}}

@event mabels_forty_teas
# en: Forty Kinds of Tea
title [e3533b] = 四十种茶
# en: {friend} wants to try one of Mabel's forty teas, and Mabel insists on choosing. {Today she starts a chart of who has tried what.|Mabel's chart of your friends' teas is pinned behind the counter now; {friend}'s column gets a tick.|Mabel's chart runs to a second sheet. {friend}'s column is the shortest, and Mabel looks at it pointedly.} {~Mabel pretends not to be interested.|Mabel has opinions about the order.}
text [438769] = {friend}想尝尝梅布尔的四十种茶之一，而梅布尔坚持由她来选。{今天她开始画一张表，记下谁喝过什么。|梅布尔那张记录你朋友们喝茶的表，如今钉在了柜台后面；{friend}那一栏添了一个勾。|梅布尔的表已经画到第二页了。{friend}那一栏最短，梅布尔意味深长地盯着它。}{~梅布尔假装不感兴趣。|梅布尔对喝的顺序很有意见。}
# en: Two students at a small tea-shop table crowded with mismatched teapots, one writing in a notebook.
scene [b50dbf] = 两个学生坐在茶馆的小桌旁，桌上挤满了不成套的茶壶，其中一人在本子上写着什么。
# en: Pay for both pots
opt.left.label [76b503] = 两壶都我请
# en: {~{friend} pronounces today's tea "bracing", which means awful. You drink yours anyway.|You pay. Mabel marks you on the chart as a patron of the arts.|{friend} declares it the best tea in the village, then sniffs yours to be sure.}
opt.left.say.1 [487728] = {~{friend}宣布今天的茶“提神”，意思是难喝。你还是把自己那杯喝完了。|你付了钱。梅布尔在表上把你记作“艺术赞助人”。|{friend}宣布这是全镇最好的茶，然后凑过来闻了闻你那杯，以防万一。}
# en: Order your usual
opt.right.label [f9feec] = 点我的老样子
# en: {~{friend} calls you unadventurous. Your tea is perfect, thank you.|"Coward," says {friend} fondly, over something purple.|You stick to your usual. {friend} drinks something that smells of bonfires and looks betrayed by it.}
opt.right.say.1 [50470e] = {~{friend}说你不爱冒险。你的茶好得很，谢谢。|“胆小鬼。”{friend}端着一杯紫色的东西，亲昵地说。|你坚持喝老样子。{friend}喝了一杯有篝火味的茶，一脸被背叛的表情。}

@event grimsbys_wrong_book
# en: Not the Book You Wanted
title [480464] = 不是你要的那本
# en: {You ask Mr Grimsby for a textbook. He vanishes into the shelves and comes back with a book on beekeeping.|You ask Mr Grimsby for one thing. He brings you another, with great confidence.|Mr Grimsby sees you coming and is already halfway up a ladder, looking for the wrong book.} {~Today's is a cookery book with a whole chapter on eels.|Today's is a history of a town that may not exist.|Today's is in a language neither of you reads.}
text [2b8dca] = {你向格林斯比先生要一本教科书。他消失在书架间，拿回来一本讲养蜂的书。|你向格林斯比先生要一样东西。他信心十足地拿来另一样。|格林斯比先生一看见你进门，就已经爬上半截梯子，去找那本错的书了。} {~今天这本是菜谱，有整整一章讲鳗鱼。|今天这本是一座可能并不存在的小镇的历史。|今天这本用的语言你们俩都不认识。}
# en: A bookshop so crowded the shelves lean together, an elderly bookseller on a ladder triumphantly holding up the wrong book.
scene [ea591e] = 挤得书架互相倚靠的书店里，一位老书商站在梯子上，得意地举着一本错的书。
# en: Buy what he found
opt.left.label [8212ca] = 买下他找到的书
# en: {~It's useless and wonderful. You read half of it on the barge.|You learn more than you meant to about something you never meant to learn.|There's a pressed flower in it, and a name you don't know on the flyleaf.}
opt.left.say.1 [7b70a6] = {~它毫无用处，又妙不可言。你在驳船上就读了一半。|你学到了比预想更多的东西，关于一件你从没打算学的事。|书里夹着一朵压干的花，扉页上写着一个你不认识的名字。}
# en: Search the shelves yourself
opt.right.label [68f103] = 自己去书架上找
# en: {~You find it behind a stack of almanacs, exactly where he said it wasn't.|You find it. Mr Grimsby looks wounded and charges you anyway.}
opt.right.say.1 [34eb8d] = {~你在一摞年鉴后面找到了它，正是他说不在的地方。|你找到了。格林斯比先生一脸受伤，照样收了你的钱。}
# en: {~A shelf leans on you for support. You hold it up for a long time.|An afternoon, a sneezing fit, and no book.}
opt.right.say.2 [f7eb7b] = {~一个书架靠在你身上寻求支撑。你扶了它很久。|一个下午，一阵喷嚏，没有书。}

@event grimsbys_damp_barrow
# en: The Damp Barrow
title [b887f1] = 受潮的书车
# en: {Outside Grimsby's there's a barrow of secondhand books, a coin apiece, slightly damp.|The barrow has a new sign: "NO READING WITHOUT BUYING". Nobody obeys it.|The barrow. You know its smell now: rain, glue and other people's thoughts.} {season == "winter": Someone has thrown a sack over it against the sleet.|{~The top book is about knots.|A cat is asleep on the poetry.|A card in the corner says "NOT RUDE, JUST OLD".}}
text [63330f] = {格林斯比书店门外有一车二手书，一枚硬币一本，略微受潮。|书车上多了块新牌子：“不买不许看。”没人理会。|那辆书车。你现在认得它的味道了：雨水、胶水，还有别人的思绪。} {season == "winter": 有人往上面盖了只麻袋挡雨雪。|{~最上面那本讲的是打绳结。|一只猫睡在诗集上。|角落里一张卡片写着：“不是没礼貌，只是旧了。”}}
# en: A wooden barrow of damp secondhand books outside a crooked bookshop, a student reading one in the drizzle.
scene [908d11] = 歪斜的书店外，一辆木推车装满受潮的二手书，一个学生在细雨中读着其中一本。
# en: Buy a damp book
opt.left.label [428d93] = 买本受潮的书
# en: {~It dries out wavy and full of someone else's underlinings.|The margins are better than the book. Someone argued with every page.|The last page is a shopping list in faded ink. You find it oddly moving.}
opt.left.say.1 [2e1f2a] = {~书晾干后皱巴巴的，满是别人画的线。|页边批注比正文还精彩。有人跟每一页都吵过架。|最后一页是一张褪色的购物清单。你莫名有些感动。}
# en: Read it standing in the rain
opt.right.label [e908fc] = 站在雨里读
# en: {~You read until your feet are cold and Mr Grimsby taps on the window.|You read a whole chapter in the drizzle and don't buy it. You feel like a thief and a scholar at once.|A previous owner has written "Don't believe this bit" in the margin. You don't.}
opt.right.say.1 [408375] = {~你一直读到脚冻僵，格林斯比先生敲了敲窗户。|你在细雨里读完一整章，却没买。你觉得自己既像小偷又像学者。|一位前主人在页边写着“这段别信”。你没信。}

@event grimsbys_last_copy
# en: The Last Copy
title [370a21] = 最后一本
# en: There's one copy left of the book you need, and {friend} has {their} hand on it too. {You both laugh. Neither of you lets go.|This keeps happening to you at Grimsby's. You're starting to suspect the shop.|Mr Grimsby swears he ordered two. It never arrives as two.} {~"I saw it first," {they} say{s}.|"We could share," {they} offer{s}, unconvincingly.|Mr Grimsby says there might be another in the cellar. There won't.}
text [31bff6] = 你要的那本书只剩一本了，而{friend}的手也搭在上面。{你们都笑了。谁也没松手。|在格林斯比书店，这种事总落到你头上。你开始怀疑是这家店在搞鬼。|格林斯比先生发誓他订了两本。到货时从来都只有一本。}{~“我先看到的。”{they}说。|“我们可以合着看。”{they}提议，毫无说服力。|格林斯比先生说地窖里也许还有一本。不会有的。}
# en: Two students in a cramped bookshop, both holding the same book, neither letting go.
scene [ec8868] = 拥挤的书店里，两个学生握着同一本书，谁也不肯放手。
# en: Let {them} have it
opt.left.label [e68f07] = 让给{them}
# en: {~{friend} promises to lend it to you "very soon". You know what that means.|You let go. {friend} buys you a bun on the way back, which nearly makes up for it.|{friend} reads it on the barge and tells you all the best parts, in the wrong order.}
opt.left.say.1 [87b7a4] = {~{friend}答应“很快”就借给你。你知道那是什么意思。|你松了手。{friend}回去路上请你吃了个面包，差不多算扯平了。|{friend}在驳船上就读了，把最精彩的部分讲给你听，顺序全是乱的。}
# en: Haggle for it
opt.right.label [3e6001] = 讨价还价抢下它
# en: {~Mr Grimsby takes your side for reasons of his own. {friend} won't speak to you until the quay.|You win it fair and square, and {friend} says so in a voice that means the opposite.}
opt.right.say.1 [f53bc6] = {~格林斯比先生出于自己的理由站在你这边。{friend}一直到码头都没理你。|你光明正大地赢了，{friend}也这么说，只是语气意思正相反。}
# en: {~{friend} outbids you, and somehow you end up paying for the tea afterwards.|You argue so long that a third-year buys it while you're both talking.}
opt.right.say.2 [d8d4d0] = {~{friend}出价比你高，结果不知怎的，事后的茶钱还是你付的。|你们争了太久，一个三年级生趁你们说话时把书买走了。}

@event pell_apothecary_drawers
# en: A Thousand Drawers
title [e5d6dc] = 一千个抽屉
# en: {Pell & Daughters has a thousand drawers, each labelled in a different hand.|You find a drawer you'd swear wasn't there last time.|You've read half the labels in the shop. The other half seem to be reading you.} Today it's {~"Moonwort. Do not hum near."|"Dried courage, low quality."|"Owl pellets (sorted)."} {season == "winter": The shop smells of camphor and wet wool.|The shop smells of mint and something burnt.}
text [84e00d] = {佩尔父女药铺有一千个抽屉，每个标签的笔迹都不一样。|你找到一个抽屉，敢发誓上次还不在。|店里的标签你读了一半。另一半好像在读你。}今天是{~“月草。附近勿哼歌。”|“晒干的勇气，品质较次。”|“猫头鹰食丸（已分拣）。”}{season == "winter": 店里一股樟脑和湿羊毛的味道。|店里一股薄荷和什么东西烧焦的味道。}
# en: An apothecary wall of a thousand tiny labelled drawers, brass handles gleaming, a student reading the labels on tiptoe.
scene [2f6345] = 药铺的一整面墙是上千个贴着标签的小抽屉，黄铜把手闪闪发亮，一个学生踮着脚读标签。
# en: Buy a pinch of it
opt.left.label [a72b3a] = 买一小撮
# en: {~One of the daughters weighs it on scales finer than an eyelash and tells you what it's really for.|It smells of the shop all the way back across the lake.|Old Pell counts the grains himself and warns you about three things you hadn't planned to do.}
opt.left.say.1 [7c16ef] = {~一个女儿用比睫毛还精细的秤给你称好，告诉你它真正的用途。|回去渡湖的一路上，它都散发着药铺的气味。|老佩尔亲自数了颗粒，还提醒你三件你本来没打算做的事。}
# en: Just read the labels
opt.right.label [82b51d] = 只看看标签
# en: {~Old Pell watches you over his spectacles the whole time, as if labels could be stolen.|You copy a dozen labels into your notebook. A daughter asks if you're planning to open a rival shop.|You learn a great deal. Old Pell sighs every time you touch a handle.}
opt.right.say.1 [a83406] = {~老佩尔一直从眼镜上方盯着你，好像标签也能被偷走。|你把十几个标签抄进本子。一个女儿问你是不是打算开家对手店。|你学到了很多。你每碰一下把手，老佩尔就叹一口气。}

@event pell_apothecary_queue
# en: Symptoms in the Queue
title [ab0a8c] = 排队的病症
# en: {The queue at Pell & Daughters notices your academy robes. A woman shows you her rash.|Word has got round the queue at Pell's that you're "the young doctor".|The queue parts for you as if you were a physician. You are not a physician.} {~A farmer has a cough like a door hinge.|A boy has a frog stuck to his hand, and the frog seems content.|An old man wants something for "the usual", and won't say what the usual is.}
text [787236] = {佩尔药铺排队的人注意到了你的学院袍。一位妇人给你看她的疹子。|佩尔药铺的队伍里传开了，大家都叫你“小大夫”。|队伍为你让开一条路，好像你是医师。你不是医师。} {~一个农夫咳得像吱呀作响的门轴。|一个男孩手上粘着一只青蛙，青蛙看起来挺满足。|一位老人要买治“老毛病”的药，死活不说是什么毛病。}
# en: A queue of villagers at an apothecary counter, all turning to a student in academy robes.
scene [87f566] = 药铺柜台前排着一队镇民，全都转向一个身穿学院袍的学生。
# en: Offer some advice
opt.left.label [55dc45] = 给点建议
# en: {~Your advice is sound. One of the daughters nods, which in this shop is a medal.|The farmer tries your remedy and comes back to thank you. Old Pell grumbles about lost trade.}
opt.left.say.1 [f7c27f] = {~你的建议很靠谱。一个女儿点了点头，在这家店里这就是勋章。|农夫试了你的方子，回来向你道谢。老佩尔抱怨生意被抢了。}
# en: {~Old Pell corrects you in front of the whole queue, kindly, which is worse.|Your advice would have worked on a horse. A daughter says so.}
opt.left.say.2 [0fdc23] = {~老佩尔当着全队人的面纠正了你，语气很和善，这更糟。|你的建议拿去治马倒是管用。一个女儿这么说。}
# en: Study a drawer intently
opt.right.label [37493b] = 专心研究抽屉
# en: {~You pretend to be fascinated by a drawer of buttons until the queue moves on.|You say "Hm" like Professor Thorne and leave quickly.|You become very interested in the floor. The woman with the rash tells her friend you were rude.}
opt.right.say.1 [7283ab] = {~你假装对一抽屉纽扣着了迷，直到队伍往前挪走。|你学索恩教授说了声“嗯。”，然后迅速离开。|你突然对地板产生了浓厚兴趣。长疹子的妇人跟朋友说你没礼貌。}

@event pell_apothecary_tonic
# en: The Daughters' Tonic
title [7c5d2b] = 女儿们的补药
# en: {One of Pell's daughters has a new tonic and needs someone to try it. Her father must not know.|The daughters have another tonic, and a notebook with your name at the top of a column.|The daughters see you and reach under the counter before you've said hello.} {~This one is green and fizzes.|This one smells of pears and thunder.|This one is clear, which they say is the worrying kind.}
text [f8cc18] = {佩尔的一个女儿调了一种新补药，需要有人试喝。绝不能让她父亲知道。|女儿们又调了一种补药，还有个本子，其中一栏最上面写着你的名字。|女儿们一看见你，没等你打招呼就把手伸到了柜台底下。} {~这一瓶是绿色的，还冒泡。|这一瓶闻起来像梨和雷雨。|这一瓶是透明的，她们说这是最让人担心的那种。}
# en: Two apothecary's daughters leaning over a counter, offering a student a small bottle of something that fizzes.
scene [ecaffe] = 药铺的两个女儿趴在柜台上，递给学生一小瓶冒着泡的东西。
# en: Drink it down
opt.left.label [65d992] = 一口喝下
# en: {~You feel wonderful, and briefly taller. The daughters take notes.|Your cold vanishes. So, for an hour, does your sense of smell.}
opt.left.say.1 [45a9dc] = {~你感觉棒极了，还短暂地长高了一点。女儿们记着笔记。|你的感冒消失了。你的嗅觉也消失了一个钟头。}
# en: {~You hiccup bubbles all the way back to the barge.|Your ears go warm and stay warm. The daughters take very interested notes.}
opt.left.say.2 [e5b95b] = {~你一路打着冒泡的嗝回到驳船。|你的耳朵发热，而且一直热着。女儿们兴致勃勃地记着笔记。}
# en: Buy a proper remedy
opt.right.label [8493b6] = 买副正经药
# en: {~Old Pell sells you something brown and reliable. The daughters look disappointed in you.|You buy the dull, tested thing. It works, dully.|A daughter wraps it and murmurs that you'll be sorry you missed the green one.}
opt.right.say.1 [15501e] = {~老佩尔卖给你一种褐色的、靠得住的药。女儿们对你很失望。|你买了那种无聊又经过检验的药。它管用，无聊地管用。|一个女儿一边包药一边嘀咕，说你错过那瓶绿的会后悔的。}

@event bakery_bun_queue
# en: The Bun Queue
title [b02932] = 买面包的队伍
# en: {There's a queue outside the bakery before the village is properly awake, and it smells like a promise.|The baker's son counts heads in the bun queue and knows you by your scarf.|The bun queue. You know everyone in it by their order.} {season == "winter": Breath steams in the cold.|{season == "autumn": Leaves skitter round everyone's ankles.|{~The baker's son is singing off-key.|A goat has joined the queue and nobody has the heart to send it away.}}}
text [3390ec] = {小镇还没完全醒来，面包房门外已经排起了队，空气里的香味像一个承诺。|面包师的儿子数着排队的人头，认得你的围巾。|买面包的队伍。队里每个人你都能按他们点的东西认出来。} {season == "winter": 呼出的气在冷空气里冒着白雾。|{season == "autumn": 落叶在每个人的脚踝边打转。|{~面包师的儿子在跑调地唱歌。|一只山羊也排进了队，谁都不忍心把它赶走。}}}
# en: A queue of villagers and students outside a little bakery at dawn, steam and the smell of cinnamon pouring out of the door.
scene [09ed66] = 黎明时一家小面包房外排着镇民和学生，热气和肉桂香从门里涌出来。
# en: Buy a bag for your corridor
opt.left.label [fed2ca] = 给走廊的人买一袋
# en: {~You come back with a warm bag and are, for one morning, the most popular person in your house.|The buns are gone before you've taken your coat off. Someone leaves you a thank-you note on a napkin.|A prefect takes one "to check it for contraband". It passes.}
opt.left.say.1 [c3953d] = {~你带回一袋热面包，整整一个早上成了学院里最受欢迎的人。|你还没脱外套，面包就被抢光了。有人在餐巾上给你留了张感谢条。|一个级长拿走一个，说要“检查有没有违禁品”。检查通过。}
# en: One bun, eaten warm
opt.right.label [7ed830] = 趁热吃一个
# en: {~You eat it on the quay while it's still too hot. Worth every burnt finger.|Butter, cinnamon and the lake in the morning. Nothing has ever been better.|You eat it slowly and think about nothing at all.}
opt.right.say.1 [46c827] = {~你在码头上趁烫就吃了。烫了手指也值。|黄油、肉桂，还有清晨的湖。再没有比这更好的了。|你慢慢吃着，什么也不想。}

@event bakery_oldest_baker
# en: The Oldest Baker
title [efae3a] = 最老的面包师
# en: The oldest of the bakers sits by the ovens, too old to knead and too stubborn to leave. {She asks, as she asks every student, whether the post at the castle is reliable these days.|She asks about the castle post. Her daughter gives you a look that says: just answer.|"Is the post reliable?" she asks. You've learned the answer she likes.} {~The ovens tick as they heat.|Flour hangs in the light.|The bell over the door rings, and she looks up, every time.}
text [e29790] = 面包师里最年长的那位坐在烤炉边，老得揉不动面，又倔得不肯走。{她问你——就像她问每个学生那样——城堡如今的邮递是否靠得住。|她问起城堡的邮递。她女儿给了你一个眼神：回答就是了。|“邮递靠得住吗？”她问。你已经学会了她爱听的答案。}{~烤炉升温时发出轻轻的嗒嗒声。|面粉悬在光里。|门上的铃铛一响，她就抬头，每次都是。}
# en: A very old woman in a flour-dusted apron sitting by warm bread ovens, looking up hopefully as the shop door opens.
scene [3f911a] = 一位系着沾满面粉围裙的老妇人坐在温热的烤炉边，门一开，她便满怀期待地抬起头。
# en: Sit with her a while
opt.left.label [4b2f48] = 陪她坐一会儿
# en: {~She tells you about her grandmother's grandmother, who waited for a letter. She doesn't say how it ended.|She tells you the family has baked here for two hundred years. She makes it sound like a promise kept.|She falls asleep mid-story. Her daughter tucks a bun into your pocket and says thank you.}
opt.left.say.1 [ee82a6] = {~她讲起她祖母的祖母，那人一直在等一封信。她没说结局。|她说她家在这里烤了两百年面包。她说得像一个守住了的承诺。|她讲着讲着睡着了。她女儿往你口袋里塞了个面包，说了声谢谢。}
# en: Help knead the dough
opt.right.label [d60b9f] = 帮忙揉面
# en: {~The dough fights back. Your arms ache by the time the trays go in.|The baker shows you the turn of the wrist. You don't have it yet.|You knead until your shoulders burn. The first loaf out has your thumbprint on it.}
opt.right.say.1 [25609a] = {~面团会反抗。等烤盘送进炉子时，你的胳膊已经酸了。|面包师教你手腕那一转。你还没学会。|你揉到肩膀发烫。出炉的第一个面包上留着你的拇指印。}

@event bakery_cooling_rack
# en: The Cooling Rack
title [5733b6] = 晾面包的窗台
# en: {Behind the bakery a window stands open, and on the sill a tray of buns is cooling, unwatched.|The cooling tray is back on the sill, nearer the edge this time. The bakers either trust everyone or are testing you.|The tray, the sill, the open window. It's practically an invitation.} {~A crow is eyeing it too.|Two first-years are pretending not to look at it.|Steam curls off the tray into the cold air.}
text [343ef1] = {面包房后面有扇窗开着，窗台上晾着一盘面包，没人看着。|那盘面包又晾在窗台上了，这回离边缘更近。面包师们要么谁都信任，要么是在考验你。|托盘、窗台、开着的窗。简直就是邀请。} {~一只乌鸦也盯着它。|两个一年级生正假装没在看它。|热气从托盘上袅袅升进冷空气里。}
# en: A tray of steaming buns cooling on the sill of an open bakery window, a crow and a student both eyeing it.
scene [22dd92] = 面包房敞开的窗台上晾着一盘冒热气的面包，一只乌鸦和一个学生都盯着它。
# en: Lift one off the sill
opt.left.label [9b35c2] = 从窗台顺一个
# en: {~You get away with it. It tastes slightly of guilt and mostly of cinnamon.|Clean away. The crow watches you with professional respect.}
opt.left.say.1 [6a1d7f] = {~你得手了。吃起来有一点点内疚味，主要是肉桂味。|干净利落。乌鸦用同行的敬意看着你。}
# en: {~A floury hand appears from the window, palm up. You pay double.|Caught by the baker's son, who tells everyone in the queue.}
opt.left.say.2 [50cf95] = {~一只沾满面粉的手从窗里伸出来，掌心朝上。你付了双倍。|被面包师的儿子逮个正着，他告诉了队伍里的每一个人。}
# en: Ask for yesterday's
opt.right.label [eb962f] = 讨点昨天的
# en: {~The baker gives you a bag of yesterday's for nothing. They're as hard as roof slates.|You get the broken ones free. You eat one and lose a little faith in bread.|"For the student who asks," says the baker, and hands you a stale one with a wink.}
opt.right.say.1 [b47d93] = {~面包师白送你一袋昨天的面包。硬得像屋顶的石板。|你免费拿到了碎掉的那些。吃了一个，你对面包的信仰动摇了一点。|“给肯开口问的学生。”面包师说着，眨眨眼递给你一个干硬的。}

@event home_cottage_old_room
# en: Your Old Room
title [8a919e] = 你的旧房间
# en: {Your old room is exactly as you left it, except smaller.|Someone has been storing apples in your old room.|Your old room has started to feel like a guest room, and you like it less for that.} {season == "winter": There's frost on the inside of the window, as always.|The window won't shut properly in the heat, as always.} Downstairs, the house is already awake.
text [05514b] = {你的旧房间和你离开时一模一样，只是变小了。|有人在你的旧房间里存了苹果。|你的旧房间开始像一间客房了，你因此不那么喜欢它了。} {season == "winter": 窗户内侧结着霜，一如往常。|天热时窗户总关不严，一如往常。}楼下，一家人早已醒了。
# en: A small childhood bedroom under the eaves, a too-short bed, a window looking out over fields.
scene [0981a6] = 屋檐下一间小小的儿时卧室，一张太短的床，窗外是田野。
# en: Sleep until noon
opt.left.label [7405ea] = 睡到中午
# en: {~You sleep like a stone. Downstairs, someone has done all your chores, loudly.|You wake to the smell of lunch and a pointed silence.|You sleep the clock round. You feel human, and slightly ashamed.}
opt.left.say.1 [5ed973] = {~你睡得像块石头。楼下有人把你的家务全干了，动静很大。|你在午饭的香味和意味深长的沉默中醒来。|你睡了个对时。感觉活过来了，也有点惭愧。}
# en: Get up with the house
opt.right.label [4c01bf] = 跟全家一起起床
# en: {final_year: {~You go down in the dark and realise there won't be many more mornings like this.|You memorise the kitchen without meaning to.}|{~You help with the fire. Nobody says much. Nobody needs to.|The creaky stair announces you. Someone hands you a cup before you've asked.}}
opt.right.say.1 [6b3cab] = {final_year: {~你摸黑下楼，忽然意识到这样的早晨不会再有很多了。|你不知不觉把厨房的样子记在了心里。}|{~你帮着生火。谁都没多说话。也不需要。|吱呀的楼梯报告了你的到来。你还没开口，就有人递给你一杯茶。}}

@event home_cottage_list
# en: The List on the Table
title [e8c27a] = 桌上的清单
# en: {Home has remembered that you know where everything is.|A day home, and already a list.|The list. Your name, underlined.} {has(origin_noble): {&The steward wants the ledgers checked.|The steward wants the tenants' letters answered.}|{has(origin_merchant): {&The shop's stock needs counting.|The shop sign needs repainting.}|{has(origin_hedge): {&Your grandmother wants herbs hung to dry.|Your grandmother wants every jar labelled.}|{~The woodpile needs splitting.|The hen house door argues.}}}}
text [4de3e8] = {家里没忘，东西放在哪儿你最清楚。|才回家一天，就有了一张清单。|那张清单。你的名字，下面画着线。} {has(origin_noble): {&管家想让你核一核账本。|管家想让你给佃户们回信。}|{has(origin_merchant): {&店里的存货要清点。|店门口的招牌要重新上漆。}|{has(origin_hedge): {&你外婆要你把草药挂起来晾干。|你外婆要你给每个罐子都贴好标签。}|{~柴堆要劈。|鸡舍的门总在跟人较劲。}}}}
# en: A kitchen table with a long handwritten list of chores weighted down by a teapot, a student in academy robes reading it with dismay.
scene [a8ef94] = 厨房桌上压着茶壶的一张长长的家务清单，一个穿学院袍的学生沮丧地读着它。
# en: Work through the whole list
opt.left.label [6b16eb] = 把清单全干完
# en: {~By supper the list is done, and someone you love says "Well." It's the highest praise in the house.|It takes all day. You sleep better than you have all term.|You finish, and the list grows a second page in a different hand.}
opt.left.say.1 [16a1d5] = {~到晚饭时清单全做完了，一位你爱的人说了声“嗯，行。”这是家里的最高赞誉。|干了一整天。你睡得比整个学期都好。|你干完了，清单上又多出了第二页，笔迹不一样。}
# en: Do it with magic
opt.right.label [155e10] = 用魔法干
# en: {~The work does itself while you supervise from a chair. The family is impressed and slightly unnerved.|It works. Your mother says it's cheating, then asks if you can do the gutters.}
opt.right.say.1 [53274e] = {~活儿自己干完了，你坐在椅子上监工。家人既佩服又有点发毛。|成功了。你母亲说这是作弊，然后问你能不能把檐沟也弄了。}
# en: {~The spell goes slightly wrong. Something is now upside down that wasn't before.|Soot. Everywhere. Someone laughs until they cry, then hands you a broom.}
opt.right.say.2 [7e8230] = {~咒语出了点偏差。有样东西现在是倒着的，原来不是。|煤灰。到处都是。有人笑到流泪，然后递给你一把扫帚。}

@event home_cottage_after_supper
# en: The Same Question
title [2bfa76] = 同一个问题
# en: After supper, when the dishes are done, someone always asks it. {"So what will you do, after?"|"Still don't know what you'll do after?" An aunt, this time.|By now you could ask it yourself, in any of their voices, and someone does.} {final_year: This time the answer is close enough to touch.|{~The fire pops.|Nobody pretends not to be listening.|Someone pours more tea to give you time.}}
text [4db073] = 晚饭后，碗碟洗完，总有人会问那个问题。{“那你以后打算做什么？”|“还不知道以后做什么吗？”这回是一位姑妈。|如今你自己都能用他们每个人的腔调问出这句话了——而总有人真的问了。}{final_year: 这一次，答案已经近在眼前。|{~炉火噼啪一响。|没人假装不在听。|有人又倒了些茶，给你留点时间。}}
# en: A family kitchen after supper by candlelight, dishes drying, everyone turned towards one student.
scene [ff9628] = 晚饭后烛光下的家庭厨房，碗碟正在晾干，所有人都转向一个学生。
# en: Tell them the truth
opt.left.label [f3042a] = 说实话
# en: {~You say you don't know. It's quiet for a moment, then someone says that's allowed.|You tell them what you're afraid of. It sounds smaller said aloud at this table.|The truth makes your mother go quiet, and then hug you, which you weren't ready for.}
opt.left.say.1 [9e28c9] = {~你说你不知道。安静了一会儿，然后有人说，这也没关系。|你把你害怕的事告诉了他们。在这张桌边说出来，它显得小了些。|实话让你母亲沉默了一下，然后抱住了你，你完全没准备好。}
# en: Give the polished answer
opt.right.label [fcba81] = 给个体面的答案
# en: {~You give the answer you'd give a professor. They're proud. It sits oddly in your chest all night.|You make it sound like a plan. Everyone relaxes except you.|"Very sensible," says an aunt. You feel as if you've told her a story.}
opt.right.say.1 [4ed89d] = {~你给出了对教授说的那种答案。他们很骄傲。整晚它都在你心里硌着。|你说得像个计划。所有人都松了口气，除了你。|“很稳妥。”一位姑妈说。你觉得自己像给她讲了个故事。}

@event home_fields_long_rows
# en: The Long Rows
title [e5b4eb] = 长长的田垄
# en: {You walk the long rows to the field's end, where you used to imagine towers.|You've seen the towers now. The horizon at the end of the rows still pulls.|The walk to the field's end is a habit now. Your feet know it by heart.} {season == "winter": The furrows crunch with frost.|The wheat is high and loud with insects.} {~A hare bolts.|A crow follows you at a respectful distance.|Smoke rises from a chimney you can't see.}
text [b79905] = {你沿着长长的田垄走到田地尽头，从前你就在那里想象高塔。|你如今见过那些塔了。田垄尽头的地平线依然在召唤。|走到田地尽头已成了习惯。你的脚比你的脑子更熟悉这条路。} {season == "winter": 垄沟结着霜，踩上去嘎吱作响。|麦子长得老高，虫鸣一片。} {~一只野兔窜了出去。|一只乌鸦隔着得体的距离跟着你。|远处看不见的烟囱里升起一缕烟。}
# en: A student walking alone between long furrowed rows towards a low wall at the edge of the fields, the horizon wide and empty.
scene [edb3f6] = 一个学生独自走在长长的田垄间，走向田地边缘的矮墙，地平线辽阔而空旷。
# en: Walk the whole boundary
opt.left.label [259a1e] = 沿田界走一整圈
# en: {~You come back muddy to the knees and hungry as a first-year.|You walk until your legs ache and your head is finally quiet.|You sit on the low wall where you always sat, and the wind does the thinking.}
opt.left.say.1 [31d573] = {~你回来时泥到膝盖，饿得像个一年级生。|你一直走到腿酸，脑子终于安静了。|你坐在一直坐的那段矮墙上，让风替你思考。}
# en: Practise where no one watches
opt.right.label [b2a1d1] = 没人时练练法术
# en: {~You set a scarecrow's hat spinning. Nobody sees. It's glorious.|You practise until your hands tingle and the crows give you a wide berth.|You try the spell you keep failing at school. Out here, with nobody watching, it nearly works.}
opt.right.say.1 [0ad658] = {~你让稻草人的帽子转了起来。没人看见。太棒了。|你练到双手发麻，乌鸦都绕着你飞。|你试了那个在学校总失败的咒语。在这儿，没人看着，它差点就成了。}

@event home_fields_neighbours
# en: Neighbours' Work
title [332e5b] = 邻居们的活计
# en: {season == "winter": The neighbours are hauling wood before the next snow.|The neighbours are bringing in the hay before the weather turns.} {They wave you over without asking if you're busy.|This time somebody has saved you a pair of gloves.|They've stopped waving. They just hand you the gloves.} {~The neighbour's boy wants to be turned into a frog.|A farmer calls you "the scholar", mostly kindly.|Someone has brought a jug of mostly cider.}
text [e37feb] = {season == "winter": 邻居们赶在下一场雪前运柴。|邻居们赶在变天前收干草。} {他们招手叫你过去，也不问你忙不忙。|这回有人给你留了一副手套。|他们不再招手了，直接把手套递给你。} {~邻居家的男孩想知道你能不能把他变成青蛙。|一个农夫叫你“读书人”，大体是善意的。|有人带来一壶基本算是苹果酒的东西。}
# en: Neighbours working together at the edge of a field, one waving a student in academy robes over to help.
scene [962599] = 邻居们在田边一起干活，其中一人招手叫一个穿学院袍的学生过来帮忙。
# en: Lend a hand
opt.left.label [d5e12c] = 搭把手
# en: {~Blisters by noon, and a supper invitation from three households.|You work till dusk. Nobody mentions the academy once, which is restful.|Your back reminds you that books are lighter than anything out here.}
opt.left.say.1 [9bf08a] = {~中午就起了水泡，还收到三户人家的晚饭邀请。|你一直干到黄昏。没人提起学院一个字，这让人很放松。|你的后背提醒你，书比这儿的任何东西都轻。}
# en: Bring them all a drink
opt.right.label [a87c41] = 给大家带点喝的
# en: {~You come back from the market with a basket and become the most popular person in the field.|They drink to the academy, then to you, then to the weather.|The neighbour's boy asks for a frog again. You give him a biscuit; it's a compromise.}
opt.right.say.1 [497c04] = {~你从集市提回一篮子东西，成了田里最受欢迎的人。|他们为学院干杯，再为你干杯，再为天气干杯。|邻居家的男孩又要变青蛙。你给了他一块饼干，算是折中。}

@event home_fields_pond
# en: The Old Pond
title [ed9a38] = 老池塘
# en: {season == "winter": The pond at the bottom of the fields has frozen over, and the local youngsters are daring each other onto the ice.|The pond at the bottom of the fields is warm and green, and the local youngsters are daring each other off the willow.} {You used to be one of them.|This time they dare you too.|They've started daring you first.} {~A dog barks at the whole business.|Someone's little sister is keeping score.|Your old initials are still carved in the willow.}
text [209ed4] = {season == "winter": 田地尽头的池塘结了冰，镇上的年轻人正互相激将着上冰。|田地尽头的池塘温暖碧绿，镇上的年轻人正互相激将着从柳树上跳下去。} {你从前也是他们中的一个。|这回他们也激你了。|他们现在先激你。} {~一条狗冲着这一切汪汪叫。|有人的小妹妹在记分。|你小时候刻的名字缩写还在柳树上。}
# en: A pond at the bottom of a field under an old willow, local youngsters daring each other at its edge.
scene [6031f0] = 田边一棵老柳树下的池塘，镇上的年轻人在岸边互相激将。
# en: Take the dare
opt.left.label [6cb2fd] = 接受挑战
# en: {season == "winter": {~You skate across and back to roaring applause from three children and a dog.|You slide the whole length on your back. It counts.}|{~You drop off the willow into the green. It's colder than memory, and better.|A perfect splash. The little sister gives it top marks.}}
opt.left.say.1 [4d7d33] = {season == "winter": {~你滑过去又滑回来，赢得三个孩子和一条狗的欢呼。|你仰面滑完了全程。这也算数。}|{~你从柳树上跳进碧水里。比记忆中更冷，也更好。|完美的水花。小妹妹给了最高分。}}
# en: {season == "winter": {~You go through the ice up to your knees and limp home to a lecture and a fire.|The ice cracks under you and you scramble back, soaked and laughed at.}|{~You belly-flop. The sound carries across three fields. Everyone heard.|You slip off the willow early and land in the reeds, muddy to the ears.}}
opt.left.say.2 [1ed50b] = {season == "winter": {~你踩破冰面，水没到膝盖，一瘸一拐地回家，迎接你的是一顿数落和一炉火。|冰在你脚下裂开，你手脚并用爬回岸上，浑身湿透，被笑了个够。}|{~你肚皮拍水。那声响传遍了三块田。所有人都听见了。|你还没站稳就从柳树上滑了下去，一头栽进芦苇丛，泥糊到耳朵。}}
# en: Hold the coats
opt.right.label [aecc6f] = 帮大家看外套
# en: {~You hold the coats and referee the arguments. Someone has to be the grown-up now.|You keep score and are accused of bias by every side.|Holding the coats, you feel very old and quite content.}
opt.right.say.1 [bd0b04] = {~你看着外套，调解争吵。现在总得有人当大人了。|你负责记分，结果每一方都说你偏心。|抱着一堆外套，你觉得自己老了，也挺知足。}

@event home_market_inn_crowd
# en: Outside the Inn
title [d68f78] = 客栈门外
# en: {The old crowd is outside the inn, exactly where you left them. "Look who it is," someone says. "The wizard."|The old crowd have been rehearsing the wizard joke. It has a second part now.|The old crowd outside the inn. Fewer of them every break: somebody married, somebody moved away.} {season == "winter": They're stamping their feet against the cold.|They're sitting on the inn steps in the long light.}
text [9c5c3d] = {老伙计们聚在客栈门外，跟你离开时一样。“看看这是谁，”有人说，“大巫师回来啦。”|老伙计们排练过“巫师”那个笑话了。现在还多了第二段。|客栈门外的老伙计们。每个假期都少几个人：有人成了家，有人搬走了。} {season == "winter": 他们在寒风里跺着脚。|他们坐在客栈台阶上，沐着长长的日光。}
# en: A knot of young locals outside a country inn, raising their cups as a student in academy robes walks up.
scene [a67c59] = 乡间客栈外聚着一群年轻的本地人，看见一个穿学院袍的学生走来，纷纷举起杯子。
# en: Buy a round
opt.left.label [ac2c88] = 请大家喝一轮
# en: {~They drink your health and ask if you can make the beer stronger. You can't. You're asked again.|For an hour it's as if you never left.|Someone tells the story of the time you fell in the duck pond. It has grown since you left.}
opt.left.say.1 [641be5] = {~他们为你的健康干杯，问你能不能把啤酒变得更烈。你不能。他们又问了一遍。|有那么一个钟头，仿佛你从未离开。|有人讲起你掉进鸭塘的那件事。你走后，这故事又长了不少。}
# en: Stay for the gossip only
opt.right.label [b278e5] = 只听八卦
# en: {~You learn who's courting, who's feuding and whose goat ate whose washing. Somebody mutters that academy folk are tight with a coin.|You keep your crowns in your pocket and get very well informed.|They notice you didn't buy a round. They notice everything.}
opt.right.say.1 [34b92e] = {~你知道了谁在恋爱、谁在结仇、谁家的山羊吃了谁家晾的衣服。有人嘀咕学院的人真抠门。|你把克朗留在兜里，消息却灵通得很。|他们注意到你没请客。他们什么都注意得到。}

@event home_market_charm_seller
# en: The Charm Seller
title [dc4b46] = 卖护身符的人
# en: {A stall in the market is selling "genuine Lumenhold charms, blessed in the seven towers".|The charm seller has new charms and a bigger sign. The claims have grown to match.|The charm seller sees your robes and starts packing up, then thinks better of it.} {has(origin_merchant): You know that markup. You were raised on it.|{~A grandmother is buying one for luck.|The charms are bent nails tied with ribbon.|One of them is, worryingly, glowing.}}
text [9b36a4] = {集市上有个摊子在卖“正宗流明堡护身符，七塔加持”。|卖护身符的人换了新货，招牌也更大了。说辞跟着一起膨胀。|卖护身符的人看见你的学院袍，开始收摊，又改了主意。} {has(origin_merchant): 你认得那种加价。你就是在这种加价里长大的。|{~一位老奶奶正买一个求好运。|那些护身符是系着丝带的弯钉子。|其中一个居然在发光，叫人不安。}}
# en: A market stall hung with ribbons and trinkets under a hand-painted sign about academy blessings, a grandmother reaching for her purse.
scene [2e47e6] = 挂满丝带和小饰物的集市摊位，手绘招牌上吹嘘着学院加持，一位老奶奶正伸手去掏钱袋。
# en: Call out the fakes
opt.left.label [2cfc0c] = 揭穿假货
# en: {~The crowd turns on him. A grandmother gets her coin back and gives you a cake. The seller gives you a look.|He folds, and offers you a share of the trade. You decline. He seems genuinely surprised.}
opt.left.say.1 [2188b8] = {~人群倒向了你这边。一位老奶奶拿回了钱，送你一块蛋糕。摊主瞪了你一眼。|他认输了，提出分你一份生意。你拒绝了。他似乎真心感到意外。}
# en: {~The crowd takes his side. "Academy snob," someone says, buying two.|He out-talks you in front of everyone. You'd admire it if it were happening to someone else.}
opt.left.say.2 [a96e0a] = {~人群站在他那边。“学院来的势利眼。”有人说着，买了两个。|他当着所有人的面把你说得哑口无言。要是发生在别人身上，你会佩服的。}
# en: Buy one for an aunt
opt.right.label [7ab465] = 给姑妈买一个
# en: {~Your aunt will love it. It's a bent nail. She will love it anyway.|You buy one. It's useless, and the old woman beside you beams at you with approval.|You buy one that glows a little. You decide not to think about why.}
opt.right.say.1 [18ad4e] = {~你姑妈会喜欢的。那是根弯钉子。她照样会喜欢。|你买了一个。毫无用处，但旁边的老妇人对你赞许地笑了。|你买了一个微微发光的。你决定不去想它为什么发光。}

@event home_market_post_office
# en: Letters to the Castle
title [b5b8cc] = 寄往城堡的信
# en: {The town's post office is the size of a cupboard, and its clerk has never posted anything to a magic academy.|The clerk has started weighing your letters with ceremony.|The clerk reaches for the castle stamp before you speak.} {season == "winter": The window is fogged; it smells of sealing wax.|Flies wander in to read the notices.} {final_year: Soon you'll write to the castle from elsewhere.|You think about who at the castle you miss.}
text [69c4a9] = {镇上的邮局只有柜子那么大，邮务员从没往魔法学院寄过东西。|邮务员开始郑重其事地称你的信了，像举行仪式。|你还没开口，邮务员就去拿城堡邮戳了。} {season == "winter": 窗户上蒙着雾气，有股封蜡的味道。|苍蝇飞进来读告示。} {final_year: 很快，你就要从别处给城堡写信了。|你想着城堡里那些你想念的人。}
# en: A post office the size of a cupboard, a clerk ceremoniously weighing a stack of letters addressed to a castle on a lake.
scene [8ee65f] = 柜子大小的邮局里，邮务员郑重地称着一摞寄往湖上城堡的信。
# en: Write to everyone
opt.left.label [0c3aa2] = 给每个人写信
# en: {~You write until your hand cramps. The clerk sighs at the stack.|You draw the cottage for someone who has never seen one.|You start one letter with "I miss" and decide to leave it that way.}
opt.left.say.1 [5c035e] = {~你写到手抽筋。邮务员对着那一摞叹气。|你给一个从没见过乡下小屋的人画了一幅你家的小屋。|你一封信开头写了“我想念”，决定就这样留着。}
# en: Write the essay you owe
opt.right.label [4e919a] = 写欠下的论文
# en: {~You write the essay on the clerk's counter, between parcels. It's not bad.|You post an essay to a professor. The clerk asks if it'll get you into trouble. Probably.|You finish it and post it. It's the dullest thing the clerk has ever weighed.}
opt.right.say.1 [d23b12] = {~你在邮局柜台上、包裹之间写完了论文。还不赖。|你把论文寄给一位教授。邮务员问这会不会给你惹麻烦。大概会。|你写完寄出。这是邮务员称过的最无聊的东西。}
