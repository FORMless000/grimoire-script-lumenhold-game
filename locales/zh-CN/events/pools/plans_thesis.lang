# Lumenhold Academy — 简体中文 (zh-CN) translation of content/events/pools/plans_thesis.grim
# Maintained by `node tools/grim.js i18n zh-CN`. Translate the text after "="; keep {tokens}.
# "# en:" shows the English source. [hash] marks the English version a line was translated from;
# lines marked STALE need updating — after fixing the text, delete the [hash] and re-run the tool.


@event break_castle_one_fire
# en: The One Lit Fire
title [c9e9bf] = 唯一一炉火
# en: {With the houses empty, the stewards light one common room and let the rest go dark.|Someone has brought a kettle, and now there's a rota for it.|The break common room. You know everyone's blanket by now.} {season == "winter": The best armchair is right by the fire.|The best armchair is by the only breeze.} {~A first-year from Stillwater is asleep in it.|Footnote is in it. Footnote moves for no one.}
text [35aebe] = {宿舍楼都空了，管事们只点亮一间公共休息室，其余的任它暗着。|有人带来了水壶，现在还排了轮值表。|假期的公共休息室。现在每个人的毯子你都认得了。} {season == "winter": 最好的扶手椅就在炉火旁。|最好的扶手椅就在唯一有风的窗边。} {~一个静水院的一年级生在椅子上睡着了。|脚注占着那把椅子。脚注不给任何人让座。}
# en: A cavernous common room in the holidays, a handful of students in blankets crowded around {season == "winter": one roaring hearth|one open window}.
scene [24c42d] = 假期里一间空旷的公共休息室，几个裹着毯子的学生挤在{season == "winter": 一炉旺火|一扇敞开的窗}旁。
# en: Talk my way into the armchair
opt.left.label [483910] = 把扶手椅骗到手
# en: {~You mention that the kitchens are giving out free toffee. The chair empties. You feel only slightly bad.|You announce, with great authority, that the armchair is due to be re-stuffed. It is, now, by you.}
opt.left.say.1 [814810] = {~你随口提到厨房在免费发太妃糖。椅子空了。你只觉得有一点点愧疚。|你郑重宣布这把扶手椅要重新填絮了。现在它确实被填上了——用你。}
# en: {~Nobody moves. Someone says, "Nice try," without looking up from their book.|The whole room watches you fail to dislodge the armchair's occupant. It's the most entertainment anyone has had all break.}
opt.left.say.2 [46c33f] = {~没人动。有人头也不抬地说：“想得美。”|全屋的人看着你没能把扶手椅上的那位挪开。这是整个假期里大家看过最好看的节目。}
# en: Take the draughty corner
opt.right.label [590fe4] = 去漏风的角落
# en: {season == "winter": {~The corner is cold enough to see your breath, but you read three chapters.|You read in gloves. Turning pages becomes a skill.}|{~It smells of old ink and warm dust. You read three chapters.|A wasp shares your corner. You reach an understanding.}}
opt.right.say.1 [f0f6f6] = {season == "winter": {~角落冷得能看见自己的呼气，但你读完了三章。|你戴着手套读书。翻页成了一门手艺。}|{~那里有旧墨水和晒暖的灰尘的气味。你读完了三章。|一只黄蜂和你共享角落。你们达成了谅解。}}

@event break_castle_kitchen_rota
# en: The Holiday Kitchen
title [cef060] = 假期的厨房
# en: {Half the kitchen staff have gone home for the break, and the cook has started drafting whoever wanders past.|The cook spots you in the corridor and holds up an apron.|The cook holds out an apron without a word. It has your name stitched on it now.} {season == "winter": There are puddings to steam for the few who stayed, and a goose that refuses to fit the oven.|The orchard has dropped everything at once, and every pan in the kitchen is full of jam.}
text [21605b] = {一半厨工回家过假期了，厨娘开始拉路过的人来帮忙。|厨娘在走廊里看见你，举起一条围裙。|厨娘一言不发地递过一条围裙。上面现在绣着你的名字。} {season == "winter": 要给留下的几个人蒸布丁，还有一只死活塞不进烤炉的鹅。|果园里的果子一下子全落了，厨房里每口锅都在熬果酱。}
# en: A steaming castle kitchen with half its ovens cold, the cook handing aprons to two reluctant students.
scene [d1a5e4] = 冒着热气的城堡厨房，一半烤炉是冷的，厨娘把围裙递给两个不情愿的学生。
# en: Roll up your sleeves
opt.left.label [52915f] = 挽起袖子
# en: {season == "winter": {~You stir puddings till your arm aches. "Just like potion work," says the cook. It isn't.|You baste the goose. The goose wins, narrowly.}|{~A morning of jam teaches you more about setting points than a term of alchemy.|You label forty jars. The cook re-spells "gooseberry" on all of them.}}
opt.left.say.1 [8da2f1] = {season == "winter": {~你搅布丁搅到胳膊发酸。“跟熬魔药一样。”厨娘说。并不一样。|你给鹅刷油。鹅以微弱优势获胜。}|{~一上午的果酱让你对凝固点的了解超过一学期炼金课。|你给四十个罐子贴了标签。厨娘把每张上的“醋栗”都重新拼了一遍。}}
# en: Discover urgent business elsewhere
opt.right.label [14e943] = 想起别处有急事
# en: {~You escape to the village and buy a pie you could have had for free. The cook sees you come back with the crumbs.|You hide in the library until lunch. Lunch, it turns out, is served by the cook, who gives you the smallest portion with a meaningful look.}
opt.right.say.1 [7339e7] = {~你溜去山下小镇，买了一个本来可以白吃的馅饼。厨娘看见你带着饼渣回来。|你躲在图书馆直到午饭。结果午饭是厨娘盛的，她意味深长地给了你最小的一份。}

@event break_castle_empty_library
# en: The Library on Holiday
title [4ce56c] = 放假的图书馆
# en: {The librarians have gone home, and the library has been left to you and the cat.|Footnote has moved from the reference desk to your chair, and opens one eye.|Your break-morning library. One window seat is yours now.} {season == "winter": Frost has drawn ferns on the tall windows.|Dust turns slowly in the long summer light.} {~Every desk is free.|Someone has left half an essay on the theory of hiccups.|The reshelving cart is full, and nobody is coming for it.}
text [df5224] = {图书管理员们都回家了，图书馆留给了你和那只猫。|脚注从咨询台挪到了你的椅子上，睁开一只眼。|你的假期早晨图书馆。有一个靠窗的座位现在归你了。} {season == "winter": 霜在高窗上画满了蕨叶。|灰尘在长长的夏日光线里慢慢打转。} {~每张书桌都空着。|有人留下半篇论打嗝理论的论文。|还书车堆满了，没人会来推。}
# en: A great library with no one at the desks, a cat asleep on the reference desk and a single student choosing a book.
scene [e16f43] = 一座书桌空无一人的大图书馆，一只猫睡在咨询台上，一个学生在挑书。
# en: Read whatever I like
opt.left.label [0ceb4d] = 想读什么读什么
# en: {~You read a book about the history of spoons and forget to eat lunch. It was a very good book about spoons.|You read until the light goes, then a little after. Your eyes will mention it tomorrow.}
opt.left.say.1 [7d67df] = {~你读了一本讲勺子历史的书，忘了吃午饭。那是一本非常好的讲勺子的书。|你一直读到天光散尽，又多读了一会儿。明天你的眼睛会提起这件事。}
# en: Get ahead on next term
opt.right.label [d47dc6] = 提前预习下学期
# en: {final_year: You make notes for a term you'll only half get to use. It still feels like the right thing to do.|{~You make a neat set of notes for next term. Future you will be grateful. Present you is bored stiff.|You read ahead three chapters and find the professor's favourite mistake waiting in the fourth.}}
opt.right.say.1 [9f7a93] = {final_year: 你为一个只能用上一半的学期做笔记。可还是觉得该这么做。|{~你为下学期整理了一套整齐的笔记。将来的你会感激。现在的你闷得要命。|你往前读了三章，在第四章撞见了教授最爱犯的那个错误。}}

@event break_castle_post_day
# en: Post for the Stay-Behinds
title [38476c] = 留守者的信件
# en: {Post day. The porter lays the letters out on one table in the Great Hall.|The porter now sorts the stay-behinds' letters into a pile of their own.|The porter nods to you. He keeps your letters on top now.} {season == "winter": {~Most of it is Midwinter cards for people who went home.|One parcel is exactly the shape of a scarf.}|{~Most of it is postcards from people's travels.|A postcard says "Wish you were here", and nobody knows whose it is.}}
text [63e061] = {邮件日。门房把信摊在大礼堂的一张桌子上。|门房现在把留守者的信单独分成一小叠。|门房朝你点点头。他现在把你的信放在最上面。} {season == "winter": {~大多是寄给回家的人的仲冬贺卡。|有个包裹的形状和一条围巾一模一样。}|{~大多是旅行中的人寄来的明信片。|一张明信片上只写着“真希望你也在”，没人知道是给谁的。}}
# en: A porter sorting a thin pile of letters on a long empty table, a few students waiting hopefully.
scene [b2c195] = 门房在空荡的长桌上分拣一小叠信，几个学生满怀希望地等着。
# en: Write a long letter home
opt.left.label [b376a0] = 给家里写封长信
# en: {final_year: You write that after this year you'll be home for good, and then look at the sentence for a long time.|{~You write four pages and pay for the heavy stamp. It's the closest thing to a conversation you've had all week.|You describe the empty castle so well that you feel lonelier writing it than living it.}}
opt.left.say.1 [491cfa] = {final_year: 你写道过完这一年就会回家长住了，然后盯着这句话看了很久。|{~你写了四页，付了厚信的邮费。这是你这一周里最像聊天的一次。|你把空荡荡的城堡写得太好，写的时候比住在里面还寂寞。}}
# en: Help the porter sort it all
opt.right.label [329389] = 帮门房分拣
# en: {~The porter tells you who writes to whom, in strict confidence. You know far too much about the second-years now.|You sort the post into houses. There's nothing for you this time. The porter gives you a biscuit, which is nearly as good.}
opt.right.say.1 [93bca8] = {~门房严格保密地告诉你谁给谁写信。现在你对二年级生知道得太多了。|你把信按学院分好。这次没有你的。门房给了你一块饼干，差不多一样好。}

@event break_home_kitchen_table
# en: Homework at the Kitchen Table
title [081adf] = 厨房桌上的功课
# en: {You spread your books across the kitchen table, where you did your sums as a child.|Your books have been moved for the bread, and one is being used as a trivet.|The family works around your books now. Mostly.} {season == "winter": The stove is the only warm place, so everyone is in the kitchen.|The door is open, and everyone passing asks what the book is about.} {~A small cousin has drawn a dragon in your margin.|The kettle boils every quarter-hour, on principle.}
text [272d56] = {你把书摊在厨房桌上，小时候你就在这儿算算术。|你的书被挪开给面包腾地方，有一本被拿去垫了锅。|家里人现在会绕着你的书干活。大多数时候。} {season == "winter": 炉子是屋里唯一暖和的地方，所以大家都在厨房。|门朝院子开着，每个路过的人都要问这书讲什么。} {~一个小表亲在你的页边画了条龙。|水壶每一刻钟烧开一次，原则问题。}
# en: A family kitchen in the morning, a student's books spread among the breakfast plates, someone reaching across them for the butter.
scene [6a8ca6] = 早晨的家中厨房，学生的书摊在早餐盘子之间，有人越过书去够黄油。
# en: Study through the noise
opt.left.label [9218fa] = 顶着吵闹学习
# en: {~You read the same paragraph nine times and learn it perfectly, along with the price of eggs.|You get through a chapter. Your notes now have a jam stain, a crumb and the shopping list on them.}
opt.left.say.1 [a65fee] = {~同一段你读了九遍，背得滚瓜烂熟，连带记住了鸡蛋的价钱。|你读完了一章。你的笔记上现在有一块果酱渍、一粒面包屑和一张购物清单。}
# en: Give up and help with lunch
opt.right.label [91e189] = 放弃，帮忙做午饭
# en: {~You're sent to the shop for the one thing everyone forgot, and you buy sweets with the change.|You peel, chop and get told about everyone in the village. Your book stays shut, and it's the best morning of the break.}
opt.right.say.1 [7e9a03] = {~你被派去店里买大家都忘了的那样东西，用找零买了糖。|你削皮、切菜，听了村里每个人的近况。书一直没打开，这是假期里最好的一个上午。}

@event break_home_the_box
# en: The Box Under the Bed
title [dfd52f] = 床底下的盒子
# en: {Your old room is smaller than you remember. Under the bed is the box where you kept everything that mattered when you were nine.|Someone has dusted the box since last time and pretended not to look inside.|You've almost reached the bottom of the box.} {~This time it's a wand you made from a stick and a lot of string.|This time it's the letter you wrote to the academy at age ten, asking to be let in early.|This time it's a drawing of seven towers, each with a little flag.}
text [4a2c58] = {你的旧房间比记忆里小。床底下是你九岁时装一切重要东西的盒子。|上次之后有人掸过盒子上的灰，还假装没往里看。|你快翻到盒底了。} {~这次是一根你用树枝和一大堆绳子做的魔杖。|这次是你十岁时写给学院的信，请求提前入学。|这次是一幅七座塔的画，每座塔上都插着小旗。}
# en: A narrow childhood bedroom with a bed far too short for its occupant, an old box of keepsakes pulled out onto the floor.
scene [2fff89] = 一间窄小的儿时卧室，床对现在的主人来说短得多，一盒旧纪念品被拖到地板上。
# en: Pack it in your trunk
opt.left.label [60f445] = 装进行李箱
# en: {~It comes back to Lumenhold with you. The trunk is heavier, and so, somehow, are you.|You pack it between your robes. Every time you open the trunk this term, it will be the first thing you see.}
opt.left.say.1 [db216f] = {~它跟你一起回了流明堡。箱子更沉了，不知怎么，你也是。|你把它夹在袍子中间。这学期每次打开箱子，它都会是你第一眼看到的东西。}
# en: Give it to the youngest cousin
opt.right.label [5ecbd0] = 送给最小的表亲
# en: {~The youngest cousin takes it with enormous seriousness and announces that they're going to be a wizard too. You feel very old.|The cousin promises to keep it safe. By supper it has been traded to a neighbour's child for a frog.}
opt.right.say.1 [53894b] = {~最小的表亲无比郑重地接过去，宣布自己也要当巫师。你觉得自己老了。|表亲保证会好好收着。到晚饭时，它已经被换给邻居家的孩子，换来一只青蛙。}

@event break_home_family_debate
# en: The Family Debate
title [673f25] = 家庭辩论
# en: {At breakfast the family is arguing, and someone says, "Ask the scholar."|The argument has started without you. Everyone turns as you come down the stairs.|"The scholar is up," someone announces. They've saved today's argument for you.} {season == "winter": {~Is it colder than the year of the big snow?|Can you freeze a pond by thinking at it?}|{~Do swallows sleep at the bottom of rivers?|Will it rain on the fair, and can you stop it?}}
text [ae49b2] = {早饭时一家人在争论，有人说：“问问读书人。”|争论没等你就开始了。你下楼时，所有人都转过头来。|“读书人起来了。”有人宣布。他们把今天的争论留给了你。} {season == "winter": {~今年是不是比大雪那年还冷？|光靠想就能把池塘冻住吗？}|{~燕子是不是睡在河底？|集市那天会下雨吗，你能不能拦住？}}
# en: A breakfast table mid-argument, several relatives pointing at a student as if they were the deciding vote.
scene [0af97b] = 争论正酣的早餐桌，几个亲戚指着一个学生，好像那是决定性的一票。
# en: Settle it with what I've learned
opt.left.label [650629] = 用学到的东西解决
# en: {~You explain it so clearly that the argument ends. There is a short, respectful silence, and then a new argument starts.|You settle it. An uncle demands to see it in writing. You write it on a napkin, and he keeps the napkin.}
opt.left.say.1 [4a57e8] = {~你讲得清清楚楚，争论结束了。一阵短暂而尊敬的沉默，然后新的争论开始了。|你解决了。一位叔叔要你写下来。你写在餐巾上，他把餐巾收了起来。}
# en: {~You explain it perfectly, and they all decide the academy has taught you nonsense.|Halfway through you realise you're wrong. So does everyone else.}
opt.left.say.2 [52fa36] = {~你讲得完美无缺，结果他们一致认定学院教了你一堆胡话。|讲到一半你发现自己错了。其他人也发现了。}
# en: Refuse to take sides
opt.right.label [146465] = 拒绝站队
# en: {~You butter your toast with great care and say, "Hm." It does not stop anyone, but it does save you.|You change the subject to the neighbour's fence. It works, but now there are two arguments.}
opt.right.say.1 [9a1a3b] = {~你非常仔细地给吐司抹黄油，说了声“嗯”。没能阻止任何人，但救了你自己。|你把话题转到邻居家的篱笆上。奏效了，但现在有两场争论了。}

@event break_home_village_children
# en: The Wizard Is Home
title [167820] = 巫师回来了
# en: {Word has spread that you're home from the wizard school. The village children are waiting at the gate.|The children are back at the gate, with a younger sibling to show you off to.|The gate committee is in session. They've drawn up a list.} {season == "winter": They want more snow.|They want it to stop being so hot.} {~The smallest has a jar, in case you make something worth keeping.|One asks if you've ever met a dragon.|The tallest has a stick that might be a wand.}
text [3088a4] = {消息传开了，说你从巫师学校回来了。村里的孩子们在门口等着。|孩子们又来到门口，还带了个弟弟妹妹来看你。|门口委员会又开会了。他们列了一张清单。} {season == "winter": 他们想要更多的雪。|他们想让天别这么热。} {~最小的那个拿着一个罐子，万一你变出什么值得留着的东西。|有个孩子问你见没见过龙。|最高的那个拿着一根棍子，说不定真是魔杖。}
# en: A gaggle of village children at a cottage gate in the morning, staring hopefully at a student in academy robes.
scene [53f9d2] = 早晨一群村里孩子聚在小屋门口，满怀期待地盯着一个穿学院长袍的学生。
# en: Show them some sparks
opt.left.label [b1cdc8] = 给他们放点火花
# en: {~You make a little burst of light over the gate. The children scream with delight and demand it again, and again.|You make a spark dance across the gatepost. The smallest one tries to catch it in cupped hands, or thinks they do, which is the same thing.}
opt.left.say.1 [a47bb8] = {~你在门上方变出一小团光。孩子们高兴得尖叫，要你再来，再来，再来。|你让一颗火花在门柱上跳舞。最小的那个想用手捧住它，或者以为捧住了，那也一样。}
# en: Teach them something real
opt.right.label [f0ec48] = 教他们点真东西
# en: {~You explain how the light gets into a spell. They listen politely and then ask for sparks.|You show them how to sit still and listen to a candle. One of them really hears it. You can tell.}
opt.right.say.1 [d2d889] = {~你讲光是怎么进到咒语里的。他们礼貌地听完，然后要火花。|你教他们静静坐着听一支蜡烛。其中一个真的听见了。你看得出来。}

@event break_work_holiday_rush
# en: The Holiday Rush
title [c1bbea] = 假日高峰
# en: {The holidays bring the crowds.|This time you've learned to eat breakfast before the rush, not during it.|You can feel the rush coming an hour before it arrives.} {member(tavern): The Gilded Newt is packed to the beams.|{member(apothecary_clerk): The queue at Pell & Daughters is out of the door.|{member(broom_courier): The loft's shelves are stacked to the rafters with parcels.|{member(library_assistant): The library is full of last-minute readers.|Everyone wants something, and now.}}}} {season == "winter": {~Everyone wants it before Midwinter.|Wet boots, short tempers.}|{~Everyone is sunburnt.|Travellers keep asking the way.}}
text [bf46c0] = {假期带来了人潮。|这次你学会了在高峰前吃早饭，而不是在高峰中。|高峰还有一个钟头才到，你已经感觉到了。} {member(tavern): 镀金蝾螈酒馆挤得水泄不通。|{member(apothecary_clerk): 佩尔父女药铺的队排到了门外。|{member(broom_courier): 阁楼的架子上包裹一直堆到房梁。|{member(library_assistant): 图书馆里全是临时抱佛脚的读者。|人人都想要点什么，而且现在就要。}}}} {season == "winter": {~人人都想在仲冬前拿到。|湿靴子，坏脾气。}|{~人人都晒得通红。|旅人不停地问路。}}
# en: A holiday rush at a busy workplace, a student in the thick of it wearing the fixed smile of someone on their fourth hour of the same question.
scene [0eb180] = 假期里忙碌的工作场所，一个学生身处人潮中央，挂着第四个钟头回答同一个问题的僵硬笑容。
# en: Smile through it
opt.left.label [35213b] = 笑着撑过去
# en: {~You smile until your face aches. Somebody tips you a coin and a peppermint.|You smile through the fourth complaint about the weather, as if it were your fault. Somehow the tips are better than ever.}
opt.left.say.1 [e14faf] = {~你笑到脸发酸。有人给了你一枚小费和一颗薄荷糖。|第四个人来抱怨天气，好像是你的错，你照样笑着。不知怎么，小费比哪次都多。}
# en: Take the heavy jobs instead
opt.right.label [7fdbc4] = 改干重活
# en: {~You haul the heaviest loads all morning and talk to no one. Your arms complain, and nobody else does.|You take the dull, heavy work nobody wants. It's tiring and blissfully quiet.}
opt.right.say.1 [ae49ee] = {~你搬了一上午最沉的东西，一句话没说。胳膊在抱怨，别的谁也没抱怨。|你揽下了没人想干的又闷又重的活。累，但安静得幸福。}

@event break_work_opening_up
# en: Opening Up
title [307370] = 开门
# en: {In the holidays you're trusted with the keys. You open up at dawn, alone.|You've learned to lift the door as you turn the key.|You could open up in your sleep, and once you nearly did.} {season == "winter": It's still dark, and the stove has gone out.|The sun is up and the street smells of warm stone.} {~There's a note under the door from someone who wanted to come in at midnight.|A cat waits on the step as if it has an appointment.|The place is yours for half an hour.}
text [b61388] = {假期里你被托付了钥匙。天一亮你独自开门。|你学会了转钥匙时顺手把门往上一抬。|你闭着眼都能开门，有一次差点真这么干了。} {season == "winter": 天还黑着，炉子夜里灭了。|太阳已经升起，街上有暖石头的气味。} {~门缝下塞着一张字条，来自半夜想进来的人。|一只猫在台阶上等着，好像有预约。|这地方有半个钟头归你一个人。}
# en: A student unlocking a shop door in the half-light of early morning, breath steaming, the street empty behind them.
scene [7b5489] = 清晨微光中一个学生在开店门，呼出白气，身后的街道空无一人。
# en: Do it all by the book
opt.left.label [433ff5] = 一切按规矩来
# en: {~Swept, stocked and opened to the minute. The owner notices and slips you a little extra.|Everything is ready when the first customer arrives. Nobody notices but you. Still, the coin is good.}
opt.left.say.1 [87aff6] = {~扫好、摆好、准点开门。老板注意到了，悄悄多塞给你一点。|第一位客人来时一切就绪。除了你没人注意。不过钱是实在的。}
# en: Steal a quiet half hour
opt.right.label [48ac16] = 偷半个钟头清闲
# en: {~You drink tea by the window and watch the street wake up. It's the best part of the job.|You read a chapter with your feet up. Nobody ever knows.}
opt.right.say.1 [78a2fb] = {~你在窗边喝茶，看街道醒来。这是这份工作最好的部分。|你把脚翘起来读了一章。没人知道。}
# en: {~The owner arrives early and finds you with your feet up. The half hour comes out of your wages.|The first customer arrives early and finds the door locked. They leave a note. So does the owner.}
opt.right.say.2 [f55bf7] = {~老板来早了，看见你翘着脚。那半个钟头从工钱里扣了。|第一位客人来早了，发现门锁着。他留了张字条。老板也留了一张。}

@event break_work_regular
# en: The Holiday Regular
title [4ae6e4] = 假期常客
# en: {Every holiday has its regular. This one comes every morning and wants to talk.|The regular is back. They wave to you as if you were old friends.|The regular has started calling you by your first name.} {~Today it's about their late husband's beard.|Today it's about a dragon they swear they saw as a girl.|Today it's about the year the lake froze, which may or may not have happened.} The queue behind them is getting longer.
text [4389fa] = {每个假期都有个常客。这一位每天早上都来，而且想聊天。|常客又来了。冲你挥手，像是老朋友。|常客开始直接叫你的名字了。} {~今天聊的是过世丈夫的胡子。|今天聊的是一条龙，她发誓小时候见过。|今天聊的是湖结冰的那一年，那年也许有，也许没有。} 后面的队越排越长。
# en: An elderly customer settling in for a long chat at a counter, a student behind it glancing at the queue.
scene [4825ff] = 一位年长的客人在柜台前坐定准备长谈，柜台后的学生瞥着排队的人。
# en: Let them finish the story
opt.left.label [884a81] = 让他们把故事讲完
# en: {~You hear the whole story. The queue thins out to somewhere else. The regular leaves happy, and so, oddly, are you.|The story has an ending you didn't expect, and you'll think about it all day. The customers you lost won't.}
opt.left.say.1 [fb7b77] = {~你听完了整个故事。排队的人散去别家了。常客高高兴兴地走了，奇怪的是，你也是。|故事的结局出乎意料，你会想一整天。流失的客人可不会。}
# en: Hurry them gently along
opt.right.label [7b4db3] = 温和地催一催
# en: {~You serve the queue and the regular leaves, mid-sentence, with a little wave. It shouldn't bother you as much as it does.|The queue is grateful. The regular says, "Another time, then," and you both know they mean it.}
opt.right.say.1 [65f752] = {~你招呼了排队的人，常客话说到一半，挥挥手走了。这事不该让你这么在意。|排队的人很感激。常客说：“那下回吧。”你们都知道这话是真心的。}

@event break_work_new_hire
# en: The Holiday Hire
title [ff5b6a] = 假期新人
# en: {The owner has taken on a holiday hire and put them next to you.|Another holiday hire, another nervous face. You're the old hand now.|This break's new hire looks at you the way you once looked at everyone.} {~They've already dropped something.|They ask whether the job is always like this. You don't answer.|They're very keen and very fast, and very nearly right.}
text [d79564] = {老板招了个假期临时工，安排在你旁边。|又一个临时工，又一张紧张的脸。现在你是老手了。|这个假期的新人看你的眼神，就像你当初看所有人。} {~他们已经摔了个东西。|他们问这活儿是不是一直这样。你没回答。|他们很热心、很快，而且差一点就对了。}
# en: A nervous new worker holding a tray at the wrong angle, a student leaning over to correct them.
scene [c6ec03] = 一个紧张的新人用错误的角度端着托盘，一个学生探身过去纠正。
# en: Show them the ropes
opt.left.label [f00110] = 带带新人
# en: {~By noon they know where everything is and that the owner is all bark. You've lost a morning and gained a friend.|You teach them the trick with the till. They teach you a song. You both get told off for the song.}
opt.left.say.1 [b40c0d] = {~到中午他们知道了每样东西在哪，也知道老板只是嘴凶。你搭进一个上午，多了个朋友。|你教他们收银台的窍门。他们教你一首歌。你们俩因为那首歌一起挨了骂。}
# en: Let them learn the hard way
opt.right.label [c3bb81] = 让他们吃点苦头
# en: {~They learn. Unfortunately, they learn by breaking a jar that the owner puts on your account.|You let them flounder. It takes them all day to find the stockroom, and you end up covering their shift anyway.}
opt.right.say.1 [e7b404] = {~他们学会了。可惜是靠打碎一个罐子学会的，老板记在了你账上。|你让他们自己摸索。他们找了一整天库房，最后还是你替他们顶了班。}

@event break_internship_lodgings
# en: Breakfast at the Lodgings
title [ae293d] = 寄宿处的早餐
# en: {{member(intern_expedition): Your lodging for the placement is a tent that flaps all night.|{member(intern_field_station): Your lodging is a bunk in the station cabin, under a shelf of jars.|Your lodging is one small room and a breakfast you pay for.}}|By now you can make any lodging home in an evening, a book on the sill and your boots by the door.|You've slept in enough borrowed beds to know breakfast matters more than the mattress.} {season == "winter": {~Your breath steams.|The water jug has frozen.}|{~It's warm before sunrise.|A bird is shouting outside.}} {~Breakfast is porridge.|Breakfast is porridge with opinions.|Breakfast is unnamed.}
text [f2d575] = {{member(intern_expedition): 这次实习的住处是一顶整夜扑扑作响的帐篷。|{member(intern_field_station): 你的住处是野外站小木屋里的一张铺位，头顶一排罐子。|你的住处是一个小房间，外加一顿要付钱的早餐。}}|如今不管什么住处，你一个晚上就能住成家：窗台上一本书，门边一双靴子。|你睡过的借来的床够多了，知道早餐比床垫要紧。} {season == "winter": {~呼出的气冒着白烟。|水壶冻住了。}|{~太阳没出来就暖了。|外面有只鸟在大喊。}} {~早餐是粥。|早餐是有主见的粥。|早餐是一样没人叫得出名的东西。}
# en: A borrowed bed at dawn, boots by the door, a bowl of breakfast waiting and a notebook open on the blanket.
scene [7aadaf] = 黎明时一张借来的床，靴子放在门边，一碗早餐等着，毯子上摊着一本笔记。
# en: Eat a proper breakfast
opt.left.label [f0ec45] = 好好吃顿早饭
# en: {~You eat slowly and listen to everyone's gossip. You arrive late enough to be noticed.|Fed, warm and five minutes late. Your supervisor looks at the clock and says nothing at all.}
opt.left.say.1 [125952] = {~你慢慢吃，听着各种闲话。到得晚了，晚到会被注意。|吃饱了，暖和了，晚了五分钟。导师看了看钟，什么也没说。}
# en: Skip it and go in early
opt.right.label [cfe210] = 不吃了，早点去
# en: {~You're the first one in. You get through a pile of work before anyone else arrives, and your stomach growls through every meeting after.|You read the day's notes on the way. By lunchtime you're faint and well informed.}
opt.right.say.1 [67b2c7] = {~你第一个到。别人来之前你已经处理掉一堆活，之后的每场会上你的肚子都在叫。|你在路上读当天的笔记。到午饭时你头晕眼花，消息灵通。}

@event break_internship_briefing
# en: The Morning Briefing
title [7aa6d4] = 晨间布置
# en: {Your supervisor reads the day's tasks aloud, once, very fast.|You bring two pens now, and a spare for the intern beside you.|You've learned to read the briefing from the way your supervisor holds the list.} {~One task makes no sense at all.|One task seems to mean the opposite of what it says.|The last task is mumbled into a cup of tea.} {final_year: It's your last placement, and you want it to count.|The others all write as if they understood.}
text [fa84ba] = {导师把当天的任务大声念一遍，只念一次，念得飞快。|你现在带两支笔，还给旁边的实习生备一支。|你已经能从导师拿清单的姿势读出任务了。} {~有一项任务完全说不通。|有一项任务似乎和字面意思正相反。|最后一项任务是对着茶杯嘟囔出来的。} {final_year: 这是最后一次实习，你想让它有分量。|其他人都写得好像全听懂了。}
# en: A supervisor reading a list of tasks aloud to a row of interns, one of whom has stopped writing.
scene [ba7fb6] = 导师对着一排实习生大声念任务清单，其中一个停下了笔。
# en: Ask what it means
opt.left.label [5dfe5f] = 问清楚是什么意思
# en: {~Your supervisor explains it again, slowly, while the other interns smirk. Two of them come to you at lunch to ask what it meant.|"Good question," says your supervisor, in a tone that suggests it wasn't. You get the task right, anyway.}
opt.left.say.1 [792617] = {~导师又慢慢解释了一遍，其他实习生偷笑。午饭时有两个人跑来问你那是什么意思。|“好问题。”导师说，语气表明并不是。不管怎样，你把任务做对了。}
# en: Guess and get on with it
opt.right.label [f42afd] = 猜一猜，先干起来
# en: {~You guess right. Your supervisor nods as if they never doubted you.|It turns out the odd task was "take the rest of the morning off". Lucky.}
opt.right.say.1 [403deb] = {~你猜对了。导师点点头，好像从没怀疑过你。|原来那项古怪的任务是“上午剩下的时间休息”。运气不错。}
# en: {~You guess wrong and spend the morning carefully doing the opposite of what was wanted.|You did the right task to the wrong thing. The wrong thing will never be the same again.}
opt.right.say.2 [c7aa1c] = {~你猜错了，一上午都在一丝不苟地做和要求相反的事。|你对错的东西做了对的任务。那样东西再也回不去了。}

@event break_internship_other_interns
# en: The Other Interns
title [ebc4c3] = 其他实习生
# en: {There are other interns here, and they've already formed a lunch table.|You've learned to find the lunch table on the first day, and which seat isn't anyone's.|By now you can tell within a morning which intern is the one to sit beside.} {~One has a cousin on the Conclave and mentions it hourly.|One is better than all of you, and very nice about it.|One has been here before and knows where the biscuits are.} {season == "winter": Lunch is eaten in coats.|Lunch is eaten in the sun.}
text [5f46bc] = {这里还有别的实习生，他们已经凑成了一张午饭桌。|你学会了第一天就找到午饭桌，还有哪个座位不属于任何人。|如今一上午你就能看出该坐在哪个实习生旁边。} {~有一个的表亲在七塔议会，每小时提一次。|有一个比你们都强，而且人很好。|有一个以前来过，知道好饼干藏在哪。} {season == "winter": 午饭是穿着外套吃的。|午饭是晒着太阳吃的。}
# en: A small group of interns eating lunch together, one sitting slightly apart with a notebook.
scene [72d29c] = 几个实习生一起吃午饭，一个拿着笔记本的人坐得稍远。
# en: Join them for lunch
opt.left.label [24ea1a] = 和他们一起吃午饭
# en: {~You chip in for the shared food and find out which of the supervisors are kind. Useful, and fun.|You talk shop until your lunch is cold. It turns out everyone else is as lost as you are, which helps.}
opt.left.say.1 [489e67] = {~你凑钱买了大家分的吃食，打听到哪些导师心肠好。有用，也开心。|你们聊工作聊到饭都凉了。原来大家和你一样摸不着头脑，这让人宽心。}
# en: Eat alone with your notes
opt.right.label [5262d8] = 独自看笔记吃饭
# en: {~You finish the reading for the afternoon. You hear laughter from the table, and you don't look up.|You get ahead of everyone. Nobody saves you a biscuit.}
opt.right.say.1 [eb6606] = {~你读完了下午的材料。桌子那边传来笑声，你没抬头。|你领先了所有人。没人给你留饼干。}

@event break_internship_stipend
# en: Stipend Day
title [75f50a] = 发津贴的日子
# en: {Stipend day. A small envelope, your name spelled almost right.|You've learned to budget the envelope before you open it.|Stipend day. You know what it's for before it arrives, and it still feels like a gift.} {member(intern_expedition) or member(intern_field_station): {~The supply cart has come, with a pedlar riding on top.|A pedlar has walked a very long way to sell you socks.}|{season == "winter": {~There's a warm scarf in a shop window you pass.|A bookshop nearby has a sale on almanacs.}|{~A cart is selling lemon ices on the corner.|A bookshop nearby has put its sale out in the sun.}}}
text [db989b] = {发津贴了。一个小信封，你的名字几乎拼对了。|你学会了在拆信封之前就把钱安排好。|发津贴的日子。钱还没到你就知道它的用处，可它仍然像一份礼物。} {member(intern_expedition) or member(intern_field_station): {~补给车来了，车顶上坐着一个货郎。|一个货郎走了很远的路来卖袜子给你。}|{season == "winter": {~你路过的橱窗里有一条暖和的围巾。|附近的书店在打折卖年历。}|{~街角有辆小车在卖柠檬冰。|附近的书店把打折书摆到了太阳底下。}}}
# en: A small envelope of coins on a desk, a student looking at it with the expression of someone doing sums.
scene [8956ab] = 书桌上一个装着硬币的小信封，一个学生看着它，一脸在算账的表情。
# en: Treat yourself
opt.left.label [ebab6c] = 犒劳一下自己
# en: {member(intern_expedition) or member(intern_field_station): {~You buy the pedlar's thickest socks. Your feet have never been so grateful.|You buy a jar of honey from the pedlar and eat it with a spoon, in triumph.}|{season == "winter": {~You buy it. It's quite unnecessary, and the warmest you've felt all week.|You spend the lot before lunch and regret none of it.}|{~You spend it before the corner and don't regret a crown.|You take your purchase to a bench in the sun and stay until your nose burns.}}}
opt.left.say.1 [4d9a99] = {member(intern_expedition) or member(intern_field_station): {~你买了货郎最厚的袜子。你的脚从没这么感激过。|你从货郎那儿买了一罐蜂蜜，用勺子吃，吃得扬眉吐气。}|{season == "winter": {~你买下了它。完全没必要，却是你这一周最暖和的时刻。|午饭前你就花光了，一点也不后悔。}|{~没走到街角你就花完了，一个克朗都不后悔。|你带着买来的东西坐到阳光下的长椅上，一直坐到鼻子晒伤。}}}
# en: Buy the book your supervisor cited
opt.right.label [d968e7] = 买导师引用的那本书
# en: {~It's the dullest book you've ever paid for, and the most useful. You underline half of it the first night.|You send for it and read it, and the next time your supervisor mentions it you nod in the right places.}
opt.right.say.1 [3bed7f] = {~这是你花钱买过最枯燥的书，也最有用。第一晚你就划了一半。|你托人捎来读了，下次导师提到它时，你在该点头的地方点了头。}

@event thesis_margin_notes
# en: Notes in the Margin
title [6ecc14] = 页边批注
# en: {Professor Thorne returns your chapter. In the margin of page one he has written "No."|Another chapter back. The margins say "Why?", "Source?" and, once, "Hm."|Thorne's notes are getting shorter. You can't decide whether that's good.} {~Page six has a single word underlined three times.|One note just says "See me."|There's a tick on page nine. You stare at it for a while.} {progress(thesis) >= 60: The argument is nearly there, and he knows it.|There's a long way to go.}
text [4c2d2f] = {索恩教授把你的章节退了回来。第一页的页边上他写着：“不。”|又一章退回来了。页边写着“为什么？”“出处？”，还有一处：“嗯。”|索恩的批注越来越短。你拿不准这是不是好事。} {~第六页有一个词被画了三道线。|有一条批注只写着“来见我”。|第九页有一个勾。你盯着它看了好一会儿。} {progress(thesis) >= 60: 论证就快成了，他也知道。|还有很长的路要走。}
# en: A thesis draft returned with a professor's spiky handwriting crawling up every margin.
scene [981dda] = 一份退回的论文草稿，教授尖利的字迹爬满了每一处页边。
# en: Rewrite to his notes
opt.left.label [cbc3e9] = 照他的批注改
# en: {~You rewrite every page he marked. The chapter is shorter and better, and you hate that he was right.|You take every note. When he reads it again he crosses out only one thing, and you could cry.}
opt.left.say.1 [ed9ffe] = {~他标过的每一页你都重写了。这一章更短、更好，你恨他是对的。|你采纳了每一条批注。他再读时只划掉了一处，你差点哭出来。}
# en: Defend my version
opt.right.label [6497f5] = 为我的版本辩护
# en: {~You make your case at his office door. He listens, says "Hm," and crosses out his own note.|You argue for your paragraph and he lets you keep it. "Then make it say so," he says, which is almost praise.}
opt.right.say.1 [d4a78e] = {~你在他办公室门口陈述理由。他听完，说了声“嗯”，划掉了自己的批注。|你为自己那一段据理力争，他让你留下了。“那就让它把话说清楚。”他说，这几乎算是夸奖。}
# en: {~You argue. Thorne waits until you've finished, then points at the sentence that proves him right.|He hears you out, then writes a new note in the margin. It says "No." again, in smaller letters.}
opt.right.say.2 [b7b6bf] = {~你争了。索恩等你说完，然后指着证明他是对的那一句。|他听你说完，在页边写了一条新批注。还是“不。”，字小了一号。}

@event thesis_carrel_neighbour
# en: The Next Carrel
title [1fe6fe] = 隔壁隔间
# en: {Your carrel neighbour, a final-year from Rootward, reads aloud under their breath.|Your carrel neighbour now reads your chapter titles aloud too.|You and your carrel neighbour now speak a language of sighs.} {~They're stuck on chapter three.|They've found a source that disagrees with you both.|They pass you half a sandwich over the partition.} {season == "winter": The thesis lab is cold enough for gloves.|Someone's notes are escaping through the window.}
text [97a4d0] = {你的隔间邻居是一位根庐的毕业年级生，总在小声念书。|你的隔间邻居现在连你的章节标题也念出声来。|你和隔间邻居现在用叹气交流。} {~他们卡在第三章了。|他们找到一份和你俩都唱反调的资料。|他们从隔板上方递给你半个三明治。} {season == "winter": 论文实验室冷得要戴手套。|有人的笔记正从窗口往外逃。}
# en: Two thesis carrels side by side, the partition between them covered in pinned notes and a shared candle.
scene [e1d83d] = 两个并排的论文隔间，中间的隔板上钉满了笔记，还有一支共用的蜡烛。
# en: Swap drafts for an hour
opt.left.label [d31846] = 交换草稿看一小时
# en: {~They find the hole in your argument in ten minutes. You find three in theirs. Everyone feels better and worse.|They read your chapter and say, "Oh, I see." You're not sure you did, until now.}
opt.left.say.1 [1201cc] = {~他们十分钟就找到了你论证里的漏洞。你在他们的里面找到三个。大家都觉得好受了些，也难受了些。|他们读完你的章节，说：“哦，我明白了。”在这之前你都不确定自己明白。}
# en: {~They love your chapter, which helps nobody. You spend the hour fixing their commas.|They ask so many questions that you start doubting your title.}
opt.left.say.2 [cd87ca] = {~他们很喜欢你的章节，这对谁都没帮助。你花了一小时改他们的逗号。|他们问了太多问题，你开始怀疑起自己的标题。}
# en: Hunt a source in the stacks
opt.right.label [714cad] = 去书库找资料
# en: {~You find it on the bottom shelf, under a dictionary and a sleeping cat. It says exactly what you hoped, in a footnote.|Three hours of climbing ladders for one paragraph. It's a very good paragraph.}
opt.right.say.1 [5c9181] = {~你在最底层书架上找到了它，压在一本词典和一只睡着的猫下面。它说的正是你希望的，在一条脚注里。|爬了三个钟头梯子换来一段话。是非常好的一段话。}

@event thesis_is_it_good
# en: Is It Any Good?
title [cfa126] = 写得好吗？
# en: {Halfway through rereading your thesis, you can't tell if it's brilliant or obvious.|The doubt has learned your timetable. It comes the morning after good work.|You know this doubt now. It reaches your carrel first.} {progress(thesis) >= 60: Most of it is written, which almost makes it worse.|So much of it is still unwritten.} {final_year and season == "spring": After this term there are no more terms.|{~First-years laugh in the courtyard below.|Last night's candle is a puddle.}}
text [6118b4] = {重读论文到一半，你分不清它是精彩还是平庸。|怀疑摸清了你的作息。它总在干得不错的一夜之后的早晨出现。|你认得这种怀疑了。它比你先到隔间。} {progress(thesis) >= 60: 大部分已经写完，这几乎让事情更糟。|还有太多没写。} {final_year and season == "spring": 这学期过后，就再也没有学期了。|{~楼下庭院里一年级生在笑。|昨晚的蜡烛化成了一摊。}}
# en: A student at a carrel in early light, holding a thick draft at arm's length as if it might bite.
scene [43c23c] = 清晨的隔间里，一个学生把厚厚的草稿举得远远的，好像它会咬人。
# en: Push on regardless
opt.left.label [b83a2c] = 不管了，继续写
# en: {~You write a page you don't believe in. By lunch you believe in about half of it, which is a start.|You keep going. The doubt keeps you company, and gets bored by evening.}
opt.left.say.1 [029adc] = {~你写了一页自己都不信的东西。到午饭时你信了大约一半，算是个开始。|你接着写。怀疑一直陪着你，到傍晚它自己也腻了。}
# en: Walk by the lake instead
opt.right.label [ff9e77] = 改去湖边散步
# en: {~You walk around the lake and come back with no new pages and one good idea. You'll find out tomorrow if it's good.|The lake is mirror-still and has no opinion on your thesis. It's a relief.}
opt.right.say.1 [11fa26] = {~你绕湖走了一圈，回来时没有新页，只有一个好主意。明天就知道它好不好了。|湖面如镜，对你的论文毫无意见。真是解脱。}

@event thesis_lab_spare_carrel
# en: The Spare Carrel
title [59d7e8] = 空着的隔间
# en: {There's an empty carrel at the end of the row, with a candle stub and nobody's name on it.|The spare carrel is still unclaimed. You've started thinking of its candle stub as yours.|You know the carrels by their scratches now. The spare one has a new scratch, and you suspect it's yours.} {season == "winter": Everyone writes in fingerless gloves.|The windows are open, and a footnote blows off someone's desk.} {~Somewhere a quill scratches without stopping.|Someone is whispering "however" over and over.|A candle gutters out three carrels down, and someone groans.}
text [2415ea] = {这排尽头有个空隔间，只有一截蜡烛头，没写任何人的名字。|那个空隔间还是没人认领。你开始把那截蜡烛头当成自己的了。|你现在能凭划痕认出每个隔间。空着的那个多了一道新划痕，你怀疑是你划的。} {season == "winter": 人人都戴着露指手套写字。|窗户开着，一条脚注从别人桌上飞走了。} {~某处一支羽毛笔沙沙写个不停。|有人在一遍遍低声念着“然而”。|隔三个隔间的蜡烛灭了，有人哀叹了一声。}
# en: A long room of wooden carrels, one at the end empty but for a candle stub and a stray page of footnotes.
scene [9557dc] = 一长排木制研读隔间，尽头那个空着，只有一截蜡烛头和一页散落的脚注。
# en: Work until the candle dies
opt.left.label [6a43fb] = 写到蜡烛燃尽
# en: {~You write until the stub drowns in its own wax. Your notes are good, and your neck will remember them.|You read one book and half of another. The room's silence does half the work for you.}
opt.left.say.1 [b50a9a] = {~你一直写到烛头淹没在自己的蜡油里。笔记很好，脖子会记住它们。|你读完一本书，又读了半本。屋里的安静替你干了一半的活。}
# en: Just sit in the quiet
opt.right.label [fbb3b9] = 只是在安静里坐坐
# en: {~You sit with your hands in your lap and listen to everyone else think. It's oddly restful.|You doze off with your cheek on someone's old footnotes. Nobody minds.}
opt.right.say.1 [2d5943] = {~你双手放在膝上，听着别人思考。出奇地让人放松。|你脸贴着别人的旧脚注睡着了。没人介意。}
# en: {~An advisor looks into the carrel and asks what you're working on. "Thinking," you say. He writes that down.|A final-year asks if you'd mind the corner. Their own candle has given out.}
opt.right.say.2 [ae00fe] = {~一位导师探头问你在研究什么。“思考。”你说。他把这记了下来。|一位毕业年级生问你介不介意让出角落。他们自己的蜡烛燃尽了。}

@event thesis_lab_footnote_war
# en: The Footnote War
title [e57e26] = 脚注之战
# en: {Two advisors are arguing about a footnote across three carrels, and every final-year in the room has stopped pretending to work.|The footnote war has broken out again. Someone has drawn up sides on a scrap of paper.|By now the footnote war has rules, a referee and a running score chalked on the door.} {~Today it's about whether an old founders' letter counts as a source.|Today it's about a comma.|Today it's about a footnote to a footnote.}
text [c4915c] = {两位导师隔着三个隔间为一条脚注争吵，屋里每个毕业年级生都不再假装干活了。|脚注之战又打响了。有人在纸片上分好了阵营。|如今脚注之战有了规则、裁判，门上还用粉笔记着比分。} {~今天争的是创始者的一封旧信算不算出处。|今天争的是一个逗号。|今天争的是一条脚注的脚注。}
# en: Two advisors arguing across a row of carrels, final-year students peering over the partitions to watch.
scene [0da858] = 两位导师隔着一排隔间争吵，毕业年级生们从隔板上方探头观战。
# en: Weigh in with a source
opt.left.label [52a73e] = 拿出处加入战局
# en: {~You produce the source, open at the right page. Both advisors fall silent, and one of them asks for your name.|Your citation settles it. The loser shakes your hand and then rereads the page for an hour.}
opt.left.say.1 [ebd6e8] = {~你拿出那份资料，正翻在对的那一页。两位导师都安静了，其中一位问了你的名字。|你的引文终结了争论。输的一方和你握了手，然后把那一页重读了一个钟头。}
# en: {~Your source turns out to be the one they were both arguing against. They unite, briefly, to explain why.|You cite the wrong edition. The room winces as one.}
opt.left.say.2 [bb8861] = {~你的资料恰好是他们俩都在反对的那份。他们短暂地联手，向你解释为什么。|你引错了版本。全屋人齐齐一缩。}
# en: Keep my head down and listen
opt.right.label [a9d2c8] = 低头听着
# en: {~You learn more about sources from ten minutes of the war than from a term of lectures, and you never have to say a word.|You take notes on both sides. Neither of them would like how fair your notes are.}
opt.right.say.1 [cfc044] = {~十分钟的战事教你的出处知识比一学期的课还多，而你一句话都不用说。|你把双方的论点都记了下来。他们谁都不会喜欢你记得这么公允。}

@event thesis_lab_borrowed_candle
# en: Borrowing a Candle
title [7f13b4] = 借一支蜡烛
# en: {The candles here give out at the worst moment. Yours just has, and the carrel next door has a full box and nobody in it.|Your candle gives out again. Next door, the usual box of spares and nobody in the chair.|The lab's candles have outlasted no one's patience tonight, least of all yours. There's a box next door.} {~A draft lies open beside the box, face up.|A note on the box says "Help yourself" in one hand and "Don't" in another.|Someone has drawn a small eye on the box.}
text [e6ab7e] = {这里的蜡烛总在最要命的时候燃尽。你的刚灭，隔壁隔间有一整盒，人却不在。|你的蜡烛又灭了。隔壁照例放着一盒备用的，椅子上没人。|今晚实验室的蜡烛没能比任何人的耐心撑得更久，尤其是你的。隔壁有一盒。} {~盒子旁边摊着一份草稿，正面朝上。|盒子上一张字条写着“请自取”，另一种笔迹写着“别”。|有人在盒子上画了一只小眼睛。}
# en: A dark carrel lit by one dying candle, a full box of candles on the empty desk next door.
scene [a34fc6] = 一支将熄的蜡烛照着昏暗的隔间，隔壁空桌上放着满满一盒蜡烛。
# en: Borrow one and keep working
opt.left.label [178881] = 借一支接着干
# en: {~You light it and work until the bell. You leave a note that says "IOU one candle", unsigned.|One candle, two good hours. You put the stub back, which is either honest or worse.}
opt.left.say.1 [929efb] = {~你点上它一直干到钟响。你留了张字条：“欠蜡烛一支”，没署名。|一支蜡烛，两个好钟头。你把烛头放了回去，这要么算诚实，要么更糟。}
# en: {~The owner comes back for a forgotten scarf and finds you lit by their candle. They say nothing, which is worse.|By morning the whole lab knows who borrowed the candle. Someone leaves a box on your desk, with a ribbon.}
opt.left.say.2 [dcbbf0] = {~主人回来取忘下的围巾，发现你正借着他们的烛光。他们什么也没说，这更糟。|到早上全实验室都知道是谁借了蜡烛。有人在你桌上放了一盒，还系了丝带。}
# en: Go back in the dark
opt.right.label [48d592] = 摸黑回去
# en: {~You walk back across the bridges in the dark, your argument going round and round. It is better by the time you reach your bed.|You stub your toe twice on the way out. The idea you had on the stairs was worth both.}
opt.right.say.1 [8370a2] = {~你摸黑走过光之桥，论证在脑子里转个不停。走到床边时它已经好多了。|出门路上你踢到两次脚趾。楼梯上冒出的那个主意值这两下。}

@event intern_royal_library_slips
# en: Request Slips
title [75d659] = 借阅单
# en: {Scholars upstairs send their requests down a brass chute. Your job is to fetch them from the stacks, which go down for miles.|You've worn a path in the dust of the third landing.|You can read the chute's rattle now. A long rattle means someone wants something from the very bottom.} {~One slip is in a hand so old the ink has gone brown.|One slip asks for "the blue one".|One slip is a love letter, sent down by mistake.}
text [2e1959] = {楼上的学者把借阅单从黄铜滑槽送下来。你的工作是去书库里取书，而书库往下延伸好几里。|你在第三层平台的灰尘里踩出了一条路。|你现在听得懂滑槽的响声了。长长的一声，意味着有人要最底层的东西。} {~有张单子的笔迹古老得墨水都变褐了。|有张单子写着“蓝色那本”。|有张单子是封情书，寄错了地方。}
# en: A brass chute dropping paper slips into a basket at the top of a deep stairwell lined with shelves.
scene [7b85db] = 一道黄铜滑槽把纸条投进篮子，篮子放在一口排满书架的深井楼梯顶上。
# en: Take the deep requests
opt.left.label [879821] = 接最深处的单子
# en: {~Four hundred steps down, the air is cold enough to keep books for ever. You come back up with the book and a lot of opinions about stairs.|You find the volume wedged behind a pipe. The scholar who asked for it nearly weeps.}
opt.left.say.1 [4cc82f] = {~往下四百级台阶，空气冷得书能永远保存。你带着那本书和一肚子对楼梯的意见回到上面。|你在一根管子后面找到了那本书。要它的学者差点哭了。}
# en: Take the near shelves
opt.right.label [ee4e7d] = 只取近处书架的
# en: {~You fetch the easy ones and leave the deep slips for someone else. Someone else notices.|You're fast and pleasant, and everyone knows you've never been below the third landing.}
opt.right.say.1 [eb61e9] = {~你取了容易的，把深处的单子留给别人。别人注意到了。|你又快又和气，可大家都知道你从没下过第三层平台。}

@event intern_royal_library_mending
# en: The Mending Table
title [1b5cc4] = 修补台
# en: {Today you're at the mending table, where crumbling records are put back together one flake at a time.|The binder hands you the tweezers without a word, which counts as a greeting.|The binder trusts you with the older pages now, which are the worst.} {~The page is a royal decree on the correct length of goose necks.|The page is a recipe, half eaten by something.|The page is a list of names, one crossed out very hard.}
text [6c0c62] = {今天你在修补台，把碎裂的档案一片一片拼回去。|装订师一言不发地把镊子递给你，这就算打招呼了。|装订师现在把更老的书页交给你了，那些最难。} {~这页是一道王室法令，规定鹅脖子的正确长度。|这页是一份食谱，被什么东西啃掉了一半。|这页是一份名单，有一个名字被狠狠划掉了。}
# en: A bright worktable under a lamp, a crumbling manuscript laid out in pieces and a student holding fine tweezers.
scene [cb79c7] = 灯下一张明亮的工作台，一份碎裂的手稿摊成好几块，一个学生拿着细镊子。
# en: Mend it myself
opt.left.label [67b19a] = 我自己来修
# en: {~Every flake goes back where it belongs. The binder holds it up to the lamp and says, "Acceptable," which here is a medal.|You save the page and read it while the glue dries. It's better than you expected.}
opt.left.say.1 [c8e44e] = {~每一片都回到了原处。装订师把它举到灯下说：“还行。”在这里，这就是勋章。|你救下了这一页，趁胶水干的时候读了它。比你想的有意思。}
# en: {~A sneeze. The binder looks at the scattered flakes and then at you. You both get the tweezers.|One flake ends up in the wrong century. Nobody can prove it was you, but everybody knows.}
opt.left.say.2 [55b845] = {~一个喷嚏。装订师看看散落的碎片，又看看你。你们俩一起拿起了镊子。|有一片被放进了错误的世纪。没人能证明是你，但人人都知道。}
# en: Watch the binder work
opt.right.label [5b7d5a] = 看装订师干活
# en: {~You watch for an hour and learn more than a book could tell you. The binder says you're slow. You were.|The binder works without speaking and you learn by watching. It's very peaceful and very little gets done.}
opt.right.say.1 [559067] = {~你看了一个钟头，学到的比书上能教的多。装订师说你慢。你确实慢。|装订师一言不发地干活，你在一旁看着学。非常宁静，也几乎没干成什么。}

@event intern_conclave_test_chamber
# en: The Test Chamber
title [cb5a52] = 测试室
# en: {The Conclave's researchers need someone to cast their newest spell for the first time. The walls are thick for a reason.|Someone has chalked a new circle on the floor. The old one is scorched.|You know every scorch mark in the chamber by now, and who made each one.} {~Today's spell is meant to make a candle burn backwards.|Today's spell is meant to tidy a room. It has opinions about what tidy means.|Today's spell is unnamed. Nobody will say why.}
text [647dd1] = {议会的研究员们需要有人第一次施放他们最新的咒语。墙那么厚是有原因的。|有人在地上用粉笔画了个新圈。旧的那个已经焦了。|如今测试室里每道焦痕你都认得，也知道是谁留下的。} {~今天的咒语据说能让蜡烛倒着烧。|今天的咒语据说能整理房间。它对“整理”有自己的看法。|今天的咒语没有名字。没人肯说为什么。}
# en: A circular chamber with scorch-marked walls, a student at the centre with a wand raised and researchers watching through thick glass.
scene [033a72] = 一间墙上满是焦痕的圆形测试室，一个学生站在中央举着魔杖，研究员们隔着厚玻璃观看。
# en: Step into the chamber
opt.left.label [2de272] = 走进测试室
# en: {~The spell works on the first try. Behind the glass, someone writes your name in the margin of their notes.|It works, more or less, for one glorious minute before the spell remembers itself.}
opt.left.say.1 [680416] = {~咒语一次成功。玻璃后面有人在笔记页边写下了你的名字。|基本成功了，光辉的一分钟之后，咒语才想起自己是谁。}
# en: {~The spell goes off sideways. Your eyebrows are fine. Your fringe has views of its own now.|The spell goes off sideways, and your robes will never fold the same way again.}
opt.left.say.2 [e3a2a9] = {~咒语往旁边炸开了。你的眉毛没事。你的刘海从此有了自己的主见。|咒语往旁边炸开了，你的袍子再也叠不回原来的样子。}
# en: Take readings behind the glass
opt.right.label [531746] = 在玻璃后记读数
# en: {~You write down numbers for three hours while someone else gets to be brave. They're very good numbers.|You note every flicker. A senior researcher reads your page and asks for your notes next time.}
opt.right.say.1 [fd1f33] = {~别人去当勇士，你记了三个钟头数字。都是非常好的数字。|你记下了每一次闪烁。一位资深研究员读了你的记录，要你下次把笔记给他。}

@event intern_conclave_minutes
# en: Taking the Minutes
title [3271ff] = 做会议记录
# en: {You've been asked to take the minutes of a Conclave research committee. There are nine members, and none of them ever agrees.|The committee is still arguing about last time's question, and now about the minutes too.|You could take these minutes in your sleep, and some of the committee do attend them that way.} {~Two of them are not speaking to each other, and want it recorded.|One of them asks what you think.|One of them falls asleep, and wakes up to vote.}
text [6435e2] = {你被派去给议会的一个研究委员会做记录。委员有九位，从没有意见一致过。|委员会还在吵上次的问题，现在连上次的记录也一起吵。|这记录你闭着眼都能做，有几位委员也确实是闭着眼出席的。} {~其中两位互不说话，并要求记录在案。|其中一位问你怎么看。|其中一位睡着了，醒来正好投票。}
# en: A long table of elderly mages in heavy robes, all talking at once, a young intern writing furiously at the end.
scene [998689] = 一张长桌旁坐满穿厚袍的年长法师，全都在同时说话，桌尾一个年轻实习生在拼命记录。
# en: Offer an opinion when asked
opt.left.label [48ef1a] = 被问到时说出看法
# en: {~The table goes silent. Then the oldest mage says, "The intern is right," and the rest pretend they agreed all along.|Your opinion settles the argument. It also starts two new ones.}
opt.left.say.1 [76b9aa] = {~桌边鸦雀无声。然后最年长的法师说：“实习生说得对。”其余人假装自己早就同意。|你的看法平息了争论。也引发了两场新的。}
# en: {~Nine heads turn towards you, slowly. You say something about wands. It isn't minuted.|You give your opinion and it is recorded in full, with the note "(intern)".}
opt.left.say.2 [9f6fdb] = {~九颗脑袋慢慢转向你。你说了点关于魔杖的话。没被记录。|你的看法被完整记录在案，后面注着“（实习生）”。}
# en: Keep my head down and write
opt.right.label [1678b2] = 低头只管记录
# en: {~Your minutes are perfect and so dull that nobody reads them, which in a committee is the highest praise.|You record every word of the argument. Your hand aches, and you understand the Conclave much better than you wanted to.}
opt.right.say.1 [55dff9] = {~你的记录完美无缺，枯燥到没人读，在委员会里这是最高的赞誉。|你记下了争论的每一个字。手腕发酸，对议会的了解远超你的本意。}

@event intern_alchemists_vat_watch
# en: Vat Watch
title [6ef11f] = 看守大缸
# en: {Your task at the works is to watch one great vat and call the foreman if it changes colour.|You've brought your own colour chart now, with notes in the margins.|You and the vat understand each other now. It's an unsettling feeling.} {~The amber is drifting, very slowly.|There's a bubble that keeps coming back, like a thought.|The vat smells faintly of cinnamon, which it never has before.} The foreman is all the way at the other end of the hall.
text [51575f] = {你在工坊的任务是看守一口大缸，一旦变色就去叫工头。|你现在自带色卡，页边写满了笔记。|你和大缸现在心意相通。这感觉让人不安。} {~琥珀色正在极慢地漂移。|有个气泡一直冒回来，像一个念头。|大缸有一丝肉桂味，以前从没有过。} 工头在大厅的另一头。
# en: A huge copper vat in a steaming hall, a student on a gantry staring into it with a colour chart in hand.
scene [e8908d] = 蒸汽弥漫的大厅里一口巨大的铜缸，一个学生站在吊台上拿着色卡盯着缸里。
# en: Adjust it myself
opt.left.label [76449d] = 我自己调
# en: {~A pinch of salt and a slow stir, and the vat settles back to its proper self. The foreman never knew, but the vat did.|You correct it before it goes wrong. When the foreman passes, he gives the vat a satisfied look as if he did it.}
opt.left.say.1 [787567] = {~一撮盐，慢慢搅动，大缸恢复了本来的样子。工头永远不会知道，但大缸知道。|你在出事之前就纠正了。工头路过时满意地看了大缸一眼，好像是他干的。}
# en: {~The vat turns a brilliant violet and hisses. The foreman arrives at a run, and you'll be hearing about it for weeks.|You make it worse. A lot worse. The whole hall smells of cinnamon until the end of the week.}
opt.left.say.2 [f430e1] = {~大缸变成鲜亮的紫罗兰色，嘶嘶作响。工头一路跑来，这事你要被念叨好几个星期。|你把它弄得更糟。糟得多。整座大厅到周末都是肉桂味。}
# en: Run for the foreman
opt.right.label [4b3ef4] = 跑去叫工头
# en: {~You run the length of the hall. The foreman fixes it in a second and explains how, at length, as you catch your breath.|By the time you're back with the foreman the colour has corrected itself. He stares at you, then at the vat.}
opt.right.say.1 [6678d5] = {~你跑完整个大厅。工头一秒钟就修好了，趁你喘气时详详细细地讲了怎么修。|等你带着工头回来，颜色已经自己恢复了。他盯着你，又盯着大缸。}

@event intern_alchemists_no_flame
# en: The Rule About Flames
title [a32af9] = 关于明火的规定
# en: {There's a strict rule at the works about naked flames, so the break room has spent forty years inventing flameless ways to boil a kettle.|Break time. The kettle sits on its warm stone, and the workers look at you hopefully.|By now the break room asks the academy intern first, whatever the problem.} {~Today the warm stone has gone cold.|Today someone wants toast, which is a much bigger question.|Today a new inspector is touring the works.}
text [d8eb15] = {工坊对明火有严格规定，所以休息室花了四十年发明各种不用火烧水的办法。|休息时间。水壶坐在温热的石头上，工人们满怀希望地看着你。|如今休息室不管遇到什么问题，都先问学院来的实习生。} {~今天那块温石凉了。|今天有人想吃烤面包，这可是大得多的问题。|今天新来的巡查员在视察工坊。}
# en: A break room in an alchemical works, workers gathered around a kettle sitting on a glowing stone that is not, technically, on fire.
scene [03a5ac] = 炼金工坊的休息室，工人们围着一把放在发光石头上的水壶，严格说来那并不算着火。
# en: Help brew the flameless tea
opt.left.label [823819] = 帮忙泡无火茶
# en: {~You heat the kettle with a reaction you learned in your first year. The break room calls it "the academy method" and adopts it on the spot.|It works, though everything boiled on it comes out a little purple.}
opt.left.say.1 [6d74a5] = {~你用一年级学的一个反应把水壶烧热了。休息室管它叫“学院法”，当场采用。|成功了，不过用它煮出来的东西都有点发紫。}
# en: {~Your method works so well that someone in charge notices the steam. There's a meeting about it, with you in it.|The kettle boils, and so, briefly, does the table.}
opt.left.say.2 [161dbb] = {~你的方法太好用了，有位管事的注意到了蒸汽。为此开了个会，你也在场。|水壶开了，桌子也短暂地开了。}
# en: Stick to the rules
opt.right.label [b9e488] = 遵守规定
# en: {~You drink cold water while everyone else drinks tea. The foreman notes your conduct, and the break room notes it too.|You remind everyone of the rule. You are absolutely right and nobody offers you a biscuit for the rest of the week.}
opt.right.say.1 [d6631e] = {~别人喝茶，你喝凉水。工头记下了你的表现，休息室也记下了。|你提醒大家注意规定。你完全正确，这一整周没人再分你饼干。}

@event intern_expedition_thin_air
# en: Up the Ridge
title [23ba3c] = 登上山脊
# en: {The instruments have to go up to the ridge before dark, and the air on the plateau is very thin.|Your legs know the path now. Your lungs are still negotiating.|You've carried things up this ridge so often that the goats have stopped looking at you.} {season == "winter": {~Snow has drifted against the path.|The wind cuts through every layer you own.}|{~The rocks are still hot from the afternoon.|The sky is clear all the way to the top of the world.}}
text [d6f7b7] = {天黑前仪器必须运上山脊，而高原上的空气非常稀薄。|腿已经认得路了。肺还在讨价还价。|你往这道山脊上搬过太多次东西，山羊都不再看你了。} {season == "winter": {~雪堆在了路边。|风穿透你身上的每一层衣服。}|{~石头还留着下午的热。|天空晴朗，一直晴到世界的顶端。}}
# en: A line of expedition members climbing a rocky ridge at dusk, carrying brass instruments wrapped in blankets.
scene [00b5b6] = 黄昏时一队远征队员攀上岩石山脊，抱着裹在毯子里的黄铜仪器。
# en: Carry the great lens
opt.left.label [e7e4f2] = 扛那块大透镜
# en: {~You carry the great lens to the top without dropping it, then sit very still for a long time. The leader nods at you, once.|Your arms are numb by the top, and the lens is perfect. It's worth it when the first star shows in it.}
opt.left.say.1 [5b1f0a] = {~你把大透镜扛到山顶，一点没摔，然后一动不动地坐了很久。领队朝你点了一下头。|到山顶时你的胳膊已经麻了，透镜完好无损。当第一颗星出现在镜中，一切都值了。}
# en: Do the sums in the tent
opt.right.label [d9b374] = 在帐篷里算数
# en: {~You work the night's sums by lamplight, warm and quiet. The lamp gutters twice. Your sums don't.|You have the charts ready when they come down. Nobody thanks you, because the charts are always ready.}
opt.right.say.1 [a6fd0a] = {~你借着灯光算当晚的数，温暖又安静。灯芯跳了两下，你的算式一下也没跳。|他们下来时星图已经准备好了。没人道谢，因为星图总是准备好的。}

@event intern_expedition_chart_dispute
# en: A Star Out of Place
title [dbb002] = 错位的星
# en: {Your chart and the senior astronomer's disagree about where one faint star is.|The senior astronomer's charts and yours have a running disagreement now, kept in red ink.|The senior astronomer now checks your charts first. A compliment, possibly.} {~Probably your hand shook.|Probably their eyesight.|Probably the thin air.} {season == "winter": The nights are long, with time to recheck everything.|The nights are short, and every hour counts.}
text [c739a4] = {你的星图和资深天文学家的星图，在一颗暗星的位置上不一致。|资深天文学家的星图和你的现在有一场持续的分歧，用红墨水记着。|资深天文学家现在先查你的星图。也许算是夸奖。} {~大概是你的手抖了。|大概是他们的眼神。|大概是稀薄的空气。} {season == "winter": 夜很长，有时间把一切都复核一遍。|夜很短，每个钟头都要紧。}
# en: Two expedition members bent over a star chart by lamplight, one pointing firmly at a dot.
scene [576570] = 两名远征队员借着灯光俯身看一张星图，其中一人坚定地指着一个点。
# en: Recheck it all night
opt.left.label [19c9f0] = 通宵复核
# en: {~You recheck it until dawn. You were right by a hair, and nobody will ever care but you.|You were wrong by a hair. You fix it, and know the sky better than you did.}
opt.left.say.1 [a067a2] = {~你一直核对到天亮。你对了，差之毫厘，除了你没人会在乎。|你错了，差之毫厘。你改了过来，对星空的了解又多了一点。}
# en: Raise it with the astronomer
opt.right.label [8f17a5] = 向天文学家提出来
# en: {~The astronomer checks, grumbles and corrects their chart. Then they buy you a cup of the camp's terrible coffee.|"Well spotted," says the astronomer, through their teeth.}
opt.right.say.1 [fef456] = {~天文学家查了一遍，嘟囔着改了自己的星图。然后请你喝了一杯营地里难喝的咖啡。|“眼尖。”天文学家咬着牙说。}
# en: {~The astronomer checks and shows you, in front of everyone, exactly where you went wrong.|They don't check. They just look at you over their spectacles until you go away.}
opt.right.say.2 [e6af69] = {~天文学家查了，当着所有人的面给你指出哪里错了。|他们没查。只是从眼镜上方看着你，直到你走开。}

@event intern_field_station_count
# en: The Dawn Count
title [c272a9] = 黎明清点
# en: {Every morning someone has to lie in the heather and count what's living on the moor. Today it's you.|You've learned which tussock is the least wet, and you guard it.|You're the station's best counter now, mostly because you've stopped minding the damp.} {season == "winter": {~Snow hares are out, white on white.|Frost has made the heather crackle under you.}|{~The skylarks are going up one after another.|The midges have found you.}}
text [cdb641] = {每天早上都得有人趴在石楠丛里，清点荒原上活着的东西。今天轮到你。|你摸清了哪个草丛最不湿，并且守着它。|你现在是野外站最好的清点员，主要是因为你不再在乎潮湿了。} {season == "winter": {~雪兔出来了，白上加白。|霜让石楠在你身下咔咔作响。}|{~云雀一只接一只飞上天。|蠓虫找到你了。}}
# en: A student lying flat in the heather at dawn, a tally board in hand, watching nesting towers on the moor.
scene [94a0ee] = 黎明时一个学生平趴在石楠丛中，手拿计数板，望着荒原上的筑巢塔。
# en: Count every last one
opt.left.label [1a8fb1] = 一只不落地数
# en: {~You count until your fingers are numb and the tally is perfect. The warden reads it twice and pins it on the wall.|You stay out until the very last nest is counted. You come back soaked and very proud of the number.}
opt.left.say.1 [272659] = {~你数到手指发麻，记录完美无缺。站长读了两遍，钉在了墙上。|你一直待到最后一个巢数完。回来时浑身湿透，为这个数字非常骄傲。}
# en: Make a sensible estimate
opt.right.label [db92d7] = 合理估一个数
# en: {~Your estimate is so close that nobody suspects. You spend the extra hour by the stove with a cup of tea.|The warden checks your number against his own and nods. You will never tell him.}
opt.right.say.1 [8f5830] = {~你估得太准了，没人起疑。省下的那个钟头你在炉边喝了杯茶。|站长拿你的数和他自己的对了对，点点头。你永远不会告诉他。}
# en: {~The warden counted too. His number is not your number. He makes a note.|Your estimate includes a flock that left last week. The warden is very nice about it, which is worse.}
opt.right.say.2 [925258] = {~站长也数了。他的数不是你的数。他记了一笔。|你的估计里包括了一群上周就飞走的鸟。站长对此非常客气，这更糟。}

@event intern_field_station_patient
# en: The Patient in Paddock Three
title [813ec2] = 三号围场的病号
# en: {The station's latest patient is a moor-drake with a splinted wing and no gratitude at all.|Feeding time in paddock three. The patient sees you coming and lowers its head.|The drake in paddock three recognises you now. This hasn't made it any nicer.} {~It has eaten a glove.|It is pretending to sleep, which it does very badly.|It has learned to open the bucket by itself.} {season == "winter": Its breath steams in the frosty air.|It is lying in the one patch of shade.}
text [ced8b7] = {野外站最新的病号是一头荒原幼龙，翅膀上着夹板，毫无感恩之心。|三号围场喂食时间。病号看见你来，低下了头。|三号围场的幼龙现在认得你了。这并没让它变得友善。} {~它吃了一只手套。|它在装睡，装得很差。|它学会了自己打开桶。} {season == "winter": 它的呼吸在霜冷的空气里冒着白气。|它躺在唯一一块阴凉里。}
# en: A muddy paddock with a splinted creature glaring from a straw nest, a student holding out a bucket at arm's length.
scene [ddabad] = 泥泞的围场里一头上着夹板的生物在草窝里瞪着眼，一个学生伸长胳膊递出一只桶。
# en: Feed it by hand
opt.left.label [cc2f18] = 亲手喂它
# en: {~It takes the food from your hand, very gently. Then it bites the bucket, to make a point.|It lets you check the splint, grumbling the whole time like an old man at the barber's.}
opt.left.say.1 [4e99a6] = {~它从你手里非常轻地叼走食物。然后咬了一口桶，以示立场。|它让你检查了夹板，全程嘟嘟囔囔，像理发店里的老头。}
# en: {~It takes the food and a bit of your sleeve. Your arm is fine. Your sleeve is not.|It butts you into the mud and then looks pleased with itself.}
opt.left.say.2 [3309dd] = {~它叼走了食物，外加一截你的袖子。胳膊没事。袖子有事。|它把你拱进泥里，然后一脸得意。}
# en: Use the long tongs
opt.right.label [cd0b4c] = 用长夹子喂
# en: {~You feed it from a safe distance. It eats, and looks at you with deep contempt.|The tongs work perfectly. You feel you've let the patient down, somehow.}
opt.right.say.1 [c8b36f] = {~你隔着安全距离喂它。它吃了，用深深的鄙夷看着你。|夹子好用极了。可你总觉得自己辜负了这位病号。}

@event intern_thornwick_pastries
# en: Thornwick Hospitality
title [5e9c3e] = 荆木的待客之道
# en: {Each morning your Thornwick hosts leave pastries on your desk, with a polite note.|The notes have grown longer and politer, which is worrying.|The pastries are a game now, and both sides know it.} {~They look perfect, which in an illusion lab is a warning.|One is steaming slightly, which it shouldn't be.|Today there's one plain biscuit, which is somehow worse.} {season == "winter": The pastries look very warm.|The icing hasn't melted in the heat.}
text [a1b318] = {每天早上，荆木的东道主都在你桌上放一盘点心，附一张客气的字条。|字条越写越长、越写越客气，这让人担心。|点心现在成了一场游戏，双方都心知肚明。} {~它们看起来完美无缺，在幻术实验室这就是警告。|有一块在微微冒热气，它不该冒的。|今天只有一块普通饼干，不知怎么更可疑了。} {season == "winter": 点心看起来很暖。|天这么热，糖霜却没化。}
# en: A polished laboratory table at a rival academy, a plate of perfect pastries set out for a visiting student.
scene [7a642b] = 对手学院一张光洁的实验桌上，一盘完美的点心摆在来访学生面前。
# en: Eat one and smile
opt.left.label [bb9a84] = 吃一块，再笑一笑
# en: {~It's real, and very good. The Thornwick interns look almost disappointed.|It's real. You eat it slowly, in front of everyone, and thank them warmly.}
opt.left.say.1 [02d79a] = {~是真的，而且非常好吃。荆木的实习生看起来几乎有点失望。|是真的。你当着所有人的面慢慢吃完，热情地道谢。}
# en: {~It's a glamour over something dry and joyless. You eat the whole thing with a smile, and the lab respects that.|It tastes of nothing at all. You compliment the baker, and someone in the corner laughs.}
opt.left.say.2 [c412ce] = {~是套在某种又干又无趣的东西上的魅影。你笑着吃完了整块，实验室对此肃然起敬。|它什么味道都没有。你夸了夸烘焙师，角落里有人笑出了声。}
# en: Bring my own breakfast
opt.right.label [34615e] = 自带早饭
# en: {~You eat your own bread, very pointedly. The Thornwick students write something down.|You leave the plate untouched. Your supervisor here calls it "a very Lumenhold choice", and doesn't mean it nicely.}
opt.right.say.1 [5cdb12] = {~你意味深长地吃着自己的面包。荆木的学生记了点什么。|你没碰那盘点心。这里的导师说这是“非常流明堡的选择”，不是好话。}

@event intern_thornwick_rivalry
# en: The Old Grudge
title [7f876b] = 老恩怨
# en: {The Thornwick students have questions about Lumenhold. Most of them are about the last time the two schools met on the duelling field.|The Thornwick students have found a new angle on the old grudge.|You and the Thornwick students have a routine now. It's almost friendly.} {~Today they want to know if Lumenhold's towers still lean.|Today they ask, sweetly, if Lumenhold teaches illusion yet.|Today one of them pretends to be you, very well.}
text [fa1e9c] = {荆木的学生对流明堡有些问题。大多是关于两校上一次在决斗场上交手的事。|荆木的学生为这桩老恩怨找到了新角度。|你和荆木的学生现在有了固定节目。几乎算友好。} {~今天他们想知道流明堡的塔是不是还歪着。|今天他们甜甜地问，流明堡是不是终于开幻术课了。|今天他们中有人扮成了你，扮得非常像。}
# en: A group of rival students around a lab bench, one of them leaning in with a pointed smile towards a visitor in different robes.
scene [07d8c1] = 一群对手学院的学生围在实验台边，其中一个朝穿着不同长袍的访客探过身去，笑得意味深长。
# en: Out-charm them
opt.left.label [a1eb25] = 用魅力压过他们
# en: {~You answer every barb with a better one. By lunch they're laughing with you rather than at you.|You make the room laugh at their joke, and then at them. Their supervisor smiles behind her notes.}
opt.left.say.1 [b5641f] = {~每句挖苦你都回以更妙的一句。到午饭时，他们是在跟你一起笑，而不是笑你。|你让满屋人先笑他们的笑话，再笑他们。他们的导师在笔记后面露出微笑。}
# en: {~You try to be witty. It comes out as a speech about the founders. They let you finish, kindly.|You lose the exchange so badly that one of them takes a bow on your behalf.}
opt.left.say.2 [70ef48] = {~你想说点俏皮话，结果说成了一篇关于创始者的演讲。他们好心地让你讲完了。|你输得太惨，他们中有人替你鞠了一躬。}
# en: Let it slide
opt.right.label [344baa] = 随它去
# en: {~You smile and go back to work. Your supervisor here notices, and approves, and you feel like you lost anyway.|You say nothing. It takes them all morning to realise you've won.}
opt.right.say.1 [0d9b22] = {~你笑笑，回去干活。这里的导师注意到了，也赞许，可你还是觉得自己输了。|你什么也没说。他们花了一上午才意识到你赢了。}

@event intern_unseen_office_coffee
# en: The Coffee Machine
title [9f1fbd] = 咖啡机
# en: {Nobody at the Office talks about anything, except the coffee machine. It's very good.|A queue forms around the machine each evening, though nobody seems to join it.|The coffee queue, you've learned, is where the Office's real work gets done.} {~Two people beside you discuss the weather in a way that isn't about the weather.|A cup has a name on it that was there yesterday, under another name.|The machine hisses, and everyone falls silent until it stops.}
text [bf535e] = {署里没人谈论任何事，除了咖啡机。它非常好用。|每晚咖啡机周围都会排起队，却没人看起来是去排队的。|你已经明白，咖啡队伍才是署里真正干活的地方。} {~你旁边两个人在聊天气，聊法显然不是在聊天气。|一只杯子上写着一个名字，昨天它也在，写的是另一个名字。|机器一嘶响，所有人都停下话头，直到它响完。}
# en: A plain room with no windows and a gleaming coffee machine, quiet people in plain coats standing near it, not quite talking.
scene [2a796e] = 一间没有窗户的朴素房间，一台锃亮的咖啡机，几个穿着普通外套的安静的人站在旁边，不太算是在交谈。
# en: Linger at the machine
opt.left.label [a4aa91] = 在咖啡机边多待会儿
# en: {~You learn three things nobody told you, and one thing nobody knows you know.|You drink your coffee slowly and listen. By the second cup you understand what nobody is saying.}
opt.left.say.1 [2e44c1] = {~你知道了三件没人告诉你的事，还有一件没人知道你知道的事。|你慢慢喝着咖啡听着。到第二杯，你听懂了没人说出口的东西。}
# en: {~Someone notices you listening and asks, very kindly, how your day is going. You don't sleep that night.|You overhear something you very much wish you hadn't. It can't be unheard.}
opt.left.say.2 [3946a5] = {~有人发现你在听，非常和气地问你今天过得怎样。那晚你没睡着。|你无意中听到一件真希望没听到的事。听到了就忘不掉了。}
# en: Take my cup back to my desk
opt.right.label [f05b97] = 端回自己桌上
# en: {~You work through the evening with your coffee. The work is dull and your supervisor approves, which is a little chilling.|Your desk is very quiet. It's the most anyone at the Office will say about you, and here that's high praise.}
opt.right.say.1 [54086b] = {~你就着咖啡工作了一晚。活很枯燥，导师很满意，这有点让人发冷。|你的桌子非常安静。这是署里任何人对你说过的最多的话，在这里这是高度赞扬。}

@event intern_unseen_office_wrong_file
# en: The Wrong File
title [a461ed] = 错放的卷宗
# en: {A file has been left on your desk. It isn't yours, and it isn't labelled.|A second unlabelled file. You're starting to think it's a test.|The unlabelled files keep arriving. You've stopped asking where they come from.} This one is tied shut with a red ribbon. {~It's very thin.|It's very thick, with a coffee ring on the cover.|The knot is one you don't recognise.}
text [4e3acb] = {有份卷宗被留在你桌上。不是你的，也没有标签。|第二份没有标签的卷宗。你开始觉得这是一场考验。|没有标签的卷宗不停地送来。你已经不再问它们从哪来。} 这份用红丝带系着。{~它非常薄。|它非常厚，封面上有个咖啡杯印。|那个结你从没见过。}
# en: A plain folder with no label lying on an empty desk under a single lamp.
scene [395e41] = 一盏孤灯下的空桌上，放着一个没有标签的朴素文件夹。
# en: Read it before returning it
opt.left.label [6c5a88] = 先读再归还
# en: {~You read it, retie the ribbon perfectly and hand it in. Your supervisor checks the knot and smiles, very slightly.|You read every page. It's about a man who sells hats. Nothing has ever made you more nervous.}
opt.left.say.1 [bff383] = {~你读完了，把丝带系得一模一样，交了回去。导师检查了那个结，非常轻微地笑了笑。|你读了每一页。讲的是一个卖帽子的人。从没有什么让你这么紧张过。}
# en: {~Your supervisor takes the file back and glances at the ribbon. "Interesting knot," she says.|You put the pages back in the wrong order. Somehow, everyone knows by morning.}
opt.left.say.2 [3ef205] = {~导师拿回卷宗，瞥了一眼丝带。“有意思的结。”她说。|你把书页放回去时顺序错了。不知怎么，第二天早上人人都知道了。}
# en: Return it unopened
opt.right.label [ab3e46] = 原封不动地归还
# en: {~You hand it back without looking. Your supervisor says nothing, which here is approval. You'll wonder about it for weeks.|You return it with the ribbon untouched. The next day there's a slightly better coffee waiting on your desk.}
opt.right.say.1 [fb7116] = {~你看都没看就交了回去。导师什么也没说，在这里这就是认可。你会为此琢磨好几个星期。|你把丝带原样未动地还了回去。第二天你桌上多了一杯稍好一点的咖啡。}
