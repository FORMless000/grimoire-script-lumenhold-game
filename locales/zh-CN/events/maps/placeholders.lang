# Lumenhold Academy — 简体中文 (zh-CN) translation of content/events/maps/placeholders.grim
# Maintained by `node tools/grim.js i18n zh-CN`. Translate the text after "="; keep {tokens}.
# "# en:" shows the English source. [hash] marks the English version a line was translated from;
# lines marked STALE need updating — after fixing the text, delete the [hash] and re-run the tool.


@event capital_library_quiet_hour
# en: The Reading Room
title [379fa3] = 阅览室
# en: Upstairs from the archives, the Royal Library keeps a reading room for anyone who can whisper. The lamps are green, the chairs are hard and a librarian watches the door like a cat at a mousehole.
text [36014a] = 皇家图书馆的书库楼上，有一间阅览室，谁只要会压低声音都能进来。灯是绿的，椅子是硬的，一位图书管理员盯着门口，像猫守着老鼠洞。
# en: A vast reading room under a glass dome, green lamps on long tables, a few readers bent over their books in the hush.
scene [dc629b] = 玻璃穹顶下宽敞的阅览室，长桌上亮着绿色台灯，几位读者在静谧中埋头看书。
# en: Read a while
opt.left.label [f39033] = 读一会儿书
# en: {~An hour with a book you couldn't get at Lumenhold, and then the librarian rings your hour out, three chapters from the end. You'll never know how it ends.|You read until the librarian's look becomes a cough, and the cough becomes your name, said aloud to the whole silent room. It was nearly worth it.}
opt.left.say.1 [14a820] = {~一个钟头，读了一本在流明堡借不到的书，然后图书管理员摇铃说你的钟点到了，离结尾还有三章。你永远不会知道结局了。|你一直读到图书管理员的眼神变成一声咳嗽，咳嗽又变成你的名字，当着整个安静的阅览室念了出来。差不多值了。}
# en: Just look at the dome
opt.right.label [359107] = 只看看穹顶
# en: {~You stand under the dome until your neck aches, then go out into the noise again.|Light falls through the glass in long dusty bars. You leave without reading a word.}
opt.right.say.1 [830ac3] = {~你站在穹顶下一直看到脖子发酸，然后回到外面的喧闹里。|光透过玻璃落成一道道带着灰尘的长条。你一个字也没读就走了。}

@event capital_townhouse_quiet_hour
# en: The Front Steps
title [caee80] = 门前台阶
# en: The townhouse is quiet: the family is out, the cook has gone to her sister's and the steps have just been scrubbed. You could sit on them, if anyone sat on steps uptown.
text [94b5f1] = 宅子里很安静：家里人出门了，厨子去了她姐姐家，台阶刚刚刷洗过。你可以坐在上面——如果上城有人坐台阶的话。
# en: Polished front steps of a tall uptown townhouse, a brass knocker shaped like a crest, the street busy with carriages below.
scene [b5bbef] = 上城一座高大宅邸前擦得锃亮的台阶，门环是一枚家徽的形状，下面的街上马车来来往往。
# en: Sit on the steps anyway
opt.left.label [6ee811] = 照样坐下
# en: {~You sit. Two carriages slow down to look. You wave. They don't.|The step is warm under you. A neighbour's footman pretends not to see you, very loudly.}
opt.left.say.1 [bb5325] = {~你坐下了。两辆马车放慢速度来看你。你挥手。他们没有。|台阶在你身下暖暖的。邻居家的男仆假装没看见你，假装得非常大声。}
# en: Go in and rest
opt.right.label [c8b03f] = 进屋歇会儿
# en: {~Your old room, a cool sheet, the clock in the hall. You sleep an hour you didn't plan.|The house is so quiet you can hear the clock two floors down. You rest, and nobody asks you anything.}
opt.right.say.1 [8f4ef2] = {~你的老房间、一条凉凉的床单、门厅里的钟。你睡了一个计划外的钟头。|宅子静得能听见两层楼下的钟声。你歇着，没有人问你任何事。}

@event capital_club_quiet_hour
# en: The Porter's Look
title [b3c649] = 门房的眼神
# en: The members' club has a porter whose whole job is to decide who you are. He looks at your boots, then at your face, then at your boots again. "Members only, unless you're expected."
text [5a769d] = 会员俱乐部有一位门房，他全部的工作就是决定你是谁。他看看你的靴子，再看看你的脸，又看看你的靴子。“会员专用，除非有人在等你。”
# en: A dim club entrance of dark wood and brass, a porter in a waistcoat at a high desk looking a student up and down.
scene [a81bf8] = 一个深色木头和黄铜装饰的俱乐部门口，一位穿马甲的门房坐在高台后，上下打量着一个学生。
# en: Say you're expected
opt.left.label [f1d2ff] = 说有人在等你
# en: {~"By whom?" You name a patron off a portrait in the hall. He lets you as far as the cloakroom, which is more than most get.|He doesn't believe you, but he admires the attempt. You get a glass of water and a better story than you came in with.}
opt.left.say.1 [6486af] = {~“谁？”你随口报出门厅里一幅肖像画上赞助人的名字。他放你走到了衣帽间，这已经比大多数人走得远了。|他不信你，但欣赏你的胆量。你得到一杯水，还有一个比来时更好的故事。}
# en: Thank him and go
opt.right.label [b81b92] = 谢过他离开
# en: {~"Another time," he says, which means never, said kindly.|You leave. Through the window, someone laughs in a chair that costs more than your year.}
opt.right.say.1 [e059b5] = {~“改天吧，”他说，意思是永远不会，只是说得很客气。|你走了。窗户里，有人坐在一把比你一年开销还贵的椅子上大笑。}

@event capital_bazaar_quiet_hour
# en: A Hundred Stalls
title [c1a6cb] = 上百个摊位
# en: The Grand Bazaar is one long noise under a glass roof: spice-sellers, map-dealers, a woman selling birds that sing in other languages. You could lose an afternoon here. You could lose a purse.
text [a75f58] = 大集市是玻璃屋顶下一长串的喧闹：卖香料的、卖地图的，还有一个女人卖会用别国语言唱歌的鸟。你可以在这里丢掉一个下午，也可以丢掉一只钱袋。
# en: A vast covered market, light falling through high windows onto stalls of spices, maps, brass and coloured glass, crowds moving between them.
scene [d50e2e] = 一座巨大的有顶市场，光从高窗洒在香料、地图、黄铜器和彩色玻璃的摊位上，人群在其间穿行。
# en: Wander and look
opt.left.label [1c88ac] = 随便逛逛
# en: {~You come out with a paper of sugared almonds and no idea where the afternoon went.|A map-seller lets you hold a chart of a coast nobody has sailed. You buy a pastry to recover.}
opt.left.say.1 [7b1bed] = {~你出来时手里拿着一包糖杏仁，完全不知道下午去哪儿了。|一个卖地图的让你捧着一张没人航行过的海岸图。你买了块点心压压惊。}
# en: Keep your hand on your purse
opt.right.label [f13bb7] = 捂紧钱袋
# en: {~You walk the length of it with a hand on your purse and see almost nothing. Your purse thanks you.|You watch a pickpocket work a whole aisle. Educational.}
opt.right.say.1 [b8ce04] = {~你一手按着钱袋走完了全程，几乎什么都没看见。你的钱袋很感激。|你看着一个扒手把整条过道做了一遍。很有教育意义。}

@event capital_arcade_quiet_hour
# en: Brass Plates
title [7c7fef] = 铜牌
# en: The arcade sells everything that isn't a thing: a physician, a tutor, a scribe, a bathhouse, a portraitist and a fortune-teller who is, her plate says, "by appointment, mostly". Today you only read the plates.
text [bbc5f5] = 这条拱廊卖的全是不算东西的东西：一位医师、一位家庭教师、一位抄写员、一间浴场、一位肖像画师，还有一位算命人，她的牌子上写着“需预约，大多数时候”。今天你只是读读这些牌子。
# en: A long stone colonnade of open doors and polished brass nameplates, a bathhouse's steam drifting out of one archway.
scene [0a2e3b] = 一条长长的石砌柱廊，一扇扇开着的门和擦亮的铜名牌，一间浴场的蒸汽从一道拱门里飘出来。
# en: Steam at the bathhouse
opt.left.label [a72b8c] = 去浴场蒸一蒸
# en: {~The bathhouse is hot, tiled and full of retired admirals. You come out new.|Steam, cold plunge, steam again. Your shoulders forget the term.}
opt.left.say.1 [b3e8e9] = {~浴场又热又满是瓷砖，里面全是退休的海军将领。你出来时焕然一新。|蒸汽、冷水池、再来蒸汽。你的肩膀忘了这个学期。}
# en: Read the plates and walk on
opt.right.label [7e8ca4] = 读完牌子走开
# en: {~"Teeth drawn, letters written, futures read." You admire the ambition and walk on.|You read every plate twice. One just says "No."}
opt.right.say.1 [b82790] = {~“拔牙、代笔、看相。”你佩服这份雄心，继续往前走。|每块牌子你都读了两遍。有一块上面只写着“不”。}

@event capital_theatre_quiet_hour
# en: Gilt and Draughts
title [0f6392] = 金漆与穿堂风
# en: The theatre is between shows: chandeliers half-lit, the foyer smelling of dust and oranges. A stagehand on a ladder is pasting up a new playbill and getting most of the paste on himself.
text [4f2c05] = 剧院正处在两场演出之间：吊灯半亮，门厅里一股灰尘和橙子的气味。梯子上的场工在贴一张新戏单，大半浆糊都抹到了自己身上。
# en: The foyer of a grand gilded theatre, chandeliers half-lit, a playbill being pasted on a pillar by a stagehand on a ladder.
scene [97b94d] = 一座金碧辉煌的大剧院门厅，吊灯半亮着，一个场工站在梯子上往柱子上贴戏单。
# en: Hold his ladder
opt.left.label [56271c] = 帮他扶梯子
# en: {~He gives you a ticket for the gods in thanks. The gods are very high and very cheap and you love them.|You hold the ladder; he tells you which actress hates which. It's better than the play.}
opt.left.say.1 [b65060] = {~他送你一张顶层楼座的票作为谢礼。顶层楼座又高又便宜，你爱死了。|你扶着梯子，他告诉你哪位女演员讨厌哪位。比戏还好看。}
# en: Read the playbill
opt.right.label [83cd9d] = 读读戏单
# en: {~You learn the names off by heart, in case anyone asks. Nobody does, but you're ready.|A tragedy, a farce and a farce pretending to be a tragedy. You'd see all three.}
opt.right.say.1 [ca0a08] = {~你把名字全背了下来，以防有人问起。没人问，但你准备好了。|一出悲剧、一出闹剧，还有一出假装成悲剧的闹剧。三出你都想看。}

@event capital_guild_quiet_hour
# en: The Hiring Hall
title [a63480] = 招工棚
# en: The Guild works' hiring hall is a bench, a chalkboard and a foreman who looks at hands, not faces. Today the board says "NOTHING" in large letters, and under it, in smaller ones, "try tomorrow".
text [425111] = 公会工坊的招工棚只有一条长凳、一块黑板和一个只看手不看脸的工头。今天黑板上大大地写着“没有”，下面小字写着“明天再来”。
# en: A bare hiring hall at the gate of a great riverside works, a chalkboard of jobs, chimneys smoking beyond the window.
scene [afe190] = 河边大工坊门口一间光秃秃的招工棚，一块写着活计的黑板，窗外烟囱冒着烟。
# en: Wait in case
opt.left.label [470f79] = 等等看
# en: {~Nothing comes up, but the old hands on the bench argue about distillation for an hour and you listen to every word.|You wait. You learn three words for a burst vat, none polite.}
opt.left.say.1 [d1b621] = {~什么活也没来，但长凳上的老工人为蒸馏争了一个钟头，你一个字都没漏。|你等着。你学会了三种说大缸炸了的说法，没一种文雅。}
# en: Come back another day
opt.right.label [657555] = 改天再来
# en: {~"Tomorrow," the foreman says, which is what he says.|You leave the bench to the regulars.}
opt.right.say.1 [c65c61] = {~“明天，”工头说，他一向这么说。|你把长凳留给了常客们。}

@event capital_docks_quiet_hour
# en: Gulls and Cranes
title [732bcb] = 海鸥与吊车
# en: Port Calder's docks never stop: cranes, barrels, a ship from somewhere hot unloading something that smells of oranges. A boy offers to mind your bag for a penny, which is how bags go missing.
text [1ccfb3] = 考尔德港的码头从不停歇：吊车、木桶，一艘从某个炎热地方来的船正在卸一批闻起来像橙子的货。一个男孩提出帮你看包，收一个便士——包就是这么丢的。
# en: Busy harbour wharves at the river's mouth, cranes swinging crates off a tall ship, gulls wheeling over stacked barrels.
scene [2791d1] = 河口繁忙的港口码头，吊车从一艘高大的船上吊起箱子，海鸥在成堆的木桶上盘旋。
# en: Pay the boy
opt.left.label [8a2024] = 付钱给男孩
# en: {~He minds it beautifully and tells you which ships are smuggling. All of them, apparently.|Your bag comes back with everything in it and one extra orange. Business is business.}
opt.left.say.1 [14a642] = {~他把包看得好好的，还告诉你哪些船在走私。据他说，全部都是。|你的包回来时东西一样不少，还多了一个橙子。生意就是生意。}
# en: Keep your bag
opt.right.label [fa77f5] = 自己看着包
# en: {~You keep your bag and watch the boy offer the same deal to a sailor, who laughs and pays. You learn something.|"Suit yourself." He's gone before you see him go.}
opt.right.say.1 [c4caf2] = {~你没让他看包，却看着他向一个水手开出同样的价，水手笑着付了钱。你学到了点东西。|“随你。”你还没看清他走，他就没影了。}

@event capital_counting_house_quiet_hour
# en: The Tide Under the Floor
title [e7f747] = 地板下的潮水
# en: After hours the counting house is yours again: empty desks, the smell of ink, and at high water the tide coming right in under the floor, slapping the piles. The night porter is lighting his lantern for his round of the moorings. He's been doing it since you were small enough to carry it.
text [67a808] = 打烊之后，账房又归你了：空荡荡的桌子，墨水的气味，涨潮时潮水一直漫到地板底下，拍打着木桩。守夜人正点起提灯，准备去巡查系泊的缆绳。从你小到只能替他提灯的时候起，他就一直这么做。
# en: A counting house on a wharf after hours, the high desks empty, an old night porter lighting a lantern by the door, water glinting through gaps in the floorboards.
scene [663095] = 打烊后码头上的账房，高桌空无一人，一位年老的守夜人在门边点着提灯，地板缝里透出粼粼水光。
# en: Walk the moorings with him
opt.left.label [9743b9] = 陪他巡一遍缆桩
# en: {~You carry the lantern again, as if you were eight. He tells you which ropes are new and which ships are late. The wind off the water gets into your bones.|The round of the moorings, rope by rope. The porter's knees are worse; your lantern is steadier. The cold walks home with you.}
opt.left.say.1 [e8821d] = {~你又替他提着灯，像八岁时那样。他告诉你哪些缆绳是新的、哪些船晚了。水上吹来的风钻进了你的骨头。|一根缆绳一根缆绳地巡过去。守夜人的膝盖更差了，你的提灯更稳了。寒意一路跟着你回了家。}
# en: Go up and rest
opt.right.label [444519] = 上楼歇息
# en: {~Your old room still smells of ink. You sleep to the sound of the tide under the floor.|Upstairs, the noise of the wharf is a lullaby you'd forgotten.}
opt.right.say.1 [a971ed] = {~你的旧房间还是一股墨水味。你听着地板下的潮声睡着了。|在楼上，码头的嘈杂成了一支你早已忘记的摇篮曲。}

@event capital_crew_loft_quiet_hour
# en: The Chandler's Downstairs
title [ec17b1] = 楼下的杂货铺
# en: Under the loft is the chandler's: rope, tar, lamp-oil and an old man who has spent thirty years not knowing what goes on over his ceiling. He nods to you as if you'd been out for bread. "They're up there," he says. "I don't know anything about it."
text [e08ff1] = 阁楼下面是船具杂货铺：绳索、焦油、灯油，还有一个三十年来一直“不知道”天花板上发生了什么的老头。他冲你点点头，好像你只是出门买了趟面包。“他们在上面，”他说，“我什么也不知道。”
# en: A chandler's shop under a loft, coils of rope and barrels of tar, an old chandler at his counter pointedly not looking up at the ceiling, which creaks.
scene [c43542] = 阁楼下的船具杂货铺里堆着成卷的绳索和一桶桶焦油，年老的店主坐在柜台后，刻意不抬头看那吱呀作响的天花板。
# en: Mind his counter an hour
opt.left.label [4e4332] = 替他看一小时柜台
# en: {~You sell a coil of rope, two lamps and a tin of tar to a captain who calls you "boy" and "miss" in the same sentence. The chandler gives you a coin and a look of mild surprise.|An hour behind the counter, measuring rope by the fathom. Your hands smell of tar till morning, and there's a coin in it.}
opt.left.say.1 [ce36e1] = {~你卖出了一卷绳子、两盏灯和一罐焦油，买主是个船长，一句话里先叫你“小子”又叫你“小姐”。店主给了你一枚硬币，神情略带惊讶。|在柜台后待了一个小时，按英寻量绳子。你的手直到第二天早上都是焦油味，好在有一枚硬币。}
# en: Sleep in your old hammock
opt.right.label [0a0d0f] = 睡你的旧吊床
# en: {~The hammock still knows your shape. You sleep through the stove smoke and an argument about a dog.|You sleep like you used to, with one hand on your boots.}
opt.right.say.1 [4e68bd] = {~吊床还记得你的形状。你一觉睡过了炉烟和一场关于狗的争吵。|你像从前那样睡着，一只手搭在靴子上。}

@event countryside_mill_quiet_hour
# en: The Turning Wheel
title [8c905e] = 转动的水车
# en: The mill wheel turns slowly, the chapel stands small and grey, and on the green the children skip to a rhyme with a lot of counting in it. They stop when you come near, and smile, and start again when you've passed.
text [b8df5b] = 水车慢慢地转，礼拜堂又小又灰，绿地上孩子们唱着一首数数特别多的歌谣跳绳。你一走近，他们就停下来冲你笑；你走过去了，他们又开始。
# en: A mill on a slow river in a small grey village, its wheel turning, children skipping a rope on the green in front of the chapel.
scene [0501dc] = 一个灰色小村里慢慢河流上的一座磨坊，水车转动，孩子们在礼拜堂前的绿地上跳绳。
# en: Watch the wheel a while
opt.left.label [3cb04a] = 看一会儿水车
# en: {~The wheel goes round, the water goes over, and the afternoon goes with it.|You watch the wheel until you notice the river is lower than the wheel is fast. Probably nothing.}
opt.left.say.1 [9efdf6] = {~水车转着，水漫过去，下午也跟着过去了。|你看着水车，直到发觉河水比水车转得慢。大概没什么。}
# en: Walk on through
opt.right.label [75daa8] = 穿村而过
# en: {~The village waves you off. All of it.|You walk on. Behind you, the skipping starts again, counting.}
opt.right.say.1 [f4db9b] = {~整个村子都在送你。每一个人。|你继续往前走。身后，跳绳又开始了，还在数数。}

@event countryside_marsh_quiet_hour
# en: Lights on the Water
title [8bf099] = 水上的光
# en: The Marsh is reeds, black water and a path that's there until it isn't. At dusk, little lights come out and hang over the pools. A house on stilts stands at the edge with a lamp in its window.
text [1515d3] = 沼泽是芦苇、黑水，还有一条路——直到它不再是路。黄昏时，小小的光点出来，悬在水塘上方。沼泽边上一座高脚屋的窗里亮着一盏灯。
# en: Reed beds and black water at dusk, small pale lights hanging low over the marsh, a house on stilts at its edge.
scene [06c465] = 黄昏时的芦苇丛和黑水，几点苍白的光低低地悬在沼泽上，沼泽边上有一座高脚屋。
# en: Watch the lights from the path
opt.left.label [a6916a] = 从小路上看那些光
# en: {~The lights drift together and apart, as if they're talking. You don't follow them, which is the main thing.|One light comes nearer than the others. You keep to the path, and it goes away, disappointed.}
opt.left.say.1 [aa39c3] = {~光点聚了又散，像在交谈。你没去追，这才是要紧的。|有一个光点比别的靠得更近。你守在路上，它失望地走了。}
# en: Turn back before dark
opt.right.label [68600c] = 天黑前回去
# en: {~You turn back while the path is still a path.|You leave the Marsh to its lights.}
opt.right.say.1 [d23b31] = {~趁路还是路，你往回走了。|你把沼泽留给了它的光。}

@event countryside_moors_quiet_hour
# en: The Third Cairn
title [22174a] = 第三座石堆
# en: The moors go on longer than they should. A shepherd tells you to stay this side of the third cairn, then walks off before you can ask why. Fog is coming up in the hollows, unhurried.
text [3d415f] = 荒原比它应有的更长。一个牧羊人叫你别越过第三座石堆，你还没来得及问为什么，他就走开了。洼地里的雾正不慌不忙地升起来。
# en: Open moorland of heather and grey stone cairns, fog rising in the hollows, a lone sheep watching from a rock.
scene [ad2313] = 开阔的石南荒原，灰色的石堆，洼地里升起雾气，一只孤零零的羊站在岩石上看着。
# en: Walk to the first cairn and back
opt.left.label [416e51] = 走到第一座石堆再回来
# en: {~The wind is clean and enormous. You touch the cairn, count to ten, and come back with your cheeks burning.|You reach the first cairn. The second is closer than it looked. You turn back anyway.}
opt.left.say.1 [bfac39] = {~风干净又辽阔。你摸了摸石堆，数到十，回来时脸颊发烫。|你走到了第一座石堆。第二座比看上去近。你还是转身回来了。}
# en: Stay by the road
opt.right.label [569d44] = 待在路边
# en: {~You watch the fog fill the hollows from the road, which is the sensible place to watch it from.|A sheep stares at you until you leave. You leave.}
opt.right.say.1 [c17d36] = {~你在路边看着雾填满洼地，路边正是看雾的明智之处。|一只羊一直盯着你，直到你离开。你离开了。}

@event countryside_ridge_quiet_hour
# en: The Stones
title [fa1976] = 立石
# en: The stones on the ridge stand in a ring, leaning a little, as if listening to the valley. From up here you can see both villages, the fen and the moors, and the road joining them like a stitch.
text [246133] = 山脊上的立石围成一圈，微微倾斜，像在聆听山谷。从这里你能看见两个村子、沼泽和荒原，还有把它们连起来的那条路，像一道针脚。
# en: A ring of grey standing stones on a bare ridge under a huge sky, the valley's villages small and far below.
scene [80c369] = 光秃秃的山脊上，巨大的天空下一圈灰色立石，山谷里的村子又小又远。
# en: Count the stones
opt.left.label [910e63] = 数数这些石头
# en: {~You count them twice and get two answers. You decide it's the wind.|Nineteen, you think. Or twenty. You stop counting.}
opt.left.say.1 [5a4321] = {~你数了两遍，得到两个答案。你决定怪风。|十九块，你想。也许二十。你不数了。}
# en: Just take in the view
opt.right.label [b51fff] = 只看风景
# en: {~The whole valley, small and peaceful, from up here. It looks very well kept.|The wind tugs your coat and the villages smoke quietly below. Nothing up here wants anything from you.}
opt.right.say.1 [a8eee7] = {~从这里看，整个山谷又小又安宁，打理得非常好。|风拽着你的外套，村子在下面安静地冒着炊烟。这上面没有任何东西想从你身上要什么。}

@event travel_city_morning
# en: A Morning in the Capital
title [ec0430] = 王都的早晨
# en: The capital wakes before you do, and louder: barrows, bells, a man selling hot chestnuts under your window as if his life depends on it, which it may.
text [d84e63] = 王都比你醒得早，也更吵：手推车、钟声，还有一个在你窗下卖热栗子的人，卖得像性命攸关——也许真是。
# en: Early morning in a capital city, a student at a lodging-house window looking down at barrows, bells and smoke.
scene [10be04] = 王都的清晨，一个学生站在旅店窗前，俯瞰手推车、钟声和烟雾。
# en: Chestnuts for breakfast
opt.left.label [84fde4] = 栗子当早饭
# en: {~They burn your fingers and taste of smoke and autumn. A good start.|You eat them walking, like a native, and get lost like a visitor.}
opt.left.say.1 [b57e70] = {~烫手，带着烟和秋天的味道。好的开头。|你边走边吃，像个本地人；然后迷路，像个外地人。}
# en: Plan the day over cheap tea
opt.right.label [07927a] = 就着便宜茶安排一天
# en: {~You draw a map of the day on the back of a playbill. The capital ignores it completely.|Cheap tea, a borrowed newspaper, a plan. Good enough.}
opt.right.say.1 [1b55e6] = {~你在一张戏单背面画了一天的地图。王都完全不理它。|便宜的茶、一份借来的报纸、一个计划。够了。}

@event travel_country_morning
# en: A Morning in the Countryside
title [ecfd29] = 乡间的早晨
# en: The country wakes slowly: a cart in the lane, mist on the fields, a rooster with opinions. Your host has left bread and a jug of milk outside your door, and a sprig of something green tied round the jug.
text [9cd336] = 乡间醒得慢：小路上一辆马车、田野上的雾，还有一只很有主见的公鸡。房东在你门外放了面包和一罐牛奶，罐子上系着一小枝绿色的什么。
# en: Early morning in a country village, mist on the fields, a student at a window watching a farmer lead a cart down the lane.
scene [acf3f1] = 乡村的清晨，田野上有雾，一个学生在窗前看着农夫牵着马车走过小路。
# en: Breakfast at the window
opt.left.label [b7c388] = 在窗边吃早饭
# en: {~The bread is still warm. The mist lifts off the fields like a lid.|You eat slowly, watching the village wake. Everyone waves at your window.}
opt.left.say.1 [5cc4d5] = {~面包还是温的。雾像盖子一样从田野上揭开。|你慢慢吃着，看着村子醒来。每个人都朝你的窗户挥手。}
# en: Walk out early
opt.right.label [ce7383] = 一早出门走走
# en: {~You walk the lane before anyone is up. The fields are very quiet, and the scarecrows are very well dressed.|An early walk, wet boots, and the whole valley to yourself.}
opt.right.say.1 [bb405a] = {~趁大家还没起，你走了一趟小路。田野非常安静，稻草人穿得非常体面。|一早的散步、湿透的靴子，还有整个山谷只属于你。}

@event vaneshade_house_quiet_hour
# en: The Black Seal
title [fda1a0] = 黑色封印
# en: The footman at Vaneshade House looks at your boots, then at your face, then at your boots again. Miss Vaneshade, he says, is at her practice and not receiving.
text [cf6298] = 凡妮希德府的侍从看看你的靴子，再看看你的脸，又看回你的靴子。他说，凡妮希德小姐正在练习，不见客。
# en: A tall black-stone house on a curving uptown street, a black wax seal carved in stone over its door, a footman on the step.
scene [d61945] = 上城一条弧形街道上一座高大的黑石宅邸，门楣上刻着一枚黑色的封印，台阶上站着一个侍从。
# en: Leave your name
opt.left.label [dc329a] = 留下你的名字
# en: {~He takes your name on a silver tray as if it might stain it. Somewhere upstairs, a window opens.|You leave your name. The door shuts with the soft, expensive sound of a door that has shut on better people.}
opt.left.say.1 [df7808] = {~他用银托盘接过你的名字，好像怕它弄脏了托盘。楼上某处，一扇窗户打开了。|你留下名字。门轻轻关上，发出那种昂贵的声音，那是一扇曾对更体面的人关上过的门。}
# en: Walk on along the Crescent
opt.right.label [6ab72e] = 沿着新月街走开
# en: {~You walk the curve of the Crescent, all black stone and white steps, and feel underdressed in a pleasant, distant way.|You walk on. Behind you, someone in an upstairs window lets a curtain fall.}
opt.right.say.1 [d0d5a8] = {~你沿着新月街的弧线走，满眼黑石与白台阶，觉得自己穿得寒酸，却寒酸得愉快而遥远。|你走开了。身后楼上的窗里，有人放下了窗帘。}

@event oracle_rooms_quiet_hour
# en: The Queue on the Stairs
title [fb079f] = 楼梯上的队伍
# en: The stairs to the Oracle's Rooms are full of people in good coats pretending not to be nervous. A clerk takes names. Nobody speaks above a whisper, in case the future is listening.
text [d959c4] = 通往神谕者厅堂的楼梯上挤满了穿着体面外套、假装不紧张的人。一个书记员登记名字。没人敢大声说话，生怕未来在听。
# en: A hushed upper staircase lined with anxious, well-dressed petitioners waiting on a bench outside a closed double door.
scene [95d9a8] = 一道静悄悄的上层楼梯，两旁长凳上坐满了衣着讲究、神情焦虑的求见者，等在一扇紧闭的双开门外。
# en: Wait with them a while
opt.left.label [feebe8] = 跟他们一起等一会儿
# en: {~You wait an hour. A man comes out white-faced and a woman comes out laughing. Neither will say what they heard.|You wait. The clerk calls a name that isn't yours, and then, oddly, looks straight at you.}
opt.left.say.1 [85c1e0] = {~你等了一个钟头。一个男人脸色发白地出来，一个女人笑着出来。谁都不肯说听到了什么。|你等着。书记员叫了一个不是你的名字，然后，奇怪地，直直看向你。}
# en: Leave them to it
opt.right.label [4dcfa4] = 让他们等去吧
# en: {~You go back down into the street, where the future is somebody else's business.|You leave. On the stairs, a duchess is crying quietly into a very good glove.}
opt.right.say.1 [96fc81] = {~你回到街上，那里的未来是别人的事。|你离开了。楼梯上，一位公爵夫人正对着一只很好的手套悄悄地哭。}

@event hollis_house_quiet_hour
# en: The Brass Plate
title [8ce7f5] = 铜牌
# en: Hollis House has the straightest window boxes in the street and a brass plate polished until it squints back at you. {slot == "noon": Someone inside is practising scales on a piano, very correctly.|Behind the curtains, someone is reading aloud, very correctly.}
text [2aa7ce] = 霍利斯宅的窗台花箱是整条街最直的，门上的铜牌擦得锃亮，亮得朝你眯眼。{slot == "noon": 屋里有人在弹钢琴音阶，弹得一丝不苟。|窗帘后面有人在朗读，读得一丝不苟。}
# en: A narrow, immaculate uptown house with a polished brass nameplate on the door and perfectly straight window boxes.
scene [b5f473] = 上城一座窄窄的、整洁无瑕的房子，门上一块擦亮的铜名牌，窗台花箱摆得笔直。
# en: Knock
opt.left.label [60f31f] = 敲门
# en: {~A maid answers, says the family is at {slot == "noon": luncheon|{slot == "evening": dinner|tea}}, and shuts the door with great precision.|Nobody answers, but the {slot == "noon": piano|reading} stops, and starts again exactly where it left off.}
opt.left.say.1 [c986da] = {~一个女仆开了门，说全家正在用{slot == "noon": 午餐|{slot == "evening": 晚餐|下午茶}}，然后极其精确地关上了门。|没人应门，可{slot == "noon": 钢琴声|朗读声}停了，然后又从刚才停下的地方接着响起来。}
# en: Pass by
opt.right.label [f4e8a5] = 走过去
# en: {~You pass by. The {slot == "noon": piano follows you to the corner, exactly in time|reading voice follows you to the corner, not missing a comma}.|You walk on. Even the cobbles outside look as if they've been told to sit up straight.}
opt.right.say.1 [adb4f9] = {~你走过去。{slot == "noon": 钢琴声跟着你到了街角，拍子分毫不差|朗读声跟着你到了街角，一个逗号都没落下}。|你继续走。连门外的鹅卵石都像是被人叮嘱过要坐直。}

@event capital_gardens_quiet_hour
# en: The Promenade
title [366697] = 散步
# en: Everyone uptown walks the Royal Gardens at this hour, slowly, in their best, nodding to the people they've decided to nod to. The fountain is the only thing in a hurry.
text [c1602c] = 这个钟点，上城的人都来皇家花园散步，慢慢地，穿着最好的衣服，向他们决定要点头的人点头。只有喷泉在赶时间。
# en: A gravel promenade between clipped hedges and a fountain in a city park, fashionable walkers strolling slowly, a hothouse glittering behind.
scene [5878f4] = 城中公园里修剪整齐的树篱之间的一条碎石步道和一座喷泉，时髦的行人慢慢踱步，后面一座温室闪闪发光。
# en: Promenade with them
opt.left.label [44788a] = 跟他们一起散步
# en: {~You walk the loop twice, nodding at the right moments. A dowager nods back, then asks a companion who you are.|You promenade. Your feet hurt and three people now know your face.}
opt.left.say.1 [e88093] = {~你绕了两圈，在该点头的时候点头。一位贵妇也向你点头，然后问同伴你是谁。|你散了步。脚疼了，又多了三个人认得你的脸。}
# en: Sit by the fountain
opt.right.label [a9eba5] = 在喷泉边坐坐
# en: {~You sit on the fountain's edge and watch the city pretend to relax.|The spray drifts over you. For a moment the capital is quiet.}
opt.right.say.1 [277cca] = {~你坐在喷泉边上，看着这座城假装放松。|水雾飘到你身上。有那么一刻，王都安静了。}

@event capital_cathedral_quiet_hour
# en: Under the Lamp
title [31e340] = 明灯之下
# en: The cathedral swallows the city's noise at the door. High over the altar the Lamp burns, as it has for four hundred years, and the light it gives is warmer than it has any right to be.
text [1a0885] = 大教堂在门口就把城市的喧嚣吞没了。祭坛上方高处，那盏明灯燃着，四百年来一直如此，它给的光比它该有的更暖。
# en: The vast dim nave of a cathedral, a single great lamp burning high above the altar, a few worshippers and visitors in the pews.
scene [f31803] = 一座大教堂幽暗宏大的中殿，一盏巨大的灯高悬在祭坛上方燃烧，长椅上坐着几个信徒和访客。
# en: Sit under the Lamp
opt.left.label [312528] = 在明灯下坐坐
# en: {~You sit a long while on a cold pew and think about nothing useful. It's the best hour of the day, stiff back and all.|You sit until the bells ring the hour overhead and the whole building hums with it, and your knees have gone numb.}
opt.left.say.1 [b0969b] = {~你在冰冷的长椅上坐了很久，什么有用的都没想。腰背僵了，可这是一天里最好的一个钟头。|你一直坐到头顶的钟敲响整点，整座建筑都随之嗡鸣，你的膝盖也麻了。}
# en: Read the old memorials
opt.right.label [97566c] = 读读古老的纪念牌
# en: {~Brass plates in the floor, names worn smooth by four centuries of feet. One is a Lumenhold headmaster's.|You read the memorials along the aisle: admirals, bakers, a famous duellist, a dog.}
opt.right.say.1 [be38e5] = {~地上嵌着的铜牌，名字被四百年的脚步磨平了。其中一块是流明堡一位校长的。|你沿着过道读那些纪念牌：海军上将、面包师、一位有名的决斗者、一条狗。}

@event capital_printing_row_quiet_hour
# en: Hot Off the Press
title [45d281] = 刚出炉
# en: Printing Row thumps like a heart. Every door has a press behind it and every press is printing something somebody will regret. A boy runs past shouting tomorrow's headline today.
text [a1d5dc] = 印刷街像一颗心脏一样咚咚作响。每扇门后都有一台印刷机，每台印刷机都在印某个人会后悔的东西。一个男孩跑过，今天就喊着明天的头条。
# en: A narrow street of print shops, presses thumping behind open doors, a boy running past with a stack of fresh broadsheets.
scene [600bd9] = 一条满是印刷铺的窄街，敞开的门后印刷机咚咚作响，一个男孩抱着一摞新印的报纸跑过。
# en: Buy a broadsheet
opt.left.label [cbfc57] = 买一份报纸
# en: {~The ink comes off on your fingers. The news is a scandal you've never heard of, involving a duke and a swan.|You read it on a step. Somebody uptown is suing somebody else for a portrait.}
opt.left.say.1 [16e957] = {~油墨沾到了手指上。新闻是一桩你从没听说过的丑闻，涉及一位公爵和一只天鹅。|你坐在台阶上读。上城有人为一幅肖像在告另一个人。}
# en: Watch the presses
opt.right.label [a6de9c] = 看印刷机
# en: {~A printer lets you watch from the door. The press bangs, the sheet lifts, and the city's morning is made.|You watch letters set backwards, very fast, by a girl who never looks down.}
opt.right.say.1 [e46e1b] = {~一个印刷工让你在门口看。机器咚地一压，纸一揭，城里的早晨就做出来了。|你看着一个从不低头的女孩飞快地把铅字反着排好。}

@event capital_bridges_quiet_hour
# en: Lamps on the Bridges
title [9f3f50] = 桥上的灯
# en: At dusk the lamplighters come out along the bridges with their long poles, and the lamps go on one by one above the buskers, the hawkers and the couples who have come to watch them do it.
text [6b3476] = 黄昏时，点灯人扛着长杆沿着桥走出来，灯一盏一盏亮起，照在街头艺人、小贩和专门来看他们点灯的情侣头上。
# en: An old stone bridge over a river at dusk crowded with buskers and walkers, a lamplighter on a ladder lighting the lamps one by one.
scene [12d836] = 黄昏时一座横跨河面的古老石桥，挤满了街头艺人和行人，一个点灯人站在梯子上把灯一盏盏点亮。
# en: Drop a coin for a busker
opt.left.label [eae59c] = 给街头艺人扔个硬币
# en: {~A fiddler plays you a jig for a penny, and a whole tune for the look on your face.|You toss a coin to a juggler with five burning torches. He catches it with his teeth.}
opt.left.say.1 [3e67ca] = {~一个拉小提琴的为一便士给你拉了一段快步舞，又为你脸上的神情拉完了整支曲子。|你给一个抛着五支火把的杂耍人扔了枚硬币。他用牙接住了。}
# en: Watch the lamps come on
opt.right.label [b649ed] = 看着灯亮起来
# en: {~One by one, all the way down the river, until the water is full of lamps too.|You watch the last lamp lit. The lamplighter tips his hat to it, as if it had done him a favour.}
opt.right.say.1 [7f9f77] = {~一盏接一盏，一直顺着河往下，直到水里也满是灯。|你看着最后一盏灯被点亮。点灯人朝它举了举帽子，好像它帮了他一个忙。}

@event ten_clockworks_quiet_hour
# en: Forty Clocks
title [da5672] = 四十座钟
# en: The Ten Clockworks' shop has forty clocks on its walls, and they all strike the hour within a breath of each other, which in this family counts as a disagreement.
text [a52451] = 滕氏钟表坊的墙上挂着四十座钟，它们报整点时前后相差不过一口气，而在这一家人看来，这就算是意见不合了。
# en: A cluttered clockmaker's workshop full of ticking clocks on every wall, a long workbench covered in tiny gears and brass tools.
scene [880e35] = 一间杂乱的钟表工坊，每面墙上都挂满了滴答作响的钟，长长的工作台上堆满了细小的齿轮和黄铜工具。
# en: Look at the clocks
opt.left.label [88acc3] = 看看那些钟
# en: {~One clock runs backwards. A small card under it says NOT FOR SALE (A HOBBY).|You lean close to the smallest clock. It's built into a thimble, and it's right.}
opt.left.say.1 [f8fb96] = {~有一座钟是倒着走的。下面一张小卡片写着：非卖品（爱好）。|你凑近最小的那座钟。它做在一枚顶针里，而且走得很准。}
# en: Step back out
opt.right.label [368902] = 退出门去
# en: {~You leave before the hour strikes. Behind you, forty clocks argue about it.|You go out into the works smoke. The ticking follows you down the street.}
opt.right.say.1 [7dceb2] = {~你在整点前离开了。身后，四十座钟为此争论不休。|你走进工坊区的烟雾里。滴答声一路跟着你下了街。}

@event capital_coaching_yard_quiet_hour
# en: Coaches In
title [b3692c] = 驿车进站
# en: A coach from the north rolls in spattered to the windows, and the yard fills with trunks, horses, porters and people trying to remember which of the trunks is theirs.
text [0e5f26] = 一辆从北方来的驿车驶进来，泥点一直溅到车窗，院子里顿时挤满了箱子、马、脚夫，还有努力回想哪只箱子是自己的人。
# en: A busy cobbled coaching yard, horses steaming, porters hauling trunks off the roof of a mud-spattered coach, travellers milling.
scene [96f12d] = 热闹的鹅卵石驿车场，马匹冒着热气，脚夫正从一辆满是泥点的驿车车顶上卸下箱子，旅客来来往往。
# en: Lend a porter a hand
opt.left.label [1d33d3] = 帮脚夫搭把手
# en: {~You hoist a trunk off the roof. It's full of books, or bricks. The porter shares his tip with you.|You carry a hatbox the size of a small sheep. Its owner tips you a coin and a stern look.}
opt.left.say.1 [ef5a21] = {~你从车顶上扛下一只箱子。里面装的是书，要么是砖。脚夫把小费分给了你。|你搬了一只小羊那么大的帽盒。它的主人赏你一枚硬币和一个严厉的眼神。}
# en: Watch the travellers
opt.right.label [c08529] = 看看那些旅客
# en: {~A man in furs, a girl with a caged owl, a whole family of fiddlers. Everyone arriving looks lost and hopeful.|You watch them come in. Somebody always gets off looking for someone who isn't there.}
opt.right.say.1 [e7e81d] = {~一个穿毛皮的男人、一个提着笼中猫头鹰的女孩、一整家拉小提琴的。每个到站的人都显得迷茫又满怀希望。|你看着他们下车。总有人下了车，要找一个并不在那儿的人。}

@event capital_fish_market_quiet_hour
# en: The Morning Catch
title [fbe87b] = 清晨的渔获
# en: The fish market has been open since before the sun and has no intention of being polite about it. The catch is on ice, the gulls are on the roofs and the fishwives are on everyone.
text [848608] = 鱼市从太阳出来之前就开张了，而且一点也不打算客气。渔获在冰上，海鸥在屋顶上，卖鱼妇在每个人身上。
# en: A noisy fish market on a stone quay at dawn, barrows of fish on ice, gulls wheeling, fishwives shouting prices.
scene [821144] = 黎明时石砌码头上一个喧闹的鱼市，手推车上的鱼铺在冰上，海鸥盘旋，卖鱼妇大声喊价。
# en: Buy a hot fish pasty
opt.left.label [b58b14] = 买一个热鱼馅饼
# en: {~Hot, peppery and wrapped in yesterday's broadsheet. You eat it on the quay with the gulls watching.|The pasty seller calls you "my love" and gives you the one with extra pastry.}
opt.left.say.1 [403153] = {~又热又辣，用昨天的报纸包着。你在码头上吃，海鸥在旁边看着。|卖馅饼的叫你“亲爱的”，给了你酥皮最多的那个。}
# en: Listen to the gossip
opt.right.label [0bfde1] = 听听闲话
# en: {~Who's courting whom, whose boat came in light, which warehouse had the customs men in. Port Calder knows everything by breakfast.|You learn three scandals and the price of eels before you've finished walking the quay.}
opt.right.say.1 [463c13] = {~谁在跟谁相好，谁的船回来时轻飘飘的，哪个仓库来过海关的人。卡尔德港早饭前就什么都知道了。|你还没走完码头，就听到了三桩丑闻和鳗鱼的价钱。}

@event ashby_lane_quiet_hour
# en: The Crooked Lane
title [57d5e9] = 歪巷
# en: Ashby Lane is so narrow the houses lean on each other for company. Washing hangs across it. A woman on a step looks at your academy coat and says, "One of Corvin's?" as if Corvin collected people.
text [b93a0b] = 阿什比巷窄得房子都靠在彼此身上作伴。衣服晾在巷子上空。台阶上一个女人看看你的学院外套，说：“科尔文的人？”好像科尔文收集人似的。
# en: A narrow crooked lane in an old harbour town, houses leaning together overhead, washing strung between the windows, a door with a scuffed step.
scene [9eddb9] = 老港镇里一条狭窄弯曲的小巷，头顶上的房子彼此倾靠，窗户之间拉着晾衣绳，一扇门前的台阶磨损了。
# en: Say you're a friend of his
opt.left.label [22f3d3] = 说你是他的朋友
# en: {~"Poor you," she says, and laughs, and then doesn't. "Tell him his grandad's chair's still here."|"A friend," she repeats. "That's new." She goes in before you can ask what she means.}
opt.left.say.1 [a5e2b6] = {~“可怜的孩子，”她说着笑了，然后又不笑了。“告诉他，他爷爷的椅子还在这儿。”|“朋友，”她重复了一遍。“这可新鲜。”你还没来得及问她是什么意思，她就进屋了。}
# en: Just walk through
opt.right.label [12b3f1] = 就从巷里穿过去
# en: {~You walk the lane end to end. Two children follow you, then lose interest.|You walk on. A window above you shuts as you pass, firmly.}
opt.right.say.1 [36ba0a] = {~你从巷头走到巷尾。两个孩子跟了你一阵，然后没了兴趣。|你继续走。你经过时，头顶上一扇窗户坚决地关上了。}

@event fennick_farm_quiet_hour
# en: Turnips and Tomatoes
title [86997d] = 芜菁和番茄
# en: The Fennick farm sits up on the windy side of the valley, all turnip rows and tomato stakes and a farmhouse built low against the weather. A goose sees you coming and makes its views known.
text [64e96c] = 芬尼克农场坐落在山谷有风的那一侧，满是一垄垄芜菁和番茄架，还有一座为了挡风盖得很低的农舍。一只鹅看见你来，表明了它的立场。
# en: A small upland farm on a windy hillside, rows of turnips and staked tomatoes, a stone farmhouse with a smoking chimney.
scene [f77ffc] = 有风的山坡上一座小小的高地农场，一垄垄芜菁和搭着支架的番茄，一座烟囱冒烟的石头农舍。
# en: Lend a hand in the rows
opt.left.label [0f3375] = 帮着干干地里的活
# en: {~You weed a row and get chased by the goose. A voice from the house calls that you can stay for tea.|{season == "winter": You help lift frozen turnips in the wind until your fingers stop working. Your hands smell of earth for a day.|You stake tomatoes in the wind until your arms ache. Your hands smell green for a day.}}
opt.left.say.1 [9f14e5] = {~你除了一垄草，被鹅追着跑。屋里有个声音喊你留下来喝茶。|{season == "winter": 你在风里帮着挖冻住的芜菁，挖到手指都不听使唤了。你的手有一天都是泥土味。|你在风里给番茄搭架子，搭到胳膊发酸。你的手有一天都是青草味。}}
# en: Lean on the gate
opt.right.label [d163c0] = 靠在门边
# en: {~From the gate you can see the whole valley, the villages very small, the moor very big.|You lean on the gate and the goose leans on the other side, both of you thinking.}
opt.right.say.1 [6140e5] = {~从门边你能看见整个山谷，村子小小的，荒原大大的。|你靠在门这边，鹅靠在门那边，你们都在想事情。}

@event almanac_printers_quiet_hour
# en: The Almanac Press
title [de1434] = 历书印刷机
# en: The printer's off the market green smells of ink and damp paper. This year's almanacs are stacked by the door, thin and cheerful: sowing days, saints' days, a good harvest forecast in very confident type.
text [b925a2] = 集市草地边的印刷坊闻起来是油墨和潮湿纸张的味道。今年的历书在门边码着，薄薄的、喜气洋洋：播种日、圣徒日，还有用很有把握的字体印着的丰收预报。
# en: A cramped village print shop with a hand press in the window, stacks of thin almanacs, funeral cards and notices pegged to dry on strings.
scene [ca1a2c] = 一家拥挤的乡村印刷铺，橱窗里一台手摇印刷机，一摞摞薄薄的历书，讣闻卡片和告示夹在绳子上晾干。
# en: Buy an almanac
opt.left.label [1eab65] = 买一本历书
# en: {~Tides, sowing days, a remedy for warts. Every year in it is a good one.|You buy one. Flicking through on the step, you find a page number missing, as if a page had been printed and taken out.}
opt.left.say.1 [a48e0f] = {~潮汐、播种日、治疣子的偏方。里面每一年都是好年景。|你买了一本。在台阶上翻看时，你发现少了一个页码，好像有一页印好了又被抽走了。}
# en: Watch the press
opt.right.label [65c858] = 看印刷机
# en: {~A woman with ink to the elbow works the press without looking up, and asks if you're the one from the academy.|The press thumps. Notices go up on the strings to dry: a sale of land, a lost dog, a wedding.}
opt.right.say.1 [02f635] = {~一个手臂上沾满油墨的女人头也不抬地操作印刷机，问你是不是学院来的那个。|印刷机咚咚作响。告示挂上绳子晾干：一块地出售、一条狗走失、一场婚礼。}

@event countryside_ford_quiet_hour
# en: The Stepping Stones
title [dbde5c] = 垫脚石
# en: At the ford the river runs wide and shallow over stepping stones, and an old ferryman sits by his punt for the days it doesn't. He's watching the water as if it owes him something.
text [394307] = 在渡口，河水又宽又浅，流过一块块垫脚石，一个老渡船夫坐在他的平底船旁，等着那些水不浅的日子。他盯着河水，好像河欠了他什么。
# en: A wide shallow river ford with stepping stones, a flat-bottomed punt tied to a post, an old ferryman sitting on the bank.
scene [e83d48] = 一处宽阔的浅水渡口，一排垫脚石，一条平底船拴在桩子上，一个老渡船夫坐在岸边。
# en: Cross on the stones
opt.left.label [28967b] = 踩着石头过去
# en: {~You make it across with one wet boot. The ferryman nods as if he'd bet on the boot.|Halfway over a stone rocks. You don't fall, but your heart does.}
opt.left.say.1 [443d6a] = {~你过去了，湿了一只靴子。渡船夫点点头，好像他早就押了那只靴子。|走到一半，一块石头晃了。你没摔，可你的心摔了一下。}
# en: Pay for the punt
opt.right.label [3c53c6] = 付钱坐船
# en: {~He poles you across without a word and holds out his hand for a coin. He looks at it a long time before he pockets it.|The punt is slow and dry and the ferryman hums the counting rhyme the whole way over.}
opt.right.say.1 [c71af6] = {~他一声不吭地把你撑过河，伸手要一枚硬币。他看了那枚硬币很久，才把它收进兜里。|船慢悠悠的，很干爽，渡船夫一路都在哼那首数数歌。}

@event hollin_coppice_quiet_hour
# en: Charcoal Smoke
title [7b74ef] = 烧炭的烟
# en: Hollin Coppice is a wood of straight young trees growing from old stumps, cut and grown again since before the villages. Blue smoke rises from a charcoal mound in a clearing, and somebody has chalked a mark on every seventh trunk.
text [eda62e] = 霍林矮林是一片从老树桩上长出来的笔直小树，早在有村子之前就砍了又长。一片空地上，一座炭堆冒着蓝烟，有人在每第七棵树干上用粉笔做了记号。
# en: A coppiced woodland of thin straight trees and old stumps, blue charcoal smoke rising from a mound in a clearing.
scene [ac5309] = 一片矮林，满是细直的小树和老树桩，空地上一座炭堆升起蓝色的烟。
# en: Forage along the rides
opt.left.label [2bf28e] = 沿着林间小道采集
# en: {~Wood sorrel, a handful of mushrooms and a scratch from a bramble you'll be noticing all week.|You fill your pockets. A charcoal burner watches from his smoke and doesn't wave.}
opt.left.say.1 [27a5c5] = {~酢浆草、一把蘑菇，还有一道荆棘划的口子，你一整个星期都会留意到它。|你装满了口袋。一个烧炭人在他的烟里看着你，没有挥手。}
# en: Count the chalk marks
opt.right.label [c413a6] = 数数粉笔记号
# en: {~Every seventh tree, all the way along. When you go back to check, the first mark is on the eighth.|You count them as far as the clearing, and stop counting there.}
opt.right.say.1 [e758c0] = {~每第七棵树，一路都是。你回去核对时，第一个记号却在第八棵上。|你一直数到空地，在那里停下不数了。}

@event countryside_tarn_quiet_hour
# en: The Still Water
title [899a25] = 静水
# en: The tarn lies up on the upland in a cup of stone, black and so still that the clouds in it look deeper than the clouds above. Nothing lives on its shore but wind.
text [efdd35] = 山间湖躺在高地上一个石头围成的凹地里，黑黑的，静得湖里的云看起来比天上的云还深。湖岸上除了风，什么也不住。
# en: A small black mountain lake high on open upland, perfectly still, reflecting the sky and clouds, a student on the stony shore.
scene [c63d6f] = 开阔高地上一个小小的黑色山湖，平静无波，倒映着天空和云，一个学生站在多石的湖岸上。
# en: Skim stones
opt.left.label [fb9959] = 打水漂
# en: {~Seven skips. Then six. The rings go out to the far side and the tarn takes a long time to be still again.|You skim stones until your arm aches. The tarn swallows each one politely.}
opt.left.say.1 [6ecbad] = {~跳了七下。然后六下。涟漪一直荡到对岸，湖面过了很久才又静下来。|你打水漂打到胳膊酸。湖礼貌地吞下了每一块石头。}
# en: Sit and look into it
opt.right.label [e09dfe] = 坐着往湖里看
# en: {~You look into the water a long time. The sky down there is a little different from this one, and you can't say how.|You sit by the tarn until you're cold. It's the quietest place you've ever been.}
opt.right.say.1 [ada37c] = {~你往水里看了很久。那下面的天空和这上面的有点不一样，你说不出是哪里。|你在湖边坐到冷了。这是你到过的最安静的地方。}

@event countryside_quarry_quiet_hour
# en: The Echo
title [ae6b95] = 回声
# en: The old quarry's walls are full of fossils, shells from a sea that left before the valley had a name. The echo here is famous: call out, and the quarry answers.
text [56b948] = 老采石场的岩壁里满是化石，是一片在山谷还没有名字之前就退去的海留下的贝壳。这里的回声很有名：喊一声，采石场就会回答。
# en: An abandoned stone quarry with tall pale rock faces streaked with fossils, rubble below, a student calling out with cupped hands.
scene [e42325] = 一座废弃的采石场，高高的浅色岩壁上布满化石纹路，下面是碎石，一个学生用手拢着嘴大声呼喊。
# en: Call out
opt.left.label [baeebd] = 喊一声
# en: {~You shout your name. The quarry says it back three times, the last time slightly wrong.|You call "hello". The echo answers "hello", and then, after a long wait, "again?"}
opt.left.say.1 [cc2326] = {~你喊出自己的名字。采石场把它回了三遍，最后一遍有点不对。|你喊“你好”。回声答“你好”，然后，等了很久，又说：“再来？”}
# en: Hunt for fossils
opt.right.label [7067a6] = 找化石
# en: {~You chip out a perfect little shell and bark your knuckles doing it.|A spiral fossil the size of your palm. You carry it all the way back and give it a name.}
opt.right.say.1 [310f84] = {~你凿出一枚完美的小贝壳，指节也磕破了。|一块手掌大的螺旋化石。你一路把它带回去，还给它起了个名字。}

@event drovers_inn_quiet_hour
# en: The Long Table
title [944a7a] = 长桌
# en: The Drovers' Inn has one long table, one fire and one rule, which nobody can remember. Drovers, tinkers and a man with a bear on a rope share it with whoever comes in.
text [900ed7] = 赶畜人客栈只有一张长桌、一个炉火和一条规矩，而谁也记不住那条规矩是什么。赶畜人、补锅匠，还有一个牵着熊的男人，跟每个进门的人同桌。
# en: A rough low-beamed roadside inn full of drovers, tinkers and travellers at one long table, a dog asleep by the fire.
scene [d8800e] = 一家粗陋低矮的路边客栈，赶畜人、补锅匠和旅客围坐在一张长桌旁，一条狗在炉火边睡着。
# en: Sit at the long table
opt.left.label [701547] = 坐到长桌边
# en: {~You buy a round you can't afford and hear six stories, four of them true.|A tinker mends your bootlace for nothing and tells your fortune for a penny. It's mostly about weather.}
opt.left.say.1 [0dfc12] = {~你请了一轮你请不起的酒，听了六个故事，其中四个是真的。|一个补锅匠免费给你补好了鞋带，又收一便士给你算命。说的大多是天气。}
# en: Have a quiet drink by the fire
opt.right.label [ad0e80] = 在炉火边安静地喝一杯
# en: {~The dog by the fire makes room for you, grudgingly. The cider is rough and warm.|You sit by the fire and let the noise go past. Somebody starts a song nobody finishes.}
opt.right.say.1 [e15050] = {~炉火边的狗不情不愿地给你让了位置。苹果酒又糙又暖。|你坐在炉火边，任喧闹从身边流过。有人起了个头唱歌，却没人唱完。}
