# Lumenhold Academy — 简体中文 (zh-CN) translation of content/events/whisperwood/delve.grim
# Maintained by `node tools/grim.js i18n zh-CN`. Translate the text after "="; keep {tokens}.
# "# en:" shows the English source. [hash] marks the English version a line was translated from;
# lines marked STALE need updating — after fixing the text, delete the [hash] and re-run the tool.


@event ww_edge
# en: Off the Path
title [8c4f58] = 离开小路
# en: {ww_deepest == 0: The path through the Whisperwood is safe, everyone says. Off it, the wood goes down and down, and things grow there that Pell pays good money for. So do other things.|{ww_deepest >= 10: The wood knows you now. The path bends politely toward the deep places, as if to save you the trouble.|{~The path, and off it, the deep green dark you've been into before.|Fog between the trunks, and the deep wood breathing behind it.|The wood is quiet at the edge. Further in, it never is.}}} {flag(ww_stag_friend): The shadow stag will meet you halfway now.|{flag(ww_trail): You know where the bee-marked trail begins.|}}
text [b09fc1] = {ww_deepest == 0: 大家都说，穿过低语森林的小路是安全的。离开小路，林子就一路往下、往下，那里长着佩尔肯出好价钱收的东西。也长着别的东西。|{ww_deepest >= 10: 林子现在认得你了。小路客客气气地朝深处拐过去，像是要替你省点事。|{~小路，和小路之外，那片你进去过的深绿色的黑暗。|树干之间起了雾，深林在雾后面呼吸。|林子边上很安静。再往里，就从来不安静了。}}} {flag(ww_stag_friend): 影鹿现在会在半路接你。|{flag(ww_trail): 你知道刻着蜜蜂的那条小径从哪儿开始。|}}
# en: A narrow forest path at the edge of an old wood, fog between the trunks, a student looking off the path into the green dark.
scene [5779de] = 一片古老森林边缘的狭窄小路，树干间弥漫着雾气，一个学生望着小路外那片绿色的黑暗。
# en: Stay on the path
opt.left.label [58d099] = 留在小路上
# en: {~You keep to the path, where the wood only mutters.|Not today. The path is quite interesting enough.|You stay on the path. The dark between the trees watches you not go in.}
opt.left.say.1 [fbe5e9] = {~你守着小路走，林子在这里只是嘟囔几句。|今天不了。小路就已经够有意思了。|你留在小路上。树间的黑暗看着你没有进去。}
# en: Step off the path
opt.right.label [30b7a0] = 离开小路
# en: A delve: press on card by card, turn back any time.
opt.right.hint [e6594e] = 一次深入：一张张卡往里走，随时可以回头。
# en: {flag(ww_stag_friend): A shadow moves between the trunks and waits. You follow it down past the easy places, into the heartwood.|{flag(ww_trail): You find the first little carved bee on a birch, and follow the trail straight into the thicket.|{bonds_around(partner) + bonds_around(close) > 0: You step off the path, and someone you trust steps off after you.|You step off the path. The mutter of the wood drops to a whisper.}}}
opt.right.say.1 [1a1ca4] = {flag(ww_stag_friend): 一道影子在树干间移动，停下来等着。你跟着它往下，越过那些容易的地方，进入心木林。|{flag(ww_trail): 你在一棵白桦上找到第一只刻着的小蜜蜂，顺着小径一路走进了灌木林。|{bonds_around(partner) + bonds_around(close) > 0: 你离开了小路，一个你信任的人也跟着你离开了小路。|你离开了小路。林子的嘟囔声低成了耳语。}}}

@event ww_edge_night
# en: The Hush Is Awake
title [d4db23] = 寂境醒了
# en: {flag(ww_hush_seen): The wood at midnight, and deep in it the Hush, awake and listening.|Midnight in the Whisperwood. You were told the deep part keeps the castle's hours. Somewhere ahead, the forest has gone quiet in a way it never is by day.} {flag(ww_mastery): Maud's old map is in your pocket.|}
text [4af414] = {flag(ww_hush_seen): 午夜的林子，在它深处，寂境醒着，正在倾听。|午夜的低语森林。有人告诉过你，深处守的是城堡的时辰。前方某处，森林安静下来，那种安静白天从来没有过。} {flag(ww_mastery): 莫德的旧地图就在你口袋里。|}
# en: A forest at midnight under a pale moon, the trees silvered, a deep silence pooling between them like water.
scene [d00e2e] = 苍白月光下的午夜森林，树木泛着银光，深沉的寂静像水一样积在树与树之间。
# en: Not tonight
opt.left.label [4bf72b] = 今晚不了
# en: {~You stand at the edge until the cold gets in, and go no further.|You listen to the silence for a while, and keep to the path.|Not tonight. The Hush can wait; it's good at it.}
opt.left.say.1 [459f80] = {~你在林子边站到寒气渗进身子，没再往前走。|你听了一会儿寂静，然后守着小路走。|今晚不了。寂境等得起；它最擅长等。}
# en: Go down into the dark
opt.right.label [65e5f6] = 下到黑暗里去
# en: A midnight delve: the Hush lies past the heartwood.
opt.right.hint [1bd15e] = 一次午夜深入：寂境在心木林之后。
# en: {flag(ww_mastery): You follow Maud's map down by moonlight, past everything that would have stopped you once.|{flag(ww_stag_friend): The shadow stag is waiting by the path, darker than the dark. It leads you down.|You step off the path. At midnight the wood is a different wood, and it knows you came.}}
opt.right.say.1 [713e40] = {flag(ww_mastery): 你借着月光照莫德的地图往下走，越过了所有曾经会拦住你的东西。|{flag(ww_stag_friend): 影鹿在路边等着，比黑暗还要黑。它领着你往下走。|你离开了小路。午夜的林子是另一片林子，它知道你来了。}}

@event ww_night_first
# en: The Wood After Midnight
title [d80a5d] = 午夜之后的森林
# en: The Whisperwood at midnight is not the wood you know. The path is the same, pale under the moon, but past the first trees the usual mutter of leaves and small feet stops, as if someone had shut a door on it. Deep in, the silence is listening.
text [edad22] = 午夜的低语森林不是你认识的那片林子。小路还是那条，在月光下泛白，可越过最前面几棵树，平常树叶的低语和小爪子的窸窣都停了，像有人关上了一扇门。深处，寂静在聆听。
# en: The edge of a forest at midnight, the path pale under the moon, and beyond the first trees a darkness so still it looks solid.
scene [ef6983] = 午夜的林缘，小路在月光下泛白，最前面几棵树后是一片静得像实体的黑暗。
# en: Go back to bed
opt.left.label [ef6924] = 回去睡觉
# en: {~You back away from the edge, and the night noises start again behind you, all at once, as if released. You'll come back when you know what keeps those hours.|You don't go in. On the walk back the castle windows look very warm, and the silence behind you feels like something that will wait.}
opt.left.say.1 [a91565] = {~你从林缘退开，身后夜里的声响一下子全回来了，像被放了出来。等你知道是什么守着这样的时辰，再回来吧。|你没有进去。回去的路上，城堡的窗户看起来格外温暖，而身后的寂静像是会一直等下去。}
# en: Go towards the silence
opt.right.label [b7e0db] = 朝寂静走去
# en: A midnight delve: the deep wood keeps the castle's hours.
opt.right.hint [6268be] = 午夜深入：森林深处守着城堡的时辰。
# en: {~You walk until the silence presses on your ears. This is what Maud meant, or would have, if you'd asked: the deep wood keeps the castle's hours.|You follow the path to where the quiet starts. It isn't empty. It's awake.}
opt.right.say.1 [809189] = {~你一直走到寂静压得耳朵发胀。这就是莫德的意思——假如你问过她的话：森林深处守着城堡的时辰。|你沿着小路走到安静开始的地方。那里不是空的。它醒着。}

@event ww_way_home
# en: The Way Home
title [e16c4a] = 回家的路
# en: {ww_haul == 0: You come out of the trees with nothing but burrs and the feeling you were watched.|{ww_haul <= 2: You come out of the trees with a light bag: a few good mushrooms, a root Pell will want.|{ww_haul <= 4: You come out of the trees with a bag that clinks and rustles: roots, caps, a shed thing or two.|{ww_haul <= 6: You come out of the trees bent under a heavy bag. Pell will have to sit down.|You come out of the trees with more than you can carry, and carry it anyway.}}}} {ww_depth >= 8: The moon is low.|{ww_depth >= 5: Your hands still smell of heartwood.|}}
text [f2f303] = {ww_haul == 0: 你从树林里出来，除了一身苍耳，就只有被盯着看的感觉。|{ww_haul <= 2: 你从树林里出来，包里轻飘飘的：几朵好蘑菇，一截佩尔会要的根。|{ww_haul <= 4: 你从树林里出来，包里叮当作响、窸窣有声：根、菌盖，还有一两样蜕下来的东西。|{ww_haul <= 6: 你从树林里出来，被沉甸甸的包压弯了腰。佩尔得坐下来慢慢看了。|你从树林里出来，带的东西多得拿不动，可你还是拿着。}}}} {ww_depth >= 8: 月亮已经很低了。|{ww_depth >= 5: 你手上还有心木的气味。|}}
# en: A tired student coming out of a dark forest into evening light, a lumpy foraging bag over one shoulder.
scene [a8e88e] = 一个疲惫的学生背着一只鼓鼓囊囊的采集袋，从漆黑的森林走进傍晚的光里。
# en: Sell it to Pell
opt.left.label [4f6722] = 卖给佩尔
# en: Crowns, by what you carry.
opt.left.hint [0ece3c] = 克朗，按你带出来的多少算。
# en: {ww_haul == 0: Pell looks at your empty bag and offers you a biscuit, which is worse than nothing.|{~Pell weighs it all on the brass scale and pays without haggling, which means you should have asked for more.|Pell's daughters sort your bag in a minute and argue about it for ten. The crowns are fair.|Pell holds a cap up to the lamp, sniffs it, and pays you double for that one alone.}}
opt.left.say.1 [7bb95e] = {ww_haul == 0: 佩尔看了看你的空袋子，递给你一块饼干，这比什么都没有还糟。|{~佩尔把东西全放在铜秤上称了，没讨价还价就付了钱，这说明你该多要些。|佩尔的女儿们一分钟就分好了你的袋子，又为此争了十分钟。价钱很公道。|佩尔把一朵菌盖举到灯下闻了闻，单为这一朵就付了你双倍。}}
# en: Keep it for the lab
opt.right.label [bfc97e] = 留给实验室
# en: Alchemy and lore, by what you carry.
opt.right.hint [52aee6] = 炼金和学识，按你带出来的多少算。
# en: {ww_haul == 0: There's nothing to keep but the walk, and you keep that.|{~You spread it all out on a lab bench and spend the evening learning what each thing is, and what it's for, and what it does to your fingers.|You press, dry, label and brew until midnight. Half of it was worth more to Pell. The other half you'd never have understood.|You brew from the wood's own stock and the lab smells of forest for a week.}}
opt.right.say.1 [c3bd86] = {ww_haul == 0: 没什么可留的，只有这趟路，你把它留下了。|{~你把东西全摊在实验台上，花了一晚上弄清楚每样是什么、有什么用、会对你的手指做什么。|你压、晒、贴标签、熬制，一直弄到午夜。一半东西卖给佩尔会更值钱。另一半你本来永远不会明白。|你用林子自己的存货熬药，实验室里一个星期都是森林的味道。}}

@event ww_stumble
# en: Back on Your Feet
title [8218be] = 重新站起来
# en: {~You go down hard, and something spills out of your bag into the dark. When you get up, the wood is waiting to see what you do.|You come to your senses in the bracken, bruised and short of breath and short of something from your bag.|A hand, or a branch, or luck, catches you before the worst. You lose a little of what you carried getting free.} {ww_grace > 0: You've got one more fall in you, maybe.|That was your last easy fall.}
text [897110] = {~你重重摔倒，包里有东西滚进了黑暗里。等你爬起来，林子正等着看你怎么办。|你在蕨丛里回过神来，浑身淤青，喘不上气，包里也少了点什么。|一只手，或一根树枝，或是运气，在最坏的事发生前拉住了你。挣脱的时候，你丢了一点带着的东西。} {ww_grace > 0: 你或许还能再摔一次。|那是你最后一次轻轻摔倒了。}
# en: A student sitting in wet bracken in a dark forest, catching their breath, a spilled foraging bag beside them.
scene [c4a5dd] = 漆黑的森林里，一个学生坐在湿漉漉的蕨丛中喘气，身边是撒了一地的采集袋。
# en: That's enough for today
opt.left.label [3d2940] = 今天就到这儿吧
# en: {~You pick up what's left and limp back toward the light.|You decide the wood has made its point.|You turn back, and the wood lets you, this time.}
opt.left.say.1 [c96949] = {~你捡起剩下的东西，一瘸一拐地朝亮光走回去。|你认定林子已经把话说明白了。|你往回走，林子这次放过了你。}
# en: Get up and go on
opt.right.label [813dfe] = 站起来继续走
# en: Deeper: the next fall may not be kind.
opt.right.hint [cae0c4] = 更深处：下一次摔倒可能就没这么客气了。
# en: {~You brush off the leaves and go on, a little slower.|You get up. The wood seems surprised, and then interested.|You go on. Somewhere behind you, something stops following.}
opt.right.say.1 [944a56] = {~你拍掉身上的落叶，继续往前，慢了一点。|你站了起来。林子似乎很意外，然后来了兴趣。|你继续往前。身后某处，有什么东西不再跟着了。}

@event ww_lost
# en: Found at Dawn
title [ad3a7a] = 黎明时被找到
# en: {ww_hush == 1: You don't remember the rest of the night. At grey dawn a lantern bobs between the trees, and Old Maud is there with a blanket and a flask of something hot. "There you are, dearie," she says, as if you'd been late for tea.|You don't remember the rest of the day. At dusk Professor Brask finds you in the ferns, cold and scratched and missing your bag. She looks you over the way she looks over a hurt foal.}
text [16afc3] = {ww_hush == 1: 那一夜剩下的事你都不记得了。灰蒙蒙的黎明时分，一盏灯笼在树间晃动，老莫德来了，带着一条毯子和一壶热乎乎的东西。“你在这儿啊，亲爱的，”她说，好像你只是喝茶迟到了。|那一天剩下的事你都不记得了。黄昏时，布拉斯克教授在蕨丛里找到了你，冻得发抖，浑身划伤，袋子也没了。她打量你的样子，就像在打量一匹受伤的小马。}
# en: A grey dawn in a forest, an old woman with a lantern helping a muddy, shivering student to their feet.
scene [c7b5e3] = 灰蒙蒙的黎明，森林里，一位提着灯笼的老妇人扶起一个浑身泥泞、瑟瑟发抖的学生。
# en: Thank her and go quietly
opt.left.label [0b09fa] = 谢过她，安静地走
# en: {ww_hush == 1: Maud walks you back to her cottage and doesn't ask a single question, which is worse than a lecture.|Brask walks you to the stables in silence. At the door she says, "The wood doesn't hate you. It just doesn't notice you yet." It's the kindest thing she's ever said.}
opt.left.say.1 [48ed6f] = {ww_hush == 1: 莫德把你送回她的小屋，一个问题也没问，这比训一顿还难受。|布拉斯克一言不发地把你送到马厩。到了门口，她说：“林子不恨你。它只是还没注意到你。”这是她说过的最温柔的话。}
# en: Ask how she knew to look
opt.right.label [9b048f] = 问她怎么知道来找
# en: {ww_hush == 1: "The bees were cross," says Maud. "They're always cross when someone's lost." She doesn't seem to be joking.|"The owls were talking about you," says Brask. "Unflatteringly." She doesn't seem to be joking.}
opt.right.say.1 [41d9f4] = {ww_hush == 1: “蜜蜂不高兴了，”莫德说。“有人迷路的时候它们总是不高兴。”她看起来不像在开玩笑。|“猫头鹰在议论你，”布拉斯克说。“说得不太好听。”她看起来不像在开玩笑。}

@thread ww_delve
# en: The Whisperwood
name [0cc2ff] = 低语森林
# en: The wood past the village goes deeper every time you go in.
premise [a4c847] = 村子那头的林子，你每进去一次，它就更深一些。
# en: You followed little carved bees a mile into the Whisperwood. You know whose bees they are.
journal.1 [55275b] = 你跟着树上刻的小蜜蜂走进低语森林一英里深。你知道那是谁的蜜蜂。
# en: You bowed in the bracken beside Professor Brask. Now the wood knows your face.
journal.2 [bf7703] = 你在蕨丛里陪布拉斯克教授一起鞠了躬。现在林子认得你的脸了。
# en: Ember's kin decided you'd do. A small smouldering tail walks with you off the path now.
journal.3 [30ca5e] = 余烬的族人认定你还行。现在你离开小路时，总有一条冒烟的小尾巴陪着你。
# en: The Shadow Stag lowered its great head to you.
journal.4 [c274ce] = 影鹿向你低下了它巨大的头。
# en: You asked the Elder Oak for its heartwood.
journal.5 [0427c0] = 你向古橡讨了一块心木。
# en: Deep in the wood there's a clearing where it's always midnight, its moonpetal waiting.
journal.6 [091611] = 林子深处有一片永远是午夜的空地，那里的月瓣花在等待。
# en: At midnight the silence opened, and you saw the Hush.
journal.7 [f8b4e9] = 午夜时分，寂静开启，你看见了寂境。
# en: You fought the Spinner, queen of the Hush, and won.
journal.8 [f45d1a] = 你与寂境的女王织网者交了手，并且赢了。
# en: You faced Absalom Vrell by his lantern, and walked away.
journal.9 [ce3db1] = 你在灯笼旁面对了阿布萨隆·弗雷尔，然后走了出来。
# en: You reached the heart of the Hush. The wood is yours, as much as a wood is ever anyone's.
journal.10 [19a6ee] = 你走到了寂境的中心。这片林子是你的了，就像林子能属于任何人的那种程度。

@event ww1_forage
# en: The Mushroom Ring
title [7d1f98] = 蘑菇圈
# en: {season == "autumn": A fairy ring in full flush, caps as big as saucers, more than you could carry.|A ring of pale caps in the moss, and among them the frilled ones Pell pays for.} Never step inside a ring, Maud says. She never says why.
text [6c7987] = {season == "autumn": 一圈仙女环正冒得旺，菌盖大得像碟子，多得你拿不完。|苔藓里一圈苍白的菌盖，中间夹着佩尔肯花钱收的那种带褶边的。} 莫德说，永远别踏进圈里去。她从没说为什么。
# en: A perfect ring of pale mushrooms in a mossy forest clearing, a student kneeling with a knife and a basket.
scene [923abf] = 长满苔藓的林间空地上，一圈完美的苍白蘑菇，一个学生拿着小刀和篮子跪在旁边。
# en: Leave it and turn back
opt.left.label [d1faaa] = 不动它，往回走
# en: {~You leave the ring to whoever made it and head back to the path.|You count the caps, don't take any, and go home feeling oddly polite.}
opt.left.say.1 [17baa8] = {~你把这个圈留给造出它的人，回到小路上去了。|你数了数菌盖，一朵没拿，回家的路上莫名觉得自己很有礼貌。}
# en: Fill your bag from outside
opt.right.label [ca3148] = 从圈外装满袋子
# en: {~You pick from the outside, kneeling in cold moss. Your knees are soaked and your bag is heavier.|You reach in for the best cap without stepping in. Something in the ring sighs. You move on, briskly.}
opt.right.say.1 [0871b0] = {~你跪在冰冷的苔藓上从圈外采。膝盖湿透了，袋子沉了。|你没踏进去，伸手够到了最好的那朵。圈里有什么叹了口气。你赶紧走了。}

@event ww1_bramble_ferret
# en: Something in Your Bag
title [31c243] = 包里有东西
# en: A bramble ferret has got into your bag, and is eating {ww_haul > 0: your best find|your lunch}. It's all bristles and bad temper, and it fights like a pin cushion that has opinions.
text [135671] = 一只荆棘雪貂钻进了你的包里，正在吃{ww_haul > 0: 你最好的收获|你的午饭}。它浑身是刺、脾气很坏，打起架来像一个有主见的针插。
# en: A small bristly ferret with brambles tangled in its fur, half inside a student's foraging bag, glaring out.
scene [a477e5] = 一只毛里缠着荆棘的小雪貂，半个身子钻在学生的采集袋里，正怒目而视。
# en: Let it have it; turn back
opt.left.label [af6fcb] = 让给它；往回走
# en: {~You tip the bag out and let it keep what it wanted. You go home lighter and wiser.|You leave it to its meal and walk back, picking bristles out of your sleeve.}
opt.left.say.1 [4620ff] = {~你把袋子倒空，让它留下它想要的。你回家时轻了些，也聪明了些。|你让它吃它的，一边往回走一边从袖子上拔刺。}
# en: Fight it for the bag
opt.right.label [f29a2c] = 跟它抢袋子
# en: {~It bolts, dropping what it stole and something shiny it stole earlier. You take both.|It gives up with a furious chitter and leaves behind its own hoard of nuts and one silver button.}
opt.right.say.1 [84dcdb] = {~它逃了，丢下了偷走的东西，还有一样它早先偷来的亮闪闪的东西。你两样都拿了。|它气急败坏地吱吱叫着放弃了，留下了它自己藏的一堆坚果和一枚银纽扣。}
# en: {~It nips, dodges, nips, and is gone with your bag's best corner. You're bleeding from places you didn't know could.|You never land a thing on it. It leaves you in the bracken, panting and full of small holes.}
opt.right.say.2 [44d3c3] = {~它咬一口、躲一下、再咬一口，叼着你袋子里最好的那一角跑了。你身上流血的地方，你都不知道还能流血。|你一下都没打着它。它把你丢在蕨丛里，气喘吁吁，浑身都是小窟窿。}
# en: Bribe it with honey
opt.up.label [272ad1] = 用蜂蜜贿赂它
# en: {~You open Maud's honey tin and hold out a fingerful. The ferret forgets the bag entirely, eats the honey, and follows you a mile, hoping.|One sniff of the silver-bee honey and the ferret is your friend for life, or at least until the honey runs out.}
opt.up.say.1 [0a99fc] = {~你打开莫德的蜂蜜罐，伸出一指头蜂蜜。雪貂把袋子忘得一干二净，吃完蜂蜜，满怀希望地跟了你一英里。|闻了一下银蜂蜜，雪貂就成了你一辈子的朋友，至少在蜂蜜吃完之前是这样。}

@event ww1_bristleback
# en: The Bristleback
title [2f4350] = 刚鬃熊
# en: A bristleback rears up out of the blackberries: a bear with a ridge of quills down its spine and a voice like a cellar door. It isn't hungry. It's offended. It swings slowly, and you can see each blow coming a long way off.
text [1d3a3a] = 一头刚鬃熊从黑莓丛里人立起来：一头脊背上长着一排硬刺的熊，嗓音像地窖门。它不饿。它是被冒犯了。它挥掌很慢，每一击你都能老远看见它过来。
# en: A huge shaggy bear-like creature with a ridge of bristles along its back rising on its hind legs in a forest clearing.
scene [7a96d7] = 林间空地上，一头背上长着一排硬鬃的巨大毛熊用后腿站了起来。
# en: Back away slowly
opt.left.label [b7e862] = 慢慢退开
# en: {~You back away the way Brask taught you: slowly, eyes down, apologising. It lets you go and goes back to its berries.|You leave the clearing to the bristleback, who seems to think that's the least you could do.}
opt.left.say.1 [1f60cd] = {~你按布拉斯克教的那样往后退：慢慢地，低着眼，一边道歉。它放你走了，回去吃它的莓子。|你把空地让给了刚鬃熊，它似乎觉得这是你起码该做的。}
# en: Stand your ground
opt.right.label [3881f5] = 寸步不让
# en: It telegraphs its blows: brace on the swing.
opt.right.hint [e750b5] = 它出手前有预兆：在它挥掌时坚守。
# en: {~It decides you're not worth the trouble and lumbers off with great dignity. Word gets round the foragers that you saw off a bristleback.|You weather three swings and land enough to make it think again. It goes, grumbling, and you go on, shaking.}
opt.right.say.1 [0e1724] = {~它认定你不值得费事，非常有尊严地慢吞吞走开了。采集者们都传开了，说你吓退了一头刚鬃熊。|你扛住了三掌，又打中了几下，让它重新考虑了一番。它嘟囔着走了，你也继续往前，腿还在抖。}
# en: {~You see the swing coming the whole way and still don't move fast enough.|It knocks you into the blackberries, which is somehow the worst part.}
opt.right.say.2 [1ff345] = {~那一掌你从头看到尾，还是没躲开。|它把你拍进了黑莓丛，不知怎么的这才是最糟的部分。}
# en: Wave fire at it
opt.up.label [943f52] = 冲它挥火
# en: {~One flare of flame and the bristleback remembers an appointment elsewhere.|You light the air between you. It snorts at the smoke, deeply offended, and leaves.}
opt.up.say.1 [e291c6] = {~火光一闪，刚鬃熊就想起来它在别处还有约。|你在你们之间点燃了空气。它冲着烟喷了口鼻息，深感被冒犯，走了。}

@event ww1_bog
# en: The Sucking Bog
title [63cbf2] = 吸人的沼泽
# en: The moss looks solid until you're on it. Then you're knee-deep in black water that pulls, gently and with great patience, like a grandmother who wants you to stay for supper.
text [95dc55] = 苔藓看起来很结实，直到你踩上去。然后你就站在没膝的黑水里了，那水在往下拉，轻轻地，极有耐心，像一个想留你吃晚饭的老奶奶。
# en: A student knee-deep in black bog water among reeds, reaching for a low branch, frogs watching from a log.
scene [82b9ad] = 芦苇丛中，一个学生站在没膝的黑色沼泽水里，伸手去够一根低垂的树枝，青蛙们在一根木头上看着。
# en: Haul yourself back out
opt.left.label [c1e40b] = 把自己拖出来
# en: {~You haul yourself back the way you came, losing a boot and gaining a smell.|You get out backwards and go home with the bog all the way up to your knees.}
opt.left.say.1 [77e3c0] = {~你沿着来路把自己拖了出来，丢了一只靴子，得了一身味儿。|你倒退着出来，带着一直到膝盖的沼泽回了家。}
# en: Wade on across
opt.right.label [46fe8c] = 蹚过去
# en: {~You wade, haul, wade and come out the far side, black to the thighs and still going.|You find the tussocks under the water by feel, and cross like a heron. A muddy heron.}
opt.right.say.1 [e27463] = {~你蹚着、拽着、蹚着，从对岸出来了，大腿以下全黑了，可还在往前走。|你摸索着找到水下的草墩，像一只苍鹭一样走了过去。一只满身泥的苍鹭。}
# en: {~The bog takes you to the waist, then to the chest. You get out, eventually, much colder and much humbler.|You lose your footing and go under. You come up spitting moss.}
opt.right.say.2 [2206fc] = {~沼泽没到了你的腰，然后是胸口。你最后还是出来了，冷多了，也谦卑多了。|你脚下一滑，沉了下去。浮上来的时候嘴里全是苔藓。}
# en: Skim across
opt.up.label [1dd5b6] = 掠过去
# en: {~A gust under your feet and you skim the bog like a skipped stone. The frogs are very impressed.|You call a wind and run on it. Your boots barely get damp.}
opt.up.say.1 [c3d407] = {~脚下一阵风，你像打水漂的石子一样掠过沼泽。青蛙们非常佩服。|你唤来一阵风，踩着它跑了过去。靴子几乎没湿。}

@event ww1_pixie_toll
# en: The Toll Stone
title [95852c] = 收费石
# en: Three pixies sit on a mossy stone across the path. "Toll," says the smallest. "Toll," agrees the middle one. The third is eating a beetle and nods. Nobody has ever established what the toll is, only that it isn't what you offer.
text [d835c1] = 三只小精灵坐在横在路上的一块长满苔藓的石头上。“过路费，”最小的那只说。“过路费，”中间那只附和。第三只在吃一只甲虫，点了点头。从来没人弄清楚过路费到底是什么，只知道不是你给的那样东西。
# en: Several tiny winged pixies perched on a mossy stone across a forest path, one holding out a tiny hand for payment.
scene [bdc654] = 几只长着翅膀的小精灵蹲在森林小路上一块长满苔藓的石头上，其中一只伸出小手要钱。
# en: Turn round
opt.left.label [ee8dd6] = 掉头
# en: {~You turn back. The pixies jeer, delighted, in tiny voices.|You don't have time to be fleeced by beetles' cousins. You go home.}
opt.left.say.1 [756f15] = {~你往回走。小精灵们用尖细的声音开心地起哄。|你没工夫被甲虫的表亲敲竹杠。你回家了。}
# en: Haggle your way past
opt.right.label [fd8b47] = 讨价还价地过去
# en: {~You argue them down to a compliment and a button, and they're so pleased they throw in a dropped cap from the ring.|You convince them that you are the toll, coming the other way. They pay you, confused, and wave you on.}
opt.right.say.1 [2cee55] = {~你把价砍到了一句恭维和一枚纽扣，它们高兴得还送了你一朵从蘑菇圈里掉下来的菌盖。|你说服它们，你就是过路费，只不过是从另一头来的。它们糊里糊涂地付了你钱，挥手让你过去。}
# en: {~They take your offer, your next offer, and your bootlaces. Then they trip you anyway, on principle.|They don't care for your terms. They express this with pinecones, at speed.}
opt.right.say.2 [55d564] = {~它们收下了你的出价，你的下一个出价，还有你的鞋带。然后照样绊了你一跤，出于原则。|它们不喜欢你的条件。它们用松果表达了这一点，速度很快。}
# en: Pay in fairy gold
opt.up.label [d2e9cd] = 用仙子金付账
# en: {~You pay in coins that will be leaves by morning. They bite them, nod, and let you by. You feel a little guilty, and a little proud.|You glamour a pebble into a crown. The smallest pixie looks at you for a long moment, then pockets it. Professional courtesy.}
opt.up.say.1 [a73345] = {~你付的硬币到早上就会变成树叶。它们咬了咬，点点头，让你过去了。你有点内疚，也有点得意。|你把一颗小石子幻化成一枚克朗。最小的那只盯着你看了很久，然后把它揣进了兜里。同行之间的礼貌。}

@event ww1_lost_firstyear
# en: A First-Year in the Ferns
title [5abce6] = 蕨丛里的一年级生
# en: A first-year is sitting in the ferns, holding a library book on edible fungi and trying very hard not to cry. They've been lost for an hour. They have eaten nothing from the book, which is the first sensible thing they've done.
text [7e631b] = 一个一年级生坐在蕨丛里，抱着一本讲可食用菌类的图书馆藏书，拼命忍着不哭。他们已经迷路一个小时了。书里的东西他们一样都没吃，这是他们做过的第一件明智的事。
# en: A small tearful first-year student sitting in tall ferns in a forest, clutching a library book, looking up hopefully.
scene [16edb4] = 森林高高的蕨丛里坐着一个哭鼻子的小个子一年级生，抱着一本图书馆的书，满怀希望地抬头看。
# en: Walk them back out
opt.left.label [9e6c31] = 把他们送出去
# en: {~You walk them all the way back to the path and point them at the castle. They thank you four times. Your delve is over, and you don't mind much.|You take them home. They ask forty questions on the way, and you answer most of them honestly.}
opt.left.say.1 [fb8d90] = {~你一路把他们送回小路，指给他们城堡的方向。他们谢了你四次。你的深入结束了，你也不怎么在意。|你把他们送回了家。一路上他们问了四十个问题，你大多老老实实地回答了。}
# en: Point the way and press on
opt.right.label [b51fac] = 指了路，继续往前
# en: {~You point them back toward the path and go on. You look back once. They're walking the right way. Probably.|You draw them a map on the flyleaf of the library book and go on. It's a good map. You keep thinking about it anyway.}
opt.right.say.1 [1f4ab3] = {~你给他们指了回小路的方向，自己继续往前。你回头看了一眼。他们走的方向是对的。大概吧。|你在那本图书馆藏书的扉页上给他们画了张地图，然后继续往前。是张好地图。可你还是一直惦记着。}

@event ww1_hollow_whisper
# en: The Riddling Hollow
title [0752a8] = 出谜语的树洞
# en: A hollow oak whispers as you pass. It's asking a riddle, the same one over and over, and it sounds as if it has been waiting a long time for anyone to try. The answer is not "a tree". You can tell that from the tone.
text [693f71] = 你经过时，一棵空心橡树在低语。它在出一个谜语，一遍又一遍，听起来像是等了很久，等有人来试一试。答案不是“一棵树”。从语气你就听得出来。
# en: A hollow in an ancient oak trunk with a faint glow inside, a student leaning close to listen.
scene [50af6a] = 一棵古老橡树的树干上有个树洞，里面透着微光，一个学生凑近了在听。
# en: Leave it riddling; turn back
opt.left.label [11b91d] = 让它接着出谜；往回走
# en: {~You leave the riddle unanswered. It follows you all the way to the path.|You go home. Halfway there you think of the answer, and it's too late, and it's probably wrong.}
opt.left.say.1 [f090db] = {~你没回答那个谜语。它一路跟着你到了小路上。|你回家了。走到一半你想出了答案，可已经太迟了，而且多半是错的。}
# en: Try an answer
opt.right.label [6d4af1] = 试着回答
# en: {~You answer, and argue the point when it quibbles. The oak goes quiet, then tells you something about the wood that you'll understand in a fortnight.|"Close enough," it sighs, and opens a path you hadn't seen.}
opt.right.say.1 [0e4d7c] = {~你回答了，它挑刺时你还跟它争了几句。橡树安静下来，然后告诉了你一件关于林子的事，你要过两个星期才会明白。|“差不多吧，”它叹了口气，打开了一条你没见过的路。}
# en: {~Wrong, says the oak, and the path rearranges itself so that you walk into a ditch.|It laughs, a terrible creaking laugh, and you find you've been walking in circles for an hour.}
opt.right.say.2 [adadeb] = {~错了，橡树说，小路重新排列了一番，让你一脚踩进了沟里。|它笑了，一种可怕的嘎吱嘎吱的笑，你发现自己已经绕着圈走了一个小时。}

@event ww1_quiet_path
# en: The Path Runs On
title [e98ce8] = 小路一直延伸
# en: {~A deer path, winding and quiet, with the castle bells faint behind you.|Birdsong, and moss, and nothing at all trying to eat you.|A stream to cross on stepping stones, and wild garlic along the bank.} For a while the wood is only a wood.
text [023f9b] = {~一条鹿径，蜿蜒而安静，城堡的钟声在身后隐约可闻。|鸟鸣，苔藓，而且没有任何东西想吃掉你。|一条要踩着垫脚石过的小溪，岸边长着野蒜。} 有一阵子，林子就只是一片林子。
# en: A deer path winding between moss-covered trees, dappled light, a student walking alone with a foraging bag.
scene [67b091] = 长满苔藓的树木之间蜿蜒着一条鹿径，光影斑驳，一个学生背着采集袋独自走着。
# en: Turn back while it's easy
opt.left.label [d572f3] = 趁还轻松往回走
# en: {~You turn round while the going is good, and are home before the light changes.|You take the quiet as a hint and head back.|You turn back at the stream, with dry feet and a clear head.}
opt.left.say.1 [bb3195] = {~你趁着好走往回走，天色还没变就到家了。|你把这份安静当作暗示，往回走了。|你在小溪边回头，脚是干的，脑子是清醒的。}
# en: Go on
opt.right.label [8d20dc] = 继续走
# en: {~You walk on, deeper, and the birdsong thins.|You go on, deeper, and the wood stops being only a wood.|You go on. The bells behind you stop being audible somewhere around the stream.}
opt.right.say.1 [722261] = {~你继续往深处走，鸟鸣渐渐稀了。|你继续往深处走，林子不再只是一片林子了。|你继续走。身后的钟声在小溪附近的某个地方听不见了。}

@event ww1_maud_blaze
# en: The Little Carved Bees
title [23be92] = 刻着的小蜜蜂
# en: On a birch, at knee height, someone has carved a tiny bee. There's another a few trees on, and another. They're old, smoothed by sixty years of bark growing round them, and they lead somewhere on purpose.
text [a3f8bb] = 一棵白桦上，齐膝高的地方，有人刻了一只小蜜蜂。往前几棵树又有一只，再往前又有一只。它们很老了，六十年来树皮绕着它们生长，已经被磨得很光滑，而且它们是有意指向某个地方的。
# en: A tiny bee carved into the bark of a birch tree, worn smooth by decades, a student tracing it with a finger.
scene [524459] = 一棵白桦的树皮上刻着一只小蜜蜂，几十年下来已被磨平，一个学生用手指描着它。
# en: Note it and turn back
opt.left.label [cebf5d] = 记下来，往回走
# en: {~You remember the birch and go home. The bees will still be there.|You touch the first bee for luck and head back.}
opt.left.say.1 [f246a0] = {~你记住了那棵白桦，回家了。蜜蜂们还会在那儿的。|你摸了摸第一只蜜蜂图个吉利，往回走了。}
# en: Follow the bees
opt.right.label [924160] = 跟着蜜蜂走
# en: {~Bee to bee, a mile in, the trail drops straight past the fringe to the thicket's edge. Next time you can start here. You know exactly whose bees these are.|You lose the trail twice and find it twice. By the end you could walk it blind.}
opt.right.say.1 [2d3a6a] = {~一只蜜蜂接一只蜜蜂，走进去一英里，小径径直越过林缘，下到灌木林的边上。下次你可以从这里出发。你很清楚这些是谁的蜜蜂。|你两次跟丢了小径，又两次找了回来。到最后你闭着眼都能走。}
# en: {~You lose the bees in a hollow full of brambles and spend an hour getting out.|The trail runs out at a fallen tree. Climbing round it, you fall in a ditch.}
opt.right.say.2 [f25551] = {~你在一个长满荆棘的坑里跟丢了蜜蜂，花了一个小时才出来。|小径在一棵倒下的树那儿断了。你绕过去的时候掉进了沟里。}

@event ww1_owl_feather
# en: The Barn Owl's Tree
title [be0cab] = 仓鸮的树
# en: High in a dead oak, a single barn-owl feather is caught on a twig, white as paper and long as your hand. Grimsby once told you an owl's flight feather makes the best quill there is. He didn't say anything about the climb.
text [bb1cb1] = 一棵枯死的橡树高处，一根仓鸮羽毛挂在细枝上，白得像纸，长得像你的手。格林斯比有一次告诉你，猫头鹰的飞羽能做成最好的羽毛笔。他可没说要爬上去。
# en: A tall dead oak with a single white barn-owl feather caught on a high branch, a student looking up at it.
scene [10c759] = 一棵高大的枯橡树，高处的树枝上挂着一根白色的仓鸮羽毛，一个学生仰头看着它。
# en: Leave it to the wind; turn back
opt.left.label [6ac3a4] = 留给风吧；往回走
# en: {~You leave the feather where it is. When you look back, it's gone.|It's a long way up and a long way home. You choose home.}
opt.left.say.1 [d66f23] = {~你把羽毛留在原处。你回头看时，它已经不见了。|往上很远，回家也很远。你选了回家。}
# en: Climb for it
opt.right.label [5d1352] = 爬上去拿
# en: {~You climb, reach, nearly fall, reach again. You come down with the feather and a fine view of the castle. Cut to a nib, it will make a quill worth having.|The branch breaks just as your fingers close. You land in leaves, feather intact.}
opt.right.say.1 [ae3477] = {~你爬，伸手，差点掉下去，再伸手。你拿着羽毛下来了，还顺带看到了城堡的好风景。削成笔尖，它会是一支值得拥有的羽毛笔。|你的手指刚握住，树枝就断了。你落在落叶堆里，羽毛完好无损。}
# en: {~The dead wood gives under your boot halfway up. You come down a good deal faster than you went up.|You get high enough to see the feather is just out of reach. Then the branch has opinions.}
opt.right.say.2 [237e38] = {~爬到一半，枯木在你靴子底下塌了。你下来的速度比上去快得多。|你爬到了能看见羽毛刚好够不着的高度。然后树枝有了自己的想法。}

@event ww1_brask_bows
# en: Brask in the Bracken
title [c03604] = 蕨丛里的布拉斯克
# en: Professor Brask is standing in the bracken, bowing deeply to nothing you can see. "Don't stare," she says without straightening. "Bow. It's watching you." You can't see what it is. You're fairly sure that's the point.
text [61a48a] = 布拉斯克教授站在蕨丛里，正向一个你看不见的东西深深鞠躬。“别盯着看，”她没直起身就说。“鞠躬。它在看着你。”你看不见那是什么。你很确定，这正是关键所在。
# en: A sturdy older professor in a riding coat bowing low to something unseen in tall bracken, in a misty forest.
scene [51bfe0] = 雾气弥漫的森林里，一位穿骑装的结实的年长教授在高高的蕨丛中向某个看不见的东西深深鞠躬。
# en: Back away and go home
opt.left.label [ed269c] = 退开，回家
# en: {~You back away. Brask doesn't watch you go, but the bracken does.|You retreat to the path. Next lesson, Brask gives you a look that says she noticed.}
opt.left.say.1 [c9b9ac] = {~你往后退。布拉斯克没有看你走，可蕨丛在看。|你退回了小路。下一堂课上，布拉斯克看你的眼神说明她注意到了。}
# en: Bow with her
opt.right.label [e0a866] = 跟她一起鞠躬
# en: {~You bow, low, and hold it until Brask straightens. Something in the bracken moves away, satisfied. "Good," says Brask. "Do that to everything down there. Most of it's older than manners."|You bow. Brask nods once. "Now the wood knows your face," she says, and walks off, which is apparently the lesson.}
opt.right.say.1 [76212f] = {~你深深鞠躬，一直保持到布拉斯克直起身。蕨丛里有什么东西心满意足地走开了。“很好，”布拉斯克说。“对那底下的每样东西都这么做。它们大多比礼节还老。”|你鞠了躬。布拉斯克点了一下头。“现在林子认得你的脸了，”她说完就走了，看来这就是这一课。}

@event ww2_grumpy_oak
# en: The Oak You Kicked
title [4ae4e1] = 被你踢了的橡树
# en: You stub your toe on a root, and say something about it. The root's oak takes this badly. It has a face in its bark now, and the face is scowling, and the path ahead is suddenly a great deal of oak.
text [f62f48] = 你在一条树根上踢到了脚趾，还骂了一句。那条树根的橡树很不高兴。它的树皮上现在有了一张脸，脸上满是怒容，而前面的路忽然变成了一大片橡树。
# en: A gnarled oak with a scowling face in its bark leaning over a forest path, a student holding a stubbed foot.
scene [98aa1f] = 一棵树皮上长着怒容的盘曲橡树俯在森林小路上方，一个学生捂着踢痛的脚。
# en: Retreat with dignity
opt.left.label [d3ae4a] = 体面地撤退
# en: {~You back away, apologising to the general direction of the oak, and limp home.|You decide the oak has won this one and turn back.}
opt.left.say.1 [e009a3] = {~你一边往后退，一边朝橡树的大致方向道歉，一瘸一拐地回家了。|你认定这一回合橡树赢了，往回走了。}
# en: Apologise properly
opt.right.label [8c7789] = 好好道歉
# en: {~You apologise to the oak at length, with references. It harrumphs, drops you an acorn the size of a fist as a mark of favour, and lets you by.|Your apology is so formal that the oak is moved. It lifts its root for you, and a hoard of truffles under it.}
opt.right.say.1 [ef3e7b] = {~你向橡树长篇大论地道歉，还引经据典。它哼了一声，丢给你一颗拳头大的橡果以示恩宠，让你过去了。|你的道歉如此正式，橡树被打动了。它为你抬起树根，底下藏着一窝松露。}
# en: {~The apology goes badly. It turns out you also stood on its cousin.|The oak hears you out and then creaks something that is very clearly "no".}
opt.right.say.2 [37ea04] = {~道歉搞砸了。原来你还踩了它的表亲。|橡树听你说完，然后嘎吱出一个非常清楚的“不”。}
# en: Show the heartwood
opt.up.label [fefd62] = 亮出心木
# en: {~You hold up the heartwood wand. The oak's scowl softens into something almost grandfatherly, and it lifts a root to let you by.|The oak sees the heartwood and goes quiet. Then it bows, creaking, and steps aside.}
opt.up.say.1 [3b3c4e] = {~你举起心木魔杖。橡树的怒容柔和下来，几乎像个慈祥的老祖父，抬起一条树根让你过去。|橡树看见心木，安静了下来。然后它嘎吱嘎吱地鞠了一躬，让到一边。}

@event ww2_grumpy_oak_fight
# en: The Oak Swings
title [46a2f8] = 橡树抡枝
# en: The oak's roots come up out of the path and close round your ankles, and a bough the size of a boat lifts overhead. Oaks are slow. This one has been practising.
text [50d812] = 橡树的根从小路下钻出来，缠住了你的脚踝，一根船那么大的树枝在头顶举了起来。橡树很慢。这一棵一直在练。
# en: An angry oak tree swinging a great bough down at a student, roots erupting from the ground around their feet.
scene [1eaf94] = 一棵愤怒的橡树朝一个学生抡下一根巨大的树枝，树根从学生脚边的地里钻出来。
# en: Tear free and run
opt.left.label [c81721] = 挣脱，快跑
# en: {~You leave a boot in the roots and run. The oak keeps the boot.|You wrench free and run, shedding half your bag. The oak looks satisfied.}
opt.left.say.1 [a884c0] = {~你把一只靴子留在树根里，跑了。橡树留下了靴子。|你用力挣脱，跑了，包里的东西撒了一半。橡树看起来很满意。}
# en: Fight it
opt.right.label [533b96] = 跟它打
# en: It roots you, then swings: guard early.
opt.right.hint [206cda] = 它先缠住你，再抡枝：早点防御。
# en: {~You burn, hack and dodge until the oak decides it's had enough exercise for one century, and goes back to scowling at nothing.|The bough comes down where you were. The oak stops, as if surprised that you're still here, and lets you go on.}
opt.right.say.1 [1493ef] = {~你烧、砍、躲，直到橡树认定这个世纪的运动量已经够了，又回去冲着空气生闷气。|树枝砸在你刚才站的地方。橡树停了下来，好像很惊讶你还在，然后让你继续走了。}
# en: {~The roots hold, the bough falls, and the oak goes back to being a tree, slightly smug.|You never get your feet free. The bough finds you twice.}
opt.right.say.2 [6f950c] = {~树根缠住了，树枝落下了，橡树又变回了一棵树，有点得意。|你始终没能把脚挣出来。树枝两次找到了你。}

@event ww2_briar_maze
# en: The Thorn Maze
title [2df3dc] = 荆棘迷宫
# en: The briars here have grown into walls taller than you, with corridors between them that turn and fork and double back. Somebody planted this, a long time ago, on purpose, and they weren't fond of visitors.
text [4893d8] = 这里的荆棘长成了比你还高的墙，墙间的通道拐来拐去、分岔又折回。很久以前，有人故意种下了它们，而且那人不怎么欢迎访客。
# en: A maze of tall thorny briars in a dim forest, narrow green corridors branching off in every direction.
scene [396c12] = 昏暗的森林里，一座由高大的带刺荆棘组成的迷宫，狭窄的绿色通道向四面八方分岔。
# en: Back out the way you came
opt.left.label [02e531] = 原路退出
# en: {~You retrace your steps while you still can, and lose only your sleeve.|You find the way out, and decide that's an achievement in itself.}
opt.left.say.1 [26e59b] = {~你趁还来得及原路退回，只丢了一只袖子。|你找到了出口，认定这本身就是一项成就。}
# en: Find the way through
opt.right.label [51285b] = 找路穿过去
# en: {~Left at every fork, then right at the one with the dead rose: the old gardener's rule, and now you know it. You come out the far side scratched but triumphant.|You notice that the moss grows on the side the old gardener wanted you to see, and follow it through.}
opt.right.say.1 [addd95] = {~每个岔口都往左，到长着一朵枯玫瑰的那个岔口往右：这是老园丁的规矩，现在你也知道了。你从另一头出来，满身划痕，但大获全胜。|你注意到苔藓长在老园丁想让你看见的那一面，顺着它走了出去。}
# en: {~The corridors turn back on themselves until you're dizzy. You come out bleeding from a hundred tiny cuts.|You take a wrong turn into a dead end so full of thorns it has its own weather.}
opt.right.say.2 [114cd8] = {~通道绕来绕去，绕得你头晕。你出来的时候身上有上百道小口子在流血。|你拐错了弯，走进一个满是荆棘的死胡同，那里刺多得自成一种天气。}
# en: Follow the lodestone
opt.up.label [7f0f70] = 跟着磁石走
# en: {~The lodestone turns, steady and patient, and you follow it through every fork without a scratch.|You let the pendant lead. It knows north, and north is through.}
opt.up.say.1 [9f23d2] = {~磁石转动着，稳定而耐心，你跟着它穿过每一个岔口，一道划痕都没有。|你让吊坠带路。它认得北方，而北方就是出口。}

@event ww2_stag_beetle
# en: The Stag Beetle
title [586e32] = 锹形甲虫
# en: A stag beetle the size of a pony is guarding a fallen log. Its jaws are as long as your arm and its shell would turn a sword. It lowers its head and starts to back up, which, you realise, is a run-up.
text [8c05cc] = 一只小马那么大的锹形甲虫守着一根倒木。它的颚有你的胳膊那么长，它的壳能把剑弹开。它低下头，开始往后退，你意识到，这是在助跑。
# en: An enormous armoured stag beetle the size of a pony lowering its antler-like jaws in a forest clearing.
scene [1baddd] = 林间空地上，一只小马大小、披着铠甲的巨型锹形甲虫压低了鹿角般的大颚。
# en: Leave it the log; turn back
opt.left.label [30465f] = 把木头让给它；往回走
# en: {~You leave the beetle its log. It watches you all the way out of the clearing, revving.|You go home. Some fights aren't yours, and that one was very much the beetle's.}
opt.left.say.1 [bc1ffd] = {~你把木头让给了甲虫。它一路盯着你走出空地，一边还在蓄劲。|你回家了。有些仗不是你的，那一仗完完全全是甲虫的。}
# en: Take it on
opt.right.label [69ccb8] = 迎战
# en: It charges in two beats: step aside on the second.
opt.right.hint [bda719] = 它分两拍冲锋：第二拍时闪开。
# en: {~It charges, misses, charges, misses, and gives up in disgust, shedding a wing-case like polished jet. Pell will weep.|You catch it mid-charge. It retreats under its log, leaving a wing-case and some dignity behind.}
opt.right.say.1 [1a5750] = {~它冲，扑空，再冲，再扑空，然后厌烦地放弃了，蜕下一片像抛光黑玉一样的鞘翅。佩尔会感动得落泪。|你在它冲到一半时截住了它。它退回了倒木底下，留下一片鞘翅和一点尊严。}
# en: {~The second charge catches you square. You fly further than you ever have on a broom.|It charges. You dodge the wrong way. You see a great many leaves, very fast.}
opt.right.say.2 [6f472a] = {~第二次冲锋正中了你。你飞出去的距离比你骑扫帚飞过的都远。|它冲过来。你躲错了方向。你极快地看到了非常多的树叶。}
# en: Step out of its way
opt.up.label [54f1ed] = 闪开它的路
# en: {~You step sideways into shadow just as it charges. It thunders past into a tree and stays there, thinking about it.|You blink out of its path and it charges straight through where you were. You leave while it's still confused.}
opt.up.say.1 [32b4e6] = {~就在它冲过来的一刻，你侧身踏进了影子里。它轰隆隆地冲过去撞上一棵树，就那么待在那儿，若有所思。|你一眨眼从它的路线上消失，它径直冲过你刚才站的地方。你趁它还糊涂着离开了。}

@event ww2_fog_wall
# en: The Fog Wall
title [7e9d08] = 雾墙
# en: The fog in front of you isn't drifting. It's standing, like a wall, and when you put out a hand it's cold and faintly springy. Behind it the wood goes on. Through it, perhaps, if you can talk it into letting you.
text [0dfe25] = 你面前的雾不是在飘。它立着，像一堵墙，你伸出手去，它是冷的，还微微有弹性。墙后面林子还在继续。或许可以穿过去，如果你能说服它让你过的话。
# en: A solid-looking wall of white fog blocking a forest path, tree branches vanishing into it, a student holding out a hand.
scene [ee90a6] = 一堵看起来很结实的白雾墙挡住了森林小路，树枝消失在雾里，一个学生伸出了手。
# en: Turn back
opt.left.label [2f9f2d] = 往回走
# en: {~You don't argue with fog. You go home.|You leave the wall to its standing and walk back toward the light.}
opt.left.say.1 [cf2571] = {~你不跟雾争。你回家了。|你让那堵墙继续立着，朝亮光走了回去。}
# en: Part it with a spell
opt.right.label [b0d16a] = 用咒语分开它
# en: {~You push, and the fog parts like a curtain, sulkily, and lets you through. You'll remember how it gave.|You find the knot at the heart of the fog and pick it. The wall unravels into ordinary mist.}
opt.right.say.1 [128c2f] = {~你一推，雾就像帘子一样不情不愿地分开，让你过去了。你会记住它是怎么让步的。|你找到了雾中心的那个结，把它挑开了。那堵墙散成了普通的雾气。}
# en: {~The fog swallows you, turns you round three times and puts you out at the edge of the wood, exactly where you started. It wasn't unkind about it.|You walk into the fog and out of it again, a mile back toward the castle. The wood is done with you for today.}
opt.right.say.2 [dc32ad] = {~雾吞没了你，把你转了三圈，放到了林子边上，正好是你出发的地方。它倒没什么恶意。|你走进雾里又走出来，已经往城堡方向退回去一英里了。林子今天跟你没话说了。}
# en: Raise the tine
opt.up.label [9b742a] = 举起鹿角尖
# en: {~You hold up the stag's tine and the fog draws back from it as from a lantern.|The fog sees the tine and parts, politely, the way a crowd parts for a duchess.}
opt.up.say.1 [9b7a8a] = {~你举起影鹿的角尖，雾像躲开一盏灯笼那样退开了。|雾看见了角尖，客客气气地分开，像人群给一位公爵夫人让路。}

@event ww2_waystone
# en: The Waystone
title [17d710] = 路石
# en: A standing stone, worn smooth, with offerings heaped at its foot: hazelnuts, a ribbon, a copper crown older than the castle. Foragers leave something here on the way in. Nobody you've asked will say what for.
text [78f498] = 一块被磨得光滑的立石，脚下堆着供品：榛子，一根丝带，一枚比城堡还老的铜克朗。采集者们进林子时会在这里留下点东西。你问过的人里，没有一个肯说是为了什么。
# en: A weathered standing stone in a forest, little offerings of nuts, coins and ribbons piled at its base.
scene [212383] = 森林里一块饱经风霜的立石，脚下堆着坚果、硬币和丝带之类的小供品。
# en: Turn back here
opt.left.label [3fbec1] = 就在这儿回头
# en: {~You leave the stone and its offerings alone and turn back.|You decide the stone is a sign, and the sign says home.}
opt.left.say.1 [482d02] = {~你没碰那块石头和它的供品，往回走了。|你认定那块石头是个指示，而指示说的是回家。}
# en: Leave an offering
opt.right.label [fa87c3] = 留下一件供品
# en: {ww_haul > 0: Something from your bag, for a little luck.|Your bag is empty: a coin from your purse, then.}
opt.right.hint [531c0f] = {ww_haul > 0: 从包里拿一样东西，换一点运气。|包是空的：那就从钱袋里拿一枚硬币吧。}
# en: {ww_haul > 0: {~You leave the best thing in your bag. Walking on, you feel watched over, which is a nicer feeling than watched.|You set down your offering with the others. A wind goes through the trees, approving.}|{~Your bag is empty, so you leave a crown from your purse. Walking on, you feel watched over, which is a nicer feeling than watched.|You set a coin down with the others, warm from your pocket. A wind goes through the trees, approving.}}
opt.right.say.1 [8d2d7c] = {ww_haul > 0: {~你留下了包里最好的东西。继续往前走时，你觉得自己被守护着，这比被盯着的感觉好多了。|你把供品和其他的放在一起。一阵风穿过树林，像是在赞许。}|{~包是空的，你便从钱袋里留下一枚克朗。继续往前走时，你觉得自己被守护着，这比被盯着的感觉好多了。|你把一枚还带着口袋余温的硬币和其他供品放在一起。一阵风穿过树林，像是在赞许。}}
# en: Palm a few offerings
opt.up.label [393a73] = 顺走几件供品
# en: {~Nobody's looking. A copper, a ribbon, a handful of nuts slip into your bag. The wood goes very quiet as you walk on.|You palm the old crown. It's cold in your pocket for the rest of the day, and something keeps pace with you, just out of sight.}
opt.up.say.1 [8ce414] = {~没人在看。一枚铜币，一根丝带，一把坚果，溜进了你的包里。你继续往前走时，林子变得非常安静。|你顺走了那枚老克朗。那天剩下的时间里，它在你口袋里一直是冰的，有什么东西一直跟你并肩走着，就在视线之外。}

@event ww2_lodestone
# en: The Iron Hollow
title [d6ad0d] = 铁石坑
# en: In this hollow every fallen leaf lies pointing the same way, and your boots feel heavier. At the bottom, half-buried in roots, is a dark stone the size of an egg, and every leaf points at it.
text [a9b404] = 在这个坑里，每一片落叶都朝着同一个方向，你的靴子也觉得沉了。坑底半埋在树根里的，是一块鸡蛋大小的深色石头，每一片叶子都指着它。
# en: A forest hollow where every fallen leaf points the same direction, a dark stone half-buried at its centre.
scene [670394] = 森林里的一个坑，每一片落叶都朝着同一个方向，中央半埋着一块深色的石头。
# en: Leave it buried
opt.left.label [50a426] = 让它埋着
# en: {~Some things are buried for a reason. You go home.|You leave the stone to its leaves and turn back.}
opt.left.say.1 [eec1a3] = {~有些东西埋着是有原因的。你回家了。|你把石头留给它的叶子，往回走了。}
# en: Dig it out
opt.right.label [c0d1e0] = 把它挖出来
# en: {~You dig until your nails are black and work it free. It turns, slowly, in your palm, to face north. A bit of cord and it's a pendant.|It comes up with a sucking sound and a lot of roots. In your hand it turns, gently, like a compass waking.}
opt.right.say.1 [98b9b2] = {~你挖到指甲缝都黑了，终于把它弄了出来。它在你掌心里慢慢转动，转向北方。加一截绳子，就是一只吊坠。|它被挖出来时发出一声吸吮般的响声，带出一大堆树根。在你手里，它轻轻地转着，像一只苏醒的罗盘。}
# en: {~The roots won't let go, and neither will you, until the hollow wall comes down on you.|You dig too deep and the hollow fills with black water.}
opt.right.say.2 [2382ab] = {~树根不肯松手，你也不肯，直到坑壁塌下来压住了你。|你挖得太深，坑里涌满了黑水。}

@event ww2_stone_words
# en: Words on a Stone
title [9583a1] = 石上的字
# en: A flat stone, mossed over, with letters carved deep in it. When you scrape the moss away, the letters are a spell: a way to gather light around you, breath by breath, until it stands between you and harm. Whoever left it here wanted it found by someone patient.
text [eca37d] = 一块长满苔藓的平石，上面深深地刻着字。你把苔藓刮掉，那些字是一条咒语：一种把光聚集在身边的方法，一口气接一口气，直到它挡在你和伤害之间。把它留在这里的人，希望它被一个有耐心的人发现。
# en: A moss-covered flat stone in a forest clearing carved with faint glowing letters, a student kneeling to read.
scene [31c2d6] = 林间空地上，一块长满苔藓的平石上刻着微微发光的字，一个学生跪下来阅读。
# en: Copy nothing; go home
opt.left.label [2cf477] = 什么都不抄；回家
# en: {~You cover the words again with moss and go home. They'll keep.|You leave the stone its secret.}
opt.left.say.1 [838aa9] = {~你又用苔藓把字盖好，回家了。它们会一直在那儿。|你把石头的秘密留给了它自己。}
# en: Work out the spell
opt.right.label [364101] = 弄懂这条咒语
# en: {~You read it three times and the light begins to gather at your shoulders. Lodestar. It feels like being walked home.|It takes an hour on your knees in the moss. By the end, light gathers when you breathe in, and stays.}
opt.right.say.1 [0edec0] = {~你读了三遍，光开始在你肩头聚集。引星。感觉就像有人送你回家。|你在苔藓上跪了一个小时。到最后，你一吸气，光就聚过来，而且留下了。}
# en: {~You get the first line and the second line, and the third line is wrong in a way that knocks you flat.|The light gathers, then goes off like a lamp dropped on stone.}
opt.right.say.2 [074b65] = {~第一行你懂了，第二行你也懂了，第三行错得把你掀翻在地。|光聚了起来，然后像一盏摔在石头上的灯一样炸开了。}

@event ww2_thornwitch
# en: The Woman Among the Thorns
title [8e4ed1] = 荆棘中的女人
# en: A thin woman in a cloak sewn with thorns has her palm on a birch, and the birch is dying: its leaves curl and fall as you watch, and the woman looks younger with every leaf. She sees you. She doesn't stop. "Siphon," she says. "They'd never teach it to you up there."
text [73098a] = 一个披着缝满荆棘的斗篷的瘦削女人把手掌按在一棵白桦上，而那棵白桦正在死去：你看着它的叶子卷曲、掉落，那个女人每掉一片叶子就年轻一分。她看见了你。她没有停。“虹吸，”她说。“上面那些人永远不会教你这个。”
# en: A thin woman in a thorn-trimmed cloak with her hand on a withering birch tree, a sickly green light flowing from the tree into her palm.
scene [206a87] = 一个斗篷上镶着荆棘的瘦削女人把手按在一棵枯萎的白桦上，一道病恹恹的绿光从树里流进她的掌心。
# en: Leave her to it
opt.left.label [d94459] = 由她去吧
# en: {~You back away and go home, and the dying birch stays in your head all evening.|You leave. She laughs, softly, without turning round.}
opt.left.say.1 [4e3a77] = {~你退开，回家了，那棵将死的白桦在你脑子里留了一整晚。|你走了。她轻声笑着，没有回头。}
# en: Talk to her
opt.right.label [47f973] = 跟她谈谈
# en: {~You talk. She listens, and stops, and takes her hand off the birch to look at you properly.|She's lonely, it turns out, and proud, and she likes being argued with. The birch gets a reprieve.}
opt.right.say.1 [807be8] = {~你开口说话。她听着，停了下来，把手从白桦上拿开，好好地打量你。|原来她很孤独，也很骄傲，而且喜欢有人跟她争论。白桦得到了缓刑。}
# en: {~She tires of you halfway through a sentence and turns her hand toward you instead.|"Enough," she says, and the thorns on her cloak lift like hackles.}
opt.right.say.2 [55086d] = {~你一句话说到一半，她就不耐烦了，把手转向了你。|“够了，”她说，斗篷上的荆棘像颈毛一样竖了起来。}
# en: Stop her
opt.up.label [cba466] = 阻止她
# en: {~You drive her off the birch and into the thorns. She goes, cursing, and the birch puts out one green leaf. You'll tell Brask.|She runs. The birch is too far gone, but the next one won't be. Brask will want to know.}
opt.up.say.1 [b98d64] = {~你把她从白桦边赶进了荆棘丛。她骂骂咧咧地走了，白桦长出了一片绿叶。你会告诉布拉斯克的。|她跑了。这棵白桦已经救不回来了，但下一棵能。布拉斯克会想知道的。}
# en: {~She turns your fire on you, and then turns to you, and then you don't remember.|She takes from you what she was taking from the birch. You wake much later, very cold.}
opt.up.say.2 [f927c7] = {~她把你的火转向了你，然后转向了你本人，然后你就不记得了。|她从你身上拿走了她从白桦身上拿走的东西。你很久以后才醒，冷得要命。}

@event ww2_thornwitch_fight
# en: Thorns
title [468523] = 荆棘
# en: Brambles come up out of the ground at her gesture. She's going to try Siphon on you next, and you have seen what it does to a birch. ⚠ Down here, nobody comes to catch you.
text [19f832] = 她一挥手，荆棘就从地里钻了出来。她接下来要对你用虹吸，而你见过它对一棵白桦做了什么。⚠ 在这底下，没人会来接住你。
# en: A woman in a thorn cloak raising both hands as brambles burst from the forest floor toward a student.
scene [d20b6e] = 一个披着荆棘斗篷的女人举起双手，荆棘从林地里迸出，朝一个学生扑去。
# en: Run for it
opt.left.label [38d292] = 快跑
# en: {~You run, and the brambles tear at you all the way to the path. She doesn't follow. She doesn't need to.|You run. Her laugh follows you further than she does.}
opt.left.say.1 [51e396] = {~你跑了，荆棘一路撕扯着你直到小路。她没追。她用不着追。|你跑了。她的笑声比她本人追得更远。}
# en: Fight her
opt.right.label [d6ea52] = 跟她打
# en: She heals by holding Siphon: break the hold.
opt.right.hint [d943c8] = 她靠维持虹吸来疗伤：打断它。
# en: {~You break her hold and she breaks, fleeing into the thorns. The birch behind her is grey, but you'll tell Brask, and it won't happen here again.|She goes down into the brambles and doesn't come up. When you look, she's gone, and so are the thorns.}
opt.right.say.1 [0cdec4] = {~你打断了她的维持，她也垮了，逃进了荆棘丛。她身后的白桦已经灰了，但你会告诉布拉斯克，这里不会再发生这种事。|她倒进荆棘丛里，再没起来。你再看时，她不见了，荆棘也不见了。}
# en: {~Her hand finds your arm, and the cold comes in, and you don't remember the rest.|She drinks from you until you can't stand. Then she leaves you, generously, alive.}
opt.right.say.2 [ecb41c] = {~她的手抓住了你的胳膊，寒意涌了进来，剩下的你都不记得了。|她吸你吸到你站不住。然后她慷慨地留了你一命。}

@event ww2_thornwitch_offer
# en: Her Lesson
title [150c88] = 她的一课
# en: "You have nerve," the thornwitch says. "I could use an apprentice with nerve." She holds out a wand of blackthorn, still bristling. "I'll teach you Siphon. It's only life. There's so much of it about." Behind her the birch is grey to the root.
text [b28689] = “你有胆量，”荆棘女巫说。“我正需要一个有胆量的学徒。”她递出一根黑刺李魔杖，上面的刺还竖着。“我教你虹吸。不过是生命而已。到处都是。”在她身后，那棵白桦已经灰到了根。
# en: A thin woman in a thorn cloak holding out a blackthorn wand to a student, a grey birch behind her.
scene [f5f7da] = 一个披着荆棘斗篷的瘦削女人向一个学生递出一根黑刺李魔杖，她身后是一棵灰白的白桦。
# en: Tell her to go
opt.left.label [c53d24] = 叫她走
# en: {~"Go," you say, "and don't come back to this wood." She shrugs, as if you'd refused a biscuit, and walks off into the thorns. You'll tell Brask.|She looks at you for a long time. Then she goes, and the thorns go with her.}
opt.left.say.1 [843cbc] = {~“走，”你说，“别再回这片林子。”她耸耸肩，好像你只是拒绝了一块饼干，走进了荆棘丛。你会告诉布拉斯克的。|她看了你很久。然后她走了，荆棘也跟着她走了。}
# en: Take the lesson
opt.right.label [187b3f] = 接受这一课
# en: A forbidden spell, and a wand that wants using.
opt.right.hint [3f2473] = 一条禁咒，和一根想被使用的魔杖。
# en: {~She shows you. It's easy, which is the worst part. You walk on with the thorn wand in your belt and a dead birch behind you.|You learn it on a fern, which curls and greys. "There," she says. "Now you know something they don't." The thorn wand pricks your palm.}
opt.right.say.1 [67f5a9] = {~她教了你。很容易，这才是最糟的。你腰里插着荆棘魔杖继续往前走，身后是一棵死去的白桦。|你在一株蕨上学会了，它卷曲、变灰。“好了，”她说。“现在你知道一些他们不知道的事了。”荆棘魔杖刺了一下你的掌心。}

@event ww2_embers_kin
# en: Ember's Kin
title [b66af0] = 余烬的族人
# en: A ring of small foxes is sitting in the dark, tails glowing like banked coals. {has(familiar_fox): Your own fox goes forward and touches noses with the eldest.|The eldest looks at you as if it has heard about you.} Foxes like these, Maud says, will walk anyone through the wood who can hold a conversation.
text [6812d3] = 一圈小狐狸坐在黑暗里，尾巴像封着的炭火一样发着光。{has(familiar_fox): 你自己的狐狸走上前，跟最年长的那只碰了碰鼻子。|最年长的那只看着你，好像听说过你。} 莫德说，这样的狐狸会领任何能好好聊天的人穿过林子。
# en: Several small foxes with glowing ember-like tails sitting in a ring in a dark forest, watching a student.
scene [002132] = 漆黑的森林里，几只尾巴像余烬一样发光的小狐狸围坐成一圈，看着一个学生。
# en: Bow and turn back
opt.left.label [474bd8] = 鞠个躬，往回走
# en: {~You bow to the foxes and go home. Their tails glow in the dark behind you all the way.|You leave them their ring. One follows you as far as the path, then vanishes.}
opt.left.say.1 [1e8d33] = {~你向狐狸们鞠了一躬，回家了。一路上它们的尾巴都在你身后的黑暗里发着光。|你把那个圈留给了它们。有一只一直跟你到小路上，然后消失了。}
# en: Hold a conversation
opt.right.label [2c5dda] = 跟它们聊聊
# en: {~You talk, they yip, and the eldest decides you'll do. From now on, a small smouldering tail will turn up whenever you step off the path, and steer you out of the worst of it.|You trade news for news. The foxes are terrible gossips. One of them will walk with you from now on.}
opt.right.say.1 [18be86] = {~你说话，它们尖声叫，最年长的那只认定你还行。从今往后，只要你离开小路，就会有一条冒着烟的小尾巴出现，把你从最糟的地方引开。|你们用消息换消息。狐狸们是可怕的八卦精。从今往后，会有一只跟你一起走。}
# en: {~You say the wrong thing, whatever it was. The foxes vanish, and so does the path.|The eldest yawns at you. A tail flicks, and you're lost.}
opt.right.say.2 [1a6e11] = {~你说错了话，不管是哪句。狐狸们消失了，小路也消失了。|最年长的那只冲你打了个哈欠。一条尾巴一甩，你就迷路了。}
# en: Meet them as equals
opt.up.label [5c41fd] = 平起平坐地相待
# en: {~You sit down in their ring as if you'd been invited, and talk to them like old friends. They're delighted. From now on, one of them walks with you whenever you step off the path.|The eldest laughs, a fox's laugh. "Manners," it says. "At last." One of them will walk with you now.}
opt.up.say.1 [5a70c9] = {~你在它们的圈里坐下，好像本来就受了邀请，像老朋友一样跟它们说话。它们高兴极了。从今往后，只要你离开小路，就会有一只陪你走。|最年长的那只笑了，狐狸的那种笑。“礼貌，”它说。“终于来了。”从现在起，会有一只跟你一起走。}

@event ww2_stag_tine
# en: The Shed Tine
title [36ab58] = 脱落的角尖
# en: In a ring of stones lies a single tine from the shadow stag's antlers, shed and left as if for someone. It's heavy, and darker than its shadow. You bowed once, in the bracken. Perhaps that was noticed.
text [c32cee] = 一圈石头里躺着一截影鹿的角尖，像是脱落后特意留给某个人的。它很沉，比它的影子还黑。你曾在蕨丛里鞠过一次躬。也许那被注意到了。
# en: A single dark antler tine lying on moss inside a ring of stones, faint shadow curling off it like smoke.
scene [22aa9e] = 一圈石头里，苔藓上躺着一截深色的鹿角尖，淡淡的影子像烟一样从它上面升起。
# en: Leave it be
opt.left.label [1c761e] = 别动它
# en: {~You bow to the tine, and leave it, and go home. That feels right too.|You don't touch it. The ring of stones seems to approve.}
opt.left.say.1 [6eb519] = {~你向角尖鞠了一躬，没动它，回家了。这样也感觉对。|你没碰它。那圈石头似乎表示赞许。}
# en: Lift it
opt.right.label [4709a9] = 把它举起来
# en: {~It weighs as much as a sack of flour and as little as a feather, depending on how you hold it. You find the right way. Wild things will look at it before they look at you.|You lift it. Somewhere in the wood, something very large breathes out, satisfied.}
opt.right.say.1 [d9f4a9] = {~它有时重得像一袋面粉，有时轻得像一根羽毛，取决于你怎么拿。你找到了正确的拿法。野生的东西会先看它，再看你。|你把它举了起来。林子某处，一个非常大的东西满足地呼出一口气。}
# en: {~It's too heavy, and then suddenly not, and you fall backwards over the ring of stones.|You lift it and it lifts you, and sets you down a long way off, bruised.}
opt.right.say.2 [3d4a83] = {~它太重了，然后忽然又不重了，你向后摔倒在那圈石头上。|你举起了它，它也举起了你，把你放到了很远的地方，摔得青一块紫一块。}

@event ww2_deer_path
# en: Deeper
title [70f044] = 更深处
# en: {~The thicket closes overhead and the daylight goes green, then grey.|Pale fungus glows on the trunks in rings, like lamps somebody keeps lit.|A path of old flagstones, sunk in moss, going down.} The wood is quieter here, and it's listening.
text [a25604] = {~灌木在头顶合拢，日光变绿，又变灰。|树干上一圈圈苍白的菌子在发光，像有人一直点着的灯。|一条陷在苔藓里的老石板路，一路向下。} 这里的林子更安静了，它在听。
# en: A dim forest thicket with dense old trees, a narrow path between them, pale fungus glowing faintly on the trunks.
scene [bbcca6] = 昏暗的森林灌木林里，古树密布，中间一条窄路，树干上的苍白菌子发着微光。
# en: Turn back
opt.left.label [2f9f2d] = 往回走
# en: {~You turn round. The light comes back a shade at a time.|You go home while you still remember the way.|You climb back up the flagstones toward the day.}
opt.left.say.1 [f2b60d] = {~你转身往回走。光一点一点地回来了。|你趁还记得路回家了。|你沿着石板路往上爬，回到白天里去。}
# en: Go deeper
opt.right.label [a3b500] = 往深处走
# en: {~You pick glowing caps from the trunks as you go, and your fingers glow for an hour.|You gather pale fungus from the lamp-rings, and the trees let you.|Down the flagstones, gathering what grows between them.}
opt.right.say.1 [3ab371] = {~你一边走一边从树干上摘发光的菌盖，手指亮了一个小时。|你从那些灯环上采下苍白的菌子，树们由着你。|顺着石板路往下，采着石缝里长的东西。}

@event ww3_shadow_stag
# en: The Shadow Stag
title [74389f] = 影鹿
# en: The shadow stag stands across the way, a stag-shaped hole in the light with antlers that go up into the canopy and don't stop. It doesn't move. It's waiting to see what you are.
text [17ce0b] = 影鹿横在路上，像光里一个鹿形的洞，鹿角一直伸进树冠里，没有尽头。它一动不动。它在等着看你是什么。
# en: A huge stag made of living shadow standing between ancient trees, its antlers lost in the dark canopy.
scene [d28005] = 古树之间站着一头由活生生的影子构成的巨鹿，它的角隐没在漆黑的树冠里。
# en: Back away
opt.left.label [be6d04] = 退开
# en: {~You back away, step by step. It watches until you're out of sight, and then a while longer.|You leave the heartwood to the stag. It seems to think that's correct.}
opt.left.say.1 [6d9d03] = {~你一步一步往后退。它一直看着你，直到你走出视线，又多看了一会儿。|你把心木林让给了影鹿。它似乎觉得这样才对。}
# en: Bow, and hold your nerve
opt.right.label [fa47e8] = 鞠躬，稳住胆量
# en: {flag(ww_bowed): You learned to bow from Brask.|A test of nerve.}
opt.right.hint [8476f6] = {flag(ww_bowed): 你跟布拉斯克学过鞠躬。|一场胆量的考验。}
# en: {flag(ww_stag_friend): You bow and don't look away, and the stag lowers its great head. From now on it'll meet you at the edge and walk you down past the easy places.|You bow and hold its gaze too long. The stag lowers its antlers, not in greeting.}
opt.right.say.1 [d36e7a] = {flag(ww_stag_friend): 你鞠躬，目光没有移开，影鹿低下了它巨大的头。从今往后，它会在林子边接你，领你越过那些容易的地方往下走。|你鞠了躬，却盯着它的眼睛看得太久了。影鹿压低了鹿角，不是在打招呼。}

@event ww3_shadow_stag_fight
# en: Antlers
title [65f85e] = 鹿角
# en: The stag lowers its antlers. Brask would tell you to run. Brask would also tell you, afterwards, that running from a shadow stag is how you teach it to chase.
text [0caac8] = 影鹿压低了鹿角。布拉斯克会叫你快跑。布拉斯克事后也会告诉你，从影鹿面前逃跑，就是在教它追。
# en: A shadow stag charging between dark trees, antlers lowered, a student raising a wand.
scene [ab4d78] = 一头影鹿在黑暗的树木间低角冲锋，一个学生举起了魔杖。
# en: Run for the path
opt.left.label [48bc35] = 朝小路跑
# en: {~You run. It doesn't chase. Somehow that's worse.|You run until the trees thin. When you look back, there's nothing but shadow.}
opt.left.say.1 [e14f77] = {~你跑了。它没追。不知怎么的，这更糟。|你一直跑到树木稀疏的地方。你回头看时，只剩下影子。}
# en: Stand and fight
opt.right.label [300910] = 站住，迎战
# en: {~It turns away at last, wounded more in its pride than its shadow. You go on, but the wood feels colder, as if you'd broken something it liked.|You drive it off. Nothing about that feels like winning.}
opt.right.say.1 [c02941] = {~它终于转身离开了，伤到的更多是骄傲而不是影子。你继续往前走，可林子感觉更冷了，好像你打碎了它喜欢的什么东西。|你把它赶走了。这件事里没有一点赢了的感觉。}
# en: {~The antlers lift you and set you down a long way off, almost gently.|It charges through you like a cold wind. You lie in the leaves for a long time.}
opt.right.say.2 [c08277] = {~鹿角把你挑起来，放到很远的地方，几乎是轻轻地。|它像一阵冷风一样冲过你的身体。你在落叶里躺了很久。}

@event ww3_elder_oak
# en: The Elder Oak
title [2df545] = 古橡
# en: The elder oak is so old the other trees grow round it like courtiers. Its bark is a face with its eyes shut. You ask, politely, how old it is, and it opens a split in its trunk to show you its rings. Sixty rings in from the bark, one ring is pale as frost. "The cold spring," it says, and nothing more.
text [8a9d76] = 古橡太老了，其他的树像朝臣一样围着它生长。它的树皮是一张闭着眼睛的脸。你礼貌地问它多大年纪，它在树干上裂开一道缝，给你看它的年轮。从树皮往里数六十圈，有一圈年轮白得像霜。“寒冷的春天，”它说，再没别的了。
# en: An immense ancient oak in a forest clearing, its bark like a face with closed eyes, a student standing small before it.
scene [e7864b] = 林间空地上一棵巨大的古橡，树皮像一张闭着眼睛的脸，一个学生小小地站在它面前。
# en: Bow out and go home
opt.left.label [ca5623] = 鞠躬告退，回家
# en: {~You bow, and leave the old thing to its long thoughts.|You go home thinking about one pale ring among a thousand brown ones.}
opt.left.say.1 [8a652a] = {~你鞠了一躬，让这位老者继续它漫长的思考。|你回家的路上一直想着上千圈褐色年轮里的那一圈苍白。}
# en: Ask it for heartwood
opt.right.label [c208e5] = 向它求一片心木
# en: A splinter of it would make a wand.
opt.right.hint [4fad57] = 它的一片碎木能做成一根魔杖。
# en: {~It considers you for so long you think it's fallen asleep. Then a splinter of heartwood, red-gold and warm, drops into your hand. Mir could carve this.|"Use it well," it creaks, "or not at all." The splinter in your palm is warm as a living thing.}
opt.right.say.1 [a830d8] = {~它端详你的时间长得你以为它睡着了。然后一片心木，红金色的，温热的，落进了你手里。米尔能雕这个。|“好好用它，”它嘎吱着说，“或者干脆别用。”你掌心里的碎木温热得像一个活物。}
# en: {~It closes its split, and its eyes open instead.|"Take," it says, "is not a word for trees." Its roots begin to move.}
opt.right.say.2 [dd5e9c] = {~它合上了那道缝，睁开的是它的眼睛。|“拿，”它说，“不是树的词。”它的根开始动了。}

@event ww3_elder_oak_fight
# en: The Slow Fall
title [ec7d5a] = 缓坠
# en: The elder oak doesn't hurry. It lifts one great bough, slowly, and you have all the time in the world to watch it come down. Its roots are moving too. The bough will take three breaths to land.
text [bcd7cb] = 古橡不着急。它慢慢举起一根巨大的树枝，你有世上所有的时间看着它落下来。它的根也在动。那根树枝要三次呼吸才会落地。
# en: A colossal oak bough slowly descending toward a student in a forest clearing, roots coiling across the ground.
scene [1e0c64] = 林间空地上，一根巨大的橡树枝正缓缓压向一个学生，树根在地面上盘绕。
# en: Get out from under it
opt.left.label [b8852c] = 从底下逃出来
# en: {~You run out from under the falling bough and keep running. The ground shakes behind you like a door slammed in a cellar.|You leave. The oak goes back to sleep before the bough has finished falling.}
opt.left.say.1 [631a02] = {~你从落下的树枝底下跑出来，一直跑。身后的地面在震，像地窖里一扇被摔上的门。|你走了。树枝还没落完，古橡就又睡着了。}
# en: Hold your ground
opt.right.label [52ce0a] = 寸步不让
# en: Answer each slow fall; its roots chip at you all along.
opt.right.hint [7b5f74] = 应对每一次缓坠；它的根会一直啃着你。
# en: {~You weather every fall, and the oak stops, surprised. It doesn't give you any heartwood. It doesn't stop you going on, either.|The oak lets the last bough rest. You've won nothing but the right to pass.}
opt.right.say.1 [44bf55] = {~你扛过了每一次坠落，古橡停了下来，很惊讶。它没给你心木。它也没拦着你继续往前走。|古橡让最后一根树枝停了下来。你赢得的只有通行的权利。}
# en: {~The third fall finds you. The roots carry you, gently, to the edge of the clearing and set you down.|You misjudge the third breath.}
opt.right.say.2 [7b9721] = {~第三次坠落找到了你。树根轻轻地把你抬到空地边上，放下。|你算错了第三次呼吸。}

@event ww3_masked_circle
# en: The Masked Circle
title [65f497] = 假面法阵会
# en: Three figures in plain white masks stand in a chalk circle, practising on a hare. One says "again," and the hare does what it just did, again, against its will. The chalk marks round the circle are copied from somewhere, badly. They haven't seen you yet.
text [1430ff] = 三个戴着素白面具的人站在一个粉笔圈里，在一只野兔身上练习。其中一个说“再来”，野兔就违背自己的意愿，把刚才做过的事又做了一遍。圈周围的粉笔符号是从哪儿抄来的，抄得很糟。他们还没看见你。
# en: Three figures in plain white masks standing in a chalk circle in a dark forest clearing, one pointing at a cringing hare.
scene [f48c6f] = 漆黑的林间空地上，三个戴着素白面具的人站在粉笔圈里，其中一个指着一只瑟缩的野兔。
# en: Slip away
opt.left.label [b06a4f] = 悄悄溜走
# en: {~You slip back into the dark before they turn. The hare's eyes stay with you.|You leave. Behind you, someone says "again", and you walk faster.}
opt.left.say.1 [8de5e0] = {~你在他们转身前退回了黑暗里。野兔的眼睛一直留在你心里。|你走了。身后有人说“再来”，你走得更快了。}
# en: Walk in as one of them
opt.right.label [7b8c58] = 装作他们的人走进去
# en: {~You stride in as if you were late. They're amateurs: they make room for you at once.|"You're late," says one. "Sorry," you say, and they believe you.}
opt.right.say.1 [9070a4] = {~你大步走进去，好像只是迟到了。他们是外行：立刻给你让了位置。|“你迟到了，”其中一个说。“抱歉，”你说，他们信了。}
# en: {~"That's not one of us," says the tallest, and says the word at you instead.|They know their own. Three wands turn your way, and a voice says "again", and again.}
opt.right.say.2 [c521ec] = {~“那不是我们的人，”最高的那个说，然后把那个词冲你说了出来。|他们认得自己人。三根魔杖转向你，一个声音说“再来”，一遍又一遍。}
# en: Break up the circle
opt.up.label [5f01a6] = 冲散这个圈子
# en: {~You scatter them. They run, masks askew, into the trees. The hare is gone before you can look. You'll tell the headmistress.|One loses a mask as they run. You don't see the face. You do see the chalk, and scuff it out.}
opt.up.say.1 [6b1e5a] = {~你把他们冲散了。他们面具歪斜地逃进了树林。你还没来得及看，野兔就不见了。你会告诉院长的。|其中一个逃跑时掉了面具。你没看到那张脸。你看到了粉笔圈，把它踢花了。}
# en: {~They make you do it again: whatever you did last, until you can't stand. Then they leave you.|Three against one, and they've practised this. You don't remember the end.}
opt.up.say.2 [34dfda] = {~他们让你再来一遍：不管你上一步做了什么，一直做到你站不住。然后他们丢下了你。|三对一，而且他们练过。你不记得结局了。}

@event ww3_masked_offer
# en: "Again"
title [357cd7] = “再来”
# en: Inside the circle, the masked three are friendly, which is worse. "It's called Compel," the tallest says. "Say the word and they do it again. Anyone. Anything." They hold out a spare mask. The hare in the middle is shaking.
text [05f223] = 在圈里，三个戴面具的人很友好，这更糟。“这叫强令，”最高的那个说。“说出那个词，他们就会再做一遍。任何人。任何事。”他们递来一张备用的面具。中间的野兔在发抖。
# en: Three masked figures in a chalk circle offering a white mask to a student, a hare frozen in the middle.
scene [c73711] = 粉笔圈里，三个戴面具的人向一个学生递出一张白面具，一只野兔僵在中间。
# en: Let the hare go and leave
opt.left.label [d80fff] = 放走野兔，离开
# en: {~You scoop up the hare on your way out of the circle, and nobody stops you, because you walk like you're allowed. Behind you they argue about who you were.|You let the hare go and walk on. They don't follow. They don't know who you are, which is the only thing they've got right.}
opt.left.say.1 [0a88a4] = {~你走出圈子时顺手抱起了野兔，没人拦你，因为你走路的样子像是本来就被允许的。身后他们在争论你是谁。|你放走了野兔，继续往前。他们没跟上来。他们不知道你是谁，这是他们唯一做对的事。}
# en: Learn the word
opt.right.label [c592ba] = 学会那个词
# en: A forbidden spell.
opt.right.hint [1ffa0f] = 一条禁咒。
# en: {~You learn it on the hare. It works the first time. You walk on with the word in your mouth like a stone.|"Again," you say, and the hare does. The masks nod. You leave before they can see your face, or you theirs.}
opt.right.say.1 [a10a69] = {~你在野兔身上学会了它。第一次就成了。你继续往前走，那个词含在嘴里，像一块石头。|“再来，”你说，野兔照做了。面具们点了点头。在他们看见你的脸、或你看见他们的脸之前，你离开了。}

@event ww3_always_midnight
# en: Where It's Always Midnight
title [2017b8] = 永远是午夜的地方
# en: You step into a clearing and it's midnight: stars overhead, though it's day behind you, and moonlight pooling in a stone basin in the middle. The moonpetal round the edge is closed. It's waiting, you'd swear, for a real midnight.
text [0e2607] = 你踏进一片空地，这里是午夜：头顶有星星，尽管你身后还是白天，月光积在中央一个石盆里。边上的月瓣花都合着。你敢发誓，它们在等一个真正的午夜。
# en: A forest clearing under a night sky in broad daytime, moonlight pooling in a stone basin full of still water.
scene [218eac] = 大白天里，一片林间空地却笼罩在夜空之下，月光积在一个盛满静水的石盆里。
# en: Step back into the day
opt.left.label [3602d9] = 退回白天里
# en: {~You step back and it's afternoon again. You note the place, and the closed flowers, and the hour they're waiting for.|You leave the clearing to its private night, and remember the moonpetal waiting.}
opt.left.say.1 [32ed0b] = {~你退后一步，又是下午了。你记下了这个地方，那些合着的花，还有它们在等的那个时辰。|你把这片空地留给它私有的夜晚，记住了那些等待着的月瓣花。}
# en: Drink from the basin
opt.right.label [b9d769] = 从石盆里喝
# en: It wants a careful hand; a brewer's.
opt.right.hint [666c88] = 它要一双小心的手；一双熬药人的手。
# en: {~You skim the moonlight off the water like cream, the way you'd skim a potion. It settles in you, slow and free. Moonwell. The flowers stay shut: not their hour. Midnight, they seem to say. Come back at midnight.|You drink the light, not the water. It fills you slowly, like a basin. Around you the moonpetal waits for midnight.}
opt.right.say.1 [2c8888] = {~你像撇药汤一样，把月光从水面上撇了下来，像撇奶油。它在你体内沉下来，缓慢，而且不要代价。月泉。花还是合着：不是它们的时辰。午夜，它们像在说。午夜再来。|你喝的是光，不是水。它慢慢地把你注满，像注满一只石盆。你周围的月瓣花在等午夜。}
# en: {~You drink the water, not the light. It's very cold, and so are you, for the rest of the day.|The basin tips. Moonlight goes everywhere, and you go down in it.}
opt.right.say.2 [5c9d30] = {~你喝的是水，不是光。水很冷，那天剩下的时间你也很冷。|石盆翻了。月光洒得到处都是，你也跟着倒在了里面。}

@event ww3_other_sky
# en: The Other Sky
title [cc2dd3] = 另一片天空
# en: A pool so still it's a mirror, except that it reflects the wrong sky: another season's stars at noon, as if the pool is looking somewhere else. When you lean over, your reflection is a moment late. Then it's a moment early.
text [8c7856] = 一潭静得像镜子的水，只是它映出的天空不对：正午时分映着另一个季节的星星，好像这潭水在看着别处。你俯身去看，你的倒影慢了一拍。然后又快了一拍。
# en: A still forest pool reflecting a completely different sky from the one above, autumn constellations in a summer noon.
scene [bf20a6] = 一潭静止的林中池水映出与头顶完全不同的天空，夏日正午里映着秋天的星座。
# en: Look away and go home
opt.left.label [29a548] = 移开目光，回家
# en: {~You look away first. All the way home your reflection in puddles is very slightly late.|You leave the pool to its other sky.}
opt.left.say.1 [db183a] = {~你先移开了目光。回家的一路上，你在水洼里的倒影都慢了那么一点点。|你把这潭水留给它的另一片天空。}
# en: Work out how it does that
opt.right.label [e9286d] = 弄清楚它是怎么做到的
# en: {~It's throwing back what's cast at it, all of it, from wherever it comes. You learn the trick of it with a pebble, then with a spark. Reflect.|You watch until your reflection catches up. Then you understand: it gives everything back. You take the lesson with you.}
opt.right.say.1 [f77ee2] = {~它把投向它的东西全部弹回去，不管是从哪儿来的。你先用一颗石子，再用一点火花，学会了其中的窍门。反照。|你一直看到倒影追上你。然后你明白了：它把一切都还回去。你把这一课带走了。}
# en: {~You lean too far, and your reflection leans further, and you're in the water and very cold.|The pool throws your own curiosity back at you, hard.}
opt.right.say.2 [0e048d] = {~你俯得太低，你的倒影俯得更低，然后你就掉进了水里，冷得要命。|那潭水把你的好奇心狠狠地砸了回来。}
# en: Answer it with starlight
opt.up.label [072204] = 用星光回应它
# en: {~You cast starlight at the pool and it throws it back, all of it, and you catch it. You understand Reflect now, in your hands.|The pool returns your starlight with interest. You learn its trick by being on the wrong end of it.}
opt.up.say.1 [8a7a8c] = {~你朝水潭施放星光，它把星光全部弹了回来，你接住了。现在你用双手明白了反照。|水潭连本带利地还回了你的星光。你是在挨打的那一头学会它的窍门的。}
# en: {~The pool returns your starlight, all of it, and you weren't ready.|It throws the light back. You see stars for some time.}
opt.up.say.2 [b4bc93] = {~水潭把你的星光全部还了回来，而你没准备好。|它把光弹了回来。你眼冒金星了好一阵。}

@event ww3_spiderlings
# en: Spiderlings
title [b9ae0d] = 小蜘蛛
# en: The branches overhead are thick with grey silk, and the silk is moving. Spiderlings, hundreds, pouring down their threads toward you, each the size of a coin. Somewhere deeper, something laid all these. You'd rather not meet it today.
text [45d0e0] = 头顶的树枝上结满了灰色的蛛丝，而蛛丝在动。小蜘蛛，成百上千，顺着丝线朝你倾泻下来，每只都有硬币那么大。更深的地方，有什么东西产下了这一切。今天你可不想遇见它。
# en: Hundreds of small grey spiders pouring down silk threads from dark branches toward a startled student.
scene [680b51] = 成百上千只灰色小蜘蛛顺着蛛丝从漆黑的树枝上倾泻而下，扑向一个受惊的学生。
# en: Run back the way you came
opt.left.label [68dc74] = 原路跑回去
# en: {~You run, brushing at your hair for the next three days.|You go home and shake out every piece of clothing you own.}
opt.left.say.1 [162e85] = {~你跑了，之后三天一直在拍头发。|你回了家，把每一件衣服都抖了一遍。}
# en: Fight through them
opt.right.label [c67eea] = 杀出一条路
# en: Many small bites: a single brace won't stop them.
opt.right.hint [d2bfbf] = 许多小口的咬：一次坚守挡不住。
# en: {~You fight through, wand flailing, until the silk thins and the bites stop. You come out with a bag full of silk-wrapped seed-cases Pell will pay for.|They scatter. You gather a handful of their silk, which is stronger than rope and lighter than breath.}
opt.right.say.1 [6a14dc] = {~你挥舞着魔杖杀了过去，直到蛛丝变稀、咬啮停止。你出来时带了一袋蛛丝裹着的种荚，佩尔会买的。|它们四散了。你收集了一把它们的丝，比绳子还结实，比呼吸还轻。}
# en: {~They're everywhere at once. You go down in a grey storm of tiny bites.|You stop a dozen and a hundred get through.}
opt.right.say.2 [e01719] = {~它们无处不在。你倒在一场灰色的小咬风暴里。|你挡住了十几只，却有上百只冲了过来。}
# en: Burn the webs
opt.up.label [1ca3da] = 烧掉蛛网
# en: {~The silk goes up like paper and the spiderlings flee in every direction. The path ahead is clear, and smells of burnt sugar.|You burn a road through the silk. Something deeper in the wood notices the smoke.}
opt.up.say.1 [01e9b2] = {~蛛丝像纸一样烧了起来，小蜘蛛们四散奔逃。前方的路清出来了，闻起来像焦糖。|你在蛛丝里烧出一条路。林子更深处，有什么注意到了烟。}

@event ww3_wisps
# en: Wisps
title [d6b4b7] = 鬼火
# en: Wisps: little blue lights that bob between the trees and ask riddles, and lead you into bogs if you answer wrong. They know where the best things grow. When something startles them, they scatter every way but one: toward the lake.
text [6a475c] = 鬼火：在树间上下浮动的蓝色小光点，会出谜语，要是你答错了，就把你引进沼泽。它们知道最好的东西长在哪儿。受惊的时候，它们会朝每一个方向四散，只有一个方向除外：湖那边。
# en: Several small floating blue lights drifting between dark trees, one hovering close to a student's face.
scene [af1e7b] = 几点漂浮的蓝色小光在漆黑的树木间飘荡，其中一点悬停在一个学生的脸旁。
# en: Ignore them; turn back
opt.left.label [b01f9e] = 别理它们；往回走
# en: {~You ignore them, which wisps find very rude. They follow you to the edge, sulking.|You turn back. The wisps scatter, and you notice, again, the direction they don't go.}
opt.left.say.1 [2d82a4] = {~你没理它们，鬼火觉得这非常失礼。它们赌着气跟你到了林子边上。|你往回走。鬼火四散了，你又一次注意到了它们不去的那个方向。}
# en: Play their game
opt.right.label [914853] = 陪它们玩
# en: {~You out-riddle the riddlers. Furious and delighted, they lead you to a hollow full of things Pell has only read about.|You argue every answer and they love it. They lead you somewhere good, and then somewhere better.}
opt.right.say.1 [63bf30] = {~你比出谜的更会出谜。它们又气又乐，把你领到一个坑里，里面的东西佩尔只在书上读到过。|你每个答案都跟它们争，它们爱死了。它们把你领到一个好地方，然后是一个更好的地方。}
# en: {~They lead you, laughing, into a bog. A deep one.|You answer wrong. They go out like candles, and you're alone in the dark.}
opt.right.say.2 [59a14f] = {~它们笑着把你领进了沼泽。很深的那种。|你答错了。它们像蜡烛一样熄灭了，你独自待在黑暗里。}

@event ww3_sinkhole
# en: The Sinkhole
title [648169] = 天坑
# en: The ground opens. A sinkhole the size of a cottage, roots hanging down into a dark that doesn't end, and the edge crumbling under your boots. ⚠ Nobody comes to catch you down here.
text [df721a] = 地面裂开了。一个小屋那么大的天坑，树根垂进没有尽头的黑暗里，坑边在你靴子底下崩塌。⚠ 在这底下，没人会来接住你。
# en: The edge of a collapsing sinkhole in a dark forest floor, roots dangling into darkness, a student leaping.
scene [1924d1] = 漆黑的林地上一个正在塌陷的天坑边缘，树根垂进黑暗里，一个学生纵身跃起。
# en: Scramble back
opt.left.label [990249] = 爬回去
# en: {~You throw yourself backwards and the edge goes without you. You go home very carefully.|You scramble back from the edge and decide you've seen enough of the wood today.}
opt.left.say.1 [b38c0e] = {~你往后一扑，坑边没带上你就塌了。你非常小心地回了家。|你从坑边爬了回来，认定今天的林子已经看够了。}
# en: Jump for the far side
opt.right.label [740d7f] = 跳到对面去
# en: {~You jump. For a moment there's nothing under you at all. Then there's moss, and you're through.|You land on the far edge as it crumbles, and run. Behind you the hole sighs.}
opt.right.say.1 [838b94] = {~你跳了。有那么一刻，你脚下什么都没有。然后是苔藓，你过来了。|你落在对面正在崩塌的边上，拔腿就跑。身后，那个坑叹了口气。}
# en: {~You don't make it. Roots catch you, and hold you, and you hang there for a long time.|The far edge gives under you.}
opt.right.say.2 [96a3b8] = {~你没跳过去。树根接住了你，抓着你，你在那儿吊了很久。|对面的边在你脚下塌了。}
# en: Ride a gust over
opt.up.label [f80013] = 乘一阵风过去
# en: {~A gust lifts you over the hole like a leaf, and sets you down on the far side, dizzy and laughing.|You float across. Something at the bottom watches you go.}
opt.up.say.1 [45a86b] = {~一阵风像托起一片叶子那样把你托过天坑，放在对面，你头晕目眩，哈哈大笑。|你飘了过去。坑底有什么东西看着你离开。}

@event ww3_heartwood_hush
# en: The Heartwood
title [ffa94d] = 心木林
# en: {~The heartwood: trees so old their roots are walls, and the light comes down in single shafts like rope.|The trees here are red-barked and warm to the touch, as if they had blood.|Silence, and the slow creak of trees that were old when the castle was a quarry.} You're deeper than most foragers ever go.
text [f6022a] = {~心木林：树老得根都成了墙，光一束一束地垂下来，像绳子。|这里的树皮是红的，摸上去是温的，像有血。|寂静，还有那些在城堡还是采石场时就已经很老的树缓慢的嘎吱声。} 你已经比大多数采集者走得都深了。
# en: Enormous red-barked trees in a dim forest heart, their roots like walls, a single shaft of light reaching the floor.
scene [be3ed9] = 昏暗的森林中心，巨大的红皮树木的根像墙一样，一束光照到了地面。
# en: Turn back
opt.left.label [2f9f2d] = 往回走
# en: {~You turn round. It's a long way back up.|You head home while you still have legs.|You turn back, and the warm red trees watch you go.}
opt.left.say.1 [e00c55] = {~你转身往回走。回上去的路很长。|你趁腿还能走回家了。|你往回走，温暖的红树们看着你离开。}
# en: Gather and go on
opt.right.label [047d5c] = 边采边往前
# en: {~You gather red bark and root-caps in the long light, and go on, slower.|You fill your bag with warm red bark, and go on.|You climb between the roots, gathering as you go, and come out lower and more tired.}
opt.right.say.1 [088038] = {~你在长长的光束里采红树皮和根菌，继续往前走，慢了一些。|你在包里装满温热的红树皮，继续往前。|你在树根间攀爬，一边走一边采，出来时更低了，也更累了。}

@event ww_dusk
# en: The Silence Ahead
title [dce7ce] = 前方的寂静
# en: The path runs on into a silence so thick it presses on your ears. No birds, no wind, no mutter of trees. At its edge a single moonpetal is closed tight, waiting for something. {flag(ww_midnight_known): Midnight. You know that now.|Midnight, by the look of the moon.}
text [29ab1b] = 小路一直延伸进一片寂静里，那寂静厚得压着你的耳朵。没有鸟，没有风，没有树的嘟囔。在它的边上，一朵月瓣花紧紧合着，在等什么。{flag(ww_midnight_known): 午夜。现在你知道了。|看月亮的样子，是午夜。}
# en: The end of a forest path where the trees go silent and dark, a single closed silver flower at the edge of the gloom.
scene [8ed25e] = 森林小路的尽头，树木变得寂静而幽暗，阴影边缘有一朵合拢的银色花朵。
# en: Turn back
opt.left.label [2f9f2d] = 往回走
# en: {~You turn back, and the birds start again behind you, as if released.|You leave the silence to itself, and to whatever keeps the castle's hours down there.}
opt.left.say.1 [8af391] = {~你往回走，身后的鸟又叫了起来，像被放了出来。|你把寂静留给它自己，留给那底下守着城堡时辰的东西。}
# en: Listen a while
opt.right.label [7fea7c] = 听一会儿
# en: {~You stand at the edge of the silence and listen to nothing for a long time. It listens back. You go home before it's dark.|You listen until you can hear your own blood. Somewhere in the silence, very far down, something turns over in its sleep.}
opt.right.say.1 [535168] = {~你站在寂静的边上，听了很久的虚无。它也在听你。你在天黑前回了家。|你一直听到能听见自己的血流声。在寂静里，很深很深的地方，有什么在睡梦中翻了个身。}

@event ww_hush_gate
# en: The Hush
title [510138] = 寂境
# en: At midnight the silence has opened. Every moonpetal along the edge is wide and shining, and the path goes on between them into the Hush, where the wood is so quiet you can hear the moon. {flag(ww_hush_seen): You've been here before. The Hush remembers.|Nobody told you it would be beautiful.}
text [3878b7] = 到了午夜，那片寂静打开了。边上每一朵月瓣花都开得大大的，闪着光，小路从它们中间一直延伸进寂境，那里的林子安静得你能听见月亮。{flag(ww_hush_seen): 你来过这里。寂境记得。|没人告诉过你，这里会这么美。}
# en: A silent moonlit forest where every silver flower has opened at once, the trees perfectly still, a student at the threshold.
scene [a5d9d4] = 寂静的月光森林里，所有银色的花同时开放，树木纹丝不动，一个学生站在入口。
# en: Turn back
opt.left.label [2f9f2d] = 往回走
# en: {~You look, and remember, and turn back while you can.|You turn back. The moonpetal close behind you one by one.}
opt.left.say.1 [50d27b] = {~你看着，记住，趁还能回头时回头了。|你往回走。身后的月瓣花一朵接一朵地合上了。}
# en: Step into the Hush
opt.right.label [7ef77c] = 踏进寂境
# en: Deep magic: every check here is hard.
opt.right.hint [a597d2] = 深层魔法：这里的每一次检定都很难。
# en: {~You step in. The sound of your own boots goes away.|You walk into the Hush. It doesn't welcome you. It doesn't stop you, either.}
opt.right.say.1 [86b806] = {~你走了进去。你自己的脚步声消失了。|你走进了寂境。它不欢迎你。它也不拦你。}

@event ww4_silence
# en: The Silence
title [7483c7] = 寂静
# en: The silence here is a thing. It presses, it leans, it wants you to stop: breathing, thinking, being. It feels like the stillness over the lake on exam mornings. Under it, very faintly, something hums one low note. ⚠ Nobody comes to catch you down here.
text [068bc5] = 这里的寂静是一样东西。它压着，倚着，想让你停下：停止呼吸，停止思考，停止存在。它感觉就像考试那天早上湖面上的那种静。在它下面，非常微弱地，有什么在哼着一个低音。⚠ 在这底下，没人会来接住你。
# en: A student standing in a perfectly still moonlit forest, hands over their ears, frost forming on the leaves around them.
scene [bc5668] = 一个学生站在纹丝不动的月光森林里，双手捂着耳朵，周围的叶子上正在结霜。
# en: Back out of it
opt.left.label [d58d08] = 从里面退出来
# en: {~You back out of the silence and it lets you go, reluctantly, like a hand.|You turn back. It takes the whole walk home for your ears to stop ringing.}
opt.left.say.1 [46b437] = {~你从寂静里退了出来，它不情愿地放开了你，像一只手。|你往回走。一路走到家，耳朵才停止嗡鸣。}
# en: Hold your own sound
opt.right.label [da37d0] = 守住你自己的声音
# en: {~You hold a small spell in your mouth like a lozenge, and the silence can't get in. You walk through it humming.|You keep one spark lit inside you the whole way through. The silence presses and finds nothing to press.}
opt.right.say.1 [479da6] = {~你把一个小咒语含在嘴里，像含一颗润喉糖，寂静进不来。你哼着歌穿了过去。|你一路在心里点着一点火花。寂静压过来，却找不到可压的东西。}
# en: {~The silence gets in. You stop, and stand, and the next thing you know is dawn.|You can't hear your own thoughts. Then you can't have them.}
opt.right.say.2 [30c854] = {~寂静钻了进来。你停下，站着，再知道事情时已经是黎明了。|你听不见自己的想法了。然后你连想法都没有了。}

@event ww4_rime_hollow
# en: The Rime Hollow
title [09626a] = 雾凇坑
# en: A hollow where it's always winter. Frost thick as fur on every twig, and in the middle, hanging from nothing, a single sliver of ice that glows. It's a spell, or the shape of one: the blow that should fell you finds you frozen instead.
text [3d6ac0] = 一个永远是冬天的坑。每根细枝上都结着厚得像毛皮的霜，正中间，悬在虚空里，是一片发着光的冰。那是一条咒语，或者说是咒语的形状：本该把你击倒的那一击，会发现你已冻住了。
# en: A hollow in a moonlit forest where everything is coated in thick white frost, a single icicle hanging from a branch, glowing.
scene [4ee8bf] = 月光森林里的一个坑，一切都裹着厚厚的白霜，一根冰柱挂在树枝上，发着光。
# en: Leave the winter here
opt.left.label [d95b56] = 把冬天留在这里
# en: {~You leave the hollow to its winter, and go home with frost in your eyelashes.|You turn back. Your breath steams all the way out of the wood.}
opt.left.say.1 [55267d] = {~你把这个坑留给它的冬天，睫毛上带着霜回了家。|你往回走。你的呼吸一路冒着白气，直到走出林子。}
# en: Take the sliver
opt.right.label [d7b0b0] = 取走那片冰
# en: {~You take it in your bare hand. It doesn't melt; it goes in. Rime. You'll never quite be warm again, and you'll never quite be felled.|The sliver goes into your collar like a needle and stays there. Rime. The hollow thaws a little, as if relieved.}
opt.right.say.1 [222b86] = {~你赤手拿起它。它没有融化；它钻了进去。雾凇。你再也不会真正暖和了，也再也不会真正被击倒。|那片冰像针一样钻进你的衣领，留在了那里。雾凇。那个坑稍稍解冻了一点，像是松了口气。}
# en: {~The sliver bites. The cold goes all the way in, and you go down.|Frost climbs your arm faster than you can let go.}
opt.right.say.2 [464d92] = {~那片冰咬了你一口。寒意一直钻到最深处，你倒下了。|霜顺着你的胳膊往上爬，比你松手还快。}

@event ww4_web_halls
# en: The Web Halls
title [29b5c6] = 蛛网大厅
# en: Webs strung between the trees like halls, silver in the moon, each thread as thick as a finger. Hanging in one, wrapped to the neck, is a hippogriff from the stables, its eyes white with fright. It's Brask's. You'd know that grey anywhere.
text [378aa8] = 树与树之间张着一张张网，像一座座大厅，在月光下泛着银光，每根丝都有手指那么粗。其中一张网里挂着一只从马厩来的鹰头马身有翼兽，被缠到了脖子，眼睛吓得发白。是布拉斯克的。那身灰色你在哪儿都认得出。
# en: Vast silver webs strung between moonlit trees like cathedral halls, a cocooned hippogriff struggling in one of them.
scene [f40817] = 月光下的树木之间张着大教堂般宏伟的银色蛛网，其中一张网里缠着一只挣扎的鹰头马身有翼兽。
# en: Leave it; turn back
opt.left.label [0a4520] = 不管它；往回走
# en: {~You can't. You do. You go home and can't look at the stables for a week.|You turn back. Its eyes follow you, and then you can't see them.}
opt.left.say.1 [da2980] = {~你不能。你还是走了。你回了家，一个星期都没法正眼看马厩。|你往回走。它的眼睛一直跟着你，然后你就看不见了。}
# en: Cut it free
opt.right.label [15023a] = 把它割下来
# en: {~You saw through the silk thread by thread and the hippogriff bolts, free, for home. Brask will find it at dawn on the stable roof. Something deeper in the Hush has noticed you took it.|It comes free all at once and kicks you, gratefully, and flies. Far off, a web shivers.}
opt.right.say.1 [5ded16] = {~你一根一根地锯断蛛丝，鹰头马身有翼兽挣脱了，朝家飞奔而去。布拉斯克会在黎明时在马厩顶上找到它。寂境更深处，有什么注意到你把它带走了。|它一下子挣脱了，感激地踢了你一脚，飞走了。远处，一张网颤了颤。}
# en: {~The silk takes your knife, then your sleeve, then you.|You get it half free and the web gets you the rest of the way.}
opt.right.say.2 [7ac11e] = {~蛛丝先吞了你的刀，然后是你的袖子，然后是你。|你把它弄出来一半，剩下的路由网替你走完了。}
# en: Burn it loose
opt.up.label [c4775b] = 把它烧下来
# en: {~You burn the silk away from its wings and it bolts for home. The whole web hall shudders. Something deeper is very, very awake now.|Fire goes up the silk like a fuse. The hippogriff drops, rights itself, and flies for the castle.}
opt.up.say.1 [403cf5] = {~你烧掉它翅膀上的丝，它朝家飞奔而去。整座蛛网大厅都在颤抖。更深处的什么东西，现在非常、非常清醒了。|火顺着蛛丝烧上去，像一根引信。鹰头马身有翼兽掉下来，翻正身子，朝城堡飞去。}

@event ww4_last_witch
# en: The Last Witch of the Wood
title [33074c] = 林中最后的女巫
# en: A ghost sits on a fallen log, knitting something that isn't there. She was the wood's witch, she says, before the castle, before the lake was a lake. She left when the Spinner came, and still can't decide if that was cowardice or manners. Then she asks what you want.
text [8eec38] = 一个鬼魂坐在一根倒木上，织着一件不存在的东西。她说，她是这片林子的女巫，在城堡之前，在湖还不是湖之前。织网者来的时候她离开了，到现在也说不清那是懦弱还是礼貌。然后她问你想要什么。
# en: The faint silver ghost of an old woman in a shawl sitting on a fallen log in a moonlit forest, knitting.
scene [2a5969] = 月光森林里，一个披着披肩的老妇人的淡银色鬼魂坐在一根倒木上织东西。
# en: Nothing; turn back
opt.left.label [ad3101] = 什么都不要；往回走
# en: {~"Wise," says the ghost, and goes on knitting the nothing.|You leave her on her log, still asking her question of the dark.}
opt.left.say.1 [f79318] = {~“明智，”鬼魂说，继续织她那件虚无。|你把她留在她的木头上，她还在向黑暗提着她的问题。}
# en: Ask about the Spinner
opt.right.label [f6c641] = 问织网者的事
# en: {~"She has a blind side," the ghost says. "The left. Something took an eye a long time ago, and she's never let anyone see. Stand on her left and talk to her like a lady, and you'll have a fair fight."|She tells you about the Spinner's left side, and laughs about it for a long time.}
opt.right.say.1 [3193ef] = {~“她有个盲侧，”鬼魂说。“左边。很久以前有什么东西夺走了一只眼睛，她从没让任何人看见过。站在她左边，像对一位贵妇那样跟她说话，你就能有一场公平的较量。”|她跟你讲织网者的左侧，讲完了还笑了很久。}
# en: {~"No," says the ghost, and she isn't there, and neither is the path.|She doesn't like your question. The cold comes down like a curtain.}
opt.right.say.2 [809a92] = {~“不，”鬼魂说，然后她不在了，小路也不在了。|她不喜欢你的问题。寒意像帷幕一样落了下来。}

@event ww4_moonpetal_bloom
# en: Moonpetal in Bloom
title [cd9d18] = 盛开的月瓣花
# en: A whole clearing of moonpetal, open to the moon, shining like a lake. You've only ever seen one bloom at a time. {has_item(moonpetal_locket): Your locket opens on its own.|{flag(ww_locket_found): You look for the root where the locket was, and can't find it.|In the middle, caught on a root, something glints.}}
text [718420] = 一整片空地的月瓣花，朝着月亮盛开，亮得像一片湖。你以前只见过一次开一朵。{has_item(moonpetal_locket): 你的吊盒自己打开了。|{flag(ww_locket_found): 你去找当初挂着吊盒的那条树根，却找不到了。|正中间，一条树根上挂着什么东西，在闪光。}}
# en: A moonlit clearing carpeted with glowing silver flowers in full bloom, a student kneeling among them.
scene [a5bb09] = 月光下的空地上铺满了盛开的发光银花，一个学生跪在花丛中。
# en: Leave them be
opt.left.label [8e7a0b] = 让它们开着
# en: {~You sit and look until the moon moves, and pick nothing, and go home.|You leave them all to bloom. You'll remember this one.}
opt.left.say.1 [accd1f] = {~你坐着看，直到月亮移了位，一朵也没摘，回家了。|你让它们全都开着。这一片你会记住的。}
# en: Gather a few
opt.right.label [7e629f] = 采几朵
# en: You gather moonpetal by the armful, and the clearing hardly notices. Caught on a root you find a silver locket, old and plain. When you open it, there's a pressed moonpetal inside already.
opt.right.say.1 [688db7] = 你一抱一抱地采月瓣花，空地几乎没察觉。在一条树根上，你发现了一只银吊盒，又旧又朴素。你打开它，里面已经夹着一片压干的月瓣花。
# en: {~You fill your bag with moonlight and go on.|You gather by the armful, and the clearing hardly notices.}
opt.right.say.2 [3fb83e] = {~你在包里装满月光，继续往前。|你一抱一抱地采，空地几乎没察觉。}

@event ww4_spinner_court
# en: An Audience
title [6e1e78] = 觐见
# en: The Spinner receives you in her halls, on the left side as is proper. {knows(maud.tuppence): "You smell of her bees," she says, as she always does. |}"The trees grow away from the water," she says. "So do I. I've never liked what's down there." She waits to see if you've brought her anything.
text [c26d14] = 织网者在她的大厅里接见你，按规矩是在左侧。{knows(maud.tuppence): “你身上有她那些蜜蜂的味道，”她说，她每次都这么说。|}“树都背着水长，”她说。“我也是。我从来不喜欢那底下的东西。”她等着看你有没有给她带什么来。
# en: A great grey spider the size of a carriage resting in a silver web canopy, bowing her forelegs to a student below.
scene [572426] = 一只马车大小的灰色巨蛛栖在银色的蛛网穹顶里，向下方的学生屈下前腿。
# en: Bow and take your leave
opt.left.label [20d10b] = 鞠躬告辞
# en: {~You bow. She bows her forelegs back. You go home with the strange warm feeling of having been to court.|"Mind the left," she says, as you leave. It may be a joke.}
opt.left.say.1 [23667b] = {~你鞠了一躬。她也屈下前腿回礼。你带着一种奇异而温暖的、刚刚觐见过宫廷的感觉回了家。|“当心左边，”你离开时她说。可能是个玩笑。}
# en: Sit with her a while
opt.right.label [4b2f48] = 陪她坐一会儿
# en: {~You sit with her and she tells you about the wood before the castle. She gives you a bolt of silk as you go, for your trouble.|She shows you her oldest webs, which are a kind of map. You leave with silk and a better sense of the Hush.}
opt.right.say.1 [6f5c49] = {~你陪她坐着，她给你讲城堡之前的林子。你走的时候，她送了你一卷丝，算是辛苦费。|她给你看她最老的网，那是一种地图。你离开时带着丝，也对寂境多了几分了解。}

@event ww_hush_heart
# en: The Heart of the Hush
title [100ca2] = 寂境之心
# en: The heart of the Hush is a ring of silvered trees round a pool that reflects nothing but the moon. Nobody is waiting here any more. The wood is yours, as much as a wood is ever anyone's.
text [1d374d] = 寂境之心是一圈泛着银光的树，围着一潭只映出月亮的水。再也没有人在这里等着了。林子是你的了，就像一片林子能属于任何人那样。
# en: The silent moonlit heart of a forest, a ring of silver trees around a still pool, a student alone and unafraid.
scene [574f8e] = 寂静的月光森林中心，一圈银色的树围着一潭静水，一个学生独自站着，毫无惧色。
# en: Take a little, and go home
opt.ok.label [d1c769] = 拿一点，回家
# en: {~You fill your bag at the edge of the pool and walk home under the moon, unhurried, unafraid.|You sit by the pool until the moon moves, and take a little, and go home.}
opt.ok.say.1 [dac078] = {~你在水边装满了包，在月光下走回家，不慌不忙，无所畏惧。|你在水边坐到月亮移了位，拿了一点，回家了。}
