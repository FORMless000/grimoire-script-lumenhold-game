# Lumenhold Academy — 简体中文 (zh-CN) translation of content/events/night.grim
# Maintained by `node tools/grim.js i18n zh-CN`. Translate the text after "="; keep {tokens}.
# "# en:" shows the English source. [hash] marks the English version a line was translated from;
# lines marked STALE need updating — after fixing the text, delete the [hash] and re-run the tool.


@event night_lead_in
# en: An Unsigned Note
title [f1e5f3] = 一张没有署名的字条
# en: A note under your door, unsigned: "The castle has a second timetable. It starts at midnight. Curfew is a suggestion made by people who go to bed early." In the corner, a map no bigger than a thumbnail, showing six doors that are open when they shouldn't be.
text [e2406e] = 门下塞着一张没有署名的字条：“城堡有第二张时间表，从午夜开始。宵禁只是早睡的人提的建议。”角落里画着一张不比拇指大的地图，标出六扇本不该开着的门。
# en: A folded note slipped under a dormitory door at night, unsigned, a tiny silver map drawn in one corner.
scene [c4d793] = 夜里塞进宿舍门缝的一张折好的字条，没有署名，角落里画着一张小小的银色地图。
# en: Burn it
opt.left.label [162285] = 烧掉它
# en: You hold it to the candle. The map in the corner is the last thing to burn, and you could swear it rearranged itself first.
opt.left.say.1 [23cef0] = 你把它凑到烛火上。角落的地图最后才烧着，你敢发誓它在那之前先自己重新排列了一番。
# en: Keep it
opt.right.label [87c2f5] = 留着它
# en: You fold it into your book. Some nights you take it out and look at the six doors.
opt.right.say.1 [6468db] = 你把它折起来夹进书里。有些夜晚，你会拿出来看看那六扇门。

@event night_out
# en: After Curfew
title [0fdaf7] = 宵禁之后
# en: {month == 12: Starfall is close, and the sky over the towers is already restless.|{month == 4 or month == 10: Exams soon. Half the windows on your corridor are still lit.|{season == "winter": {~Frost on the window, and the corridors are colder than the snow.|Snow on the sills; the tower creaks like a ship.|Ice in the water jug, and the tower silent with snow.}|{season == "summer": {~The night is warm and the castle's windows are all open.|Moths at the window, and somebody laughing on the lawn.|The night is short and never quite dark.}|{~The castle settles for the night, beam by beam.|Rain on the leads, and a gargoyle gargling it.|The wind finds every keyhole in the tower.}}}}} {has(watched): Bram does his rounds earlier these nights. You've learned the sound of his boots.|{health < 30: Every bone you own would like to stay in bed.|{mood < 25: You can't sleep anyway.|{gold < 10: Your purse is light, and some doors after midnight pay.|{bonds(partner) > 0: {~A note under your door, in a hand you know: "Roof?"|You could be on the observatory roof with someone right now.|Somewhere across the castle, someone you love is also awake.}|{final_year: {~Your last year. The castle at night won't be yours much longer.|The doors you know by heart will open for someone else next year.|Next year someone else will lie awake in this bed.}|{~Somewhere a door that should be locked isn't.|Down in the courtyard, a lantern goes out on purpose.|Someone has left the servants' stair unbolted again.}}}}}}}
text [5904cb] = {month == 12: 星坠节快到了，塔楼上方的天空已经躁动起来。|{month == 4 or month == 10: 快考试了。你们走廊上一半的窗户还亮着。|{season == "winter": {~窗上结了霜，走廊比雪还冷。|窗台上积着雪；塔楼像一艘船一样嘎吱作响。|水罐里结了冰，塔楼被雪捂得悄无声息。}|{season == "summer": {~夜很暖，城堡的窗户全开着。|飞蛾扑着窗户，有人在草坪上笑。|夜很短，始终不曾全黑。}|{~城堡一根梁接一根梁地沉入夜色。|雨打在屋顶的铅皮上，一只石像鬼在咕噜咕噜地漱口。|风钻进了塔楼里的每一个锁眼。}}}}}{has(watched): 这些夜里布拉姆巡夜更早了。你已经听熟了他的靴子声。|{health < 30: 你身上的每一根骨头都想待在床上。|{mood < 25: 反正你也睡不着。|{gold < 10: 你的钱袋很轻，而午夜之后，有些门是给钱的。|{bonds(partner) > 0: {~门缝底下塞进一张字条，字迹你认得：“屋顶？”|此刻你本可以和某个人待在观星台的屋顶上。|城堡另一头，你爱的人也还醒着。}|{final_year: {~这是你的最后一年。夜里的城堡很快就不再属于你了。|你烂熟于心的那些门，明年会为别人打开。|明年，会有别人在这张床上睁着眼睡不着。}|{~某处一扇本该锁着的门没有锁。|庭院里，一盏灯笼被人故意熄灭了。|又有人没闩上仆役楼梯的门。}}}}}}}
# en: A dormitory window at midnight, the castle dark beyond it, one lantern moving along a far battlement.
scene [0df004] = 午夜的宿舍窗户，窗外城堡一片漆黑，远处城垛上有一盏提灯在移动。
# en: Sleep
opt.left.label [a62ca8] = 睡觉
# en: A night's rest.
opt.left.hint [dfe4c4] = 好好睡一晚。
# en: {~You blow out the candle and let the castle keep its secrets for one more night.|Sleep. The night can wait. It always does.|You pull the blanket up and listen to the castle until you're asleep.}
opt.left.say.1 [5e979b] = {~你吹灭蜡烛，让城堡再守住一晚它的秘密。|睡吧。夜晚可以等。它向来会等。|你把毯子拉上来，听着城堡的声音，直到睡着。}
# en: Go out
opt.right.label [1d9fab] = 出去
# en: No rest tonight.
opt.right.hint [abd6a5] = 今晚不休息。
# en: {~You wait for the last footsteps to fade, then ease the door open.|Boots in hand, you take the servants' stair.|You slip out while the castle is still settling, and nobody hears.}
opt.right.say.1 [c72d45] = {~你等最后的脚步声消失，然后轻轻推开门。|你拎着靴子，走仆人用的楼梯。|你趁城堡还在安顿下来时溜了出去，谁也没听见。}

@event night_sleep
# en: Lights Out
title [794e40] = 熄灯
# en: {has(locked_out): {~The lock on your door turns at curfew now, from the outside. The castle has decided where you sleep.|Bram's boots go past your door twice before midnight. There's nowhere to go, so you go to bed.|Locked in for the night. You can hear the castle's second timetable starting without you.}|{break and has(plan_home): {~Your old bed at home, too short now, and the smell of the kitchen still in the walls.|At home the night is so quiet you can hear the kettle cooling downstairs.|Your own pillow, your own ceiling, and nobody's footsteps but family's.}|{has(plan_internship): {~Your lodgings are small, the bed is narrow, and you're too tired to mind.|The city doesn't stop at night, but you do.|Tomorrow's work is already laid out on the chair. The bed is the only other furniture.}|{off_campus: {~A borrowed bed, a strange ceiling, and the day finally over.|The night is quiet here, far from the towers.|You fall asleep before you've finished deciding to.}|{season == "winter": {~Frost on the window, and the blankets pulled up to your ears.|Snow on the sills; the tower creaks like a ship.|Ice in the water jug, and the warmest place in the castle is your bed.}|{~The castle settles for the night, beam by beam.|Rain on the leads, and a gargoyle gargling it.|The day is done, and the candle is low.}}}}}}
text [cfe782] = {has(locked_out): {~现在每到宵禁，你的房门就会从外面锁上。城堡替你决定了在哪儿睡。|午夜前，布拉姆的靴子声两次经过你的门口。无处可去，你只好上床。|今晚被锁在屋里。你能听见城堡的第二张时间表在没有你的情况下开始了。}|{break and has(plan_home): {~家里你那张旧床，如今已经嫌短了，墙里还留着厨房的味道。|家里的夜那么安静，你能听见楼下的水壶慢慢变凉。|自己的枕头，自己的天花板，除了家人，没有别人的脚步声。}|{has(plan_internship): {~你的住处很小，床很窄，可你累得顾不上计较。|城市夜里不会停下，但你会。|明天的活儿已经摆在椅子上了。除了床，那是屋里唯一的家具。}|{off_campus: {~借来的床，陌生的天花板，这一天总算结束了。|远离七塔的地方，夜很安静。|你还没想好要不要睡，就已经睡着了。}|{season == "winter": {~窗上结了霜，被子一直拉到耳朵。|窗台上积着雪，塔楼像船一样吱呀作响。|水罐里结了冰，城堡里最暖和的地方就是你的床。}|{~城堡一根梁一根梁地安顿下来。|雨落在铅皮屋顶上，一只滴水兽咕噜咕噜地漱着口。|一天过完了，蜡烛也快燃尽了。}}}}}}
# en: A narrow bed under a slanting ceiling, a candle just blown out, its thread of smoke curling up in the moonlight.
scene [a78cfa] = 斜顶下的一张窄床，刚吹灭的蜡烛冒出一缕细烟，在月光里袅袅升起。
# en: Sleep
opt.ok.label [a62ca8] = 睡觉
# en: A night's rest.
opt.ok.hint [dfe4c4] = 好好睡一晚。
# en: {break and has(plan_home): {~You sleep the way you only sleep at home: all night, without a single dream you remember.|Somebody looks in on you before they go to bed, as if you were still small. You pretend to be asleep, and then you are.|You wake late, to bread and the smell of the garden. Home mends things.}|{~You blow out the candle, and the day goes with it.|You're asleep before the candle has stopped smoking.|You lie awake a little, listening, and then you don't.}}
opt.ok.say.1 [84548d] = {break and has(plan_home): {~你睡得只有在家才睡得那样沉：一整夜，一个梦也不记得。|睡前有人进来看了你一眼，好像你还是个孩子。你假装睡着了，然后就真的睡着了。|你很晚才醒，闻到面包和花园的味道。家能治好很多事。}|{~你吹灭蜡烛，这一天也跟着熄了。|蜡烛还没停止冒烟，你就已经睡着了。|你醒着躺了一会儿，听着，然后就不再听了。}}

@event night_suspicion
# en: A Word in the Morning
title [42e6c8] = 早上的一句话
# en: {has(watched): Bram is waiting at the foot of the stair, and this time he has a notebook open. "Twice," he says. "I did warn you."|Bram is waiting at the foot of the stair. "Someone was out last night," he says, looking at nobody in particular, which is to say at you.}
text [04ce49] = {has(watched): 布拉姆等在楼梯脚下，这次手里摊着一本笔记本。“两次了，”他说，“我警告过你。”|布拉姆等在楼梯脚下。“昨晚有人出去了。”他说着，没看任何人——也就是说，看着你。}
# en: A prefect waiting at the foot of a dormitory stair at breakfast time, arms folded, a small notebook open.
scene [e8d3a9] = 早饭时分，一名级长抱着胳膊等在宿舍楼梯脚下，摊开着一本小笔记本。
# en: Deny everything
opt.left.label [b2b240] = 一口否认
# en: Three months of detention and a door that is checked at midnight. Bram writes it all down, neatly.
opt.left.say.1 [509dcb] = 三个月的禁闭，外加一扇午夜有人查的门。布拉姆把这一切工工整整地记了下来。
# en: "I'll be keeping an eye on you." He means it literally.
opt.left.say.2 [772653] = “我会盯着你的。”他是字面意思。
# en: Own up
opt.right.label [3a0128] = 承认
# en: Three months of detention and a door that is checked at midnight. Bram writes it all down, neatly.
opt.right.say.1 [509dcb] = 三个月的禁闭，外加一扇午夜有人查的门。布拉姆把这一切工工整整地记了下来。
# en: "I'll be keeping an eye on you." He means it literally.
opt.right.say.2 [772653] = “我会盯着你的。”他是字面意思。

@event midnight_newt_cards
# en: Upstairs at the Newt
title [fe653a] = 镀金蝾螈的楼上
# en: Upstairs at the Gilded Newt, after hours, the real game starts. The stakes are higher than anything downstairs, and nobody asks your name.
text [ef03fa] = 打烊之后，镀金蝾螈酒馆楼上，真正的牌局才开始。赌注比楼下任何一桌都大，也没人问你的名字。
# en: A smoky upstairs room at a tavern after hours, a card table under one lamp, coins stacked high.
scene [e9f7a8] = 打烊后酒馆楼上烟雾缭绕的房间，一盏灯下一张牌桌，硬币堆得老高。
# en: Play a few hands
opt.left.label [efba54] = 玩几把
# en: {~You leave with more than you came with and a few new enemies who smile too much.|Luck, nerve and one well-timed sigh. The pot is yours.}
opt.left.say.1 [6262fc] = {~你走的时候比来的时候多了钱，也多了几个笑得太多的新仇人。|运气、胆量，加上一声恰到好处的叹气。彩池归你了。}
# en: {~The cards go cold, and so does your purse. On the stair down, a face from the castle turns away a little too fast.|You lose your stake and walk back in the dark, poorer, wiser and not sure you went unseen.}
opt.left.say.2 [10d4e5] = {~牌运转冷，你的钱袋也跟着凉了。下楼时，一张城堡里的面孔转开得有点太快。|你输掉了赌本，摸黑走回去，钱少了，人精了，也说不准有没有被人看见。}
# en: Watch, then leave
opt.right.label [908b14] = 看一会儿就走
# en: {~You watch one hand, see someone lose a familiar on a bluff, and leave before you're tempted.|You stay long enough to learn the rules, and leave before they learn you.}
opt.right.say.1 [b1d011] = {~你看了一把，看见有人虚张声势输掉了自己的使魔，趁自己还没心动就走了。|你待到学会了规矩，又在他们认清你之前离开了。}

@event midnight_boathouse_ring
# en: The Ring Under the Boathouse
title [31b605] = 船屋下的擂台
# en: {Under the boathouse, by lantern light, someone has chalked a ring on the flagstones. Purses go to whoever is still standing.|The chalk ring under the boathouse again, freshly drawn. The student holding the money knows your face.|The ring is busier than ever, and the money-holder nods to you like a regular.} {flag(ring_last_standing): Tonight a slate by the steps reads LAST STANDING: whoever steps in fights until they drop or have beaten four.|"Next," says the student holding the money, looking at you. Win, and you can fight on for a bigger purse.}
text [e01954] = {船屋底下，借着提灯的光，有人在石板上用粉笔画了个圈。钱袋归最后还站着的人。|船屋底下的粉笔圈又画好了，线条还很新。管钱的学生认得你的脸。|擂台比以往都热闹，管钱的学生朝你点点头，像对熟客一样。} {flag(ring_last_standing): 今晚台阶旁的石板上写着“站到最后”：谁进场，就要一直打到倒下，或者连赢四场。|“下一个。”管钱的学生看着你说。赢了，你就能接着打，钱袋更大。}
# en: A cellar under a boathouse, lanterns hung from the beams, students in a ring around two duellists, coins changing hands.
scene [faa793] = 船屋下的地窖，梁上挂着提灯，学生们围成一圈看两个决斗者，硬币在人手间传递。
# en: Step into the ring
opt.left.label [bf566a] = 走进圈里
# en: Four bouts at most, each harder and richer.
opt.left.hint [df632b] = 最多四场，一场比一场难，一场比一场肥。
# en: {You win the first bout and the ring's respect, which is worth less and lasts longer.|Your opponent yields. Somebody whistles, and the money-holder looks at you: another?|You put your opponent down in the first exchange, and the crowd starts calling your name.}
opt.left.say.1 [764973] = {你赢下第一场，也赢得了擂台的尊重，后者不值钱，却更持久。|对手认输了。有人吹了声口哨，管钱的学生看着你：再来一场？|第一回合你就把对手撂倒了，人群开始喊你的名字。}
# en: {You lose, and limp home past a window where a light is still burning.|A bruising loss, and a lantern somewhere on the path home. Maybe it saw you; maybe not.|You go down to a first-year with long arms. The crowd enjoys it more than you do.}
opt.left.say.2 [443821] = {你输了，一瘸一拐地回去，路过一扇还亮着灯的窗。|输得鼻青脸肿，回去的路上远处有一盏提灯。也许它看见了你，也许没有。|你栽在一个胳膊很长的一年级生手里。人群比你开心多了。}
# en: Not tonight
opt.right.label [4bf72b] = 今晚算了
# en: Watch, and bet if you like.
opt.right.hint [6e4615] = 在旁边看，想押就押。
# en: {You stay at the edge of the crowd and watch someone else's turn.|You shake your head. The money-holder shrugs and looks for somebody braver.|"Not tonight," you say, and find a place on the cellar steps to watch.}
opt.right.say.1 [6e2d17] = {你待在人群边上，看别人上场。|你摇摇头。管钱的学生耸耸肩，去找更勇敢的人。|“今晚算了。”你说，然后在地窖台阶上找了个位置看。}

@event midnight_kitchen_raid
# en: The Kitchens at Midnight
title [174e5a] = 午夜的厨房
# en: The refectory kitchens at midnight: banked fires, a larder that isn't locked, and the smell of tomorrow's bread already rising.
text [14230d] = 午夜的膳堂后厨：封好的炉火，一间没上锁的储藏室，明天的面包已经在发酵，香气飘了出来。
# en: A dark castle kitchen at midnight, a student with a candle reaching into a larder, a cat watching from the hearth.
scene [22b604] = 午夜昏暗的城堡厨房，一个学生举着蜡烛把手伸进储藏室，一只猫在炉边看着。
# en: Fill your pockets
opt.left.label [4d57c0] = 装满口袋
# en: {~Bread, cheese and half a pie. Nobody counts the pies, you hope, and the scullery door creaks as you leave.|You eat by the banked fire with the kitchen cat. On your way out, a kitchen boy is up early. Did he see you?}
opt.left.say.1 [e01feb] = {~面包、奶酪和半个馅饼。没人会数馅饼——但愿如此。你离开时，洗碗间的门吱呀响了一声。|你和厨房的猫一起在封好的炉火边吃东西。出门时，一个厨房小工起得很早。他看见你了吗？}
# en: Just warm yourself by the fire
opt.right.label [9fd3db] = 只在火边暖暖身子
# en: {~You sit by the embers until your hands stop hurting, and take nothing. The walk back is cold.|The kitchen cat sits with you. You leave the larder alone, feel strangely proud of it, and shiver all the way back to bed.}
opt.right.say.1 [ff8310] = {~你坐在余烬旁直到手不再疼，什么也没拿。回去的路很冷。|厨房的猫陪你坐着。你没碰储藏室，心里有种奇怪的自豪，一路哆嗦着回到床上。}

@event midnight_restricted_stacks
# en: The Restricted Stacks
title [700d36] = 禁书区的书架
# en: The Restricted Section at midnight. The chains on the shelves clink when nobody touches them. One book has been left open, as if for you.
text [a86ad6] = 午夜的禁书区。书架上的锁链在没人碰的时候叮当作响。有一本书摊开着，仿佛是为你留的。
# en: A chained library section at midnight, a student reading by a stolen candle, shelves leaning in like listeners.
scene [9d85ce] = 午夜被锁链锁住的藏书区，一个学生借着偷来的蜡烛读书，书架像听众一样倾身靠近。
# en: Read the open book
opt.left.label [5b587f] = 读那本摊开的书
# en: {~Three pages before the book closes itself. You remember every word, which is worrying.|The book shows you a diagram you're not supposed to understand. You understand it.}
opt.left.say.1 [133dfa] = {~读了三页，书就自己合上了。你记住了每一个字，这让人不安。|书给你看了一张你本不该看懂的图。你看懂了。}
# en: {~The book slams shut and a lamp comes on two floors down. You're gone before it reaches the stair.|The pages scream, briefly. You leave quickly, and hope nobody heard.}
opt.left.say.2 [4c4306] = {~书啪地合上，楼下两层亮起一盏灯。等它照到楼梯，你已经走了。|书页短促地尖叫了一声。你赶紧离开，但愿没人听见。}
# en: Leave it open and go
opt.right.label [a40ffc] = 让它开着，离开
# en: {~You back away from the book. It seems disappointed.|You leave it open for whoever it was waiting for. It wasn't you, you decide.}
opt.right.say.1 [43824e] = {~你从书前退开。它似乎很失望。|你让它摊着，留给它在等的人。你认定那不是你。}

@event midnight_observatory_stars
# en: Stars at Midnight
title [aa78c1] = 午夜的星星
# en: The observatory roof at midnight is the quietest place in the castle. {bonds(partner) > 0: You've brought someone.|The stars are very close tonight.} Nobody comes up here after curfew, mostly.
text [ef69f2] = 午夜的观星台屋顶是城堡里最安静的地方。{bonds(partner) > 0: 你带了个人来。|今晚星星离得很近。}宵禁之后，基本上没人上来。
# en: The observatory roof at midnight, a student lying on the leads, the sky thick with stars.
scene [1bfcc3] = 午夜的观星台屋顶，一个学生躺在铅皮屋面上，满天繁星。
# en: Stay until the sky turns
opt.left.label [6b603a] = 待到天色转亮
# en: {~You count stars until you lose count, and then until the sky goes grey. You'll be tired. It was worth it.|A meteor, then another. You stay until the first bell.}
opt.left.say.1 [8ea599] = {~你数星星数到数乱了，又一直数到天色发灰。你会很累。值得。|一颗流星，又一颗。你一直待到第一声钟响。}
# en: An hour, then bed
opt.right.label [d38b58] = 待一个钟头就睡
# en: {~An hour of stars, and you're back in bed before anyone stirs, you think.|You slip back down the stair, the sky still in your eyes. A lantern turns a far corner, and you don't wait to see whose.}
opt.right.say.1 [a31603] = {~看了一个钟头星星，你回到床上时还没人醒——你是这么想的。|你溜下楼梯，眼里还满是星空。远处拐角转过一盏提灯，你没等着看是谁的。}

@event midnight_passage_mapping
# en: The Passage After Dark
title [8077de] = 入夜后的密道
# en: Behind the third gargoyle the passage is busier at midnight than at noon. {met(corvin): Corvin's chalk marks are fresh.|Someone's chalk marks are fresh.} A draught comes from a direction that has no wall.
text [77c2e1] = 第三座石像鬼后面的密道，午夜比正午还热闹。{met(corvin): 科尔文的粉笔记号还是新的。|有人的粉笔记号还是新的。}一阵风从一个没有墙的方向吹来。
# en: A secret passage behind a gargoyle at midnight, chalk marks on the walls, a candle guttering in a draught from nowhere.
scene [e3c614] = 午夜石像鬼后的密道，墙上有粉笔记号，一支蜡烛在不知从哪来的风里摇曳。
# en: Follow the draught
opt.left.label [989dda] = 顺着风走
# en: {~The draught leads you to a door you've never seen, and then, politely, closes it.|A new turning, a new stair. You chalk it for the map.}
opt.left.say.1 [8bc3e0] = {~风把你领到一扇你从没见过的门前，然后礼貌地把它关上了。|一个新的拐角，一段新的楼梯。你用粉笔记下来，画进地图。}
# en: {~After an hour of cold stone, the passage lets you out somewhere unexpected: the prefects' corridor, empty, you hope.|You get lost for an hour and come out in the wrong tower, cold and dusty, and not alone on the stair.}
opt.left.say.2 [84c0e8] = {~在冰冷的石头间走了一个钟头后，密道把你放到了一个意想不到的地方：级长的走廊，但愿是空的。|你迷路了一个钟头，从错误的塔里钻出来，又冷又满身灰，楼梯上还不止你一个人。}
# en: Mark it and go back
opt.right.label [776869] = 做个记号就回去
# en: {~You chalk an arrow at the turning and leave the rest for another night.|You mark it on your copy of the map and go back to bed, a little sorry.}
opt.right.say.1 [c06aa7] = {~你在拐角处用粉笔画了个箭头，剩下的留给下一个夜晚。|你在自己那份地图上做了记号，回去睡觉，有点遗憾。}
