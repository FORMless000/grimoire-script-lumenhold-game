# Lumenhold Academy — 简体中文 (zh-CN) translation of content/events/breaks.grim
# Maintained by `node tools/grim.js i18n zh-CN`. Translate the text after "="; keep {tokens}.
# "# en:" shows the English source. [hash] marks the English version a line was translated from;
# lines marked STALE need updating — after fixing the text, delete the [hash] and re-run the tool.


@event brk_one_long_table
# en: One Long Table
title [ca265b] = 一张长桌
# en: {season == "winter": The Great Hall has given up on house tables for the break. Everyone left eats at one long table by the fire: a handful of students, two professors and a cook who sits down with you, which nobody has ever seen.|Half the candles are out for the summer. The few of you left eat at one long table under the one lit chandelier, and the cook brings out whatever she likes.} {~Someone has started a game of passing the salt without asking.|A professor tells a story about the founders that is almost certainly libel.|The cook asks everyone what they'd change about her soup. Only one answer is the right one.}
text [8bb643] = {season == "winter": 假期里，大礼堂放弃了按学院分桌。留下的人都在炉火边的一张长桌上吃饭：几个学生，两位教授，还有一位跟你们坐在一起吃饭的厨娘，这事以前从没人见过。|夏天，一半的蜡烛都熄了。留下的寥寥几人在唯一亮着的吊灯下围着一张长桌吃饭，厨娘想端什么就端什么。} {~有人开始了一个不打招呼就传盐的游戏。|一位教授讲了个关于创始人的故事，几乎肯定是诽谤。|厨娘问每个人会怎么改她的汤。只有一个答案是对的。}
# en: A vast empty dining hall with a single long table at one end, a handful of students and staff eating together under one chandelier.
scene [0a13a6] = 一间空旷的巨大餐厅，一端只摆着一张长桌，几个学生和教职员在同一盏吊灯下一起吃饭。
# en: Stay for the whole evening
opt.left.label [af8c47] = 待一整晚
# en: {~You stay until the fire is embers, and learn more about the staff in one evening than in a term. Your reading waits on the bench, unread.|You stay and talk until the cook throws you all out. It's the best supper of the year, and your essay notes never leave your bag.|You stay, and the table gets louder and warmer, and you forget the work you came down meaning to do.}
opt.left.say.1 [be2a51] = {~你一直待到炉火只剩余烬，一个晚上了解的教职员比一整个学期还多。你的书搁在长凳上，一页没读。|你一直聊到厨娘把你们全轰出去。这是一年里最好的一顿晚饭，你的论文笔记一次也没从包里拿出来。|你待着，长桌越来越热闹、越来越暖和，你忘了下楼时本打算做的功课。}
# en: Eat, then go and work
opt.right.label [46534a] = 吃完就去用功
# en: {~You eat fast and go back to your books. Through the floor, later, you can hear them laughing.|You take your bowl up to the library. The laughter follows you up the stairs, then thins.|You thank the cook, slip out, and get a good evening's work done in the quiet. It is very quiet.}
opt.right.say.1 [5c3615] = {~你吃得飞快，回去看书了。后来，隔着地板，你能听见他们在笑。|你端着碗上了图书馆。笑声跟着你上了楼梯，然后渐渐稀了。|你谢过厨娘，溜了出来，在安静里做了一晚上好功课。非常安静。}

@event brk_kitchen_pie
# en: The Cook's Holiday Pie
title [680b1c] = 厨娘的节日馅饼
# en: The kitchens are nearly empty for the break, and the cook has decided to make the pie she never has time for in term: a pie the size of a cartwheel, with {season == "winter": a frost-apple filling and pastry stars on top.|a summer-berry filling and a pastry lake on top, with a pastry boat.} She looks at you. "Hands," she says. "Washed."
text [fe7f29] = 假期里厨房几乎空了，厨娘决定做那个她在学期里从来没空做的馅饼：一个车轮那么大的馅饼，{season == "winter": 霜苹果馅，上面盖着酥皮星星。|夏日莓果馅，上面盖着一片酥皮湖，湖上还有一条酥皮小船。} 她看着你。“手，”她说。“洗干净。”
# en: A steamy castle kitchen, a red-faced cook rolling out pastry the size of a tabletop, a student up to the elbows in flour.
scene [1e70a4] = 热气腾腾的城堡厨房里，一个红脸厨娘在擀一张桌面大的酥皮，一个学生两条胳膊沾满了面粉。
# en: Help with the pastry
opt.left.label [e46b4e] = 帮忙做酥皮
# en: {~You roll and crimp and get flour in your eyebrows. The pie is enormous and lopsided, and the cook says it's the best she's made. You get the first slice.|Making pastry is just alchemy with butter, you realise. The cook agrees, and gives you a slice to prove it.|You stamp out pastry stars until your arms ache. The pie is glorious. You eat too much of it.}
opt.left.say.1 [9d54ad] = {~你擀、捏边，眉毛上都沾了面粉。馅饼巨大又歪斜，厨娘说这是她做过最好的。你分到了第一块。|你意识到，做酥皮就是加了黄油的炼金术。厨娘同意，还给了你一块来证明。|你压酥皮星星压到胳膊发酸。馅饼美极了。你吃得太多了。}
# en: Lick the bowl and run
opt.right.label [4308ed] = 舔完碗就跑
# en: {~You take the bowl, a spoon and your leave. The cook shouts after you, without much heat.|The bowl is the best part of any pie, and you're not ashamed. The cook pretends to be furious.|You steal the bowl and eat it on the stairs. It's worth every word she says.}
opt.right.say.1 [74d46e] = {~你拿了碗、一把勺子，然后告辞。厨娘在后面喊你，没什么火气。|碗才是任何馅饼最好的部分，你一点也不害臊。厨娘假装气坏了。|你偷了碗，坐在楼梯上吃。她说的每一句都值得。}

@event brk_courtyard_quiet
# en: The Empty Courtyard
title [0a74ee] = 空荡荡的庭院
# en: {season == "winter": Snow has filled the courtyard knee-deep and nobody has dug a path. The fountain is a cake of ice with a frozen fish in it, looking surprised.|The courtyard bakes in the sun with nobody to cross it. The fountain is low and warm, and a cat has claimed the rim.} You can hear the castle breathe.
text [c63e1e] = {season == "winter": 雪在庭院里积到膝盖深，没人铲出一条路。喷泉成了一块冰糕，里面冻着一条鱼，一脸惊讶。|庭院在太阳下烤着，没人穿过。喷泉的水很低，温温的，一只猫占了它的边沿。} 你能听见城堡在呼吸。
# en: A castle courtyard with no one in it, the fountain still, a single student sitting on its rim.
scene [039ad2] = 一座空无一人的城堡庭院，喷泉静止着，只有一个学生坐在它的边沿上。
# en: Make the first tracks
opt.left.label [8ee2c2] = 踩出第一行脚印
# en: {season == "winter": You wade across it on purpose, then back, then in a large figure of eight. Tomorrow someone will wonder who did it, and you'll know.|You walk every flagstone you've hurried across all term, slowly, barefoot. The stones are hot, and so are your soles.}
opt.left.say.1 [9a1478] = {season == "winter": 你故意蹚过去，又蹚回来，然后踩出一个大大的八字。明天会有人好奇是谁干的，而你会知道。|你光着脚，慢慢走过整个学期里匆匆穿过的每一块石板。石头很烫，你的脚底也很烫。}
# en: Sit and do nothing
opt.right.label [4e16b2] = 坐着什么都不做
# en: {season == "winter": You sit on the fountain's icy rim and watch the snow land on nothing. Your feet go numb. You don't mind.|You sit by the cat and do nothing until the shadows move. The cat permits it.}
opt.right.say.1 [0ffe63] = {season == "winter": 你坐在喷泉结冰的边沿上，看雪落在空处。你的脚冻麻了。你不在乎。|你在猫旁边坐着，什么都不做，直到影子挪了位置。猫准许了。}

@event brk_snowball_bram
# en: Bram in the Snow
title [fee04c] = 雪中的布拉姆
# en: Bram has stayed for the break, and he is patrolling an empty courtyard because somebody must. He is writing in his ledger. There is nobody to write down. You have a snowball in your hand, and you don't remember making it.
text [8f2ddc] = 布拉姆假期留了下来，他在一个空荡荡的庭院里巡逻，因为总得有人巡。他在账本上写东西。没有人可以记。你手里有一个雪球，你不记得什么时候捏的。
# en: A stern prefect with a red sash brushing snow off his ledger in a snowy courtyard, a snowball clearly having just hit him.
scene [64e10d] = 雪中的庭院里，一个系红肩带的严肃级长正拍掉账本上的雪，显然刚被一个雪球砸中。
# en: Throw it
opt.left.label [542258] = 扔出去
# en: It takes his sash clean off. For a moment his face is outraged. Then he puts down the ledger, very deliberately, and makes a snowball of his own. Twenty minutes later you're both soaked, and he's laughing, and he'll deny it by Monday.
opt.left.say.1 [814d30] = 它把他的肩带直接打飞了。有那么一刻他一脸愤怒。然后他非常刻意地放下账本，自己捏了一个雪球。二十分钟后，你们俩都湿透了，他在笑，而到星期一他会否认这件事。
# en: Drop it and say hello
opt.right.label [02d583] = 扔掉它，打个招呼
# en: "Prefect." "Student." He looks at the snowball melting at your feet, and at you. "Very wise," he says, and walks on, and you think, just possibly, he was disappointed.
opt.right.say.1 [235f5b] = “级长。”“同学。”他看看你脚边正在化的雪球，又看看你。“非常明智，”他说，然后走开了，你觉得，说不定，他有点失望。

@event brk_library_alone
# en: The Library to Yourself
title [67cd41] = 独享图书馆
# en: The library is yours. No queue for the good desk, no whispering, no one shelving loudly in the next row. Even the librarian's cat has gone off duty, and is asleep on the returns cart.
text [dd19fc] = 图书馆是你的了。好座位不用排队，没有窃窃私语，隔壁一排也没人哐哐地上架。连图书管理员的猫都下班了，在还书车上睡着。
# en: A huge empty library with long shafts of light, one student lying on the floor between the stacks with a book held up overhead.
scene [735b83] = 一座空旷的巨大图书馆，长长的光柱，一个学生躺在书架之间的地板上，把一本书举在头顶。
# en: Read for the exams
opt.left.label [6d9dfd] = 为考试读书
# en: {~You work through the term's reading list in a week. It's dull, and your next exam will thank you.|You take the good desk and keep it all break, and the reading gets done.|You read until the light goes, and get further than you have all term.}
opt.left.say.1 [ed946b] = {~你一个星期就读完了这学期的书单。很枯燥，你的下一场考试会感谢你。|你占了好座位，整个假期都没让出去，书也读完了。|你一直读到天黑，比这一整个学期读得都远。}
# en: Read whatever you like
opt.right.label [419fa9] = 想读什么读什么
# en: {~You read a history of the castle's drains, a book of Northern poems and half a novel. None of it is on any syllabus. All of it is wonderful.|You find a shelf of old letters bound into books, and read strangers' lives all afternoon.|You read lying on the floor between the stacks, which you've wanted to do since your first week.}
opt.right.say.1 [53dec4] = {~你读了一本城堡排水系统史、一本北方诗集，还有半本小说。没有一本在任何课程大纲上。每一本都很棒。|你找到一架装订成书的旧信件，一下午都在读陌生人的人生。|你躺在书架之间的地板上读书，这事你从入学第一周就想干了。}

@event brk_kael_shore
# en: Kael at the Water
title [348fe9] = 水边的凯尔
# en: Kael hasn't gone home for the break. He doesn't say why, and you don't ask. He's on a rock by the lake, skimming stones that leave a trail of frost across the water, and he moves up to make room without looking round.
text [d97fe6] = 凯尔假期没有回家。他没说为什么，你也没问。他坐在湖边的一块石头上打水漂，石子在水面上留下一道霜痕，他没回头，往旁边挪了挪给你腾地方。
# en: A pale Northern student sitting alone on a rock at a lake's edge, skimming stones, frost on the stones around him.
scene [cc4fa1] = 一个苍白的北方学生独自坐在湖边的一块石头上打水漂，周围的石头上结着霜。
# en: Sit with him
opt.left.label [6fadbf] = 陪他坐着
# en: {~You sit. The rock is cold. Neither of you says much, and after a while he hands you a stone, and you skim it, badly. He almost smiles.|You sit with him until the light goes. Somewhere in the second hour, he starts talking about snow, and doesn't stop for a long time.}
opt.left.say.1 [1c2969] = {~你坐下了。石头很冷。你们俩都没怎么说话，过了一会儿他递给你一颗石子，你打了个水漂，打得很糟。他几乎笑了。|你陪他坐到天黑。第二个小时里的某个时候，他开始讲雪，讲了很久很久。}
# en: Leave him his quiet
opt.right.label [c00de6] = 让他一个人静静
# en: {~You leave him to the stones. From the path you look back: his trail of frost is still going out across the lake, further than seems possible.|He's earned his quiet. You let him have it, and feel the lack of the company all evening.}
opt.right.say.1 [26e26b] = {~你让他继续打水漂。你从小路上回头看：他那道霜痕还在往湖心延伸，远得不像是可能的。|这份安静是他应得的。你让给了他，整个晚上都觉得少了个伴。}

@event brk_starfall_observatory
# en: Starfall, Almost Alone
title [837b59] = 星落，几乎独自一人
# en: Starfall, and almost nobody left to see it. Seraphine is lying on the observatory floor with the dome open, watching the stars fall. "I painted this," she says, without looking at you. "Last spring. I didn't know you'd be in it."
text [7ef3b7] = 星落时节，却几乎没人留下来看。瑟拉芬躺在观星台的地板上，穹顶打开着，看星星落下。“我画过这个，”她没看你就说。“去年春天。我不知道你会在画里。”
# en: An observatory dome open to a sky full of falling stars, a seer in a paint-stained smock lying on the floor looking up.
scene [bc5085] = 观星台的穹顶向满是流星的天空敞开，一个穿着沾满颜料的罩衫的预言者躺在地板上仰望。
# en: Lie down beside her
opt.left.label [7eadc8] = 在她身边躺下
# en: {~You lie on the cold floor beside her and count stars until you lose count, and then keep going. Somewhere around midnight she says, "That's the one," and doesn't say which.|You lie and watch. She tells you which ones she's already seen fall, last spring, in paint.}
opt.left.say.1 [8d13eb] = {~你在她身边冰冷的地板上躺下，数星星数到数乱了，然后接着数。快到午夜时，她说：“就是那颗，”却没说是哪颗。|你躺着看。她告诉你哪些她已经见过落下了，去年春天，在颜料里。}
# en: Ask what else she painted
opt.right.label [1a2506] = 问她还画了什么
# en: {~"Nothing you'd want to know," she says, too quickly. She goes back to the stars. So do you, but it isn't quite the same.|She shakes her head and points at the sky. "Watch. Don't ask. That's the whole trick."}
opt.right.say.1 [3c0e43] = {~“你不会想知道的，”她说得太快了。她又看向星星。你也是，可感觉不太一样了。|她摇摇头，指着天空。“看着。别问。诀窍就这些。”}

@event brk_mir_project
# en: The Break Project
title [dab2a2] = 假期作品
# en: Mir has had the workshop to themself for a week and it shows. In the middle of the floor is something the size of a wardrobe with too many gears. "It's a machine," Mir says, "for turning pages. Any book. Hands free." It's very loud. "It's not finished."
text [b0c454] = 米尔独占工坊一个星期了，看得出来。地板中央有个衣柜那么大的东西，齿轮多得过分。“这是一台机器，”米尔说，“用来翻书。任何书。不用手。”它非常吵。“还没做完。”
# en: A cluttered workshop with a half-built clockwork machine the size of a wardrobe, an artificer in goggles waving a spanner.
scene [8dadc7] = 杂乱的工坊里有一台衣柜大小、做了一半的发条机器，一个戴护目镜的工匠挥着一把扳手。
# en: Hold the spanner
opt.left.label [53ea92] = 帮忙拿扳手
# en: {~You hold the spanner, then the lamp, then a gear that's hotter than it looks. By midnight the machine turns one page, beautifully, and then eats the book. Mir is ecstatic.|You spend the evening as Mir's assistant, which mostly means holding things and being told about them. It's the best kind of evening.}
opt.left.say.1 [a97b4e] = {~你拿着扳手，然后是灯，然后是一个比看起来烫的齿轮。到午夜，机器漂亮地翻了一页，然后把书吃了。米尔欣喜若狂。|你当了一晚上米尔的助手，主要就是拿东西、听他们讲这些东西。这是最好的那种夜晚。}
# en: Suggest a smaller machine
opt.right.label [7d7fb3] = 建议做台小一点的
# en: {~"Smaller," Mir repeats, as if you'd said "duller". But they write it down, and when you come back, the wardrobe is gone and there's a thing the size of a teacup that turns pages very politely.|Mir sulks for an hour, and then admits you're right, and then sulks about that.}
opt.right.say.1 [993277] = {~“小一点，”米尔重复道，好像你说的是“无聊一点”。可TA还是记了下来，等你再来时，衣柜不见了，取而代之的是一个茶杯大小的东西，翻书翻得非常有礼貌。|米尔赌气赌了一个小时，然后承认你是对的，然后又为这个赌气。}

@event brk_holiday_edition
# en: The Holiday Edition
title [f456fa] = 假日特刊
# en: Nessa is putting out a holiday edition of the Ledger for the eleven people still in the castle. There is no news. Her quill keeps trying to invent some. "Give me a story," Nessa says. "Anything. Please. Before it writes that the lake has resigned."
text [b68e45] = 内莎在给城堡里剩下的十一个人出一期《流明纪事报》假日特刊。没有新闻。她的羽毛笔一直想编点出来。“给我一个故事，”内莎说。“什么都行。求你了。趁它还没写出湖辞职了。”
# en: A cluttered newspaper office in an empty castle, an editor with ink on her nose surrounded by blank pages, a quill hovering.
scene [e55499] = 空荡荡的城堡里一间杂乱的报社办公室，一个鼻尖沾着墨水的编辑被空白的稿纸围着，一支羽毛笔悬在空中。
# en: Give her a real one
opt.left.label [9dd190] = 给她一个真故事
# en: {~You tell her about the cook's pie. She makes it the front page. It sells out, all eleven copies.|You give her the snowball fight. She runs it with a drawing. Bram buys three copies and pretends not to.}
opt.left.say.1 [1c1d74] = {~你跟她讲了厨娘的馅饼。她把它做成了头版。全部卖光，十一份。|你把打雪仗的事给了她。她配了张插图登了出来。布拉姆买了三份，还假装没买。}
# en: Let the quill have its way
opt.right.label [239ac7] = 让羽毛笔随便写
# en: {~The quill writes that the lake has resigned and been replaced by a smaller, more manageable pond. Nessa prints it under protest. It's the most-read edition of the year.|The quill invents a romance between two gargoyles. Nessa refuses to print it, and then prints it.}
opt.right.say.1 [0e69c3] = {~羽毛笔写道，湖辞职了，由一个更小、更好管的池塘接任。内莎抗议着把它印了出来。这是一年里读的人最多的一期。|羽毛笔编了一段两座石像鬼之间的恋情。内莎拒绝印，然后还是印了。}

@event brk_duel_trophies
# en: Polishing the Trophies
title [2b8187] = 擦奖杯
# en: The duelling hall is empty except for the trophy cabinets, which are open, and a bucket of polish with a note on it: "Volunteers. —Thorne". Two hundred years of cups and shields stare at you, tarnished.
text [cb6253] = 决斗厅里空空荡荡，只有敞开着的奖杯柜，和一桶擦亮剂，上面贴着一张纸条：“志愿者。——索恩”。两百年的奖杯和盾牌暗淡无光地盯着你。
# en: An empty duelling hall, trophy cabinets standing open, a student polishing a silver cup with a cloth.
scene [15b247] = 空荡荡的决斗厅里，奖杯柜敞开着，一个学生正用布擦一只银杯。
# en: Polish them all
opt.left.label [a53131] = 全部擦一遍
# en: {~It takes all afternoon. Halfway through you find a cup won by a student from your own corner of the country, a hundred years ago. You polish that one twice.|By the end your arms ache and the cabinets shine. Thorne, passing, nods once at the work. It feels like an honour.}
opt.left.say.1 [ffd443] = {~擦了一整个下午。擦到一半，你发现一只奖杯是一百年前一个和你同乡的学生赢的。那一只你擦了两遍。|到最后你胳膊酸了，柜子亮了。索恩路过，冲这活儿点了一下头。感觉像一份荣誉。}
# en: Read the names instead
opt.right.label [f8d714] = 改读名字
# en: {~You read every name on every cup instead. Some of them are on portraits in the halls. One of them is carved on the bench you sit on every morning.|You read the names and the years, and the losers' names scratched underneath by someone with a grudge. It's a whole history, written in spite.}
opt.right.say.1 [5f3655] = {~你转而读了每只奖杯上的每个名字。有些人的肖像挂在走廊里。其中一个名字刻在你每天早上坐的那张长凳上。|你读名字和年份，还有被某个记仇的人刻在下面的输家的名字。这是一整部历史，用怨气写成。}

@event brk_amaranth_restock
# en: Restocking the Infirmary
title [47f8a6] = 补充医务室
# en: With the beds empty for the break, Sister Amaranth is restocking the infirmary from the bottom shelf to the top. She hands you a list and a ladder. "Count everything," she says. "Then count it again. The second count is the true one."
text [0b7ad8] = 假期里病床都空了，阿玛兰斯修女正在从最底层到最顶层补充医务室的存货。她递给你一张清单和一架梯子。“全部数一遍，”她说。“然后再数一遍。第二遍才是真的。”
# en: A healer in a white apron counting jars on high shelves in an empty infirmary, a student up a ladder handing them down.
scene [ceb987] = 空荡荡的医务室里，一个系白围裙的医者在清点高处架子上的罐子，一个学生站在梯子上往下递。
# en: Count everything twice
opt.left.label [61f8f1] = 全部数两遍
# en: {~You count salves and tinctures until you dream in labels. The second count is different from the first in three places. Amaranth is not surprised.|By the end you know where every remedy in the castle lives. That will be useful, one day, at the worst possible time.}
opt.left.say.1 [2e18a1] = {~你数药膏和酊剂，数到做梦都是标签。第二遍和第一遍有三处不一样。阿玛兰斯并不意外。|到最后你知道了城堡里每一种药放在哪儿。总有一天这会派上用场，在最糟糕的时候。}
# en: Ask her about the strange jars
opt.right.label [76a103] = 问她那些奇怪的罐子
# en: {~She tells you what's in the black jar on the top shelf, and then why it's on the top shelf. You come down the ladder very carefully.|"That one," she says, "is for a curse we haven't had since my first year. I keep it in case." She doesn't say which curse.}
opt.right.say.1 [a178dc] = {~她告诉你顶层那只黑罐子里装的是什么，然后告诉你它为什么放在顶层。你下梯子的时候非常小心。|“那一罐，”她说，“是治一种诅咒的，从我入职第一年以后就没再见过。我留着以防万一。”她没说是哪种诅咒。}

@event brk_stables_round
# en: The Feeding Round
title [8c5ca0] = 喂食巡视
# en: Most of the stable hands have gone home, so Professor Brask does the feeding round herself, at dawn, every day. She doesn't ask for help. She hands you a bucket anyway.
text [8daf28] = 大部分马夫都回家了，所以布拉斯克教授每天黎明亲自巡视喂食。她不叫人帮忙。她还是递给了你一只桶。
# en: A stable in winter or summer with every stall occupied, a professor and a student carrying buckets down the long aisle at dawn.
scene [a98b67] = 冬天或夏天的马厩里每个隔栏都住着，黎明时分，一位教授和一个学生拎着桶走在长长的过道上。
# en: Do the whole round
opt.left.label [e3ddd4] = 走完整个巡视
# en: {~You carry buckets until your shoulders burn. The hippogriffs eat out of your hand by the end. Brask says nothing, which from her is a speech.|You do the round, then the next day's round. On the third day a griffon lets you scratch its neck. Brask raises an eyebrow, impressed.}
opt.left.say.1 [3e4679] = {~你拎桶拎到肩膀火辣辣的。到最后，鹰头马身有翼兽们都从你手里吃东西了。布拉斯克什么都没说，从她嘴里出来，这就是一篇演讲。|你走完一轮，又走了第二天的一轮。第三天，一只狮鹫让你挠了它的脖子。布拉斯克挑了挑眉，很是佩服。}
# en: Feed the old ones slowly
opt.right.label [915d3e] = 慢慢喂那些老家伙
# en: {~You spend the whole round with the oldest horse, who takes a full hour to eat and is worth every minute.|You feed the elderly creatures at the end of the row by hand. Brask lets you. "They don't get visitors," she says.}
opt.right.say.1 [630f1b] = {~你整个巡视都陪着最老的那匹马，它吃一顿要整整一个小时，每一分钟都值得。|你亲手喂这一排尽头那些上了年纪的动物。布拉斯克由着你。“它们没人来看，”她说。}

@event brk_corridors_echo
# en: The Echo
title [ae6b95] = 回声
# en: With nobody on the stairs, the lecture tower echoes like a well. You say "hello" on the first landing and it comes back, a moment later, from somewhere near the top, in a voice that isn't quite yours.
text [b26436] = 楼梯上没人，讲堂塔里的回声像井一样。你在第一个平台上说“你好”，过了一会儿，它从靠近塔顶的某个地方传回来，用的声音不太像你的。
# en: An empty spiral staircase in a castle tower, a student halfway up shouting a word and listening to it come back.
scene [9bd24e] = 城堡塔楼里空荡荡的旋转楼梯，一个学生站在半中间喊出一个词，听它传回来。
# en: Run all the stairs
opt.left.label [c80c48] = 把楼梯全跑一遍
# en: {~You race your own echo to the top and lose. You lie on the top landing, wheezing, while it laughs at you on the way down.|You run up and down until you can't. The echo keeps going a while without you.}
opt.left.say.1 [922018] = {~你跟自己的回声比赛跑到塔顶，输了。你躺在顶层平台上喘气，它一路笑着下去了。|你上上下下跑到跑不动。回声没有你也接着跑了一会儿。}
# en: Talk to the echo
opt.right.label [d7b254] = 跟回声说话
# en: {~You ask the echo a question. It answers a different one. You spend an hour trying to work out which.|You tell the echo your name. It tells you someone else's, very faintly. You look it up later. A student from a hundred years ago.}
opt.right.say.1 [144ba8] = {~你问了回声一个问题。它回答了另一个问题。你花了一个小时琢磨是哪一个。|你把你的名字告诉回声。它很轻很轻地告诉你另一个人的名字。后来你去查了。一个一百年前的学生。}

@event brk_corvin_route
# en: The Holiday Route
title [c677a5] = 假日路线
# en: Corvin is in the passage behind the third gargoyle with a lantern and a grin. "Holidays," he says, "are when the castle forgets to lock things. I've found three doors this week. One of them goes to a room full of hats." He offers you the lantern.
text [666369] = 科尔文在第三座石像鬼后面的通道里，提着灯笼，咧着嘴笑。“假期，”他说，“就是城堡忘了锁门的时候。我这个星期找到了三扇门。其中一扇通到一间全是帽子的屋子。”他把灯笼递给你。
# en: A lanky student with a lock-pick behind one ear grinning beside a narrow secret passage behind a gargoyle, holding a lantern.
scene [e60ce7] = 一个耳后夹着撬锁针的瘦高学生提着灯笼，在石像鬼后面一条狭窄的密道旁咧嘴笑着。
# en: Take the lantern
opt.left.label [3ae185] = 接过灯笼
# en: {~The room full of hats is real. So is a second room, full of umbrellas, and a third you don't talk about. You put everything back. Mostly.|You explore until dawn. Corvin draws a map on the back of his hand and loses half of it washing.}
opt.left.say.1 [50900a] = {~全是帽子的屋子是真的。还有第二间，全是雨伞，以及第三间，你们闭口不提。你把东西都放回去了。大部分吧。|你探索到天亮。科尔文在手背上画了张地图，洗手时洗掉了一半。}
# en: Keep him company, not the route
opt.right.label [1f06d8] = 陪他聊天，不走路线
# en: {~You sit in the passage and talk instead. He tells you about the doors he hasn't tried, and why, and it's more interesting than the doors.|You stay with the lantern while he goes. He comes back with a hat. It suits you.}
opt.right.say.1 [cffcc7] = {~你坐在通道里跟他聊天。他跟你讲那些他还没试过的门，以及为什么没试，这比门本身还有意思。|他去探路时你守着灯笼。他回来时带了一顶帽子。挺适合你的。}

@event home_cottage_rain
# en: Rain on the Roof
title [7c62e7] = 屋顶上的雨
# en: {season == "winter": Sleet on the roof all day, and nobody going anywhere.|A summer storm, sudden and loud, and the whole house shut in together.} {~Someone gets the old cards out.|Someone starts telling a story you've heard a hundred times.}
text [1183cd] = {season == "winter": 雨夹雪打了一整天屋顶，谁也出不去。|一场夏日暴雨，来得又急又响，全家人都被关在了一起。} {~有人拿出了那副旧扑克牌。|有人开始讲一个你听过一百遍的故事。}
# en: A cottage kitchen in heavy rain, a family playing cards around the table, a kettle steaming.
scene [5899bb] = 大雨中的小屋厨房，一家人围着桌子打牌，水壶冒着热气。
# en: Play every hand
opt.left.label [4c6199] = 每一局都打
# en: {~You lose three hands, win one, and lose the winnings in the next. Your family cheats outrageously. You remember why you love them.|You play until the rain stops, and then a few more, and pay your debts in coppers.}
opt.left.say.1 [be2e97] = {~你输了三局，赢了一局，又在下一局把赢的输了回去。你的家人明目张胆地作弊。你想起了你为什么爱他们。|你一直打到雨停，又多打了几局，用铜板还清了债。}
# en: Read by the window
opt.right.label [9776cf] = 靠窗读书
# en: {~You read by the rain-streaked window while the cards go on behind you. Every so often someone asks you to settle an argument, and you lose your page.|You get through a whole book while the storm goes over. Somebody saves you the last biscuit, and somebody else eats it.}
opt.right.say.1 [8ba445] = {~你在被雨打湿的窗边读书，身后的牌局还在继续。时不时有人让你评理，你就找不到读到哪儿了。|暴雨过去的时候，你读完了一整本书。有人给你留了最后一块饼干，又有人把它吃了。}

@event home_cottage_photograph
# en: The Picture on the Mantel
title [4f9289] = 壁炉架上的画像
# en: There's a new picture on the mantel: you, on the day you left for the academy, in robes two sizes too big. {final_year: It looks like someone else's child now.|You look terrified. You were.} Someone has polished the frame.
text [6b5ed3] = 壁炉架上多了一张新画像：你，出发去学院那天，穿着大了两号的长袍。{final_year: 现在看起来像别人家的孩子了。|你看上去吓坏了。你当时确实吓坏了。} 有人把画框擦得锃亮。
# en: A small framed picture on a cottage mantelpiece of a child in oversized robes, a student holding it and smiling ruefully.
scene [f8921f] = 小屋壁炉架上一幅小小的画像，画里的孩子穿着过大的长袍，一个学生拿着它，苦笑着。
# en: Tell them what it's really like
opt.left.label [b5aa1f] = 告诉他们那里真实的样子
# en: {~You tell them about the stairs that move, the professor who throws chalk, the friend who can't make toast. They laugh in the right places, and look worried in the others.|You tell them everything you can, and not the rest. They know there's a rest. They let you keep it.}
opt.left.say.1 [94a95d] = {~你跟他们讲会动的楼梯，扔粉笔的教授，烤不好面包的朋友。他们在该笑的地方笑，在别的地方一脸担心。|你把能说的都告诉了他们，剩下的没说。他们知道还有剩下的。他们让你留着。}
# en: Put it back and say nothing
opt.right.label [b2ea95] = 放回去，什么都不说
# en: {~You put it back, straighter. Later, you see someone straighten it again.|You put it back. Some things are better on a mantel than said out loud.}
opt.right.say.1 [b9954e] = {~你把它放回去，摆得更正了些。后来，你看见有人又把它摆正了一次。|你把它放了回去。有些事放在壁炉架上，比说出口要好。}

@event home_fields_harvest_help
# en: All Hands
title [b6ce9a] = 全员上阵
# en: {season == "winter": The neighbours are clearing a fallen tree from the far field before the thaw, and every pair of hands is wanted.|The neighbours are getting in a late crop before the weather turns, and every pair of hands is wanted.} You still remember how. Your back remembers more.
text [d30748] = {season == "winter": 邻居们要在解冻前把一棵倒在远处田里的树清走，每一双手都用得上。|邻居们要赶在天气变坏前收完一茬晚熟的庄稼，每一双手都用得上。} 你还记得怎么干。你的腰记得更清楚。
# en: A field at harvest or a frozen field being cleared, neighbours working in a line, a student in academy boots among them.
scene [ffad2e] = 一片收获中或正在清理的冰冻田地，邻居们排成一行干活，一个穿学院靴子的学生夹在中间。
# en: Work the whole day
opt.left.label [2345e2] = 干上一整天
# en: {~By sunset you're filthy and aching, the job is done, and a neighbour presses a coin on you you can't refuse.|You work till dark. Nobody mentions the academy once, and you like that more than you expected.}
opt.left.say.1 [b939a0] = {~到日落时你又脏又疼，活儿干完了，一个邻居硬塞给你一枚硬币，你推都推不掉。|你一直干到天黑。没人提过一次学院，你喜欢这样，比你预想的还喜欢。}
# en: Do a bit of quiet magic
opt.right.label [c1bd86] = 用一点悄悄的魔法
# en: {~A little lift here, a little warmth there. The work goes twice as fast. Nobody says anything, but an old neighbour watches your hands the whole time, and doesn't smile.|You make it easier than it should be. The neighbours thank you warily, as if you'd brought a stranger.}
opt.right.say.1 [7cf34a] = {~这里抬一下，那里暖一下。活儿快了一倍。没人说什么，可一位老邻居一直盯着你的手，没有笑。|你让活儿变得比它该有的轻松。邻居们小心翼翼地道谢，好像你带来了一个陌生人。}

@event home_fields_old_friend
# en: Someone You Grew Up With
title [ad478a] = 一起长大的人
# en: {~Someone you grew up with is leaning on the gate at the end of the lane, the way they always did. They're married now.|At the gate, the friend from before. You've both changed; the gate hasn't. They've taken over the mill, and never mean to leave.}
text [faf8cf] = {~一个和你一起长大的人倚在小巷尽头的门边，就像他们以前一直那样。他们结婚了。|门边站着从前的那个朋友。你们都变了；那扇门没变。他们接手了磨坊，从没打算离开。}
# en: Two young people leaning on a field gate at sunset, one in work clothes, one in academy robes, talking easily.
scene [d8bc0d] = 日落时，两个年轻人倚在田间的大门上轻松地聊天，一个穿着干活的衣服，一个穿着学院长袍。
# en: Talk until it's dark
opt.left.label [3e41aa] = 一直聊到天黑
# en: {~You talk until you can't see each other's faces. It's easy, the way it is with people who knew you before you were anyone.|You talk about nothing for two hours. It's the best conversation you've had in months.}
opt.left.say.1 [37edc4] = {~你们聊到看不清彼此的脸。很轻松，就像和那些在你还谁都不是时就认识你的人在一起一样。|你们闲聊了两个小时。这是你几个月来最好的一次谈话。}
# en: Tell them about the academy
opt.right.label [e245d0] = 跟他们讲学院的事
# en: {~They listen politely. Halfway through you notice they've stopped asking questions, and you stop.|You tell them everything. They say "huh" a lot. You realise you're talking about a place they'll never see.}
opt.right.say.1 [72b9ea] = {~他们礼貌地听着。讲到一半你发现他们不再提问了，你就停了。|你把一切都告诉了他们。他们一直说“嗯”。你意识到，你在讲一个他们永远也不会见到的地方。}

@event home_fields_night_sky
# en: The Sky Without Towers
title [bd172d] = 没有塔楼的天空
# en: At home the sky comes right down to the ground on every side. No towers, no observatory dome, just stars from one edge to the other. {month == 11 or month == 12: And Starfall, which looks different out here: closer, somehow, and less like a show.|You'd forgotten how many there are.}
text [0617bd] = 在家里，天空四面八方一直垂到地面。没有塔楼，没有观星台的穹顶，只有从这头到那头的星星。{month == 11 or month == 12: 还有星落，在这里看起来不一样：不知怎么的更近了，也不那么像一场表演了。|你都忘了有这么多。}
# en: A student lying on their back in a dark field at night, the sky enormous and full of stars, no buildings anywhere.
scene [7af3d4] = 夜里，一个学生仰面躺在漆黑的田野上，天空巨大而布满星星，四周没有一座建筑。
# en: Name every one you know
opt.left.label [8ebd51] = 叫出每一颗你认识的
# en: {~You name them until the dew soaks through. You know more than you did last year. You know which ones are lying.|You name them aloud, softly. A fox somewhere across the field barks, as if correcting you.}
opt.left.say.1 [9bd12a] = {~你一颗颗叫着它们的名字，直到露水渗透了衣服。你比去年认识得多了。你知道哪些在撒谎。|你轻声念出它们的名字。田野那头某处一只狐狸叫了一声，像是在纠正你。}
# en: Just lie there
opt.right.label [de0f5b] = 就那样躺着
# en: {~You don't name anything. You just lie there until you're cold, and walk home feeling enormous and very small.|You lie in the grass and let the sky be a sky. It's the first time in months nothing has been a lesson.}
opt.right.say.1 [cfae81] = {~你什么都没叫。你就那样躺着直到冷了，走回家时觉得自己既巨大又渺小。|你躺在草里，让天空只是天空。这是几个月来第一次，什么都不是一堂课。}

@event home_market_stallholder
# en: The Stallholder Remembers
title [c58e20] = 摊主还记得
# en: The cheese-seller remembers you. "The one who went to the magic school!" she tells everyone in earshot. "Do us a trick, then." The whole queue turns round to look.
text [1e19f8] = 卖奶酪的记得你。“去魔法学校的那个！”她冲着所有听得见的人说。“那给我们变个戏法吧。”整个队伍都转过来看。
# en: A country market stall piled with cheeses, a cheerful stallholder pointing at a student and laughing.
scene [2e31f6] = 乡村集市上堆满奶酪的摊位，一个快活的摊主指着一个学生大笑。
# en: Do a small trick
opt.left.label [62f443] = 变个小戏法
# en: {~You make a cheese float, very slightly. The queue applauds. The cheese-seller gives you the cheese. Your family is mortified and proud in equal parts.|You light a candle with a look. A child bursts into tears of joy. You get a discount for life.}
opt.left.say.1 [9563fa] = {~你让一块奶酪浮了起来，就一点点。队伍里响起掌声。卖奶酪的把奶酪送给了你。你的家人又难为情又骄傲，两者不相上下。|你看了一眼就点燃了一根蜡烛。一个孩子喜极而泣。你得到了终身折扣。}
# en: Laugh and buy some cheese
opt.right.label [bd5f9e] = 笑一笑，买点奶酪
# en: {~"Next time," you say, and buy the cheese. She's disappointed and gives you a bigger piece anyway.|You buy the cheese and refuse the trick. The queue loses interest. You're oddly relieved.}
opt.right.say.1 [432ef5] = {~“下次吧，”你说，买了奶酪。她很失望，还是给了你更大的一块。|你买了奶酪，没变戏法。队伍失去了兴趣。你莫名松了口气。}

@event home_market_letter_home
# en: A Letter for the Castle
title [7a2624] = 寄往城堡的信
# en: The market has a post counter, and you find yourself writing a letter to the castle: to someone you miss already. It's strange, missing the castle from home. You didn't expect to.
text [93f070] = 集市上有个邮政柜台，你发现自己在写一封寄往城堡的信：写给一个你已经开始想念的人。在家里想念城堡，这感觉很奇怪。你没料到会这样。
# en: A village post counter at a country market, a student writing a letter on the counter with a borrowed pen.
scene [f0ae59] = 乡村集市上的一个邮政柜台，一个学生用借来的笔在柜台上写信。
# en: Write a long one
opt.left.label [9fc2eb] = 写一封长的
# en: {~You write four pages and pay for the postage twice. It'll arrive before you do, and be read aloud, probably, to people you'd rather it wasn't.|You write until the postmaster coughs. It's a good letter. You'll find out how good when you get back.}
opt.left.say.1 [d69c0b] = {~你写了四页，付了两份邮费。它会比你先到，而且多半会被大声念给一些你宁愿他们没听到的人听。|你一直写到邮政局长咳嗽。是封好信。你回去就知道有多好了。}
# en: Write two lines and go
opt.right.label [0b833a] = 写两行就走
# en: {~"Home is fine. Miss you. See you soon." It's enough. It's more than enough.|You write two lines, then a third, then stop before it turns into a confession.}
