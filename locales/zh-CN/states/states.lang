# Lumenhold Academy — 简体中文 (zh-CN) translation of content/states/states.grim
# Maintained by `node tools/grim.js i18n zh-CN`. Translate the text after "="; keep {tokens}.
# "# en:" shows the English source. [hash] marks the English version a line was translated from;
# lines marked STALE need updating — after fixing the text, delete the [hash] and re-run the tool.


@state origin_noble
# en: Minor Nobility
name [ccd408] = 小贵族出身
# en: A family name that opens doors and an allowance that arrives every month — with letters attached.
desc [f16745] = 一个能敲开大门的姓氏，外加每月准时到账的零花钱——附带家书。

@state origin_scholar
# en: Scholarship Student
name [036234] = 奖学金学生
# en: The Crown pays your way — as long as your standing stays above 30.
desc [287085] = 王室为你支付学费——只要你的学业保持在 30 以上。

@state origin_hedge
# en: Hedge-Witch's Grandchild
name [b36bba] = 乡野女巫的孙辈
# en: Raised among drying herbs and muttered charms. Proper magic still feels a little too proper.
desc [3e1ecc] = 在晾晒的草药和念叨的咒语间长大。正统魔法对你来说，总还是有点太“正统”了。

@state origin_street
# en: Street-Raised
name [9b8f09] = 街头长大
# en: You learned to read crowds before you learned to read runes.
desc [8551b3] = 你学会读懂人群，比学会读懂符文还早。

@state origin_merchant
# en: Merchant's Child
name [a051a5] = 商人之子
# en: Everything has a price, and you were taught to haggle it down.
desc [c5b5c4] = 万物皆有价，而你从小就学会了砍价。

@state class_pyromancy
# en: Elective: Pyromancy
name [bc2cb8] = 选修：火焰术
# en: Fire answers to will, not wishes. Singed eyebrows are considered a rite of passage.
desc [f7cdfd] = 火焰回应意志，而非愿望。烧焦眉毛被视为一种成人礼。

@state class_tidecalling
# en: Elective: Tidecalling
name [25e58c] = 选修：唤潮术
# en: Lessons on the lake shore, bending water and patience in equal measure.
desc [550653] = 在湖岸上课，操纵湖水与磨练耐心，二者同等重要。

@state class_illusion
# en: Elective: Illusion & Glamour
name [b30964] = 选修：幻术与魅影
# en: The art of making people see what you want. Professor Vey insists it is not lying.
desc [7aa865] = 让人看见你想让他们看见的东西的艺术。维伊教授坚称这不算撒谎。

@state class_alchemy
# en: Elective: Practical Alchemy
name [8a43a8] = 选修：实用炼金
# en: Brewing, distilling and the occasional controlled explosion.
desc [4cfafb] = 熬煮、蒸馏，以及偶尔一场受控的爆炸。

@state class_divination
# en: Elective: Divination
name [14ec75] = 选修：占卜学
# en: Tea leaves, star charts and the Mirror of Next Tuesday.
desc [531e06] = 茶叶、星图，还有“下周二之镜”。

@state class_artifice
# en: Elective: Artifice
name [20fedd] = 选修：奇械术
# en: Enchanting objects to do what they were never meant to do.
desc [1d11f0] = 给物品施加魔法，让它们做本不该做的事。

@state class_beastcraft
# en: Elective: Beastcraft
name [664aeb] = 选修：驭兽学
# en: Familiars, griffon husbandry and dodging the manticore pen.
desc [d23187] = 魔宠、狮鹫饲养，以及绕开蝎尾狮的围栏。

@state class_astromancy
# en: Elective: Astromancy
name [58b65d] = 选修：星象学
# en: Midnight lectures on the observatory roof. You will learn the stars; you will lose sleep.
desc [9aeff9] = 天文台屋顶上的午夜讲座。你会认识星星，也会失去睡眠。

@state class_healing
# en: Elective: Healing Arts
name [9056e4] = 选修：治愈术
# en: Mending flesh with light and needle. Sister Amaranth expects perfection.
desc [1f8e64] = 以光与针缝合血肉。阿玛兰斯修女要求完美。

@state class_umbral
# en: Elective: Umbral Theory
name [44e968] = 选修：暗影理论
# en: Restricted. The study of shadow, death and what lies behind both. Strictly theoretical. Mostly.
desc [ddfba6] = 受限课程。研究阴影、死亡，以及二者背后的东西。纯属理论。大体上是。

@state club_dueling
# en: Club: Dueling Circle
name [ba1685] = 社团：决斗社
# en: Bruises, glory and the Spring Tournament.
desc [284ecb] = 淤青、荣耀，还有春季锦标赛。

@state club_choir
# en: Club: Choir of the Spheres
name [7a5e02] = 社团：天球合唱团
# en: Harmonies that make the candles flicker in time.
desc [f7c729] = 和声能让烛火随着节拍摇曳。

@state club_skyrace
# en: Club: Skyrace Squad
name [ffb40f] = 社团：天空竞速队
# en: Brooms, hoops and screaming crowds.
desc [727b30] = 飞帚、光环和尖叫的人群。

@state club_ledger
# en: Club: The Lumen Ledger
name [c5d754] = 社团：《流明纪事报》社
# en: The student paper. Deadlines, scoops and enemies.
desc [0bbdce] = 学生报纸。截稿日、独家新闻和仇家。

@state club_garden
# en: Club: Verdant Circle
name [b7b687] = 社团：青翠社
# en: Greenhouse afternoons with mandrakes that sing off-key.
desc [443e64] = 温室里的午后时光，还有唱歌跑调的曼德拉草。

@state club_stargazers
# en: Club: Stargazers
name [82b69d] = 社团：观星社
# en: Telescopes, cocoa and constellations nobody else can name.
desc [7d729f] = 望远镜、热可可，以及谁也叫不出名字的星座。

@state club_cartographers
# en: Club: Midnight Cartographers
name [6737ac] = 社团：午夜制图社
# en: A club that officially does not exist, mapping corridors that officially do not either.
desc [e99289] = 一个官方上并不存在的社团，绘制着官方上同样不存在的走廊。

@state job_library
# en: Job: Library Assistant
name [79ff99] = 工作：图书馆助理
# en: Reshelving books that bite. Quiet hours, modest pay.
desc [c1eafc] = 把会咬人的书放回书架。工时安静，薪水微薄。

@state job_tavern
# en: Job: The Gilded Newt
name [73eefc] = 工作：镀金蝾螈酒馆
# en: Serving cider in the village tavern. Good tips, sore feet.
desc [598a90] = 在镇上的酒馆端苹果酒。小费不错，脚很酸。

@state job_apothecary
# en: Job: Apothecary Clerk
name [1e38cf] = 工作：药铺店员
# en: Labelling jars at Pell & Daughters. Do not lick anything.
desc [ddcc95] = 在佩尔父女药铺给瓶瓶罐罐贴标签。什么都别舔。

@state job_stables
# en: Job: Familiar Stables
name [ecb6b5] = 工作：魔宠马厩
# en: Feeding hippogriffs and mucking out things that breathe smoke.
desc [1c9431] = 喂鹰头马身有翼兽，清扫会喷烟的东西。

@state job_tutor
# en: Job: First-Year Tutor
name [c57f7a] = 工作：一年级辅导员
# en: Explaining the difference between a hex and a jinx, again.
desc [0f630b] = 再一次解释“恶咒”和“小咒”的区别。

@state job_courier
# en: Job: Broom Courier
name [c82174] = 工作：飞帚信使
# en: Parcels across the lake at full speed. Pays well. Hurts often.
desc [216f36] = 全速飞越湖面送包裹。报酬丰厚。经常受伤。

@state sick
# en: Lake Fever
name [977d44] = 湖热病
# en: Shivers, sniffles and a nose that glows faintly blue.
desc [ca2430] = 发抖、流鼻涕，鼻头还泛着淡淡的蓝光。

@state injured
# en: Injured
name [624ada] = 受伤
# en: Something is bruised, sprained or bent the wrong way.
desc [316db4] = 身上有什么地方青了、扭了，或者弯错了方向。

@state exhausted
# en: Exhausted
name [34cdec] = 精疲力竭
# en: You could sleep standing up. You might have.
desc [6c252f] = 你站着都能睡着。说不定已经睡过了。

@state inspired
# en: Inspired
name [b91753] = 灵感迸发
# en: Ideas arrive faster than you can write them down.
desc [ba8e50] = 想法涌来的速度比你记下来还快。

@state heartbroken
# en: Heartbroken
name [a560a2] = 心碎
# en: Songs are suddenly about you. All of them.
desc [dd2311] = 突然之间，所有的歌唱的都是你。每一首。

@state slacking
# en: Skipping Classes
name [169826] = 逃课中
# en: Freedom! Also: falling behind.
desc [e0a116] = 自由！以及：进度落后。

@state detention
# en: Detention
name [49189b] = 禁闭
# en: Scrubbing cauldrons under the eye of a prefect.
desc [e387b0] = 在级长的监视下刷坩埚。

@state probation
# en: Academic Probation
name [e41d9e] = 留校察看
# en: One more failure and the board will not be lenient. Raise your Standing above 35 to clear it.
desc [e60680] = 再失败一次，委员会就不会手下留情了。把学业提升到 35 以上即可解除。

@state in_debt
# en: Debt to Grisk
name [d38823] = 欠格里斯克的债
# en: The goblin moneylender takes 12 crowns a month until the debt is cleared.
desc [a06b95] = 地精放贷人每月拿走 12 克朗，直到债务还清。

@state famous
# en: Talk of the Academy
name [a60529] = 学院热议人物
# en: Strangers know your name. Some of them even say it nicely.
desc [e6822e] = 陌生人都知道你的名字。其中一些人提起时甚至还挺客气。

@state hiccup_hex
# en: Hiccup Hex
name [c18908] = 打嗝恶咒
# en: Every hiccup releases a small, harmless, extremely embarrassing firework.
desc [14430d] = 每打一个嗝，就会冒出一朵小小的、无害的、极其丢人的烟花。

@state blessed
# en: Maud's Blessing
name [d2410d] = 莫德的祝福
# en: A sprig of rosemary in your pocket that never wilts.
desc [7af4e4] = 口袋里一枝永不枯萎的迷迭香。

@state familiar_fox
# en: Familiar: Ember
name [7343af] = 魔宠：余烬
# en: A fox-spirit with a smouldering tail who has decided you are hers.
desc [8b3cfa] = 一只尾巴冒着余火的狐灵，她已经认定你是她的人了。

@state familiar_owl
# en: Familiar: Clockwork Owl
name [e993d5] = 魔宠：发条猫头鹰
# en: Mira's gift. It hoots the hour, mostly correctly, and remembers your homework.
desc [f65a4c] = 米拉的礼物。它会报时（大多准确），还会记得你的作业。

@state training
# en: Tournament Training
name [5aecec] = 锦标赛特训
# en: Dawn drills on the dueling green.
desc [ba8ab4] = 在决斗草坪上的黎明操练。

@state wakeful
# en: Draught of Wakefulness
name [e9272f] = 清醒药剂
# en: You haven't blinked in eleven hours. Your notes are immaculate.
desc [8764b7] = 你已经十一个小时没眨眼了。笔记无可挑剔。

@state haunted
# en: Haunted Dormitory
name [42efc1] = 闹鬼的宿舍
# en: Something rearranges your socks at night.
desc [88b052] = 夜里有什么东西在重新整理你的袜子。

@state watched
# en: Under Bram's Eye
name [53b10a] = 被布拉姆盯上
# en: The prefect is watching you. Specifically, and with relish.
desc [03458f] = 那位级长正盯着你。专门盯着，而且乐在其中。

@state umbral_curse
# en: Umbral Curse
name [11a418] = 暗影诅咒
# en: A cold that lives under your skin. Something in the restricted section followed you home.
desc [3ffb2e] = 一股寒意住在你的皮肤下。禁书区里有什么东西跟着你回来了。

@state hollow_dreams
# en: Hollow Dreams
name [b977da] = 空洞之梦
# en: Every night: a black star, a door beneath the lake, a voice that knows your name.
desc [b0df12] = 每一夜：一颗黑色的星，一扇湖底之门，一个知道你名字的声音。

@state star_mark
# en: The Star-Mark
name [b7b256] = 星痕
# en: A pale, star-shaped mark on your palm that hums near old magic.
desc [c1678d] = 掌心一枚苍白的星形印记，靠近古老魔法时会嗡嗡作响。

@state summer_away
# en: Summer Away
name [77bf0e] = 离校度暑
# en: Away from the academy for the summer recess. No rent, no classes.
desc [abac1f] = 暑假期间离开学院。不交房租，不用上课。

@state summer_work
# en: Summer Work
name [2d8ae9] = 暑期打工
# en: A summer of honest (and occasionally dishonest) labour.
desc [4dd36c] = 一个诚实（偶尔不太诚实）劳动的夏天。

@state frog_voice
# en: Croaking
name [5daa73] = 呱呱叫
# en: A botched transfiguration left you with the voice of a bullfrog.
desc [02c975] = 一次失败的变形术，让你的嗓音变成了牛蛙。

@state garden_plot
# en: Garden Plot
name [7ba473] = 一方菜园
# en: A little square of earth behind the greenhouses that is yours. Things grow; so do you.
desc [3a1dd5] = 温室后面一小块属于你的泥土。东西在长，你也在长。

@state pen_pal
# en: Pen Pal in Thornwick
name [7e85f7] = 荆木学院的笔友
# en: A student at the rival academy who writes you long, funny letters full of terrible gossip.
desc [b0b239] = 对手学院的一名学生，常给你写又长又好笑、满是糟糕八卦的信。

@state frost_ward
# en: Ilse's Frost-Ward
name [302a95] = 伊尔泽的霜之护符
# en: A sliver of Northern winter that Ilse sewed into your collar. Cold things think twice about you.
desc [ca24da] = 伊尔泽缝进你衣领里的一缕北境寒冬。冰冷的东西靠近你之前都会犹豫一下。
