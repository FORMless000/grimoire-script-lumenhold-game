# Lumenhold Academy — 简体中文 (zh-CN) translation of content/states/states.grim
# Maintained by `node tools/grim.js i18n zh-CN`. Translate the text after "="; keep {tokens}.
# "# en:" shows the English source. [hash] marks the English version a line was translated from;
# lines marked STALE need updating — after fixing the text, delete the [hash] and re-run the tool.


@state origin_noble
# en: Minor Nobility
name [ccd408] = 小贵族出身
# en: A family name that opens doors, and letters from home that bring money and expectations in the same envelope.
desc [1593e8] = 一个能敲开大门的姓氏，还有家书：钱和期望装在同一个信封里。
# en: Comfortable: 60 crowns from home to start, and 38 from the family before each later term, now and then with a gift. Every letter weighs on you a little. Tuition is yours to pay.
money [72c925] = 宽裕：起步时家里给 60 克朗，此后每学期开学前家里寄来 38 克朗，偶尔还有一份礼物。每封信都让你心里沉一沉。学费自己付。

@state origin_scholar
# en: Scholarship Student
name [036234] = 奖学金学生
# en: The Crown pays for clever students, for as long as they stay clever.
desc [a89deb] = 王室资助聪明的学生——只要他们一直聪明。
# en: Tight: 30 crowns to start. Before each later term, 38 crowns if last term's GPA was 3.0 or better, 46 at 3.5 or better, and nothing below. Tuition is yours to pay.
money [5d6aae] = 拮据：起步 30 克朗。此后每学期开学前，若上学期 GPA 达到 3.0，发 38 克朗；达到 3.5，发 46 克朗；低于 3.0 则分文没有。学费自己付。

@state origin_hedge
# en: Hedge-Witch's Grandchild
name [b36bba] = 乡野女巫的孙辈
# en: Raised among drying herbs and muttered charms: a practical hand with potions, and not much patience for theory.
desc [e66cc4] = 在晾晒的草药和念叨的咒语间长大：调药是一把好手，对理论却没什么耐心。
# en: Poor: 15 crowns and no money from home. You will need a job from the first term.
money [fa3a9c] = 贫穷：15 克朗，家里不会寄钱来。你从第一学期起就需要打工。

@state origin_street
# en: Street-Raised
name [9b8f09] = 街头长大
# en: You learned to read crowds before you learned to read runes.
desc [8551b3] = 你学会读懂人群，比学会读懂符文还早。
# en: Poor: 8 crowns and no one to send more. You will need a job from the first term.
money [224c03] = 贫穷：8 克朗，也没人会再寄钱来。你从第一学期起就需要打工。

@state origin_merchant
# en: Merchant's Child
name [a051a5] = 商人之子
# en: Everything has a price, and you were taught to haggle it down.
desc [c5b5c4] = 万物皆有价，而你从小就学会了砍价。
# en: Rich but unsteady: 120 crowns to start, and 78 from the company before each later term when trade goes well, about two terms in three; nothing when it doesn't. Tuition is yours to pay.
money [ae479e] = 富有但不稳定：起步 120 克朗；此后每学期开学前，生意好时商行寄来 78 克朗，大约三个学期有两个；生意不好就分文没有。学费自己付。

@state class_pyromancy
# en: Elective: Pyromancy
name [bc2cb8] = 选修：火焰术
# en: Fire answers to will, not wishes. Singed eyebrows are considered a rite of passage.
desc [f7cdfd] = 火焰回应意志，而非愿望。烧焦眉毛被视为一种成人礼。

@state class_tidecalling
# en: Elective: Tidecalling
name [25e58c] = 选修：唤潮术
# en: Lessons on the lake shore, bending water and patience in equal measure.
desc [550653] = 在湖岸上课，操纵湖水与磨练耐心，二者同等重要。

@state class_illusion
# en: Elective: Illusion & Glamour
name [b30964] = 选修：幻术与魅影
# en: The art of making people see what you want. Professor Vey insists it is not lying.
desc [7aa865] = 让人看见你想让他们看见的东西的艺术。维伊教授坚称这不算撒谎。

@state class_alchemy
# en: Elective: Practical Alchemy
name [8a43a8] = 选修：实用炼金
# en: Brewing, distilling and the occasional controlled explosion.
desc [4cfafb] = 熬煮、蒸馏，以及偶尔一场受控的爆炸。

@state class_divination
# en: Elective: Divination
name [14ec75] = 选修：占卜学
# en: Tea leaves, star charts and the Mirror of Next Tuesday.
desc [531e06] = 茶叶、星图，还有“下周二之镜”。

@state class_artifice
# en: Elective: Artifice
name [20fedd] = 选修：奇械术
# en: Enchanting objects to do what they were never meant to do.
desc [1d11f0] = 给物品施加魔法，让它们做本不该做的事。

@state class_beastcraft
# en: Elective: Beastcraft
name [664aeb] = 选修：驭兽学
# en: Familiars, griffon husbandry and dodging the manticore pen.
desc [d23187] = 魔宠、狮鹫饲养，以及绕开蝎尾狮的围栏。

@state class_astromancy
# en: Elective: Astromancy
name [58b65d] = 选修：星象学
# en: Midnight lectures on the observatory roof. You will learn the stars; you will lose sleep.
desc [9aeff9] = 天文台屋顶上的午夜讲座。你会认识星星，也会失去睡眠。

@state class_healing
# en: Elective: Healing Arts
name [9056e4] = 选修：治愈术
# en: Mending flesh with light and needle. Sister Amaranth expects perfection.
desc [1f8e64] = 以光与针缝合血肉。阿玛兰斯修女要求完美。

@state class_umbral
# en: Elective: Umbral Theory
name [44e968] = 选修：暗影理论
# en: Restricted. The study of shadow, death and what lies behind both. Strictly theoretical. Mostly.
desc [ddfba6] = 受限课程。研究阴影、死亡，以及二者背后的东西。纯属理论。大体上是。

@state club_dueling
# en: Club: Dueling Circle
name [ba1685] = 社团：决斗社
# en: Bruises, glory and the Spring Tournament.
desc [284ecb] = 淤青、荣耀，还有春季锦标赛。

@state club_choir
# en: Club: Choir of the Spheres
name [7a5e02] = 社团：天球合唱团
# en: Harmonies that make the candles flicker in time.
desc [f7c729] = 和声能让烛火随着节拍摇曳。

@state club_skyrace
# en: Club: Skyrace Squad
name [ffb40f] = 社团：天空竞速队
# en: Brooms, hoops and screaming crowds.
desc [727b30] = 飞帚、光环和尖叫的人群。

@state club_ledger
# en: Club: The Lumen Ledger
name [c5d754] = 社团：《流明纪事报》社
# en: The student paper. Deadlines, scoops and enemies.
desc [0bbdce] = 学生报纸。截稿日、独家新闻和仇家。

@state club_garden
# en: Club: Verdant Circle
name [b7b687] = 社团：青翠社
# en: Greenhouse afternoons with mandrakes that sing off-key.
desc [443e64] = 温室里的午后时光，还有唱歌跑调的曼德拉草。

@state club_stargazers
# en: Club: Stargazers
name [82b69d] = 社团：观星社
# en: Telescopes, cocoa and constellations nobody else can name.
desc [7d729f] = 望远镜、热可可，以及谁也叫不出名字的星座。

@state club_cartographers
# en: Club: Midnight Cartographers
name [6737ac] = 社团：午夜制图社
# en: A club that officially does not exist, mapping corridors that officially do not either.
desc [e99289] = 一个官方上并不存在的社团，绘制着官方上同样不存在的走廊。

@state job_library
# en: Job: Library Assistant
name [79ff99] = 工作：图书馆助理
# en: Reshelving books that bite. Quiet hours, modest pay.
desc [c1eafc] = 把会咬人的书放回书架。工时安静，薪水微薄。

@state job_tavern
# en: Job: The Gilded Newt
name [73eefc] = 工作：镀金蝾螈酒馆
# en: Serving cider in the village tavern. Good tips, sore feet.
desc [598a90] = 在镇上的酒馆端苹果酒。小费不错，脚很酸。

@state job_apothecary
# en: Job: Apothecary Clerk
name [1e38cf] = 工作：药铺店员
# en: Labelling jars at Pell & Daughters. Do not lick anything.
desc [ddcc95] = 在佩尔父女药铺给瓶瓶罐罐贴标签。什么都别舔。

@state job_stables
# en: Job: Familiar Stables
name [ecb6b5] = 工作：魔宠马厩
# en: Feeding hippogriffs and mucking out things that breathe smoke.
desc [1c9431] = 喂鹰头马身有翼兽，清扫会喷烟的东西。

@state job_tutor
# en: Job: First-Year Tutor
name [c57f7a] = 工作：一年级辅导员
# en: Explaining the difference between a hex and a jinx, again.
desc [0f630b] = 再一次解释“恶咒”和“小咒”的区别。

@state job_courier
# en: Job: Broom Courier
name [c82174] = 工作：飞帚信使
# en: Parcels across the lake at full speed. Pays well. Hurts often.
desc [216f36] = 全速飞越湖面送包裹。报酬丰厚。经常受伤。

@state hungry
# en: Hungry
name [0ae59c] = 饥饿
# en: The board went unpaid this month. Bread rolls pocketed from the refectory only go so far.
desc [67e035] = 这个月的伙食费没交上。从膳堂顺来的面包卷也只能撑这么久。
# en: {~Your stomach growls through every lecture.|Bread rolls in your pockets, and not enough of them.|You learn exactly how long a bowl of porridge lasts.}
tick.say.1 [169a81] = {~每节课上你的肚子都在叫。|兜里揣着面包，可惜不够多。|你精确地知道了一碗粥能撑多久。}

@state sick
# en: Lake Fever
name [977d44] = 湖热病
# en: Shivers, sniffles and a nose that glows faintly blue.
desc [ca2430] = 发抖、流鼻涕，鼻头还泛着淡淡的蓝光。
# en: {~You sniffle through the month, nose glowing faintly blue.|Shivers, tea and far too many handkerchiefs.}
tick.say.1 [f0b7d2] = {~你吸着鼻子过了一整个月，鼻尖泛着淡淡的蓝光。|发抖、喝茶，还有多得离谱的手帕。}

@state injured
# en: Injured
name [624ada] = 受伤
# en: Something is bruised, sprained or bent the wrong way.
desc [316db4] = 身上有什么地方青了、扭了，或者弯错了方向。
# en: {~Every staircase reminds you where it hurts.|You limp, and the moving stairs show no sympathy.}
tick.say.1 [c69fb6] = {~每一段楼梯都在提醒你哪里疼。|你一瘸一拐，会动的楼梯毫不同情。}

@state exhausted
# en: Exhausted
name [34cdec] = 精疲力竭
# en: You could sleep standing up. You might have.
desc [6c252f] = 你站着都能睡着。说不定已经睡过了。
# en: {~You yawn through a whole lecture without ever closing your mouth.|You could sleep standing up, and once you do.}
tick.say.1 [1a54ed] = {~你打了一整节课的哈欠，嘴就没合上过。|你站着都能睡着，而且真睡着过一次。}

@state inspired
# en: Inspired
name [b91753] = 灵感迸发
# en: Ideas arrive faster than you can write them down.
desc [ba8e50] = 想法涌来的速度比你记下来还快。
# en: {~Ideas arrive faster than you can write them down.|You fill a notebook and start another.}
tick.say.1 [d826d8] = {~灵感来得比你记下的还快。|你写满一本笔记，又开了一本。}

@state heartbroken
# en: Heartbroken
name [a560a2] = 心碎
# en: Songs are suddenly about you. All of them.
desc [dd2311] = 突然之间，所有的歌唱的都是你。每一首。
# en: {~Every song in the common room is about you.|You walk the long way round, to miss a certain corridor.}
tick.say.1 [f73fc5] = {~公共休息室里的每首歌都在唱你。|你绕远路走，只为避开某条走廊。}

@state slacking
# en: Skipping Classes
name [169826] = 逃课中
# en: Freedom! Also: falling behind.
desc [e0a116] = 自由！以及：进度落后。
# en: {~A free morning, a lie-in, a twinge of guilt.|You skip a lecture, and nobody seems to mind yet.}
tick.say.1 [2416b1] = {~一个自由的早晨，一场懒觉，一丝内疚。|你逃了一节课，暂时好像没人在意。}

@state detention
# en: Detention
name [49189b] = 禁闭
# en: Your afternoons and evenings belong to a prefect, a bucket and a long list of chores.
desc [51150d] = 你的下午和傍晚都归一个级长、一只水桶和一长串杂活所有。

@state probation
# en: Academic Probation
name [e41d9e] = 留校察看
# en: Your marks are below the line. Two terms under a 1.0 and the Disciplinary Board sits. A GPA of 2.0 clears it.
desc [9f9702] = 你的成绩跌破了底线。连续两个学期GPA 低于 1.0，纪律委员会就要开会了。GPA 回到 2.0 即可解除。
# en: {~Probation sits on your shoulder through every lecture.|Your name is on a list you never wanted to be on.}
tick.say.1 [95cc4f] = {~每节课上，察看处分都压在你肩头。|你的名字上了一张你从不想上的名单。}

@state hardship_grant
# en: Hardship Grant
name [db03a0] = 困难补助
# en: The bursar's hardship fund pays 8 crowns a month for a term. The paperwork asked how poor you were, in detail.
desc [b1f685] = 财务官的困难基金每月发 8 克朗，为期一个学期。申请表把你有多穷问得清清楚楚。
# en: {~The hardship grant arrives in a brown envelope with your name spelled wrong.|Eight crowns from the fund, and a form to say you received them.}
tick.say.1 [6386b4] = {~困难补助装在一个牛皮纸信封里送来，你的名字拼错了。|基金寄来八克朗，外加一张让你签收的表格。}

@state bursar_loan
# en: Bursar's Loan
name [9b1ce0] = 财务官的贷款
# en: The academy lent you sixty crowns. It takes 8 a month when you can pay, seven times, then a last 4, with no interest and no collectors: only a very patient ledger.
desc [2599b5] = 学院借给你六十克朗。等你付得起时每月还 8 克朗，共七次，最后一次还 4 克朗，不收利息，也没有催债人：只有一本非常有耐心的账簿。
# en: {~No loan payment this month. The bursar notes it without comment, which is its own comment.|The loan waits. The ledger is patient; you are less so.}
tick.say.1 [863378] = {~这个月没还贷款。财务官记下了，一言不发，这本身就是一种表态。|贷款在等着。账簿很有耐心，你就没那么有耐心了。}
# en: The bursar's loan is paid off. She stamps the ledger with something like a smile.
tick.say.2 [f6df86] = 财务官的贷款还清了。她在账簿上盖了个章，脸上的表情近乎微笑。

@state in_debt
# en: Debt to Grisk
name [d38823] = 欠格里斯克的债
# en: The goblin moneylender takes 12 crowns a month until the debt is cleared. Ignore a missed payment and he adds another.
desc [37f244] = 地精放贷人每月拿走 12 克朗，直到债务还清。漏还一笔却置之不理，他就再加一个月。

@state famous
# en: Talk of the Academy
name [a60529] = 学院热议人物
# en: Strangers know your name. Some of them even say it nicely.
desc [e6822e] = 陌生人都知道你的名字。其中一些人提起时甚至还挺客气。

@state hiccup_hex
# en: Hiccup Hex
name [c18908] = 打嗝恶咒
# en: Every hiccup releases a small, harmless, extremely embarrassing firework.
desc [14430d] = 每打一个嗝，就会冒出一朵小小的、无害的、极其丢人的烟花。

@state blessed
# en: Maud's Blessing
name [d2410d] = 莫德的祝福
# en: A sprig of rosemary in your pocket that never wilts.
desc [7af4e4] = 口袋里一枝永不枯萎的迷迭香。

@state familiar_fox
# en: Familiar: Ember
name [7343af] = 魔宠：余烬
# en: A fox-spirit with a smouldering tail who has decided you are hers.
desc [8b3cfa] = 一只尾巴冒着余火的狐灵，她已经认定你是她的人了。

@state familiar_owl
# en: Familiar: Clockwork Owl
name [e993d5] = 魔宠：发条猫头鹰
# en: Mir's gift. It hoots the hour, mostly correctly, and remembers your homework.
desc [863cd5] = 米尔的礼物。它会报时（大多准确），还会记得你的作业。

@state training
# en: Tournament Training
name [5aecec] = 锦标赛特训
# en: Dawn drills on the dueling green.
desc [ba8ab4] = 在决斗草坪上的黎明操练。

@state wakeful
# en: Draught of Wakefulness
name [e9272f] = 清醒药剂
# en: You haven't blinked in eleven hours. Your notes are immaculate.
desc [8764b7] = 你已经十一个小时没眨眼了。笔记无可挑剔。

@state haunted
# en: Haunted Dormitory
name [42efc1] = 闹鬼的宿舍
# en: Something rearranges your socks at night.
desc [88b052] = 夜里有什么东西在重新整理你的袜子。

@state watched
# en: Under Bram's Eye
name [53b10a] = 被布拉姆盯上
# en: The prefect is watching you. Specifically, and with relish.
desc [03458f] = 那位级长正盯着你。专门盯着，而且乐在其中。

@state umbral_curse
# en: Umbral Curse
name [11a418] = 暗影诅咒
# en: A cold that lives under your skin. Something in the restricted section followed you home.
desc [3ffb2e] = 一股寒意住在你的皮肤下。禁书区里有什么东西跟着你回来了。

@state hollow_dreams
# en: Hollow Dreams
name [b977da] = 空洞之梦
# en: Every night: a black star, a door beneath the lake, a voice that knows your name.
desc [b0df12] = 每一夜：一颗黑色的星，一扇湖底之门，一个知道你名字的声音。

@state star_mark
# en: The Star-Mark
name [b7b256] = 星痕
# en: A pale, star-shaped mark on your palm that hums near old magic.
desc [c1678d] = 掌心一枚苍白的星形印记，靠近古老魔法时会嗡嗡作响。

@state star_crowned
# en: The Star's Crown
name [0aeb75] = 星之冠
# en: The star on your palm has grown a crown of points. Spells come at a thought, and a voice at the back of your mind agrees with you a little too often.
desc [3a1131] = 你掌心的星痕长出了一圈冠冕般的尖角。咒语心念一动便成，脑海深处有个声音，总是过分地赞同你。

@state star_taste
# en: A Taste of the Star
name [751069] = 星辰的滋味
# en: Since the man in grey showed you, everything comes easier, and every night you dream of cold water.
desc [87451c] = 自从灰衣人让你看过之后，一切都变得容易，而每天夜里你都梦见冰冷的水。
# en: {~Spells come easier, and the dreams come colder.|You wake with frost on the inside of the window, and the day's work goes like a song.}
tick.say.1 [477cc7] = {~咒语来得更容易了，梦也更冷了。|你醒来时窗户内侧结了霜，而这一天的功课顺得像一首歌。}

@state grey_watching
# en: He Remembers
name [a9b41a] = 他记得
# en: You told the man in grey to get out. Candles burn blue when you're alone in the library, and you've learned to look over your shoulder.
desc [e4400f] = 你叫灰衣人滚出去。你独自待在图书馆时，蜡烛会烧成蓝色，你也学会了时不时回头看一眼。

@state summer_away
# en: Summer Away
name [77bf0e] = 离校度暑
# en: Away from the academy for the summer recess. No rent, no classes.
desc [abac1f] = 暑假期间离开学院。不交房租，不用上课。

@state summer_work
# en: Summer Work
name [2d8ae9] = 暑期打工
# en: A summer of honest (and occasionally dishonest) labour.
desc [4dd36c] = 一个诚实（偶尔不太诚实）劳动的夏天。

@state frog_voice
# en: Croaking
name [5daa73] = 呱呱叫
# en: A botched transfiguration left you with the voice of a bullfrog.
desc [02c975] = 一次失败的变形术，让你的嗓音变成了牛蛙。

@state garden_plot
# en: Garden Plot
name [7ba473] = 一方菜园
# en: A little square of earth behind the greenhouses that is yours. Things grow; so do you.
desc [3a1dd5] = 温室后面一小块属于你的泥土。东西在长，你也在长。

@state pen_pal
# en: Pen Pal in Thornwick
name [7e85f7] = 荆木学院的笔友
# en: A student at the rival academy who writes you long, funny letters full of terrible gossip.
desc [b0b239] = 对手学院的一名学生，常给你写又长又好笑、满是糟糕八卦的信。

@state frost_ward
# en: Ilse's Frost-Ward
name [302a95] = 伊尔泽的霜护符
# en: A sliver of Northern winter that Ilse sewed into your collar. Cold things think twice about you.
desc [ca24da] = 伊尔泽缝进你衣领里的一缕北境寒冬。冰冷的东西靠近你之前都会犹豫一下。

@state plan_castle
# en: Break: at the castle
name [961ce0] = 假期：留在城堡
# en: A skeleton crew, empty corridors and secrets. Board costs 6 crowns a month.
desc [c6616d] = 只剩少数留守的职员、空荡的走廊和秘密。每月食宿 6 克朗。

@state plan_home
# en: Break: at home
name [5a492e] = 假期：回家
# en: Family, old friends and free board. The days are slower here.
desc [8e2284] = 家人、老朋友和免费食宿。这里的日子过得慢些。

@state gig_grounds
# en: Holiday gig: the grounds
name [1908bb] = 假期打工：庭园
# en: Working the grounds for Old Maud this break. Good pay, sore hands.
desc [c0cf6b] = 这个假期跟老莫德打理庭园。工钱不错，手会酸。

@state gig_kitchens
# en: Holiday gig: the kitchens
name [78fcf0] = 假期打工：后厨
# en: Working the Refectory kitchens this break. Good pay, short temper.
desc [b6d78e] = 这个假期在膳堂后厨帮工。工钱不错，脾气会变短。

@state gig_library
# en: Holiday gig: the stocktake
name [4d1632] = 假期零工：图书盘点
# en: The library's holiday stocktake, for its senior clerks. Every book counted, every bite noted. Better pay than the baseline gigs.
desc [ffcda9] = 图书馆的假期盘点，给资深馆员的活。每本书都要数，每次被咬都要记。比基础零工报酬更高。

@state gig_newt
# en: Holiday gig: the Newt's holiday rush
name [d06f0d] = 假期零工：蝾螈酒馆的节日高峰
# en: Running the Gilded Newt through the holiday rush, for its managers. The best tips of the year, and the longest nights.
desc [1bfad0] = 替镀金蝾螈酒馆撑过节日高峰，给经理的活。一年里最好的小费，也是最长的夜。

@state gig_pell
# en: Holiday gig: the remedy rush
name [cbd921] = 假期零工：药剂旺季
# en: Mixing the season's remedies at Pell & Daughters, for its assistant apothecaries. Good pay, and the village depends on it.
desc [13afb3] = 在佩尔父女药铺调配应季药剂，给助理药师的活。报酬不错，全村都指望着你。

@state gig_post
# en: Holiday gig: the holiday post
name [715a4f] = 假期零工：节日邮件
# en: Flying the holiday post for the courier loft, for its chief couriers. Every parcel in the valley, and the weather against you.
desc [efbb90] = 替信使阁楼飞送节日邮件，给首席信使的活。山谷里的每一个包裹，还有跟你作对的天气。

@state plan_work
# en: Break: working full-time
name [3237e0] = 假期：全职打工
# en: Working on campus through the break: a holiday gig, and board as usual. Tiring.
desc [91b8eb] = 整个假期在校内打工：一份假期零工，食宿照常付。很累。

@state plan_internship
# en: Break: internship
name [4871d8] = 假期：实习
# en: A research placement away from the castle, with a stipend and a supervisor.
desc [f66cf3] = 离开城堡的研究实习，有津贴，也有导师。

@state locked_out
# en: Confined After Dark
name [3f39dd] = 入夜禁足
# en: Caught once too often. Your door is checked at midnight, and the night is closed to you.
desc [a2bb11] = 被抓得太多次了。午夜有人查你的门，夜晚对你关上了。
