# Lumenhold Academy — 简体中文 (zh-CN) translation of content/world/items.grim
# Maintained by `node tools/grim.js i18n zh-CN`. Translate the text after "="; keep {tokens}.
# "# en:" shows the English source. [hash] marks the English version a line was translated from;
# lines marked STALE need updating — after fixing the text, delete the [hash] and re-run the tool.


@item borrowed_wand
# en: Borrowed Wand
name [d1a14d] = 借来的魔杖
# en: The academy's loan to every first-year: scuffed beech, a chipped tip and somebody else's initials on the handle. It works. Mostly.
desc [0cbc2c] = 学院借给每个一年级生的：磨花的山毛榉，崩了一角的杖尖，杖柄上刻着别人的姓名缩写。能用。大部分时候。

@item hazel_wand
# en: Hazelwood Wand
name [60934a] = 榛木魔杖
# en: Mir's work: light, springy hazel with a copper band. It warms up before you do.
desc [ab427a] = 米尔的手艺：轻巧有弹性的榛木，箍着一圈铜。它比你先热起来。

@item ashwood_wand
# en: Ashwood Duelling Wand
name [47421e] = 白蜡木决斗魔杖
# en: A duellist's wand, dense and unforgiving. Anything that tries to block it gets a shock for its trouble.
desc [c99d2d] = 决斗者的魔杖，沉实，毫不留情。谁想挡它，谁就会被狠狠震一下。

@item heartwood_wand
# en: Heartwood Wand
name [9cc254] = 心材魔杖
# en: Carved by Mir from a splinter the elder oak gave you. The grain moves when no one is looking.
desc [033f3b] = 米尔用古橡送你的木片雕成。没人看的时候，木纹会动。

@item edmunds_silver_wand
# en: Edmund's Silver Wand
name [52050b] = 埃德蒙的银魔杖
# en: Slender silver, sixty years old, wrapped for decades in a faded scarf. Near the lake it hums one low note.
desc [b73a9d] = 纤细的银杖，六十岁了，在一条褪色的围巾里裹了几十年。靠近湖边时，它会哼出一个低音。

@item thorn_wand
# en: Thorn Wand
name [881a54] = 荆棘魔杖
# en: Blackthorn, still bristling, still faintly green at the core. It wants to be used, and it does not much care for what.
desc [f9b9f8] = 黑刺李木，尖刺仍在，芯里还泛着一点绿。它想被使用，至于用来做什么，它不太在乎。
# en: {~The thorn wand pricks your palm when you pick it up, as if it were keeping count.|You dream of brambles growing over a door. The thorn wand is warm in the morning.}
tick.say.1 [94b5cd] = {~你拿起荆棘魔杖时，它扎了一下你的掌心，像在记数。|你梦见荆棘爬满了一扇门。早上醒来，荆棘魔杖是温的。}

@item school_robes
# en: School Robes
name [d3931a] = 校袍
# en: Regulation black with the house trim, a size too big in the sleeves. Everyone has a pair.
desc [1e3de2] = 按规定的黑色，镶着学院边，袖子大了一号。人人都有一套。

@item duelling_coat
# en: Quilted Duelling Coat
name [d80576] = 绗缝决斗外套
# en: Padded, stitched in diamonds, smelling faintly of the duelling hall. Bracing in it feels like leaning on a wall.
desc [8a4280] = 夹着棉，缝成菱格，隐约有决斗厅的味道。穿着它坚守，像靠在一堵墙上。

@item ward_cloak
# en: Ward-Stitched Cloak
name [3c238e] = 护界绣斗篷
# en: Amaranth's ward thread runs through the hem in a pattern too fine to see. Fire and frost slide off it like rain.
desc [253e8a] = 阿玛兰斯修女的护界线织进了下摆，花纹细得看不见。火与霜从上面滑落，就像雨水。

@item midnight_robes
# en: Midnight-Blue Robes
name [1d09a3] = 午夜蓝长袍
# en: Deep blue wool with silver trim and a lining like the night sky. People stand up a little straighter when you walk in.
desc [0219e6] = 深蓝羊毛，镶银边，里衬像夜空。你一走进来，大家都会把腰板挺直一点。

@item spinner_silk_robe
# en: Spinner-Silk Robe
name [4b8892] = 织网者丝袍
# en: Grey silk that drinks the light, sewn by the village tailor from what the Spinner left you. You move in it like a rumour.
desc [e3e7a0] = 吸光的灰丝，由小镇裁缝用织网者留给你的丝缝成。穿上它，你走动起来像一则传言。

@item ilse_frost_ward
# en: Ilse's Frost-Ward
name [302a95] = 伊尔泽的霜护符
# en: A sliver of Northern winter that Ilse sewed into your collar. Cold things think twice about you.
desc [ca24da] = 伊尔泽缝进你衣领里的一小片北境寒冬。冰冷的东西靠近你之前会再想一想。

@item black_star_coin
# en: Black-Star Coin
name [48124c] = 黑星硬币
# en: Black, cold as ice and heavier than it should be, stamped with a hollow star. You keep meaning to throw it away.
desc [710aa7] = 漆黑，冰冷，比它该有的分量更沉，上面压着一颗空心的星。你一直打算把它扔掉。

@item lodestone_pendant
# en: Lodestone Pendant
name [08ddaa] = 磁石吊坠
# en: A dark stone on a leather cord that turns, very slowly, to face north. In the Whisperwood it is never wrong.
desc [08b15b] = 皮绳上挂着一块暗色的石头，会非常缓慢地转向北方。在低语森林里，它从不出错。

@item stag_tine
# en: Stag's Tine
name [86432e] = 鹿角尖
# en: A tine shed by the shadow stag, smooth as old ivory. Wild things look at it before they look at you.
desc [3c8e61] = 影鹿脱落的一截角尖，光滑得像旧象牙。野生的东西会先看它，再看你。

@item owl_quill
# en: Owl-Feather Quill
name [4a647e] = 猫头鹰羽毛笔
# en: A barn-owl feather cut to a nib. Notes taken with it are tidier than the hand that wrote them.
desc [565ab9] = 一根仓鸮羽毛削成的笔。用它记的笔记，比写字的手还要工整。

@item moonpetal_locket
# en: Moonpetal Locket
name [9f9cf2] = 月瓣吊盒
# en: A plain silver locket with one pressed moonpetal inside. It opens on its own at midnight.
desc [4c3806] = 一只朴素的银吊盒，里面夹着一片压干的月瓣花。到了午夜，它会自己打开。

@item pocket_almanac
# en: Pocket Almanac
name [b50a94] = 袖珍年历
# en: Tides, moons and weather for fifty years, in print you need a lens for. Grimsby's pencil notes run down every margin.
desc [20f75c] = 五十年的潮汐、月相和天气，字小得要用放大镜看。格林斯比的铅笔批注写满了每一页的页边。

@item measuring_spoon
# en: Pell's Measuring Spoon
name [64ca3a] = 佩尔的量勺
# en: A brass spoon worn thin on one side by forty years of exact quarters. Pell's daughters say it is theirs.
desc [f96014] = 一把黄铜勺，四十年来精确地量了无数个四分之一，一侧都磨薄了。佩尔的女儿们说这是她们的。

@item honey_tin
# en: Honey Tin
name [516547] = 蜂蜜罐
# en: A dented tin of Maud's silver-bee honey. Shared, it opens doors; the bees seem to know it is yours.
desc [812c30] = 一只磕瘪了的罐子，装着老莫德的银蜂蜜。拿出来分享，能叩开许多门；蜜蜂们似乎知道它是你的。

@item outcast_grimoire
# en: The Outcast's Grimoire
name [a3c841] = 放逐者的魔典
# en: A black-bound book of forbidden practice in a cramped, elegant hand. Its pages are cold, and some of them are blank until midnight.
desc [747aa5] = 一本黑色封皮的禁术之书，字迹紧凑而优雅。书页冰冷，有些页要到午夜才显出字来。
