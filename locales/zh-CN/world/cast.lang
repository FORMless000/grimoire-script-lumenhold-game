# Lumenhold Academy — 简体中文 (zh-CN) translation of content/world/cast.grim
# Maintained by `node tools/grim.js i18n zh-CN`. Translate the text after "="; keep {tokens}.
# "# en:" shows the English source. [hash] marks the English version a line was translated from;
# lines marked STALE need updating — after fixing the text, delete the [hash] and re-run the tool.


@npc lyra
# en: Lyra Vaneshade
name [7ccd7a] = 莱拉·凡妮希德
# en: Heir of House Vaneshade, pyromancy prodigy
title [a4c6ad] = 凡妮希德家族继承人，火焰术天才
# en: Emberhall
house [6adebf] = 烬厅
# en: Brilliant, impatient and used to winning. She treats everyone as either a rival or furniture — and is quietly lonely about it.
desc [b8c380] = 才华横溢，缺乏耐心，习惯了赢。在她眼里，每个人要么是对手，要么是家具——她为此默默地孤独着。

@npc tobias
# en: Tobias Fennick
name [b5c657] = 托比亚斯·芬尼克
# en: Farmer's son on a turnip scholarship
title [ae6bc4] = 拿着芜菁奖学金的农家子弟
# en: Rootward
house [dd14d3] = 根庐
# en: Big hands, bigger heart. Talks to plants and, worryingly, the plants seem to answer.
desc [325d88] = 手掌大，心更大。他会跟植物说话，而令人担忧的是，植物似乎会回答。

@npc seraphine
# en: Seraphine Hale
name [b9b6ae] = 瑟拉芬·海尔
# en: Seer who never quite looks at the present
title [a72b9b] = 从不正眼看“现在”的预言者
# en: Stillwater
house [67e7fc] = 静水
# en: Speaks in half-sentences, as if finishing the other half in a different week. Often right. Unsettlingly often.
desc [abbc16] = 说话总是只说半句，仿佛另一半要留到下个星期再说完。她常常是对的。准得让人发毛。

@npc corvin
# en: Corvin Ashby
name [5f13bd] = 科尔文·阿什比
# en: Charming liability
title [c06ba3] = 迷人的麻烦精
# en: Duskgate
house [a1e05f] = 暮门
# en: Knows every locked door in the academy and has opinions about all of them. Owes money to at least three people.
desc [3fb5db] = 认识学院里每一扇锁着的门，并对每一扇都有意见。至少欠着三个人的钱。

@npc mira
# en: Mira Ten
name [6acc41] = 米拉·滕
# en: Artificer of questionable inventions
title [dcc640] = 发明可疑的奇械师
# en: Brasswick
house [6604c0] = 铜芯
# en: Smells permanently of solder and ozone. Has built a clockwork owl, a self-stirring cauldron and at least one small fire.
desc [7b73bc] = 身上永远带着焊锡和臭氧的味道。造过一只发条猫头鹰、一口自动搅拌坩埚，以及至少一场小火灾。

@npc kael
# en: Kael Dumont
name [18aead] = 凯尔·杜蒙
# en: Transfer student from the frozen North
title [80355d] = 来自冰封北境的转学生
# en: Stillwater
house [67e7fc] = 静水
# en: Arrived mid-term with no luggage and frost in his eyelashes. Doesn't talk about where he came from. Watches the sky at night.
desc [058f2e] = 学期中途到来，没带行李，睫毛上挂着霜。从不谈起自己从哪里来。夜里总在看天。

@npc nessa
# en: Nessa Quill
name [3ad688] = 内莎·奎尔
# en: Editor of the Lumen Ledger
title [c35a40] = 《流明纪事报》主编
# en: Duskgate
house [a1e05f] = 暮门
# en: Runs the student paper with a quill that writes on its own. Everyone is a story; some are just not finished yet.
desc [2179de] = 用一支会自己写字的羽毛笔经营着学生报纸。每个人都是一个故事；有些只是还没写完。

@npc bram
# en: Bram Hollis
name [182554] = 布拉姆·霍利斯
# en: Prefect, enforcer, menace
title [2cee1b] = 级长、执法者、祸害
# en: Emberhall
house [6adebf] = 烬厅
# en: Upper-year prefect with a ledger of demerits and a fondness for writing your name in it.
desc [01de4f] = 高年级级长，揣着一本记过簿，特别喜欢在上面写你的名字。

@npc thorne
# en: Professor Aldric Thorne
name [734bbb] = 奥尔德里克·索恩教授
# en: Professor Thorne
short [fff982] = 索恩教授
# en: Master of Arcana
title [c13eee] = 奥术大师
# en: Faculty
house [078d5f] = 教职员
# en: Severe, exacting, allergic to flattery. Rumoured to have once out-dueled a storm.
desc [a1a584] = 严厉、苛刻，对奉承过敏。传说他曾在决斗中赢过一场风暴。

@npc maud
# en: Old Maud
name [9c77f5] = 老莫德
# en: Old Maud
short [9c77f5] = 老莫德
# en: Groundskeeper and hedge-witch
title [e5de9f] = 园丁兼乡野女巫
# en: Faculty
house [078d5f] = 教职员
# en: Keeps bees, chickens and a rather large secret garden. Gives advice you only understand two weeks later.
desc [8d1e7c] = 养蜂、养鸡，还有一座相当大的秘密花园。她的建议，你往往要过两周才听得懂。

@npc isolde
# en: Headmistress Isolde Marrow
name [9e3659] = 伊索尔德·马罗院长
# en: Headmistress Marrow
short [feeebf] = 马罗院长
# en: Headmistress of Lumenhold
title [b622da] = 流明堡院长
# en: Faculty
house [078d5f] = 教职员
# en: Tall, pale and impossibly calm. She remembers every student's name — and every student's mistakes.
desc [264ae0] = 高挑、苍白，冷静得不可思议。她记得每个学生的名字——也记得每个学生犯过的错。

@npc ilse
# en: Ilse Dumont
name [7e9501] = 伊尔泽·杜蒙
# en: Kael's younger sister, a storm in white furs
title [8c137b] = 凯尔的妹妹，一场裹着白色毛皮的风暴
# en: none
house [a7afdb] = 无
# en: Raised by the Hollow cult to open a door she has never seen. Sharp as an icicle, lonely as a frozen lake, and much younger than she pretends to be.
desc [908293] = 被空洞教团养大，只为打开一扇她从未见过的门。锋利如冰锥，孤独如冰封的湖——而且比她装出来的样子年轻得多。
