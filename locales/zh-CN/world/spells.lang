# Lumenhold Academy — 简体中文 (zh-CN) translation of content/world/spells.grim
# Maintained by `node tools/grim.js i18n zh-CN`. Translate the text after "="; keep {tokens}.
# "# en:" shows the English source. [hash] marks the English version a line was translated from;
# lines marked STALE need updating — after fixing the text, delete the [hash] and re-run the tool.


@spell flame
# en: Flame
name [1551a0] = 火焰
# en: Fire from the fingertips: a candle's worth at first, a bonfire's later. Burns through wards that only expect cleverness.
desc [500494] = 指尖生火：起初只有一根蜡烛的分量，后来是一堆篝火。能烧穿那些只防备聪明人的结界。

@spell tide
# en: Tide
name [f63371] = 潮涌
# en: Water called up and moved: a wave, a wall, a lake politely asked to step aside.
desc [dfeef2] = 召来并驱使水：一道浪，一堵水墙，或请一整片湖礼貌地让开。

@spell foresight
# en: Foresight
name [1834e4] = 预见
# en: A glimpse of the next few moments. Enough to know which way the dice will fall, sometimes.
desc [d1ae0e] = 瞥见接下来的片刻。有时，足以知道骰子会落在哪一面。

@spell starlight
# en: Starlight
name [461e3b] = 星光
# en: The light of a named star, held in the hand. Darkness that eats light finds it hard to swallow.
desc [c90510] = 一颗有名字的星星的光，握在手里。吞噬光的黑暗很难把它咽下去。

@spell mend
# en: Mend
name [c5efbd] = 愈合
# en: Knits cuts, cracks and broken teacups. Hearts take longer.
desc [fff564] = 缝合伤口、裂缝和摔碎的茶杯。心要慢一些。

@spell purify
# en: Purify
name [3d9ade] = 净化
# en: Draws out poison, curse-cold and bad ingredients. The cure has to come from somewhere; it leaves you tired.
desc [3c860c] = 拔除毒素、诅咒之寒和坏掉的药材。解药总得从某处来；它会让你很累。

@spell glamour
# en: Glamour
name [ca8c7e] = 魅影
# en: A little more charm than you really have. People remember liking you and not quite why.
desc [844244] = 比你实际拥有的多一点点魅力。人们记得喜欢你，却说不清为什么。

@spell mirror
# en: Mirror
name [247ee2] = 镜像
# en: A double of yourself, or of anything you can see. It doesn't talk, which is its only flaw.
desc [664e97] = 一个你自己的替身，或任何你看得见的东西的替身。它不会说话——这是它唯一的缺点。

@spell haste
# en: Haste
name [2f6010] = 疾速
# en: Speed borrowed from hares and hawks. You act first; you pay for it with a long nap.
desc [1f52a3] = 从野兔和鹰那里借来的速度。你先出手；代价是之后睡上很久。

@spell beast_speech
# en: Beast-speech
name [ba402d] = 兽语
# en: Talk with animals, briefly. Most of them have been waiting to complain.
desc [9298ce] = 短暂地与动物交谈。它们大多一直在等着抱怨。

@spell ward
# en: Ward
name [a11053] = 护界
# en: A pale shell that turns aside the next harm.
desc [349fd9] = 一层苍白的护壳，能挡开下一次伤害。

@spell shadowstep
# en: Shadowstep
name [d5b5ab] = 影步
# en: Step into one shadow and out of another. Short distances only; the shadows in between are not friendly.
desc [c7cfde] = 踏入一片影子，从另一片影子里走出。只限短距离；中间的那些影子并不友善。
